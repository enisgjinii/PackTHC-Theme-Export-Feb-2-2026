{"sections":{"custom_liquid_yPbBx7":{"type":"custom-liquid","name":"Calendly Link","settings":{"custom-liquid":"<div id=\"draggableCalendly\">\n    <a href=\"https:\/\/calendly.com\/digital-packthc\/30min\" target=\"_blank\" style=\"position: fixed; top: 185px; right: 20px; left: unset; z-index: 1000;width: 150px;height: 150px;border-radius: 10px;overflow: hidden;box-shadow: 0 4px 15px rgba(0,0,0,0.2);display: block;text-decoration: none;cursor: move;\">\n        <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0618\/1925\/6945\/files\/calendly-new.gif?v=1758821779\" \n             alt=\"Book a Meeting\" \n             style=\"width: 100%; height: 100%; object-fit: cover; pointer-events: none;\">\n    <\/a>\n<\/div>\n\n<style>\n#draggableCalendly a {\n    transition: transform 0.3s ease, box-shadow 0.3s ease;\n}\n#draggableCalendly a:hover:not(.dragging) {\n    transform: scale(1.05);\n}\n#draggableCalendly a.dragging {\n    opacity: 0.8;\n    transform: scale(1.05);\n    box-shadow: 0 8px 25px rgba(0,0,0,0.4) !important;\n}\n@media (max-width: 768px) {\n    #draggableCalendly a {\n        width: 80px !important;\n        height: 80px !important;\n        right: 10px !important;\nleft: unset !important;\nz-index: 98 !important;\n    }\n}\n<\/style>\n\n<script>\ndocument.addEventListener('DOMContentLoaded', function() {\n    var container = document.getElementById('draggableCalendly');\n    if (!container) return;\n    \n    var btn = container.querySelector('a');\n    if (!btn) return;\n    \n    var isDragging = false;\n    var hasMoved = false;\n    var startX, startY, initialX, initialY;\n\n    btn.addEventListener('mousedown', function(e) {\n        isDragging = true;\n        hasMoved = false;\n        btn.classList.add('dragging');\n        startX = e.clientX;\n        startY = e.clientY;\n        initialX = btn.offsetLeft;\n        initialY = btn.offsetTop;\n        e.preventDefault();\n        e.stopPropagation();\n    });\n\n  document.addEventListener('mousemove', function(e) {\n        if (isDragging) {\n            hasMoved = true;\n            var deltaX = e.clientX - startX;\n            var deltaY = e.clientY - startY;\n            btn.style.left = (initialX + deltaX) + 'px';\n            btn.style.top = (initialY + deltaY) + 'px';\n            btn.style.right = 'auto';\n        }\n    });\n\n    document.addEventListener('mouseup', function() {\n        if (isDragging) {\n            isDragging = false;\n            btn.classList.remove('dragging');\n        }\n    });\n\n    btn.addEventListener('click', function(e) {\n        if (hasMoved) {\n            e.preventDefault();\n            e.stopPropagation();\n        }\n    });\n\n    \/\/ Touch support for mobile\n    btn.addEventListener('touchstart', function(e) {\n        isDragging = true;\n        hasMoved = false;\n        btn.classList.add('dragging');\n        var touch = e.touches[0];\n        startX = touch.clientX;\n        startY = touch.clientY;\n        initialX = btn.offsetLeft;\n        initialY = btn.offsetTop;\n        e.preventDefault();\n        e.stopPropagation();\n    }, {passive: false});\n\n    document.addEventListener('touchmove', function(e) {\n        if (isDragging) {\n            hasMoved = true;\n            var touch = e.touches[0];\n            var deltaX = touch.clientX - startX;\n            var deltaY = touch.clientY - startY;\n            btn.style.left = (initialX + deltaX) + 'px';\n            btn.style.top = (initialY + deltaY) + 'px';\n            btn.style.right = 'auto';\n            e.preventDefault();\n        }\n    }, {passive: false});\n\n    document.addEventListener('touchend', function() {\n        if (isDragging) {\n            isDragging = false;\n            btn.classList.remove('dragging');\n            setTimeout(function() {\n                hasMoved = false;\n            }, 100);\n        }\n    });\n});\n<\/script>"}},"custom_liquid_XcYCx3":{"type":"custom-liquid","name":"t:sections.custom-liquid.p