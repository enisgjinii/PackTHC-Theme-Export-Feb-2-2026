{"sections":{"breadcrumb_cyhcMz":{"type":"breadcrumb","settings":{"full":false,"color_scheme":"","alignment":"flex-start","show_title":false,"title_font":"--heading-font-family","title_size":10,"title_space":10,"padding_top":10,"padding_bottom":10,"padding_top_mobile":5,"padding_bottom_mobile":5}},"main":{"type":"main-product","blocks":{"vendor_EKQiFe":{"type":"vendor","settings":{"padding_bottom":10}},"title":{"type":"title","settings":{"font_size":"h3","padding_bottom":20}},"judge_me_reviews_preview_badge_gFX3GF":{"type":"shopify:\/\/apps\/judge-me-reviews\/blocks\/preview_badge\/61ccd3b1-a9f2-4160-9fe9-4fec8413e5d8","settings":{}},"price":{"type":"price","settings":{"font_size_price":"h4","padding_bottom":20}},"custom_liquid_PPFPBE":{"type":"custom-liquid","settings":{"custom-liquid":"<style>\n  .sku-label {\n    background-color: #066A3B;\n    color: white;\n    display: inline-block;\n    padding: 6px;\n    border-radius: 5px;\n    font-size: 14px;\n    margin:0;\n  }\n<\/style>\n\n<p class=\"sku-label\">\n  SKU:\n  {% if product.variants.size > 1 %}\n    {% for variant in product.variants %}\n      {{ variant.sku }}{% if forloop.last == false %}, {% endif %}\n    {% endfor %}\n  {% else %}\n    {{ product.variants.first.sku }}\n  {% endif %}\n<\/p>","padding_bottom":10}},"availability_KXzfjK":{"type":"availability","disabled":true,"settings":{"low_stock":0,"padding_bottom":10}},"variant-picker":{"type":"variant-picker","disabled":true,"settings":{"picker_type":"dropdown","padding_bottom":12}},"add-to-cart":{"type":"add-to-cart","disabled":true,"settings":{"text_transform":"uppercase","quantity_selector":true,"dynamic_checkout":true,"show_gift_card":true,"padding_bottom":20}},"description":{"type":"description","settings":{"color_scheme_dt":"","row_limit":"4","padding_bottom":20}},"complementary":{"type":"complementary","settings":{"heading":"Pairs well with","make_collapsible_row":true,"icon":"price_tag","product_list_limit":10,"products_per_page":3,"show_add_to_cart":true,"padding_bottom":0}},"custom_liquid_zY9Xa4":{"type":"custom-liquid","settings":{"custom-liquid":"<!-- 🔹 START: Pack-Wise Pricing Table -->\n<style>\n  .pack-pricing-table {\n    width: 100%;\n    border-collapse: collapse;\n    margin-top: 20px;\n    font-family: 'Helvetica Neue', sans-serif;\n    color: #333;\n  }\n\n  .pack-pricing-table th,\n  .pack-pricing-table td {\n    border: 1px solid #e0e0e0;\n    padding: 12px;\n    text-align: center;\n  }\n\n  .pack-pricing-table th {\n    background-color: #f9f9f9;\n    font-weight: 600;\n    font-size: 16px;\n  }\n\n  .qty-input {\n    width: 50px;\n    text-align: center;\n    padding: 6px;\n    border: 1px solid #ccc;\n    border-radius: 4px;\n    margin: 0 5px;\n  }\n\n  .qty-btn {\n    padding: 6px 12px;\n    background-color: #28a745;\n    color: white;\n    border: none;\n    cursor: pointer;\n    border-radius: 4px;\n    font-size: 14px;\n  }\n\n  .qty-btn:hover {\n    background-color: #218838;\n  }\n\n  .btn-add-to-cart {\n    margin-top: 20px;\n    padding: 12px 24px;\n    background-color: rgba(var(--button-bg-color));\n    color: white;\n    font-size: 16px;\n    border-radius: var(--button-radius);\n    cursor: pointer;\n    border: 1px solid rgba(var(--button-bg-color));\n  }\n\n  .btn-add-to-cart:hover {\n    background-color: white;\n    color: rgba(var(--button-bg-color));\n  }\n\n  @media screen and (max-width: 600px) {\n    .pack-pricing-table th,\n    .pack-pricing-table td {\n      font-size: 14px;\n      padding: 10px;\n    }\n\n    .qty-btn {\n      padding: 5px 10px;\n      font-size: 12px;\n    }\n\n    .btn-add-to-cart {\n      font-size: 14px;\n      width: 100%;\n    }\n  }\n<\/style>\n\n<table class=\"pack-pricing-table\">\n  <thead>\n    <tr>\n      <th>Product Name<\/th>\n      <th>Price<\/th>\n      <th>Unit Price<\/th>\n      <th>Quantity<\/th>\n    <\/tr>\n  <\/thead>\n  <tbody>\n    {% for variant in product.variants %}\n      <tr data-variant-id=\"{{ variant.id }}\">\n        <td>{{ variant.title }}<\/td>\n        <td>{{ variant.price | money }}<\/td>\n        <td>\n          {% assign count = variant.title | split: \" \" | first | plus: 0 %}\n          {% assign unit_price = variant.price | divided_by: count %}\n          {{ unit_price | money }}\n        <\/td>\n        <td>\n          <div style=\"display: flex; justify-content: center; align-items: center;\">\n            <button type=\"button\" class=\"qty-btn minus\" data-variant-id=\"{{ variant.id }}\">−<\/button>\n            <input type=\"number\" min=\"0\" value=\"0\" class=\"qty-input\" data-variant-id=\"{{ variant.id }}\" \/>\n            <button type=\"button\" class=\"qty-btn plus\" data-variant-id=\"{{ variant.id }}\">+<\/button>\n          <\/div>\n        <\/td>\n      <\/tr>\n    {% endfor %}\n  <\/tbody>\n<\/table>\n\n<!-- 🔸 Add to Cart Button -->\n<button type=\"button\" onclick=\"addAllToCart()\" class=\"btn-add-to-cart\">Add to Cart<\/button>\n\n<!-- 🔹 JavaScript -->\n<script>\n  \/\/ Handle quantity buttons\n  document.querySelectorAll('.qty-btn').forEach(button => {\n    button.addEventListener('click', function () {\n      const variantId = this.dataset.variantId;\n      const input = document.querySelector(`.qty-input[data-variant-id=\"${variantId}\"]`);\n      let current = parseInt(input.value) || 0;\n      if (this.classList.contains('plus')) {\n        input.value = current + 1;\n      } else if (this.classList.contains('minus') && current > 0) {\n        input.value = current - 1;\n      }\n    });\n  });\n\n  \/\/ Add selected items to cart\n  function addAllToCart() {\n    const inputs = document.querySelectorAll('.qty-input');\n    let items = [];\n\n    inputs.forEach(input => {\n      const qty = parseInt(input.value);\n      const variantId = input.dataset.variantId;\n      if (qty > 0) {\n        items.push({ id: parseInt(variantId), quantity: qty });\n      }\n    });\n\n    if (items.length === 0) {\n      alert(\"Please select at least one quantity.\");\n      return;\n    }\n\n    let promises = items.map(item =>\n      fetch('\/cart\/add.js', {\n        method: 'POST',\n        headers: { 'Content-Type': 'application\/json' },\n        body: JSON.stringify(item)\n      })\n    );\n\n    Promise.all(promises)\n      .then(responses => {\n        \/\/ Open the cart drawer if available\n        if (window.Shopify && Shopify.theme && typeof Shopify.theme.cartDrawer === 'object') {\n          Shopify.theme.cartDrawer.open();\n        } else {\n          window.location.href = '\/cart';\n        }\n      })\n      .catch(error => {\n        alert('Error adding items to cart.');\n        console.error(error);\n      });\n  }\n<\/script>\n<!-- 🔹 END -->","padding_bottom":20}},"description_tab_3p8AUA":{"type":"description-tab","settings":{"heading_tab":"More Information","content_tab":"{{ product.description }}"}},"share_pbxQhp":{"type":"share","settings":{"share_label":"Share","type":"social","padding_bottom":20}}},"block_order":["vendor_EKQiFe","title","judge_me_reviews_preview_badge_gFX3GF","price","custom_liquid_PPFPBE","availability_KXzfjK","variant-picker","add-to-cart","description","complementary","custom_liquid_zY9Xa4","description_tab_3p8AUA","share_pbxQhp"],"custom_css":[".details {text-transform: capitalize;}",".product-details-tabs {border: 1px solid;}",".title {text-transform: uppercase;}",".tab-head {font-size: 4.6rem;}",".field-wrap {display: none;}",".field-title {border: 1px solid; border-radius: 5px; padding: 10px; display: inline-block;}",".media-preview-wrap {border: hidden;}"],"settings":{"full":false,"color_scheme":"scheme-2","space":50,"sticky_add_to_cart":"hidden","width":50,"layout":"layout-2","media_ratio":"square","media_fit":"contain","lightbox":true,"video_looping":true,"group_image":true,"alignment":"left","padding_top":8,"padding_bottom":8,"padding_top_mobile":8,"padding_bottom_mobile":8}},"174600052724911e49":{"type":"apps","blocks":{"judge_me_reviews_review_widget_RhUVUj":{