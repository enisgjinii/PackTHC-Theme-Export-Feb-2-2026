        "custom_liquid_3b9466": {
          "type": "custom_liquid",
          "name": "PRICING TABLE",
          "settings": {
            "custom_liquid": "<style>\nth, td {\n  font-size:13px;\n  text-align:center;\n  padding:8px;\n}\n.email, .mob, th {\n  color:#033770 !important;\n  font-size:15px;\n}\n@media (max-width: 767px) {\n  th, td {\n    font-size: 10px;\n    padding: 6px;\n  }\n  .email, .mob {\n    font-size: 12px;\n  }\n}\n</style>\n\n{% assign current_variant = product.selected_or_first_available_variant %}\n\n<!-- Default Product Pricing Table -->\n<div id=\"default-pricing-table\">\n  {% assign qty_list = product.metafields.custom.quantity_table %}\n  {% assign unit_list = product.metafields.custom.unit_table %}\n  {% assign price_list = product.metafields.custom.price_table %}\n  \n  {% if qty_list and unit_list and price_list %}\n    <table style=\"width: 100%; border-collapse: collapse; margin-top: 20px;\">\n      <thead>\n        <tr>\n          <th style=\"border: 1px solid #ddd;color: #033770;\" colspan=\"2\">Quantity</th>\n          <th style=\"border: 1px solid #ddd; color: #033770;\">Price Per Case</th>\n          <th style=\"border: 1px solid #ddd; color: #033770;\">Price Per Piece</th>\n        </tr>\n      </thead>\n      <tbody>\n        {% assign qty_array = qty_list | split: ',' %}\n        {% assign unit_array = unit_list | split: ',' %}\n        {% assign price_array = price_list | split: ',' %}\n        \n        {% for i in (0..qty_array.size) %}\n          {% if i < qty_array.size %}\n            <tr>\n              <td style=\"border: 1px solid #ddd;\" colspan=\"2\">{{ qty_array[i] }}</td>\n              <td style=\"border: 1px solid #ddd;\">{{ price_array[i] }}</td>\n              <td style=\"border: 1px solid #ddd;\">{{ unit_array[i] }}</td>\n            </tr>\n          {% endif %}\n        {% endfor %}\n      </tbody>\n      <tfoot>\n        <tr>\n          <td style=\"border: 1px solid #ddd; font-weight:bold;\" colspan=\"4\">\n            For Higher Quantity Pricing, Please \n            <a class=\"email\" href=\"mailto:hello@packthc.com\"> Email Us</a> \n            or Call <a href=\"tel:+1816PACKTHC\" class=\"mob\">+1(816)PACKTHC</a>\n          </td>\n        </tr>\n      </tfoot>\n    </table>\n  {% endif %}\n</div>\n\n<!-- Variant Pricing Table -->\n<div id=\"variant-pricing-table\" style=\"display: none;\">\n  <table style=\"width: 100%; border-collapse: collapse; margin-top: 20px;\">\n    <thead>\n      <tr>\n        <th style=\"border: 1px solid #ddd;\" colspan=\"2\">Quantity</th>\n        <th style=\"border: 1px solid #ddd;\">Price Per Case</th>\n        <th style=\"border: 1px solid #ddd;\">Price Per Piece</th>\n      </tr>\n    </thead>\n    <tbody id=\"variant-table-body\">\n      <!-- Content will be populated by JavaScript -->\n    </tbody>\n    <tfoot>\n      <tr>\n        <td style=\"border: 1px solid #ddd; font-weight:bold;\" colspan=\"4\">\n          For Higher Quantity Pricing, Please \n          <a class=\"email\" href=\"mailto:hello@packthc.com\"> Email Us</a> \n          or Call <a href=\"tel:+1816PACKTHC\" class=\"mob\">+1(816)PACKTHC</a>\n        </td>\n      </tr>\n    </tfoot>\n  </table>\n</div>\n\n<!-- Hidden data for all variants -->\n{% assign has_variants_with_pricing = false %}\n{% assign first_variant_with_pricing_id = '' %}\n\n{% for variant in product.variants %}\n  {% if variant.metafields.custom.quantity_table and variant.metafields.custom.unit_table and variant.metafields.custom.price_table %}\n    {% assign has_variants_with_pricing = true %}\n    {% if first_variant_with_pricing_id == blank %}\n      {% assign first_variant_with_pricing_id = variant.id %}\n    {% endif %}\n  {% endif %}\n{% endfor %}\n\n{% if has_variants_with_pricing %}\n<script type=\"application/json\" id=\"variant-pricing-data\">\n{\n  {% for variant in product.variants %}\n    \"{{ variant.id }}\": {\n      \"title\": \"{{ variant.title }}\",\n      \"qty\": \"{{ variant.metafields.custom.quantity_table }}\",\n      \"unit\": \"{{ variant.metafields.custom.unit_table }}\",\n      \"price\": \"{{ variant.metafields.custom.price_table }}\"\n    }{% unless forloop.last %},{% endunless %}\n  {% endfor %}\n}\n</script>\n\n<script>\nlet currentSelectedVariant = '{{ current_variant.id }}';\nlet isVariantSelected = false;\n{% if qty_list and unit_list and price_list %}\nlet hasDefaultPricing = true;\n{% else %}\nlet hasDefaultPricing = false;\n{% endif %}\nconst hasVariantPricing = {{ has_variants_with_pricing | json }};\nconst firstVariantWithPricing = '{{ first_variant_with_pricing_id }}';\n\nfunction showDefaultTable() {\n  document.getElementById('default-pricing-table').style.display = 'block';\n  document.getElementById('variant-pricing-table').style.display = 'none';\n}\n\nfunction showVariantTable(variantId) {\n  if (!hasVariantPricing) { showDefaultTable(); return; }\n\n  const data = JSON.parse(document.getElementById('variant-pricing-data').textContent);\n  const variant = data[variantId];\n  \n  if (!variant || !variant.qty || !variant.unit || !variant.price) {\n    showDefaultTable(); return;\n  }\n  \n  document.getElementById('default-pricing-table').style.display = 'none';\n  document.getElementById('variant-pricing-table').style.display = 'block';\n  \n  const qtyArray = variant.qty.split(',');\n  const unitArray = variant.unit.split(',');\n  const priceArray = variant.price.split(',');\n  \n  let tableHTML = '';\n  for (let i = 0; i < qtyArray.length; i++) {\n    const qty = qtyArray[i] ? qtyArray[i].trim() : '';\n    const unit = unitArray[i] ? unitArray[i].trim() : '';\n    const price = priceArray[i] ? priceArray[i].trim() : '';\n    if (qty && unit && price) {\n      tableHTML += `<tr>\n        <td style=\"border: 1px solid #ddd;\" colspan=\"2\">${qty}</td>\n        <td style=\"border: 1px solid #ddd;\">${price}</td>\n        <td style=\"border: 1px solid #ddd;\">${unit}</td>\n      </tr>`;\n    }\n  }\n  document.getElementById('variant-table-body').innerHTML = tableHTML;\n}\n\n// ✅ NEW: Selected variant ko JSON script tag se padhna\nfunction getVariantFromPage() {\n  // Method 1: Naye theme ka selected variant JSON\n  const selectedVariantEl = document.querySelector('script[data-selected-variant]');\n  if (selectedVariantEl && selectedVariantEl.textContent.trim()) {\n    try {\n      const variantData = JSON.parse(selectedVariantEl.textContent);\n      if (variantData && variantData.id) return String(variantData.id);\n    } catch(e) {}\n  }\n\n  // Method 2: URL se variant ID\n  const urlParams = new URLSearchParams(window.location.search);\n  if (urlParams.get('variant')) return urlParams.get('variant');\n\n  // Method 3: Select dropdown\n  const select = document.querySelector('select[name=\"id\"]');\n  if (select && select.value) return select.value;\n\n  return null;\n}\n\nfunction checkVariantSelection() {\n  if (!hasVariantPricing) { showDefaultTable(); return; }\n\n  const newVariant = getVariantFromPage();\n  \n  if (newVariant && newVariant !== currentSelectedVariant) {\n    currentSelectedVariant = newVariant;\n    showVariantTable(newVariant);\n  }\n}\n\nfunction initializePricingTable() {\n  if (hasDefaultPricing) {\n    showDefaultTable();\n  } else if (hasVariantPricing && firstVariantWithPricing) {\n    showVariantTable(firstVariantWithPricing);\n  } else {\n    document.getElementById('default-pricing-table').style.display = 'none';\n    document.getElementById('variant-pricing-table').style.display = 'none';\n  }\n  \n  // ✅ On load, agar already ek variant selected hai to uski table dikhao\n  if (hasVariantPricing) {\n    const currentOnLoad = getVariantFromPage();\n    if (currentOnLoad) {\n      currentSelectedVariant = currentOnLoad;\n      showVariantTable(currentOnLoad);\n    }\n  }\n}\n\nif (hasVariantPricing) {\n  // ✅ Naye theme ke liye: variant-selects custom element ko sun'na\n  document.addEventListener('change', function(e) {\n    setTimeout(checkVariantSelection, 100);\n  });\n\n  document.addEventListener('click', function(e) {\n    if (e.target.closest('variant-selects, .product-form__input')) {\n      setTimeout(checkVariantSelection, 150);\n    }\n  });\n\n  // ✅ URL change detect karna (naye themes pushState use karte hain)\n  const originalPushState = history.pushState;\n  history.pushState = function() {\n    originalPushState.apply(this, arguments);\n    setTimeout(checkVariantSelection, 100);\n  };\n  window.addEventListener('popstate', function() {\n    setTimeout(checkVariantSelection, 100);\n  });\n\n  // ✅ MutationObserver: jab selected variant JSON badley\n  const observer = new MutationObserver(function() {\n    setTimeout(checkVariantSelection, 100);\n  });\n  \n  document.addEventListener('DOMContentLoaded', function() {\n    const variantJsonEl = document.querySelector('script[data-selected-variant]');\n    if (variantJsonEl) {\n      observer.observe(variantJsonEl, { childList: true, characterData: true, subtree: true });\n    }\n  });\n\n  setInterval(checkVariantSelection, 1000);\n}\n\ndocument.addEventListener('DOMContentLoaded', function() {\n  initializePricingTable();\n});\n</script>\n{% endif %}"
          }
