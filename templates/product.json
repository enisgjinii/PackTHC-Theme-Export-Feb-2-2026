    "custom_liquid_UDqbXR": {
      "type": "custom-liquid",
      "name": "Dumentions",
      "settings": {
        "custom_liquid": "<style>\n  .product-tabs {\n    max-width: 1250px;\n    margin: 40px auto;\n    padding: 0 20px;\n  }\n  .tab-navigation {\n    display: flex;\n    gap: 20px;\n    border-bottom: 2px solid #e5e5e5;\n  }\n  .tab-button {\n    padding: 12px 24px;\n    background: none;\n    border: none;\n    font-size: 16px;\n    font-weight: 600;\n    cursor: pointer;\n    color: #666;\n    transition: all 0.3s ease;\n    border-bottom: 3px solid transparent;\n    margin-bottom: -2px;\n  }\n  .tab-button.active {\n    color: #000;\n    border-bottom-color: #000;\n  }\n  .tab-content {\n    display: none;\n  }\n  .tab-content.active {\n    display: block;\n    animation: fadeIn 0.3s ease;\n  }\n  @keyframes fadeIn {\n    from { opacity: 0; transform: translateY(10px); }\n    to { opacity: 1; transform: translateY(0); }\n  }\n  .accordion-section {\n    display: none;\n  }\n  .accordion-header {\n    background: #f8f8f8;\n    padding: 15px 20px;\n    border: 1px solid #e5e5e5;\n    border-radius: 8px;\n    margin-bottom: 10px;\n    cursor: pointer;\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    font-size: 16px;\n    font-weight: 600;\n    color: #333;\n    transition: all 0.3s ease;\n  }\n  .accordion-header:hover { background: #f0f0f0; }\n  .accordion-header.active {\n    background: #000;\n    color: #fff;\n    border-color: #000;\n  }\n  .accordion-icon {\n    transition: transform 0.3s ease;\n    font-size: 20px;\n  }\n  .accordion-header.active .accordion-icon {\n    transform: rotate(180deg);\n  }\n  .accordion-content {\n    max-height: 0;\n    overflow: hidden;\n    transition: max-height 0.3s ease;\n    margin-bottom: 10px;\n  }\n  .accordion-content.active { max-height: 2000px; }\n  .tab-image-container {\n    display: flex;\n    justify-content: space-between;\n    gap: 10px;\n  }\n  .tab-image-container img {\n    width: 50%;\n    max-width: 100%;\n    height: auto;\n    object-fit: contain;\n    border-radius: 8px;\n  }\n  .tab-single-image-wrapper {\n    width: 100%;\n    display: flex;\n    justify-content: center;\n    margin: 20px 0;\n  }\n  .tab-single-image-wrapper img {\n    width: 90%;\n    max-width: 1200px;\n    object-fit: contain;\n    border-radius: 8px;\n  }\n  @media (max-width: 767px) {\n    .tab-navigation { display: none; }\n    .tab-content { display: none !important; }\n    .accordion-section { display: block; }\n    .tab-image-container {\n      flex-direction: column;\n      margin-left: 0;\n      margin-right: 0;\n    }\n    .tab-image-container img {\n      width: 100% !important;\n      margin-bottom: 15px;\n    }\n    .tab-single-image-wrapper img { width: 100%; }\n  }\n</style>\n\n{% liquid\n  assign dim_single = product.metafields.custom.paper_cones.value\n  assign dim1 = product.metafields.custom.image1.value\n  assign dim2 = product.metafields.custom.image2.value\n  assign feat1 = product.metafields.custom.feature_image1.value\n  assign feat2 = product.metafields.custom.feature_image2.value\n\n  if dim_single or dim1\n    assign has_dimension = true\n  else\n    assign has_dimension = false\n  endif\n%}\n\n{% if has_dimension or feat1 %}\n<div class=\"product-tabs\">\n\n  <!-- Desktop Tabs Navigation -->\n  <div class=\"tab-navigation\">\n    {% if has_dimension %}\n      <button class=\"tab-button active\" onclick=\"openTab(event, 'dimension')\">DIMENSION</button>\n    {% endif %}\n    {% if feat1 %}\n      <button class=\"tab-button {% unless has_dimension %}active{% endunless %}\" onclick=\"openTab(event, 'features')\">FEATURES</button>\n    {% endif %}\n  </div>\n\n  <!-- Desktop: DIMENSION -->\n  {% if has_dimension %}\n    <div id=\"dimension\" class=\"tab-content active\">\n      {% if dim_single %}\n        <div class=\"tab-single-image-wrapper\">\n          <img src=\"{{ dim_single | image_url: width: 1200 }}\" alt=\"Dimension Image\" />\n        </div>\n      {% elsif dim1 and dim2 %}\n        <div class=\"tab-image-container\">\n          <img src=\"{{ dim1 | image_url: width: 1200 }}\" alt=\"Dimension Image 1\" />\n          <img src=\"{{ dim2 | image_url: width: 1200 }}\" alt=\"Dimension Image 2\" />\n        </div>\n      {% elsif dim1 %}\n        <div class=\"tab-single-image-wrapper\">\n          <img src=\"{{ dim1 | image_url: width: 1200 }}\" alt=\"Dimension Image\" />\n        </div>\n      {% endif %}\n    </div>\n  {% endif %}\n\n  <!-- Desktop: FEATURES -->\n  {% if feat1 %}\n    <div id=\"features\" class=\"tab-content {% unless has_dimension %}active{% endunless %}\">\n      {% if feat2 %}\n        <div class=\"tab-image-container\">\n          <img src=\"{{ feat1 | image_url: width: 1200 }}\" alt=\"Feature Image 1\" />\n          <img src=\"{{ feat2 | image_url: width: 1200 }}\" alt=\"Feature Image 2\" />\n        </div>\n      {% else %}\n        <div class=\"tab-single-image-wrapper\">\n          <img src=\"{{ feat1 | image_url: width: 1200 }}\" alt=\"Feature Image\" />\n        </div>\n      {% endif %}\n    </div>\n  {% endif %}\n\n  <!-- Mobile Accordion -->\n  <div class=\"accordion-section\">\n\n    <!-- DIMENSION Accordion -->\n    {% if has_dimension %}\n      <div class=\"accordion-item\">\n        <div class=\"accordion-header active\" onclick=\"toggleAccordion(this)\">\n          <span>DIMENSION</span>\n          <span class=\"accordion-icon\">▼</span>\n        </div>\n        <div class=\"accordion-content active\">\n          {% if dim_single %}\n            <div class=\"tab-single-image-wrapper\">\n              <img src=\"{{ dim_single | image_url: width: 1200 }}\" alt=\"Dimension Image\" />\n            </div>\n          {% elsif dim1 and dim2 %}\n            <div class=\"tab-image-container\">\n              <img src=\"{{ dim1 | image_url: width: 1200 }}\" alt=\"Dimension Image 1\" />\n              <img src=\"{{ dim2 | image_url: width: 1200 }}\" alt=\"Dimension Image 2\" />\n            </div>\n          {% elsif dim1 %}\n            <div class=\"tab-single-image-wrapper\">\n              <img src=\"{{ dim1 | image_url: width: 1200 }}\" alt=\"Dimension Image\" />\n            </div>\n          {% endif %}\n        </div>\n      </div>\n    {% endif %}\n\n    <!-- FEATURES Accordion -->\n    {% if feat1 %}\n      <div class=\"accordion-item\">\n        <div class=\"accordion-header {% unless has_dimension %}active{% endunless %}\" onclick=\"toggleAccordion(this)\">\n          <span>FEATURES</span>\n          <span class=\"accordion-icon\">▼</span>\n        </div>\n        <div class=\"accordion-content {% unless has_dimension %}active{% endunless %}\">\n          {% if feat2 %}\n            <div class=\"tab-image-container\">\n              <img src=\"{{ feat1 | image_url: width: 1200 }}\" alt=\"Feature Image 1\" />\n              <img src=\"{{ feat2 | image_url: width: 1200 }}\" alt=\"Feature Image 2\" />\n            </div>\n          {% else %}\n            <div class=\"tab-single-image-wrapper\">\n              <img src=\"{{ feat1 | image_url: width: 1200 }}\" alt=\"Feature Image\" />\n            </div>\n          {% endif %}\n        </div>\n      </div>\n    {% endif %}\n\n  </div>\n</div>\n{% endif %}\n\n<script>\n  function openTab(evt, tabName) {\n    var i, tabContent, tabButtons;\n    tabContent = document.getElementsByClassName(\"tab-content\");\n    for (i = 0; i < tabContent.length; i++) {\n      tabContent[i].classList.remove(\"active\");\n    }\n    tabButtons = document.getElementsByClassName(\"tab-button\");\n    for (i = 0; i < tabButtons.length; i++) {\n      tabButtons[i].classList.remove(\"active\");\n    }\n    document.getElementById(tabName).classList.add(\"active\");\n    evt.currentTarget.classList.add(\"active\");\n  }\n\n  function toggleAccordion(header) {\n    var content = header.nextElementSibling;\n    var allHeaders = document.querySelectorAll('.accordion-header');\n    var allContents = document.querySelectorAll('.accordion-content');\n    allHeaders.forEach(function(h) {\n      if (h !== header) h.classList.remove('active');\n    });\n    allContents.forEach(function(c) {\n      if (c !== content) c.classList.remove('active');\n    });\n    header.classList.toggle('active');\n    content.classList.toggle('active');\n  }\n</script>",
