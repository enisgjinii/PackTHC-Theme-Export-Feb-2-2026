{"sections":{"7feb7870-ac9d-4a9f-9619-36a9b61de25f":{"type":"main-page","disabled":true,"settings":{}},"rich_text_p67wqU":{"type":"rich-text","blocks":{"heading_8yeKdw":{"type":"heading","settings":{"content":"Price Match Guarantee","heading_size":"h2"}}},"block_order":["heading_8yeKdw"],"custom_css":[],"name":"t:sections.rich-text.name","settings":{"full":false,"color_scheme":"scheme-2","align":"center","width":80,"padding_top":20,"padding_bottom":1,"padding_top_mobile":10,"padding_bottom_mobile":0}},"rich_text_x8eaQR":{"type":"rich-text","blocks":{"text_CrjEie":{"type":"text","settings":{"content":"<p>At PackTHC USA, we understand that pricing is a big concern for our customers. That's why we offer a price match guarantee on all of our products. If you find a lower price elsewhere, simply let us know and we'll match it. We're committed to offering the best prices available, so you can rest assured that you're getting the best value for your money when you shop with us.<\/p>"}}},"block_order":["text_CrjEie"],"name":"t:sections.rich-text.name","settings":{"full":false,"color_scheme":"scheme-2","align":"left","width":80,"padding_top":20,"padding_bottom":1,"padding_top_mobile":10,"padding_bottom_mobile":0}},"forms":{"type":"apps","blocks":{"0d66aaf4-b536-4b80-93d8-62640b39dd10":{"type":"shopify:\/\/apps\/forms\/blocks\/inline\/8744a304-fcb1-4347-b211-bb6b4759a76a","settings":{"form_id":"471096","text_color":"#202020","button_background_color":"#e0131a","button_label_color":"#ffffff","links_color":"#1878b9","errors_color":"#e02229","text_alignment":"center","form_alignment":"center","padding_top":10,"padding_bottom":10,"padding_right":0,"padding_left":0}}},"block_order":["0d66aaf4-b536-4b80-93d8-62640b39dd10"],"custom_css":[],"settings":{"full":false,"padding_top":0,"padding_bottom":20,"padding_top_mobile":0,"padding_bottom_mobile":10}},"rich_text_EFmVca":{"type":"rich-text","blocks":{"heading_CF9m4F":{"type":"heading","settings":{"content":"What Qualifies?","heading_size":"h3"}},"text_Ge6BGV":{"type":"text","settings":{"content":"<p><strong>Product must be identical to the competitor's product<\/strong><\/p>"}},"text_azwCHE":{"type":"text","settings":{"content":"<p>The product must be a matching item, brand, and color to qualify. If the brand is not identical, we can still evaluate a price match, so please still submit a request!<\/p>"}},"text_eeWNy6":{"type":"text","settings":{"content":"<p><strong>Product must be immediately available at the online retailer.<\/strong><\/p>"}},"text_YNz8Fr":{"type":"text","settings":{"content":"<p>The item must be in stock on the competitor's website and available to order online.<\/p>"}},"text_zBkifD":{"type":"text","settings":{"content":"<p><strong>Product must have a similar return and warranty policy.<\/strong><\/p>"}},"text_X9xwdJ":{"type":"text","settings":{"content":"<p>PackTHC USA offers the industry's leading return and warranty policy. Some competitors cut corners, but we always stand behind our customers!<\/p>"}}},"block_order":["heading_CF9m4F","text_Ge6BGV","text_azwCHE","text_eeWNy6","text_YNz8Fr","text_zBkifD","text_X9xwdJ"],"name":"t:sections.rich-text.name","settings":{"full":false,"color_scheme":"scheme-2","align":"left","width":80,"padding_top":10,"padding_bottom":1,"padding_top_mobile":0,"padding_bottom_mobile":0}},"rich_text_jXQk3W":{"type":"rich-text","blocks":{"heading_fK8cUy":{"type":"heading","settings":{"content":"How to Request a Price Match","heading_size":"h3"}},"text_dxaKYz":{"type":"text","settings":{"content":"<p><strong>Through the Contact Form<\/strong><\/p>"}},"text_BXMqif":{"type":"text","settings":{"content":"<p>Just fill out the contact form above.<\/p>"}},"text_h9dbhe":{"type":"text","settings":{"content":"<p><strong>Email Us Directly<\/strong><\/p>"}},"text_YH9jnD":{"type":"text","settings":{"content":"<p>1. Email us at: <a href=\"mailto:hello@packthc.com\" title=\"mailto:hello@packthc.com\">hello@packthc.com<\/a> with \"Price Match Request\" as the subject<\/p>"}},"text_Qh4WYN":{"type":"text","settings":{"content":"<p>2. In the body of the email, please include your contact information as well as the following:<\/p>"}},"text_K6fkQF":{"type":"text","settings":{"content":"<ul><li>URL or screenshot of the competitor's product page for the identical product<\/li><li>Your desired quantity<\/li><li>Your shipping zip code<\/li><\/ul>"}}},"block_order":["heading_fK8cUy","text_dxaKYz","text_BXMqif","text_h9dbhe","text_YH9jnD","text_Qh4WYN","text_K6fkQF"],"name":"t:sections.rich-text.name","settings":{"full":false,"color_scheme":"scheme-2","align":"left","width":80,"padding_top":20,"padding_bottom":1,"padding_top_mobile":20,"padding_bottom_mobile":0}},"rich_text_NYBM6C":{"type":"rich-text","blocks":{"heading_69R3qk":{"type":"heading","settings":{"content":"What Happens Next?","heading_size":"h3"}},"text_iPrVyt":{"type":"text","settings":{"content":"<p>Once we receive your request, our team will review the information and get back to you as soon as possible. If your request is approved, we'll send you an email with a special discount code to use at checkout. PackTHC USA's Price Match Guarantee ensures that you're getting the best price on the market. We won't be beat!<\/p>"}}},"block_order":["heading_69R3qk","text_iPrVyt"],"name":"t:sections.rich-text.name","settings":{"full":false,"color_scheme":"scheme-2","align":"left","width":80,"padding_top":20,"padding_bottom":1,"padding_top_mobile":20,"padding_bottom_mobile":0}}},"order":["7feb7870-ac9d-4a9f-9619-36a9b61de25f","rich_text_p67wqU","rich_text_x8eaQR","forms","rich_text_EFmVca","rich_text_jXQk3W","rich_text_NYBM6C"]}