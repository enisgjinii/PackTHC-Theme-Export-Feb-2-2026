{%- if template.name == 'article' -%}
{%- assign featured_img = article.image | default: blog.image -%}

{%- comment -%} Description: prefer excerpt; else first paragraph of content {%- endcomment -%}
{%- assign first_para = article.content
  | split: '</p>'
  | first
  | replace: '<p>', ''
  | strip_html
  | strip_newlines
-%}
{%- assign desc_text = article.excerpt | default: first_para -%}
{%- assign desc_clean = desc_text | strip_html | strip_newlines -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "mainEntityOfPage": { "@type": "WebPage", "@id": {{ request.origin | append: request.path | json }} },
  "url": {{ request.origin | append: request.path | json }},
  "headline": {{ article.title | json }},
  "description": {{ desc_clean | json }},
  "articleBody": {{
    article.content
    | replace: '<br>', '\n'
    | replace: '<br/>', '\n'
    | replace: '<br />', '\n'
    | replace: '<p>', ''
    | replace: '</p>', '\n\n'
    | replace: '<li>', '• '
    | replace: '</li>', '\n'
    | strip_html
    | json
  }},
  {%- if featured_img -%}
  "image": {
    "@type": "ImageObject",
    "url": {{ featured_img | image_url: width: 1200 | prepend: "https:" | json }},
    "width": 1200,
    "height": 630
  },
  {%- endif -%}
  "datePublished": {{ article.published_at | date: "%Y-%m-%dT%H:%M:%S%:z" | json }},
  "dateModified": {{ article.updated_at | date: "%Y-%m-%dT%H:%M:%S%:z" | json }},
  "author": {
    "@type": "Person",
    "name": {{ article.author | json }},
    "url": {{ shop.url | json }}
  },
  "publisher": {
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "url": {{ shop.url | json }}{% if shop.brand.logo %},
    "logo": {
      "@type": "ImageObject",
      "url": {{ shop.brand.logo | image_url: width: 600 | prepend: "https:" | json }},
      "width": 600,
      "height": 600
    }{% endif %}
  }
}
</script>
{%- endif -%}