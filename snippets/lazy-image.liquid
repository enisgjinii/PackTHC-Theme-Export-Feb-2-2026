{%- comment -%}
  Lazy image with auto alt
  Alt priority: alt param → image.alt → section/product/article/collection title → ""
{%- endcomment -%}

{%- liquid
  assign image_lazy = settings.image_lazy

  if image_lazy
    assign image_class = 'no-js-hidden ' | append: class | strip
  else
    assign image_class = class | strip
  endif

  unless lazy
    assign lazy = 'lazy'
  endunless
  unless height
    assign height = width | divided_by: image.aspect_ratio | ceil
  endunless
  unless width
    assign width = height | times: image.aspect_ratio | ceil
  endunless
  unless width_url
    assign width_url = width | times: 1.4 | ceil
  endunless
  unless height_url
    assign height_url = width_url | divided_by: image.aspect_ratio | ceil
  endunless
  if show_aspect_ratio
    assign aspect_ratio = width | times: 1.0 | divided_by: height | prepend: '--aspect-ratio: ' | append: ' / 1'
  endif

  assign auto_alt = alt
  if auto_alt == blank and image.alt != blank
    assign auto_alt = image.alt
  endif
  if auto_alt == blank and section and section.settings and section.settings.title != blank
    assign auto_alt = section.settings.title
  endif
  if auto_alt == blank and product and product.title != blank
    assign auto_alt = product.title
  endif
  if auto_alt == blank and article and article.title != blank
    assign auto_alt = article.title
  endif
  if auto_alt == blank and collection and collection.title != blank
    assign auto_alt = collection.title
  endif
  if auto_alt == blank
    assign auto_alt = ''
  endif

  if image_lazy
    assign image_src    = image | image_url: width: width_url, height: height_url
    assign image_srcset = image | image_url: width: width_url, height: height_url | image_tag
    assign srcset_split = image_srcset | split: 'srcset="'
    assign srcset       = srcset_split[1] | split: '"'
  endif
-%}

{%- if image_lazy -%}
  {{ image | image_url: width: 1, height: 1 | image_tag: loading: 'lazy', class: image_class, width: width, height: height, srcset: nil, data-src: image_src, data-srcset: srcset.first, style: aspect_ratio, alt: auto_alt }}
{%- else -%}
  {{ image | image_url: width: width_url | image_tag: loading: lazy, class: image_class, width: width, height: height, style: aspect_ratio, alt: auto_alt }}
{%- endif -%}

{%- if image_lazy -%}
<noscript>
  <img src="{{ image | image_url: width: width, height: height }}"
       alt="{{ auto_alt | escape }}"
       loading="{{ lazy }}"
       {% if class %}class="{{ class | strip }}"{% endif %}
       style="object-position: {{ image.presentation.focal_point | default: '50% 50%' }}"
       width="{{ width }}" height="{{ height }}">
</noscript>
{%- endif -%}