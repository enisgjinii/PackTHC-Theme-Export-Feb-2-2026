<div class="related-post carousel-swiper">
	<template data-options data-pagination-mobile data-css-mode="off">
		{
			"navigation": {
				"nextEl": "{{ section_id }} .swiper-button-next",
				"prevEl": "{{ section_id }} .swiper-button-prev"
			},
			"pagination": {
				"el": "{{ section_id }} .swiper-pagination",
				"clickable": true
			},
			"slidesPerView": 3,
			"breakpoints": {
				"240": {
					"slidesPerView": "auto",
					"spaceBetween": 24
				},
				"992": {
					"slidesPerView": 3,
					"spaceBetween": 32
				}
			}
		}
	</template>

	<div class="swiper">
		<div class="swiper-wrapper">
			{%- assign articleid = article.id -%}
			{%- for article in blog.articles limit: total -%}
				{% if article.id != articleid %}
					<div class="swiper-slide" data-{{ forloop.index0 }} {% if request.design_mode %} data-index="{{ forloop.index0 }}"{% endif %}>
						<article class="article-card color-{{ section.settings.post_color_scheme }}">
							{%- liquid
								assign article_image = article.image
							-%}

							<div class="article-media-wrap adapt-media{% unless article_image %} no-media{% endunless %}">
								{%- if article_image -%}
									<a href="{{ article.url }}" class="article-image{% if settings.image_lazy and article_image %} lazy-image{% endif %}">
										{%- liquid
											assign image_load = 'eager'

											if forloop.index > 1
												assign image_load = 'lazy'
											endif

											if section.settings.image_ratio == 'adapt'
												assign show_aspect_ratio = true
											endif

											render 'lazy-image', image: article_image, width: 740, lazy: image_load, show_aspect_ratio: show_aspect_ratio
										-%}
									</a>
								{%- else -%}
									<h2 class="article-title h5">
										<a href="{{ article.url }}" class="article-link link-underline">
											{{- article.title | escape -}}
										</a>
									</h2>
								{%- endif -%}
							</div>

							<div class="article-info">
								{%- if article_image -%}
									<h2 class="article-title h5">
										<a href="{{ article.url }}">
											{{- article.title | escape -}}
										</a>
									</h2>
								{%- endif -%}

								<div class="article-meta">
									<span class="article-date mitem">
										{{- article.published_at | time_tag: format: 'short_month_day_year' -}}
									</span>

									{%- render 'icon', code: 'spikes' -%}

									{%- if blog.comments_enabled? -%}
										<a class="info-item" href="{{ article.comment_post_url }}">{{ 'blogs.article.comments' | t: count: article.comments_count }}</a>
									{%- endif -%}
								</div>

								<a class="read-more h6 link-underline" href="{{ article.url }}">{{- 'blogs.article.read_more' | t -}}</a>
							</div>
						</article>
					</div>
				{%- endif -%}
			{%- endfor -%}
		</div>
	</div>

	<div class="swiper-controls">
		<button class="swiper-button-prev" title ="{{ 'general.swipper.prev' | t }}" aria-label="{{ 'general.swipper.prev' | t }}" id="{{ 'general.swipper.prev' | t }}" aria-labelledby="{{ 'general.swipper.prev' | t }}">{%- render 'icon', code: 'arrow-left-slider' -%}</button>
		<div class="swiper-pagination" tabindex="-1"></div>
		<button class="swiper-button-next" title ="{{ 'general.swipper.next' | t }}" aria-label="{{ 'general.swipper.next' | t }}" id="{{ 'general.swipper.next' | t }}" aria-labelledby="{{ 'general.swipper.next' | t }}">{%- render 'icon', code: 'arrow-right-slider' -%}</button>
	</div>
</div>