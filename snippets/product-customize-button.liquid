{% comment %}
  Product Customize Button Snippet
  
  Usage: {% render 'product-customize-button', product: product %}
  
  This button links to the product configurator page with all product data passed via URL parameters.
  The configurator iframe will receive this data and can use it to pre-populate the customization options.
{% endcomment %}

{% assign current_variant = product.selected_or_first_available_variant %}
{% assign product_image = product.featured_image | image_url: width: 400 %}

{% comment %} Check if product should show customize button {% endcomment %}
{% assign show_customize = false %}

{% comment %} Option 1: Show for all products {% endcomment %}
{% if section.settings.show_customize_for_all == true %}
  {% assign show_customize = true %}
{% endif %}

{% comment %} Option 2: Show if product has customization metafield {% endcomment %}
{% if product.metafields.custom.customizable == true %}
  {% assign show_customize = true %}
{% endif %}

{% comment %} Option 3: Show if product is tagged 'customizable' {% endcomment %}
{% if product.tags contains 'customizable' %}
  {% assign show_customize = true %}
{% endif %}

{% comment %} Option 4: Always show (default behavior) - remove the checks above if you want this {% endcomment %}
{% assign show_customize = true %}

{% if show_customize %}
<style>
.customize-product-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  background: linear-gradient(135deg, #004A26 0%, #006633 100%);
  color: #fff;
  padding: 14px 28px;
  border-radius: 8px;
  text-decoration: none;
  font-weight: 600;
  font-size: 16px;
  margin-top: 15px;
  transition: all 0.3s ease;
  box-shadow: 0 4px 15px rgba(0, 74, 38, 0.3);
  border: none;
  cursor: pointer;
  width: 100%;
  max-width: 400px;
}

.customize-product-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(0, 74, 38, 0.4);
  background: linear-gradient(135deg, #006633 0%, #008844 100%);
  color: #fff;
}

.customize-product-btn svg {
  width: 20px;
  height: 20px;
  flex-shrink: 0;
}

.customize-product-btn .btn-text {
  flex: 1;
  text-align: center;
}

@media (max-width: 768px) {
  .customize-product-btn {
    padding: 12px 20px;
    font-size: 14px;
    max-width: 100%;
  }
}
</style>

{% capture configurator_url %}/pages/product-configurator?product={{ product.handle }}&product_id={{ product.id }}&variant_id={{ current_variant.id }}&title={{ product.title | url_encode }}&sku={{ current_variant.sku | url_encode }}&vendor={{ product.vendor | url_encode }}&image={{ product_image | url_encode }}&price={{ current_variant.price | money_without_currency | url_encode }}{% endcapture %}

<a href="{{ configurator_url }}" class="customize-product-btn" data-product-handle="{{ product.handle }}">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M12 20h9"></path>
    <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
  </svg>
  <span class="btn-text">Customize This Product</span>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M5 12h14M12 5l7 7-7 7"/>
  </svg>
</a>

<script>
// Update the customize button URL when variant changes
document.addEventListener('DOMContentLoaded', function() {
  const customizeBtn = document.querySelector('.customize-product-btn[data-product-handle="{{ product.handle }}"]');
  
  if (customizeBtn) {
    // Listen for variant changes
    document.addEventListener('change', function(e) {
      if (e.target.matches('select[name="id"], input[name="id"]')) {
        const newVariantId = e.target.value;
        const currentUrl = new URL(customizeBtn.href, window.location.origin);
        currentUrl.searchParams.set('variant_id', newVariantId);
        customizeBtn.href = currentUrl.pathname + currentUrl.search;
      }
    });
  }
});
</script>
{% endif %}
