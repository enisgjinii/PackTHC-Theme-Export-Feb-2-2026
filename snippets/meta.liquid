{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: shop.url
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name
  assign og_image = nil
  if request.page_type == 'product'
    assign og_type = 'product'
    if product.featured_media
      assign og_image = product.featured_media | image_url: width: 1200
    endif
  elsif request.page_type == 'article'
    assign og_type = 'article'
    if article.image
      assign og_image = article.image | image_url: width: 1200
    endif
  elsif request.page_type == 'collection'
    assign og_type = 'product.group'
    if collection.image
      assign og_image = collection.image | image_url: width: 1200
    elsif collection.products.first and collection.products.first.featured_media
      assign og_image = collection.products.first.featured_media | image_url: width: 1200
    endif
  elsif page_image
    assign og_image = page_image | image_url: width: 1200
  elsif request.page_type == 'password'
    assign og_url = shop.url
  endif
  assign clean_canonical = canonical_url
  if clean_canonical == blank
    assign clean_canonical = request.url | split: '?' | first | split: '#' | first
  endif
  if request.page_type == 'password'
    assign clean_canonical = shop.url
  endif
  assign og_url = clean_canonical
-%}
<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="{{ settings.text_color }}">
<title>{{ og_title }}</title>
{%- if og_description -%}<meta name="description" content="{{ og_description | escape }}">{%- endif -%}
<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:description" content="{{ og_description | escape }}">
{%- if og_image -%}<meta property="og:image" content="{{ og_image }}"><meta property="og:image:secure_url" content="{{ og_image }}">{%- endif -%}
<meta name="twitter:site" content="@pack_thc">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
{%- if og_image -%}<meta name="twitter:image" content="{{ og_image }}">{%- endif -%}
<link rel="canonical" href="{{ clean_canonical }}">
<link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
<link rel="dns-prefetch" href="//cdn.shopify.com">
<link rel="preconnect" href="https://apps.hiko.software" crossorigin>
<link rel="preconnect" href="https://accounts.google.com" crossorigin>
{%- if settings.favicon != blank -%}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">{%- endif -%}
{{ content_for_header }}
{%- if settings.body_font.system -%}
	<link href="{{ settings.body_font | font_url | preload_tag: as: 'font' }}" type="font/woff2" crossorigin>
{%- endif -%}
{%- if settings.heading_font.system -%}
	<link href="{{ settings.heading_font | font_url | preload_tag: as: 'font' }}" type="font/woff2" crossorigin>
{%- endif -%}
<style id="dynamic-variables-theme-css">
	:root {
		--scrollbar-width:  17px;
		--container-content: {{ settings.screen_lg | minus: 30 }}px;
	}
</style>
{{ 'swiper.css' | asset_url | stylesheet_tag }}
<script>document.documentElement.className = document.documentElement.className.replace( 'no-js', 'js' );</script>
<script src="{{ 'swiper.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
