{% comment %}
  Section: Product Carousel with Navigation
  Usage: Add this file to sections folder as 'product-carousel.liquid'
{% endcomment %}

<style>
        #shopify-section-{{ section.id }} {
          padding: 40px 0;
          background-color: {{ section.settings.background_color }};
        }

        #shopify-section-{{ section.id }} .container {
          max-width: 1500px;
          margin: 0 auto;
          padding: 0 20px;
        }

        #shopify-section-{{ section.id }} .header {
          margin-bottom: 40px;
          display: flex;
          justify-content: space-between;
          align-items: flex-end;
              margin-bottom: 20px;
        }

        #shopify-section-{{ section.id }} .header-content {
          flex: 1;
        }

        #shopify-section-{{ section.id }} .subtitle {
          font-size: 14px;
          color: {{ section.settings.subtitle_color }};
          margin-bottom: 10px;
          text-transform: uppercase;
          letter-spacing: 1px;
          font-weight: 400;
        }

        #shopify-section-{{ section.id }} .title {
          font-size: 48px;
          font-weight: 700;
          color: {{ section.settings.title_color }};
          margin-bottom: 0;
          line-height: 1.2;
          margin-top: 0;
        }

        #shopify-section-{{ section.id }} .header-nav {
          display: flex;
          gap: 12px;
        }

        #shopify-section-{{ section.id }} .header-nav-btn {
          width: 50px;
          height: 50px;
          border-radius: 50%;
          background: {{ section.settings.button_color }};
          border: none;
          color: white;
          font-size: 24px;
          cursor: pointer;
          display: flex;
          align-items: center;
          justify-content: center;
          transition: all 0.3s ease;
          box-shadow: 0 2px 8px rgba(0,0,0,0.2);
          padding: 0;
        }

        #shopify-section-{{ section.id }} .header-nav-btn:hover {
          background: {{ section.settings.button_hover_color }};
          transform: scale(1.1);
        }

        #shopify-section-{{ section.id }} .header-nav-btn:active {
          transform: scale(0.95);
        }

        #shopify-section-{{ section.id }} .header-nav-btn:disabled {
          opacity: 0.5;
          cursor: not-allowed;
        }

        #shopify-section-{{ section.id }} .carousel-wrapper {
          position: relative;
          padding: 0px 0;
        }

        #shopify-section-{{ section.id }} .carousel-container {
          display: flex;
          gap: 20px;
          overflow-x: auto;
          scroll-behavior: smooth;
          scrollbar-width: none;
          -ms-overflow-style: none;
          scroll-snap-type: x mandatory;
          -webkit-overflow-scrolling: touch;
        }

        #shopify-section-{{ section.id }} .carousel-container::-webkit-scrollbar {
          display: none;
        }

        #shopify-section-{{ section.id }} .card {
          flex: 0 0 280px;
          background: {{ section.settings.card_background }};
          border-radius: 12px;
          overflow: hidden;
          box-shadow: 0 2px 8px rgba(0,0,0,0.1);
          transition: transform 0.3s ease, box-shadow 0.3s ease;
          cursor: pointer;
          text-decoration: none;
          color: inherit;
          display: block;
          scroll-snap-align: start;
        }

        #shopify-section-{{ section.id }} .card:hover {
          box-shadow: 0 4px 16px rgba(0,0,0,0.15);
        }

        #shopify-section-{{ section.id }} .card-image {
          width: 100%;
          height: 280px;
          background: #000;
          position: relative;
          overflow: hidden;
        }

        #shopify-section-{{ section.id }} .card-image img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          transition: transform 0.3s ease;
        }

        #shopify-section-{{ section.id }} .card:hover .card-image img {
          transform: scale(1.05);
        }

        #shopify-section-{{ section.id }} .card-content {
          padding: 20px 20px 0 20px;
        }

        #shopify-section-{{ section.id }} .card-title {
          font-size: 20px;
          font-weight: 600;
          color: {{ section.settings.card_text_color }};
          line-height: 1.4;
          margin-bottom: 8px;
        }

        @media (max-width: 768px) {
          #shopify-section-{{ section.id }} .title {
            font-size: 32px;
          }

          #shopify-section-{{ section.id }} .container {
            padding: 0 15px;
          }

          #shopify-section-{{ section.id }} .carousel-container {
            gap: 15px;
            padding: 0 5px;
          }

          #shopify-section-{{ section.id }} .card {
            flex: 0 0 calc(100vw - 50px);
            max-width: 320px;
          }

          #shopify-section-{{ section.id }} .header {
            flex-direction: column;
            align-items: flex-start;
            gap: 20px;
          }

          #shopify-section-{{ section.id }} .header-nav-btn {
            width: 40px;
            height: 40px;
            font-size: 20px;
          }
        }

    #shopify-section-{{ section.id }} .search-bar-wrapper {
      margin-bottom: 24px;
      display: flex;
      justify-content: center;
    }

    #shopify-section-{{ section.id }} .search-input-wrapper {
      position: relative;
      width: 100%;
      max-width: 480px;
      display: flex;
      align-items: center;
    }

    #shopify-section-{{ section.id }} .search-icon {
      position: absolute;
      left: 14px;
      color: #999;
      pointer-events: none;
      flex-shrink: 0;
    }

    #shopify-section-{{ section.id }} .carousel-search-{{ section.id }} {
      width: 100%;
      padding: 12px 44px 12px 44px;
      border: 1.5px solid #e0e0e0;
      border-radius: 50px;
      font-size: 15px;
      outline: none;
      box-sizing: border-box;
      background: #fff;
      color: #1a1a1a;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    #shopify-section-{{ section.id }} .carousel-search-{{ section.id }}:focus {
      border-color: {{ section.settings.button_color }};
      box-shadow: 0 0 0 3px {{ section.settings.button_color }}22;
    }

    #shopify-section-{{ section.id }} .search-clear-btn {
      position: absolute;
      right: 12px;
      background: #e0e0e0;
      border: none;
      border-radius: 50%;
      width: 22px;
      height: 22px;
      display: none;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      color: #555;
      padding: 0;
      transition: background 0.2s ease;
      flex-shrink: 0;
    }

    #shopify-section-{{ section.id }} .search-clear-btn:hover {
      background: #ccc;
    }
    #shopify-section-{{ section.id }} .no-results-box {
    text-align: center;
    padding: 40px 20px;
  }

  #shopify-section-{{ section.id }} .no-results-text {
    font-size: 16px;
    color: #888;
    margin-bottom: 16px;
  }

  #shopify-section-{{ section.id }} .see-all-btn {
    display: inline-block;
    padding: 12px 28px;
    background: {{ section.settings.button_color }};
    color: #fff;
    border-radius: 50px;
    text-decoration: none;
    font-size: 15px;
    font-weight: 600;
    transition: background 0.2s ease;
  }

  #shopify-section-{{ section.id }} .see-all-btn:hover {
    background: {{ section.settings.button_hover_color }};
  }
</style>

<div class="container">
  <div class="header">
    <div class="header-content">
      {% if section.settings.subtitle != blank %}
        <div class="subtitle">{{ section.settings.subtitle }}</div>
      {% endif %}
      {% if section.settings.title != blank %}
        <h2 class="title">{{ section.settings.title }}</h2>
      {% endif %}
    </div>
    <div class="header-nav">
      <button class="header-nav-btn carousel-prev-{{ section.id }}" aria-label="Previous">‹</button>
      <button class="header-nav-btn carousel-next-{{ section.id }}" aria-label="Next">›</button>
    </div>
  </div>
  <div class="search-bar-wrapper">
    <div class="search-input-wrapper">
      <svg
        class="search-icon"
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      <input
        type="text"
        class="carousel-search-{{ section.id }}"
        placeholder="{{ section.settings.search_placeholder }}"
      >
      <button class="search-clear-{{ section.id }} search-clear-btn" aria-label="Clear search">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
  </div>

  <div class="carousel-wrapper">
    <div class="carousel-container carousel-{{ section.id }}">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'product' %}
              {% if block.settings.product != blank %}
                {% assign product = block.settings.product %}
                <a href="{{ product.url }}" class="card" {{ block.shopify_attributes }}>
                  <div class="card-image">
                    {% if product.featured_image %}
                      {{
                        product.featured_image
                        | image_url: width: 600
                        | image_tag: alt: product.title, loading: 'lazy'
                      }}
                    {% else %}
                      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    {% endif %}
                  </div>
                  <div class="card-content">
                    {% if block.settings.show_title %}
                      <div class="card-title">{{ product.title }}</div>
                    {% endif %}
                  </div>
                </a>
              {% endif %}

            {% when 'custom' %}
              <a href="{{ block.settings.link }}" class="card" {{ block.shopify_attributes }}>
                <div class="card-image">
                  {% if block.settings.image != blank %}
                    {{
                      block.settings.image
                      | image_url: width: 600
                      | image_tag: alt: block.settings.title, loading: 'lazy'
                    }}
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {% endif %}
                </div>
                <div class="card-content">
                  {% if block.settings.show_title %}
                    <div class="card-title">{{ block.settings.title }}</div>
                  {% endif %}
                </div>
              </a>
          {% endcase %}
        {% endfor %}
      {% else %}
        {% comment %} Default placeholder cards {% endcomment %}
        {% for i in (1..6) %}
          <div class="card">
            <div class="card-image">
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
            <div class="card-content">
              <div class="card-title">Product {{ i }}</div>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>
<div class="no-results-{{ section.id }} no-results-box" style="display:none;">
  <p class="no-results-text">{{ section.settings.no_results_text }}</p>
  {% if section.settings.all_strains_url != blank %}
    <a href="{{ section.settings.all_strains_url }}" class="see-all-btn">
      {{ section.settings.see_all_btn_text }}
    </a>
  {% endif %}
</div>

<script>
  (function () {
    const carousel = document.querySelector('.carousel-{{ section.id }}');
    const prevBtn = document.querySelector('.carousel-prev-{{ section.id }}');
    const nextBtn = document.querySelector('.carousel-next-{{ section.id }}');
    const searchInput = document.querySelector('.carousel-search-{{ section.id }}');
    const clearBtn = document.querySelector('.search-clear-{{ section.id }}');

    // Calculate scroll amount based on card width + gap
    function getScrollAmount() {
      const card = carousel.querySelector('.card');
      if (!card) return 300;
      const cardWidth = card.offsetWidth;
      const gap = 20; // matches CSS gap
      return cardWidth + gap;
    }

    prevBtn.addEventListener('click', () => {
      carousel.scrollBy({
        left: -getScrollAmount(),
        behavior: 'smooth',
      });
    });

    nextBtn.addEventListener('click', () => {
      carousel.scrollBy({
        left: getScrollAmount(),
        behavior: 'smooth',
      });
    });

    // Disable buttons when at start/end
    function updateButtons() {
      const maxScroll = carousel.scrollWidth - carousel.clientWidth;
      prevBtn.disabled = carousel.scrollLeft <= 0;
      nextBtn.disabled = carousel.scrollLeft >= maxScroll - 1;
    }

    if (searchInput && clearBtn) {
      searchInput.addEventListener('input', function () {
        const query = this.value.toLowerCase().trim();
        clearBtn.style.display = query ? 'flex' : 'none';

        const cards = carousel.querySelectorAll('.card');
        let visibleCount = 0;

        cards.forEach((card) => {
          const title = card.querySelector('.card-title');
          const text = title ? title.textContent.toLowerCase() : '';
          const isVisible = !query || text.includes(query);
          card.style.display = isVisible ? 'block' : 'none';
          if (isVisible) visibleCount++;
        });

        const noResults = document.querySelector('.no-results-{{ section.id }}');
        noResults.style.display = query && visibleCount === 0 ? 'block' : 'none';
      });

      clearBtn.addEventListener('click', function () {
        searchInput.value = '';
        clearBtn.style.display = 'none';
        carousel.querySelectorAll('.card').forEach((card) => (card.style.display = 'block'));
        searchInput.focus();
      });
    }

    carousel.addEventListener('scroll', updateButtons);
    window.addEventListener('resize', updateButtons);
    updateButtons();
  })();
</script>

{% schema %}
{
  "name": "Education Strains",
  "tag": "section",
  "class": "product-carousel-section",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button Color",
      "default": "#2d7a5e"
    },
    {
      "type": "color",
      "id": "button_hover_color",
      "label": "Button Hover Color",
      "default": "#246952"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card Background",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Heading Settings"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Fresh from the Field"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle Color",
      "default": "#666666"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Discover Our Latest Strains"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Card Text Colors"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card Title Color",
      "default": "#1a1a1a"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search Placeholder Text",
      "default": "Search strains..."
    },
    {
      "type": "url",
      "id": "all_strains_url",
