      "default": "No strains found"
    },
    {
      "type": "text",
      "id": "see_all_btn_text",
      "label": "See All Button Text",
      "default": "See All Strains"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "checkbox",
          "id": "show_title",
          "label": "Show Title",
          "default": true
        }
      ]
    },
    {
      "type": "custom",
      "name": "Custom Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Product Title"
        },
        {
          "type": "checkbox",
          "id": "show_title",
          "label": "Show Title",
          "default": true
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Education Strains",
      "blocks": [
        {
          "type": "custom"
        },
        {
          "type": "custom"
        },
        {
          "type": "custom"
        },
        {
          "type": "custom"
        },
        {
          "type": "custom"
        },
        {
          "type": "custom"
        }
      ]
    }
  ]
}
{% endschema %}
