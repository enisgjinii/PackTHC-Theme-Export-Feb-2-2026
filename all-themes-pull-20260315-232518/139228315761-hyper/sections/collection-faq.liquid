{% comment %}
  Collection FAQ Section with Metafields
  File: sections/collection-faq.liquid
{% endcomment %}

{% if collection.metafields.custom.faq_questions != blank %}
<section class="collection-faq-section">
  <div class="faq-container">
    <h2 class="faq-main-heading">{{ section.settings.heading | default: 'Frequently Asked Questions' }}</h2>

    <div class="faq-accordion">
      {% for question in collection.metafields.custom.faq_questions.value %}
        {% assign index = forloop.index0 %}
        {% assign answer = collection.metafields.custom.faq_answers.value[index] %}
        
        <div class="faq-item {% if forloop.first %}active{% endif %}">
          <button class="faq-question" type="button">
            {{ question }}
            <span class="faq-icon">
              <svg class="icon-plus" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
              <svg class="icon-minus" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
            </span>
          </button>
          <div class="faq-answer" {% if forloop.first %}style="display: block;"{% endif %}>
            <div class="faq-answer-content">
              {{ answer }}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .collection-faq-section {
    padding: 60px 20px;
    background-color: #f5f5f5;
  }

  .faq-container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .faq-main-heading {
    font-size: 28px;
    font-weight: 800;
    margin-bottom: 36px;
    color: #1a1a1a;
    text-align: center;
  }

  .faq-accordion {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    align-items: start;
  }

  .faq-item {
    background-color: #ffffff;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid #e8e8e8;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .faq-item.active {
    border-color: #d0d0d0;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    background-color: #ffffff;
  }

  .faq-question {
    width: 100%;
    padding: 20px 22px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 15px;
    font-weight: 600;
    text-align: left;
    color: #1a1a1a;
    transition: color 0.2s ease;
    gap: 12px;
  }

  .faq-item.active .faq-question {
    color: #1a1a1a;
  }

  .faq-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    color: #1a1a1a;
  }

  .faq-item .icon-minus {
    display: none;
  }

  .faq-item.active .icon-plus {
    display: none;
  }

  .faq-item.active .icon-minus {
    display: block;
  }

  .faq-answer {
    display: none;
    padding: 0 22px 20px 22px;
    color: #555555;
    line-height: 1.65;
    font-size: 14px;
  }

  .faq-item.active .faq-answer {
    color: #555555;
  }

  .faq-answer-content {
    padding-top: 4px;
    border-top: 1px solid #f0f0f0;
    padding-top: 14px;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .faq-accordion {
      grid-template-columns: 1fr;
    }

    .faq-main-heading {
      font-size: 22px;
      margin-bottom: 24px;
    }

    .faq-question {
      font-size: 14px;
      padding: 16px 18px;
    }

    .faq-answer {
      padding: 0 18px 16px 18px;
      font-size: 13px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const faqItems = document.querySelectorAll('.faq-item');
    
    faqItems.forEach(item => {
      const question = item.querySelector('.faq-question');
      const answer = item.querySelector('.faq-answer');
      
      question.addEventListener('click', function() {
        const isActive = item.classList.contains('active');
        
        // Close all items
        faqItems.forEach(otherItem => {
          otherItem.classList.remove('active');
          otherItem.querySelector('.faq-answer').style.display = 'none';
        });
        
        // Toggle current item
        if (!isActive) {
          item.classList.add('active');
          answer.style.display = 'block';
        }
      });
    });
  });
</script>
{% endif %}

{% schema %}
{
  "name": "Collection FAQ",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Frequently Asked Questions"
    }
  ],
  "presets": [
    {
      "name": "Collection FAQ"
    }
  ]
}
{% endschema %}

