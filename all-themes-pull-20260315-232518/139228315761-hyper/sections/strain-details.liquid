{% comment %}
  Product Details Section - Simplified with Emojis and Professional Shadows
{% endcomment %}

<style>
    :root {
      --primary-color: #033770;
      --secondary-color: #4caf50;
      --accent-color: #e8f5e9;
      --light-bg: #fafafa;
      --white: #ffffff;
      --text-dark: #222222;
      --text-light: #666666;
      --border-color: #e0e0e0;
    }

    .product-details-section {
      max-width: 1200px;
      margin: 0 auto;
      padding: 40px 20px;
    }

    /* ===== MAIN HERO SECTION ===== */
    .block-main-info{
     margin-bottom: 20px;
    }

    .hero-wrapper {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 50px;
      align-items: start;
    }

    .hero-image-side {
      text-align: center;
    }

    .trichome-image {
      width: 100%;
      max-width: 550px;
      border-radius: 8px;
      box-shadow: rgba(0, 0, 0, 0.24) 0px 3px 8px;
      margin-bottom: 20px;
    }

    .image-caption {
      color: var(--text-light);
      text-align: start;
      font-size: 13px;
      line-height: 1.6;
      padding: 15px;
      border-radius: 8px;
      box-shadow: rgba(0, 0, 0, 0.24) 0px 3px 8px;
    }

    .hero-content-side {
      display: flex;
      flex-direction: column;
    }

    .product-title-section {
      padding-bottom: 20px;
    }

    .product-title-section h1 {
      font-size: 48px;
      font-weight: 700;
      margin: 0 0 10px 0;
      color: var(--text-dark);
    }

    .genetics-info {
      color: var(--text-light);
      font-size: 14px;
      font-weight: 500;
      margin-bottom: 20px;
    }

    .info-badges {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    .strain-badge {
      padding: 6px 16px;
      background: var(--accent-color);
      color: var(--primary-color);
      border: 1px solid #c8e6c9;
      border-radius: 8px;
      font-weight: 600;
      font-size: 14px;
      text-transform: capitalize;
      transition: all 0.3s ease;
      box-shadow: rgba(0, 0, 0, 0.24) 0px 3px 8px;
    }

    /* ===== EFFECTS SECTION ===== */
    .effects-section {
      margin: 10px 0;
      padding: 15px;
      background: var(--accent-color);
      border-radius: 8px;
      box-shadow: rgba(0, 0, 0, 0.24) 0px 3px 8px;
    }

    .section-label {
      font-size: 14px;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      color: var(--primary-color);
      font-weight: 700;
      margin-bottom: 15px;
    }

    .effects-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }

    .effect-item {
      padding: 12px 15px;
      background: var(--white);
      border-radius: 8px;
      font-weight: 500;
      font-size: 14px;
      color: var(--text-dark);
      border: 1px solid var(--border-color);
      transition: all 0.3s ease;
    }

    /* ===== TERPENES SECTION ===== */

    .terpenes-section h3 {
      font-size: 20px;
      font-weight: 700;
      margin-bottom: 15px;
      margin-top: 10px;
      color: var(--text-dark);
    }

    .terpene-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
    }

    .terpene-badge {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 10px 15px;
      background: var(--light-bg);
      border-radius: 8px;
      font-size: 14px;
      font-weight: 600;
      color: var(--text-dark);
      transition: all 0.3s ease;
      box-shadow: rgba(0, 0, 0, 0.24) 0px 3px 8px;
    }

    .terpene-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--primary-color);
      flex-shrink: 0;
    }

    /* ===== SCALES SECTION ===== */
    .scales-section {
      margin-top: 30px;
      padding: 25px;
      background: var(--light-bg);
      border-radius: 8px;
      box-shadow: rgba(0, 0, 0, 0.24) 0px 3px 8px;
    }

    .scale-item {
      margin-bottom: 25px;
    }

    .scale-item:last-child {
      margin-bottom: 0;
    }

    .scale-header h4 {
      font-size: 14px;
      font-weight: 700;
      margin: 0 0 10px 0;
      color: var(--text-dark);
    }

    .scale-track {
      height: 8px;
      background: var(--border-color);
      border-radius: 10px;
      position: relative;
      margin: 10px 0;
    }

    .strain-scale-fill {
      height: 100%;
      background: #000000;
      border-radius: 8px;
      position: relative;
      overflow: visible;
      display:block;
    }

    .strain-scale-fill::after {
      content: '';
      position: absolute;
      right: -8px;
      top: 50%;
      transform: translateY(-50%);
      width: 16px;
      height: 16px;
      background: var(--white);
      border: 3px solid var(--primary-color);
      border-radius: 50%;
      box-shadow: 0 2px 6px rgba(0,0,0,0.15);
      display:block;
    }

    .scale-labels {
      display: flex;
      justify-content: space-between;
      font-size: 13px;
      color: var(--text-light);
      font-weight: 600;
      margin-bottom: 8px;
    }

    /* ===== DESCRIPTION BLOCK ===== */
    .block-description {
      margin-bottom: 40px;
    }
  /*
    .description-container {
      background: var(--white);
      padding: 40px;
      border-radius: 12px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.08);
      border-top: 4px solid var(--primary-color);
    } */

    .description-container h2 {
      font-size: 30px;
      font-weight: 700;
      margin-bottom: 25px;
      color: var(--text-dark);
    }

    .description-text {
      font-size: 15px;
      line-height: 1.8;
      color: var(--text-light);
      margin-bottom: 20px;
    }

    .images-showcase {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 15px;
      margin: 35px 0;
    }

    .showcase-image {
      position: relative;
      overflow: hidden;
      border-radius: 8px;
      aspect-ratio: 1;
    }

    .showcase-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.4s ease;
    }

    .showcase-image:hover img {
      transform: scale(1.08);
    }

    .showcase-image {
      box-shadow: rgba(0, 0, 0, 0.24) 0px 3px 8px;
    }

    .features-row {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      margin-top: 30px;
    }

    .feature-box {
      background: var(--light-bg);
      padding: 20px;
      border-radius: 8px;
      text-align: center;
      transition: all 0.3s ease;
      box-shadow: rgba(0, 0, 0, 0.24) 0px 3px 8px;
    }

    .feature-box h4 {
      font-size: 13px;
      font-weight: 700;
      margin-bottom: 10px;
      text-transform: capitalize;
      color: var(--text-dark);
    }

    .feature-box p {
      font-size: 12px;
      color: var(--text-light);
      line-height: 1.6;
    }

    /* ===== PRODUCT SELECTION ===== */
    .block-product-selection {
      margin-bottom: 40px;
    }

    .selection-header {
      text-align: center;
      margin-bottom: 40px;
    }

    .selection-header small {
      display: block;
      color: var(--primary-color);
      text-transform: uppercase;
      letter-spacing: 1.5px;
      font-size: 15px;
      font-weight: 700;
    }

    .selection-header h2 {
      font-size: 30px;
      font-weight: 700;
      margin-bottom: 15px;
      color: var(--text-dark);
      margin-top: 5px;
    }

    .selection-header p {
      color: var(--text-light);
      font-size: 14px;
      max-width: 600px;
      margin: 0 auto;
      line-height: 1.7;
    }

    .products-masonry {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 15px;
      margin-bottom: 35px;
    }

    .product-card {
      background: var(--white);
      border-radius: 8px;
      overflow: hidden;
      box-shadow: rgba(0, 0, 0, 0.24) 0px 3px 8px;
      transition: all 0.4s ease;
    }


    .product-image-wrapper {
      position: relative;
      overflow: hidden;
      height: 220px;
      background: var(--accent-color);
    }

    .product-card-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s ease;
    }

    .product-card-content {
      padding: 20px;
      text-align: center;
    }

    .product-card-title {
      font-size: 14px;
      font-weight: 700;
      margin: 0 5px 15px 5px;
      color: var(--text-dark);
    }

    .view-product-btn {
      display: inline-block;
      padding: 10px 25px;
      background: var(--primary-color);
      color: var(--white) !important;
      text-decoration: none;
      border-radius: 6px;
      font-weight: 700;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      transition: all 0.3s ease;
    }

    .promo-boxes {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 25px;
    }

    .promo-box {
      padding: 20px;
      border-radius: 8px;
      text-align: center;
      box-shadow: rgba(0, 0, 0, 0.24) 0px 3px 8px;
    }


    .promo-box h3 {
      font-size: 24px;
      font-weight: 700;
      margin-bottom: 12px;
      color: var(--text-dark);
    }

    .promo-box p {
      color: var(--text-light);
      line-height: 1.7;
      font-size: 13px;
    }

    /* ===== CATEGORIES INFO ===== */
    .block-categories {
      margin-bottom: 40px;
    }

    .strain-categories-wrapper h2 {
      font-size: 30px;
      font-weight: 700;
      color: var(--text-dark);
      text-align: center;
      margin-bottom: 20px;
    }

    .info-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .info-card {
      padding: 25px;
      border-radius: 8px;
      box-shadow: rgba(0, 0, 0, 0.24) 0px 3px 8px;
    }

    .info-card small {
      color: var(--text-light);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 1px;
      font-weight: 700;
      display: block;
      margin-bottom: 8px;
    }

    .info-card strong {
      font-size: 18px;
      font-weight: 700;
      color: var(--text-dark);
      display: block;
    }

    /* ===== EFFECTS & YIELD ===== */
    .block-effects-yield {
      margin-bottom: 40px;
    }


    .split-content {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 40px;
      margin-bottom: 40px;
    }
    .content-column{
      box-shadow: rgba(0, 0, 0, 0.24) 0px 3px 8px;
      padding: 20px;
      border-radius: 8px;
    }

    .content-column h3 {
      font-size: 24px;
      font-weight: 700;
      margin-bottom: 20px;
      color: var(--text-dark);
    }

    .tags-container {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .tag {
      padding: 8px 16px;
      border-radius: 8px;
      font-weight: 600;
      font-size: 14px;
      text-transform: capitalize;
    }

    .tag-dark {
      background: var(--accent-color);
      color: var(--primary-color);
    }

    .tag-light {
      background: var(--accent-color);
      color: var(--primary-color);
      border: 1px solid #c8e6c9;
    }

    .tag-accent {
      background: #fff3cd;
      color: #856404;
      border: 1px solid #ffeaa7;
    }

    .yield-highlight {
      padding: 20px;
      border-radius: 8px;
      box-shadow: rgba(0, 0, 0, 0.24) 0px 3px 8px;
    }

    .yield-highlight h3 {
      font-size: 25px;
      font-weight: 700;
      margin-bottom: 15px;
      color: var(--text-dark);
    }

    .yield-highlight small {
      color: var(--text-light);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 1px;
      font-weight: 700;
      display: block;
      margin-bottom: 8px;
    }

    .yield-highlight strong {
      font-size: 18px;
      font-weight: 700;
      color: var(--primary-color);
      display: block;
    }
    /* ===== MORE SIMILAR STRAINS SECTION ===== */
.block-similar-strains {
  margin-bottom: 40px;
}

.similar-strains-wrapper h2 {
  font-size: 30px;
  font-weight: 700;
  color: var(--text-dark);
  text-align: center;
  margin-bottom: 40px;
}

.similar-strains-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}

.strain-card {
  border-radius: 8px;
  overflow: hidden;
  box-shadow: rgba(0, 0, 0, 0.24) 0px 3px 8px;
}


.strain-image-wrapper {
  height: 250px;
  overflow: hidden;
  background: var(--accent-color);
}

.strain-card-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s ease;
}

.strain-card:hover .strain-card-image {
  transform: scale(1.05);
}

.strain-card-footer {
  padding: 5px 0px 20px 0px;
  text-align: center;
}

.strain-card-title {
  font-size: 16px;
  font-weight: 700;
  margin-bottom: 15px;
  color: var(--text-dark);
}

.view-strain-btn {
  display: inline-block;
  padding: 10px 25px;
  background: var(--primary-color);
  color: var(--white) !important;
  text-decoration: none;
  border-radius: 6px;
  font-weight: 700;
  font-size: 14px;
  letter-spacing: 0.5px;
  transition: all 0.3s ease;
}

.view-strain-btn:hover {
  background: var(--text-dark);
}

@media (max-width: 1024px) {
  .similar-strains-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 768px) {
  .similar-strains-grid {
    grid-template-columns: 1fr;
  }
}

    /* ===== RESPONSIVE ===== */
    @media (max-width: 1024px) {
      .hero-wrapper {
        grid-template-columns: 1fr;
        gap: 30px;
      }

      .split-content,
      .promo-boxes {
        grid-template-columns: 1fr;
      }

      .products-masonry {
        grid-template-columns: repeat(2, 1fr);
      }

      .info-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 768px) {
      .product-title-section h1 {
        font-size: 32px;
      }

      .products-masonry,
      .features-row,
      .images-showcase,
      .terpene-grid,
      .info-grid {
        grid-template-columns: 1fr;
      }

      .selection-header h2 {
        font-size: 28px;
      }

      .hero-wrapper,
      .split-content {
        gap: 20px;
      }
    }
</style>

<div class="product-details-section">
  {% for block in section.blocks %}
    {% case block.type %}
      {% when 'main_info' %}
        <div class="block-main-info" {{ block.shopify_attributes }}>
          <div class="hero-wrapper">
            <div class="hero-image-side">
              <div class="hero-image-container">
                {% if block.settings.trichome_image %}
                  <img
                    src="{{ block.settings.trichome_image | img_url: '1024x1024' }}"
                    alt="{{ block.settings.product_name }}"
                    class="trichome-image"
                  >
                {% endif %}
                <div class="image-caption">
                  {{ block.settings.image_description }}
                </div>
              </div>
            </div>

            <div class="hero-content-side">
              <div class="product-title-section">
                <h1>
                  {{ block.settings.emoji_main }}
                  {{ block.settings.product_name }}
                </h1>
                <p class="genetics-info">{{ block.settings.genetics }}</p>
                <div class="info-badges">
                  {% if block.settings.strain-badge_1 != blank %}
                    <span class="strain-badge">{{ block.settings.strain-badge_1 }}</span>
                  {% endif %}
                  {% if block.settings.strain-badge_2 != blank %}
                    <span class="strain-badge">{{ block.settings.strain-badge_2 }}</span>
                  {% endif %}
                  {% if block.settings.strain-badge_3 != blank %}
                    <span class="strain-badge">{{ block.settings.strain-badge_3 }}</span>
                  {% endif %}
                </div>
              </div>

              <div class="effects-section">
                <div class="section-label">{{ block.settings.emoji_effects }} Top Effects</div>
                <div class="effects-grid">
                  {% if block.settings.effect_1 != blank %}
                    <div class="effect-item">
                      {{ block.settings.effect_emoji_1 }}
                      {{ block.settings.effect_1 }}
                    </div>
                  {% endif %}
                  {% if block.settings.effect_2 != blank %}
                    <div class="effect-item">
                      {{ block.settings.effect_emoji_2 }}
                      {{ block.settings.effect_2 }}
                    </div>
                  {% endif %}
                  {% if block.settings.effect_3 != blank %}
                    <div class="effect-item">
                      {{ block.settings.effect_emoji_3 }}
                      {{ block.settings.effect_3 }}
                    </div>
                  {% endif %}
                  {% if block.settings.effect_4 != blank %}
                    <div class="effect-item">
                      {{ block.settings.effect_emoji_4 }}
                      {{ block.settings.effect_4 }}
                    </div>
                  {% endif %}
                  {% if block.settings.effect_5 != blank %}
                    <div class="effect-item">
                      {{ block.settings.effect_emoji_5 }}
                      {{ block.settings.effect_5 }}
                    </div>
                  {% endif %}
                </div>
              </div>

              <div class="terpenes-section">
                <h3>{{ block.settings.emoji_terpenes }} Terpenes</h3>
                <div class="terpene-grid">
                  {% if block.settings.terpene_1 != blank %}
                    <div class="terpene-badge">
                      <span class="terpene-dot"></span>
                      {{ block.settings.terpene_1 }}
                    </div>
                  {% endif %}
                  {% if block.settings.terpene_2 != blank %}
                    <div class="terpene-badge">
                      <span class="terpene-dot"></span>
                      {{ block.settings.terpene_2 }}
                    </div>
                  {% endif %}
                  {% if block.settings.terpene_3 != blank %}
                    <div class="terpene-badge">
                      <span class="terpene-dot"></span>
                      {{ block.settings.terpene_3 }}
                    </div>
                  {% endif %}
                  {% if block.settings.terpene_4 != blank %}
                    <div class="terpene-badge">
                      <span class="terpene-dot"></span>
                      {{ block.settings.terpene_4 }}
                    </div>
                  {% endif %}
                  {% if block.settings.terpene_5 != blank %}
                    <div class="terpene-badge">
                      <span class="terpene-dot"></span>
                      {{ block.settings.terpene_5 }}
                    </div>
                  {% endif %}
                  {% if block.settings.terpene_6 != blank %}
                    <div class="terpene-badge">
                      <span class="terpene-dot"></span>
                      {{ block.settings.terpene_6 }}
                    </div>
                  {% endif %}
                </div>
              </div>

              <div class="scales-section">
                <div class="scale-item">
                  <div class="scale-header">
                    <h4>{{ block.settings.emoji_energy }} Energy Level</h4>
                  </div>
                  <div class="scale-labels">
                    <span>Calming</span>
                    <span>Energizing</span>
                  </div>
                  <div class="scale-track">
                    <div class="strain-scale-fill" style="width: {{ block.settings.energy_level | default: 35 }}%;"></div>
                  </div>
                </div>

                <div class="scale-item">
                  <div class="scale-header">
                    <h4>{{ block.settings.emoji_thc }} THC Potency</h4>
                  </div>
                  <div class="scale-labels">
                    <span>Low THC</span>
                    <span>High THC</span>
                  </div>
                  <div class="scale-track">
                    <div class="strain-scale-fill" style="width: {{ block.settings.thc_level | default: 60 }}%;"></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

      {% when 'description' %}
        <div class="block-description" {{ block.shopify_attributes }}>
          <div class="description-container">
            <h2>
              {{ block.settings.emoji_about }}
              {{ block.settings.title }}
            </h2>
            {% if block.settings.description_1 != blank %}
              <p class="description-text">{{ block.settings.description_1 }}</p>
            {% endif %}
            {% if block.settings.description_2 != blank %}
              <p class="description-text">{{ block.settings.description_2 }}</p>
            {% endif %}

            <div class="images-showcase">
              {% if block.settings.bud_image %}
                <div class="showcase-image">
                  <img src="{{ block.settings.bud_image | img_url: '1024x1024' }}" alt="Bud showcase 1">
                </div>
              {% endif %}
              {% if block.settings.bud_image_2 %}
                <div class="showcase-image">
                  <img src="{{ block.settings.bud_image_2 | img_url: '1024x1024' }}" alt="Bud showcase 2">
                </div>
              {% endif %}
              {% if block.settings.bud_image_3 %}
                <div class="showcase-image">
                  <img src="{{ block.settings.bud_image_3 | img_url: '1024x1024' }}" alt="Bud showcase 3">
                </div>
              {% endif %}
              {% if block.settings.bud_image_4 %}
                <div class="showcase-image">
                  <img src="{{ block.settings.bud_image_4 | img_url: '1024x1024' }}" alt="Bud showcase 4">
                </div>
              {% endif %}
            </div>

            <div class="features-row">
              {% if block.settings.feature_1_title != blank %}
                <div class="feature-box">
                  <h4>
                    {{ block.settings.feature_1_emoji }}
                    {{ block.settings.feature_1_title }}
                  </h4>
                  <p>{{ block.settings.feature_1_desc }}</p>
                </div>
              {% endif %}
              {% if block.settings.feature_2_title != blank %}
                <div class="feature-box">
                  <h4>
                    {{ block.settings.feature_2_emoji }}
                    {{ block.settings.feature_2_title }}
                  </h4>
                  <p>{{ block.settings.feature_2_desc }}</p>
                </div>
              {% endif %}
              {% if block.settings.feature_3_title != blank %}
                <div class="feature-box">
                  <h4>
                    {{ block.settings.feature_3_emoji }}
                    {{ block.settings.feature_3_title }}
                  </h4>
                  <p>{{ block.settings.feature_3_desc }}</p>
                </div>
              {% endif %}
              {% if block.settings.feature_4_title != blank %}
                <div class="feature-box">
                  <h4>
                    {{ block.settings.feature_4_emoji }}
                    {{ block.settings.feature_4_title }}
                  </h4>
                  <p>{{ block.settings.feature_4_desc }}</p>
                </div>
              {% endif %}
            </div>
          </div>
