{% comment %}
  Related Collections - Card Strip Style
  Setup: Create metafield "custom.related_collections" (list of collection references)
{% endcomment %}

{% if collection and collection.metafields.custom.related_collections %}
<div class="rcstrip-wrapper">
  {% if section.settings.title != blank %}
  <div class="rcstrip-header">
    <h2 class="rcstrip-title">{{ section.settings.title }}</h2>
    <div class="rcstrip-line"></div>
  </div>
  {% endif %}

  <div class="rcstrip-outer">
    <button class="rcstrip-arrow left" id="arrowLeft" aria-label="Scroll left">&#8249;</button>

    <div class="rcstrip-track" id="stripTrack">
      {% for related_coll in collection.metafields.custom.related_collections.value %}
        <a href="{{ related_coll.url }}"
           class="rccard{% if related_coll.handle == collection.handle %} active{% endif %}"
           style="animation-delay: {{ forloop.index | times: 0.05 }}s">

          <div class="rccard-imgbox">
            <span class="rccard-num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>

            {% if related_coll.image %}
              {{ related_coll.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: related_coll.title }}
            {% elsif related_coll.products.first.featured_image %}
              {{ related_coll.products.first.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: related_coll.title }}
            {% else %}
              <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#033770" stroke-width="1.5" opacity="0.4">
                <rect x="3" y="3" width="18" height="18" rx="2"/>
                <circle cx="8.5" cy="8.5" r="1.5"/>
                <path d="M21 15l-5-5L5 21"/>
              </svg>
            {% endif %}
          </div>

          <div class="rccard-info">
            <div class="rccard-name">{{ related_coll.title }}</div>
            <div class="rccard-bar"></div>
          </div>

        </a>
      {% endfor %}
    </div>

    <button class="rcstrip-arrow right" id="arrowRight" aria-label="Scroll right">&#8250;</button>
  </div>
</div>
{% endif %}

<style>
  .rcstrip-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding: 15px 20px;
  }

  .rcstrip-header {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 24px;
  }

  .rcstrip-title {
    font-size: 20px;
    font-weight: 800;
    color: #033770;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .rcstrip-line {
    flex: 1;
    height: 2px;
    background: linear-gradient(to right, #033770 0%, transparent 100%);
    opacity: 0.15;
  }

.rcstrip-outer {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: flex-start;
}

.rcstrip-track {
  display: flex;
  gap: 0;
  overflow-x: auto;
  scrollbar-width: none;
  -ms-overflow-style: none;
  scroll-behavior: smooth;
  padding-bottom: 4px;
  justify-content: safe center;
  max-width: 100%;
}
.rcstrip-track::-webkit-scrollbar { display: none; }

  .rccard {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-decoration: none;
    color: #1a2332;
    flex-shrink: 0;
    width: 160px;
    position: relative;
    transition: transform 0.2s cubic-bezier(.34,1.56,.64,1);
    padding: 0 6px;
    animation: rcFadeUp 0.4s ease both;
  }

  @keyframes rcFadeUp {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .rccard:hover { transform: translateY(-4px); }

  .rccard-imgbox {
    width: 100%;
    aspect-ratio: 1/1;
    border-radius: 12px;
    overflow: hidden;
    background: #dde6f2;
    position: relative;
    border: 2px solid transparent;
    transition: border-color 0.2s, box-shadow 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .rccard:hover .rccard-imgbox {
    border-color: #033770;
    box-shadow: 0 8px 24px rgba(3,55,112,0.18);
  }

  .rccard.active .rccard-imgbox {
    border-color: #033770;
    box-shadow: 0 8px 28px rgba(3,55,112,0.22);
  }

.rccard-imgbox img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  transition: transform 0.35s ease;
  image-rendering: -webkit-optimize-contrast;
}

  .rccard:hover .rccard-imgbox img { transform: scale(1.06); }

  .rccard.active .rccard-imgbox::after {
    content: '✓ Current';
    position: absolute;
    top: 8px; right: 8px;
    background: #033770;
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 20px;
    letter-spacing: 0.04em;
  }

  .rccard-num {
    position: absolute;
    top: 8px; left: 12px;
    font-size: 36px;
    font-weight: 800;
    color: rgba(255,255,255,0.2);
    line-height: 1;
    user-select: none;
    pointer-events: none;
  }

  .rccard-info {
    padding: 10px 4px 4px;
    width: 100%;
  }

  .rccard-name {
    font-size: 13px;
    font-weight: 600;
    color: #1a2332;
    line-height: 1.35;
    transition: color 0.2s;
  }

  .rccard:hover .rccard-name,
  .rccard.active .rccard-name { color: #033770; }

  .rccard-bar {
    margin-top: 6px;
    height: 3px;
    width: 0;
    background: #033770;
    border-radius: 2px;
    transition: width 0.3s ease;
  }

  .rccard:hover .rccard-bar { width: 40px; }
  .rccard.active .rccard-bar { width: 100%; background: #f0a500; }

  .rcstrip-arrow {
    position: absolute;
    top: calc(50% - 28px);
    transform: translateY(-50%);
    z-index: 10;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    transition: all 0.2s;
    background: #033770;
    color: #fff;
    box-shadow: 0 4px 14px rgba(3,55,112,0.3);
    opacity: 0;
    pointer-events: none;
    line-height: 1;
    padding: 0;
  }

  .rcstrip-arrow.visible {
    opacity: 1;
    pointer-events: all;
  }

  .rcstrip-arrow:hover {
    background: #0a4d9e;
    transform: translateY(-50%) scale(1.08);
    box-shadow: 0 6px 20px rgba(3,55,112,0.4);
  }

  .rcstrip-arrow.left  { left: -18px; }
  .rcstrip-arrow.right { right: -18px; }

  @media (max-width: 768px) {
    .rcstrip-wrapper { padding: 10px 15px; }
    .rccard { width: 130px; }
    .rccard-num { font-size: 28px; }
    .rcstrip-arrow { display: none; }
  }
</style>

<script>
  (function () {
    const track = document.getElementById('stripTrack');
    const left  = document.getElementById('arrowLeft');
    const right = document.getElementById('arrowRight');

    if (!track || !left || !right) return;

    function update() {
      left.classList.toggle('visible',  track.scrollLeft > 10);
      right.classList.toggle('visible', track.scrollLeft + track.clientWidth < track.scrollWidth - 10);
    }

    left.addEventListener('click',  () => track.scrollBy({ left: -340, behavior: 'smooth' }));
    right.addEventListener('click', () => track.scrollBy({ left:  340, behavior: 'smooth' }));
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();

    const active = track.querySelector('.rccard.active');
    if (active) {
      setTimeout(() => active.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' }), 200);
    }
  })();
</script>

{% schema %}
{
  "name": "Related Collections",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Shop by Size",
      "info": "Setup: Settings > Custom Data > Collections > Add 'related_collections' (List of Collection references)"
    }
  ],
  "presets": [
    {
      "name": "Related Collections"
    }
  ]
}
{% endschema %}