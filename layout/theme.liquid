    <script>
      (function () {
        function norm(t) {
          return (t || '').replace(/\s+/g, ' ').trim();
        }

        function already(typeStr) {
          var f = false;
          document.querySelectorAll('script[type="application/ld+json"]').forEach(function (s) {
            if ((s.text || '').indexOf('"@type":"' + typeStr + '"') > -1) {
              f = true;
            }
          });
          return f;
        }

        function inject(obj) {
          try {
            var s = document.createElement('script');
            s.type = 'application/ld+json';
            s.text = JSON.stringify(obj);
            document.head.appendChild(s);
          } catch (e) {}
        }

        var Q_LEAD = /^(what|how|why|when|where|which|can|do|does|did|is|are|should|could|would)\b/i;

        function looksLikeQuestion(txt) {
          var x = norm(txt || '');
          return /\?$/.test(x) || Q_LEAD.test(x);
        }

        function isJunk(t) {
          var x = norm(t);
          if (!x) return true;
          if (x.length < 10) return true;
          if (/continue reading|read more|shop now|learn more|contact us/i.test(x)) return true;
          if (/^\w{3}\s\d{1,2},\s\d{4}/i.test(x)) return true;
          return false;
        }

        var STOP_SEL = [
          '.post-navigation',
          '.blog-comments',
          '.comment-list',
          '.comment-form',
          '.post-content-footer',
          '.related',
          '[class*="related"]',
          '.article-list',
          '.blog-grid',
          '.pagination',
          '.nav',
        ].join(',');

        var FAQ_LABEL =
          /^(faqs?|frequently asked questions|q\s*&\s*a|questions\s*&\s*answers|common questions|help|support)\s*:?\s*$/i;

        // broad scope: blog, product, article or fallback to document
        var scope =
          document.querySelector('.post-content') ||
          document.querySelector('.blog-content') ||
          document.querySelector('.product-single__description') ||
          document.querySelector('.product-description') ||
          document.querySelector('#ProductInfo') ||
          document.querySelector('article') ||
          document;

        function collectAnswerFromHeading(startEl) {
          var parts = [],
            cur = startEl.nextElementSibling;
          while (cur) {
            if (cur.matches && cur.matches(STOP_SEL)) break;
            if (/^H[1-4]$/.test(cur.tagName)) break; // next heading
            if (/(P|DIV|UL|OL|BLOCKQUOTE|TABLE)/.test(cur.tagName)) {
              if (cur.tagName === 'UL' || cur.tagName === 'OL') {
                var lis = Array.from(cur.querySelectorAll('li'))
                  .map(function (li) {
                    return norm(li.innerText);
                  })
                  .filter(Boolean);
                var listTxt = lis.join('\n');
                if (!isJunk(listTxt)) parts.push(listTxt);
              } else {
                var txt = norm(cur.innerText);
                if (!isJunk(txt)) parts.push(txt);
              }
            }
            cur = cur.nextElementSibling;
          }
          return norm(parts.join('\n\n'));
        }

        function collectFromFAQSection(head) {
          var items = [],
            el = head.nextElementSibling;
          while (el) {
            if (el.matches && el.matches(STOP_SEL)) break;
            if (/^H[12]$/.test(el.tagName) && !FAQ_LABEL.test(norm(el.textContent))) break;
            if (/^H[1-4]$/.test(el.tagName) && FAQ_LABEL.test(norm(el.textContent))) break;

            if (/^H[2-4]$/.test(el.tagName) && looksLikeQuestion(el.textContent)) {
              var q = norm(el.textContent),
                a = collectAnswerFromHeading(el);
              if (q && a) items.push({ q: q, a: a });
            }

            if (el.tagName === 'DETAILS') {
              var sum = el.querySelector('summary');
              var q2 = norm(sum ? sum.innerText : '');
              var c = el.cloneNode(true);
              var s = c.querySelector('summary');
              if (s) s.remove();
              var a2 = norm(c.innerText);
              if (q2 && !isJunk(a2)) items.push({ q: q2, a: a2 });
            }

            el = el.nextElementSibling;
          }
          return items;
        }

        function collectFromHeadings() {
          var out = [];
          Array.from(scope.querySelectorAll('h2,h3,h4')).forEach(function (h) {
            if (!looksLikeQuestion(h.textContent)) return;
            if (h.closest && h.closest(STOP_SEL)) return;
            var q = norm(h.textContent),
              a = collectAnswerFromHeading(h);
            if (q && a) out.push({ q: q, a: a });
          });
          return out;
        }

        function collectFromDLs() {
          var out = [];
          Array.from(scope.querySelectorAll('dl')).forEach(function (dl) {
            var nodes = Array.from(dl.children);
            for (var i = 0; i < nodes.length; i++) {
              var n = nodes[i];
              if (n.tagName === 'DT') {
                var dt = n;
                // find next dd sibling(s)
                var dd = dt.nextElementSibling;
                if (dd && dd.tagName === 'DD') {
                  var q = norm(dt.innerText),
                    a = norm(dd.innerText);
                  if (q && a && !isJunk(a)) out.push({ q: q, a: a });
                }
              }
            }
          });
          return out;
        }

        function collectFromDetails() {
          var out = [];
          Array.from(scope.querySelectorAll('details')).forEach(function (d) {
            var sum = d.querySelector('summary');
            if (sum) {
              var q = norm(sum.innerText);
              var c = d.cloneNode(true);
              var s = c.querySelector('summary');
              if (s) s.remove();
              var a = norm(c.innerText);
              if (q && a && !isJunk(a)) out.push({ q: q, a: a });
            }
          });
          return out;
        }

        function collectFAQs() {
          var all = [];

          // 1. Explicit FAQ sections (headings like "FAQs")
          var faqHeads = Array.from(scope.querySelectorAll('h1,h2,h3,h4')).filter(function (h) {
            return FAQ_LABEL.test(norm(h.textContent));
          });
          faqHeads.forEach(function (h) {
            all = all.concat(collectFromFAQSection(h));
          });

          // 2. dl/dt/dd pairs
          all = all.concat(collectFromDLs());

          // 3. details/summary
          all = all.concat(collectFromDetails());

          // 4. heading-based Q/A (fallback)
          all = all.concat(collectFromHeadings());

          // dedupe and filter
          var seen = new Set(),
            out = [];
          all.forEach(function (it) {
            var q = norm(it.q),
              a = norm(it.a);
            if (!q || !a) return;
            var key = q + '|' + a.slice(0, 180);
            if (!seen.has(key) && !isJunk(a)) {
              seen.add(key);
              out.push({ q: q, a: a });
            }
          });
          return out;
        }

        function addFAQ() {
          if (already('FAQPage')) return;
          var items = collectFAQs();
          if (!items.length) return;
          inject({
            '@context': 'https://schema.org',
            '@type': 'FAQPage',
            mainEntity: items.map(function (it) {
              return {
                '@type': 'Question',
                name: it.q.replace(/\?*$/, '?'),
                acceptedAnswer: { '@type': 'Answer', text: it.a },
              };
            }),
          });
        }

        // run once + observe short-lived mutations (for dynamic content)
        addFAQ();
        var obs = new MutationObserver(function () {
          addFAQ();
        });
        obs.observe(document.documentElement, { childList: true, subtree: true });
        setTimeout(function () {
          try {
            obs.disconnect();
          } catch (e) {}
        }, 12000);
      })();
    </script>

    <script>
      (function () {
        'use strict';

        function initConditionalLogic() {
          // Shopify Forms Shadow DOM के अंदर जाना है
          const formsEmbed = document.querySelector('shopify-forms-embed');
          if (!formsEmbed || !formsEmbed.shadowRoot) {
            console.log('Form अभी load नहीं हुआ, retry...');
            return false;
          }

          const shadowRoot = formsEmbed.shadowRoot;
          const form = shadowRoot.querySelector('form');
          if (!form) return false;

          // "Are You Sales Tax Exempt" के checkboxes find करो
          const yesCheckbox = form.querySelector('input[value="Yes"][name*="are_you_sales_tax_exempt"]');
          const noCheckbox = form.querySelector('input[value="No"][name*="are_you_sales_tax_exempt"]');

          // SALES TAX ID fields find करो
          const allFields = form.querySelectorAll('._formFieldContainer_1mxsl_5, ._formFileInput_ehvsf_1');
          let taxIdField = null;
          let uploadField = null;

          allFields.forEach((field) => {
            const label = field.querySelector('label, p');
            if (label) {
              const text = label.textContent.trim();
              if (text.includes('SALES TAX ID #')) {
                taxIdField = field;
              } else if (text.includes('Upload SALES TAX ID')) {
                uploadField = field;
              }
            }
          });

          if (!yesCheckbox || !noCheckbox) {
            console.log('Yes/No checkboxes नहीं मिले');
            return false;
          }

          if (!taxIdField || !uploadField) {
            console.log('⚠️ SALES TAX ID fields form में नहीं हैं - पहले उन्हें add करो!');
            return false;
          }

          // Toggle function
          function toggleFields() {
            if (yesCheckbox.checked) {
              // Yes है तो show करो
              taxIdField.style.display = 'block';
              uploadField.style.display = 'block';
            } else {
              // No है या कुछ select नहीं तो hide करो
              taxIdField.style.display = 'none';
              uploadField.style.display = 'none';
            }
          }

          // Event listeners
          yesCheckbox.addEventListener('change', toggleFields);
          noCheckbox.addEventListener('change', toggleFields);

          // Initial state
          toggleFields();

          console.log('✅ Conditional logic successfully initialized!');
          return true;
        }

        // Form load होने तक retry करो
        let attempts = 0;
        const maxAttempts = 20;

        const interval = setInterval(() => {
          attempts++;
          if (initConditionalLogic() || attempts >= maxAttempts) {
            clearInterval(interval);
            if (attempts >= maxAttempts) {
              console.log('❌ Form load नहीं हुआ या fields missing हैं');
            }
          }
        }, 500);
      })();
    </script>
    <script>
      // Replace small images with medium/large for better quality
      document.addEventListener('DOMContentLoaded', function () {
        const searchImages = document.querySelectorAll('#searchresults .result-image img');

        searchImages.forEach((img) => {
          if (img.src.includes('_small')) {
            // Replace _small with _medium for better quality
            img.src = img.src.replace('_small', '_medium');

            // Optional: Use _large for even better quality
            // img.src = img.src.replace('_small', '_large');
          }

          // Remove loading="lazy" for above-the-fold images
          if (img.loading === 'lazy') {
            const parent = img.closest('li');
            const position = Array.from(parent.parentElement.children).indexOf(parent);
            if (position < 5) {
              // First 5 images load immediately
              img.loading = 'eager';
            }
          }
        });
      });
    </script>
