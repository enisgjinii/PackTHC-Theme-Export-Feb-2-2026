{% comment %}
  ─────────────────────────────────────────────────
  PackTHC 3D Product Customizer — Embed Section
  ─────────────────────────────────────────────────
  Adds a "Customize in 3D" button on product pages
  that navigates to the customizer app as a new page,
  passing all product data as URL parameters.
{% endcomment %}

{%- liquid
  assign customizer_url = section.settings.customizer_url | default: 'https://jar-product-customizer.vercel.app'
  assign btn_text = section.settings.button_text | default: 'Customize in 3D'
  assign show_for_all = section.settings.show_for_all_products
  assign allowed_tag = section.settings.required_tag

  assign show_button = false
  if show_for_all
    assign show_button = true
  elsif allowed_tag != blank
    if product.tags contains allowed_tag
      assign show_button = true
    endif
  else
    assign show_button = true
  endif

  assign current_variant = product.selected_or_first_available_variant
  assign product_image = product.featured_image | image_url: width: 800
  assign encoded_title = product.title | url_encode
  assign encoded_vendor = product.vendor | url_encode
  assign encoded_price = current_variant.price | money_without_trailing_zeros | url_encode
  assign encoded_image = product_image | url_encode
  assign encoded_shop_name = shop.name | url_encode

  assign full_url = customizer_url | append: '?product=' | append: product.handle | append: '&product_id=' | append: product.id | append: '&variant_id=' | append: current_variant.id | append: '&title=' | append: encoded_title | append: '&sku=' | append: current_variant.sku | append: '&vendor=' | append: encoded_vendor | append: '&price=' | append: encoded_price | append: '&image=' | append: encoded_image | append: '&shop=' | append: shop.permanent_domain | append: '&shop_name=' | append: encoded_shop_name
-%}

{%- if show_button and product != blank -%}
  <style>
    .packthc-customize-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      width: 100%;
      padding: 16px 28px;
      margin-top: 16px;
      font-size: 15px;
      font-weight: 700;
      letter-spacing: 0.03em;
      text-transform: uppercase;
      color: #fff;
      background: linear-gradient(135deg, #1e3a5f 0%, #0f172a 100%);
      border: none;
      border-radius: 8px;
      cursor: pointer;
      text-decoration: none;
      transition: transform 0.15s, box-shadow 0.15s, background 0.2s;
    }
    .packthc-customize-link:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(15, 23, 42, 0.35);
      background: linear-gradient(135deg, #2563eb 0%, #1e3a5f 100%);
      color: #fff;
      text-decoration: none;
    }
    .packthc-customize-link:active {
      transform: translateY(0);
    }
    .packthc-customize-link svg {
      width: 22px;
      height: 22px;
      flex-shrink: 0;
    }
    .packthc-section {
      padding: 0 0 20px;
    }
  </style>

  <div class="packthc-section page-width">
    <a
      href="{{ full_url }}"
      class="packthc-customize-link"
      target="_blank"
      rel="noopener"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
        <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
        <line x1="12" y1="22.08" x2="12" y2="12"/>
      </svg>
      {{ btn_text }}
    </a>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "3D Product Customizer",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "customizer_url",
      "label": "Customizer App URL",
      "default": "https://jar-product-customizer.vercel.app",
      "info": "The full URL of your deployed jar-product-customizer app."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Customize in 3D"
    },
    {
      "type": "checkbox",
      "id": "show_for_all_products",
      "label": "Show for all products",
      "default": true,
      "info": "If unchecked, only show for products with the tag below."
    },
    {
      "type": "text",
      "id": "required_tag",
      "label": "Required product tag",
      "default": "customizable",
      "info": "Only show the button on products with this tag (when 'Show for all' is off)."
    }
  ],
  "presets": [
    {
      "name": "3D Product Customizer"
    }
  ]
}
{% endschema %}
