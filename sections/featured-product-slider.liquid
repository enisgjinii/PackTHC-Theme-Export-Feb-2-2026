{%- liquid
	assign section_id    = '#shopify-section-' | append: section.id
	assign animation     = settings.section_animation
	assign full          = section.settings.full
	assign image_width   = section.settings.image_width
	assign space_between = section.settings.space
	assign show_arrows   = section.settings.show_arrows
	assign show_dots     = section.settings.show_dots
	assign product       = section.settings.product
	assign content_width = section.settings.content_width
	assign button_type   = settings.select_button
-%}

<style>
	{{ section_id }} .section-wrapper {
		padding-top: {{ section.settings.padding_top_mobile }}px;
		padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
	}

	@media (min-width: 992px) {
		{{ section_id }} .featured-product-product {
			max-width: {{ content_width }}%;
			margin: 0 auto;
		}
	}

	@media (min-width: 992px) {
		{{ section_id }} .section-wrapper {
			padding-top: {{ section.settings.padding_top }}px;
			padding-bottom: {{ section.settings.padding_bottom }}px;
		}

		{{ section_id }} .product-gallery {
			width: {{ image_width }}%;
			margin-right: {{ space_between }}px;
		}

		{{ section_id }} .product-summary {
			display: flex;
			width: calc( {{ 100 | minus: image_width }}% - {{ space_between }}px );
		}

		{%- for block in section.blocks -%}
			{%- if block.type != 'collapsible-tab' and block.type != '@app' -%}
				{{ section_id }} [data-{{ block.id }}] {
					padding-bottom: {{ block.settings.padding_bottom }}px;
				}
			{%- endif -%}
			{%- if block.type == 'description' -%}
				{{ section_id }} [data-{{ block.id }}] {
					margin-bottom:{{ block.settings.padding_bottom }}px;
					padding-bottom: 0;
				}
			{%- endif -%}
		{%- endfor -%}
	}

	{%- for block in section.blocks -%}
		{%- if block.type != 'collapsible-tab' and block.type != '@app' -%}
			{{ section_id }} [data-{{ block.id }}] {
				padding-bottom: {{ block.settings.padding_bottom | times: 0.8 }}px;
			}
		{%- endif -%}

		{%- if block.type == 'description' -%}
			{{ section_id }} [data-{{ block.id }}] {
				margin-bottom:{{ block.settings.padding_bottom }}px;
				padding-bottom: 0;
			}
		{%- endif -%}

		{%- case block.type -%}
			{%- when 'divider' -%}
				{{ section_id }} [data-{{ block.id }}] .product-divider {
					height: {{ block.settings.height }}px;

					{%- if block.settings.color != blank -%}
						background-color: {{ block.settings.color }};
					{%- endif -%}
				}
			{%- when 'countdown' -%}
				{{ section_id }} [data-{{ block.id }}] .product-countdown {
					padding: {{ block.settings.padding }}px;

					{%- if block.settings.border != blank -%}
						border: 0.1rem solid {{ block.settings.border }};
					{%- endif -%}
				}
		{%- endcase -%}
	{%- endfor -%}
</style>

<div class="section-wrapper color-{{ section.settings.color_scheme }}">
	<div class="{% if full %}stretch-section stretch-padding{% else %}container{% endif %}">
		<div class="featured-product-product">
			<div class="product-gallery{% if animation %} scroll-trigger{% endif %}">
				<div class="carousel-swiper">
					<template data-options>
						{
							{%- if section.settings.loop -%}
								"loop": true,
							{%- endif -%}

							{%- if section.settings.autoplay -%}
								"autoplay": {
									"delay": {{ section.settings.delay | times: 1000 }},
									"disableOnInteraction": false,
									"pauseOnMouseEnter": true
								},
							{%- endif -%}

							{%- if show_arrows -%}
								"navigation": {
									"nextEl": "{{ section_id }} .swiper-button-next",
									"prevEl": "{{ section_id }} .swiper-button-prev"
								},
							{%- endif -%}

							{%- if show_dots -%}
								"pagination": {
									"el": "{{ section_id }} .swiper-pagination",
									"clickable": true
								},
							{%- endif -%}
							"pagination": {
								"el": "{{ section_id }} .swiper-pagination",
								"clickable": true
							},
							"autoHeight": true,
							"spaceBetween": 20,
							"speed": {{ section.settings.speed | times: 1000 }},
							"breakpoints": {
								"240": {
									"slidesPerView": 1,
									"spaceBetween": 15
								},
								"992": {
									"slidesPerView": 2
								}
							}
						}
					</template>
					<div class="swiper">
						<div class="swiper-wrapper">
							{% comment %} Gallery {% endcomment %}
							{% if product.images.size >= 2 %}
								{% for image in product.images %}
									<div class="swiper-slide">
										<img src="{{ image.src | image_url: width: 600, height: 600 }}" alt="{{ image.alt | escape }}" width="600" height="600">
									</div>
								{% endfor %}
							{% elsif product.images.size == 1 %}
								{% for image in product.images %}
									<div class="swiper-slide">
										<img src="{{ image.src | image_url: width: 600, height: 600 }}" alt="{{ image.alt | escape }}" width="600" height="600">
									</div>
									<div class="swiper-slide">
										<img src="{{ image.src | image_url: width: 600, height: 600 }}" alt="{{ image.alt | escape }}" width="600" height="600">
									</div>
									<div class="swiper-slide">
										<img src="{{ image.src | image_url: width: 600, height: 600 }}" alt="{{ image.alt | escape }}" width="600" height="600">
									</div>
								{% endfor %}
							{% else %}
								{%- for i in (1..4) -%}
									<div class="swiper-slide">
										{%- render 'product-card-placeholder-slider', index: forloop.index -%}
									</div>
								{% endfor %}
							{% endif %}
						</div>
					</div>

					{%- if show_arrows -%}
						<div class="swiper-controls {% if show_dots %} has-dots{% endif %}">
							<button class="swiper-button-prev" title ="{{ 'general.swipper.prev' | t }}" aria-label="{{ 'general.swipper.prev' | t }}" id="{{ 'general.swipper.prev' | t }}" aria-labelledby="{{ 'general.swipper.prev' | t }}">{%- render 'icon', code: 'arrow-left-small' -%}</button>
							<button class="swiper-button-next" title ="{{ 'general.swipper.next' | t }}" aria-label="{{ 'general.swipper.next' | t }}" id="{{ 'general.swipper.next' | t }}" aria-labelledby="{{ 'general.swipper.next' | t }}">{%- render 'icon', code: 'arrow-right-small' -%}</button>
						</div>
					{%- endif -%}

					{%- if show_dots -%}
						<div class="swiper-pagination" tabindex="-1"></div>
					{%- endif -%}
				</div>
			</div>
			{% comment %} Summary {% endcomment %}
			{%- assign alignment = 'text-' | append: section.settings.summary_horizontal_align | append: ' flex-align-' | append: section.settings.summary_vertical_align -%}

			{%- if product != blank -%}
				{%- render 'product-summary-slider', product: product, class: alignment -%}
			{%- else -%}
				<div class="product-summary text-center flex-align-center onboarding">
					<div class="product-summary-inner">
						<h6 class="product-vendor">
							{{- 'onboarding.products.vendor' | t -}}
						</h6>

						<h2 class="product-title h3">
							{{- 'onboarding.products.title' | t -}}
						</h2>

						<div class="product-price">
							{%- render 'price' -%}
						</div>

						<div class="item-field">
							<button class="button add-to-cart-button primary-button medium-button" disabled>{{- 'products.product.sold_out' | t -}}

							{% if settings.select_button == 'direction' %}
								{%- render 'icon', code: 'direction-button' -%}
							{% elsif settings.select_button == 'arrow' %}
								{%- render 'icon', code: 'arrow-button' -%}
							{% endif %}
							</button>
						</div>

						<div class="details-product">
							<a class="button link-underline" href="#">{{- 'products.product.view_full_detail' | t -}}</a>
							{% if button_type == 'direction' %}
								{%- render 'icon', code: 'direction-button' -%}
							{% elsif button_type == 'arrow' %}
								{%- render 'icon', code: 'arrow-button' -%}
							{% endif %}
						</div>

						<div class="product-description">
							{{- 'onboarding.products.description' | t -}}
						</div>
					</div>
				</div>
			{%- endif -%}
		</div>
	</div>
</div>

{% schema %}
{
	"name": "t:sections.featured-product-slider.name",
	"tag": "section",
	"class": "featured-product-slider-section",
	"disabled_on": {
		"groups": ["header", "footer"]
	},
	"settings": [
		{
			"type": "checkbox",
			"id": "full",
			"default": false,
			"label": "t:sections.featured-product-slider.settings.full.label"
		},
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"label": "t:settings_schema.colors.label",
			"default": "scheme-1"
		},
		{
			"type": "range",
			"id": "content_width",
			"default": 100,
			"min": 60,
			"max": 100,
			"step": 1,
			"unit": "%",
			"label": "t:general.dimensions.content_width.label"
		},
		{
			"type": "range",
			"id": "space",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 60,
			"unit": "px",
			"label": "t:sections.featured-product-slider.settings.space.label",
			"info": "t:sections.featured-product-slider.settings.space.info"
		},
		{
			"type": "product",
			"id": "product",
			"label": "t:sections.featured-product-slider.settings.product.label"
		},
		{
			"type": "header",
			"content": "t:sections.featured-product-slider.settings.header_image.content"
		},
		{
			"type": "range",
			"id": "image_width",
			"min": 30,
			"max": 70,
			"step": 1,
			"default": 66,
			"unit": "%",
			"label": "t:sections.featured-product-slider.settings.image_width.label"
		},
		{
			"type": "header",
			"content": "t:general.slider.options.label"
		},
		{
			"type": "checkbox",
			"id": "show_arrows",
			"default": true,
			"label": "t:general.slider.show_arrows.label"
		},
		{
			"type": "checkbox",
			"id": "show_dots",
			"default": false,
			"label": "t:general.slider.show_dots.label"
		},
		{
			"type": "checkbox",
			"id": "loop",
			"default": false,
			"label": "t:general.slider.loop.label"
		},
		{
			"type": "checkbox",
			"id": "autoplay",
			"default": false,
			"label": "t:general.slider.autoplay.label"
		},
		{
			"type": "range",
			"id": "delay",
			"default": 3,
			"min": 3,
			"max": 10,
			"step": 0.1,
			"label": "t:general.slider.delay.label"
		},
		{
			"type": "range",
			"id": "speed",
			"default": 0.5,
			"min": 0,
			"max": 2,
			"step": 0.1,
			"label": "t:general.slider.speed.label"
		},
		{
			"type": "header",
			"content": "t:sections.featured-product-slider.settings.header_summary.content"
		},
		{
			"type": "select",
			"id": "summary_vertical_align",
			"options": [
				{
					"value": "start",
					"label": "t:general.layout.vertical.option_1.label"
				},
				{
					"value": "center",
					"label": "t:general.layout.vertical.option_2.label"
				},
				{
					"value": "end",
					"label": "t:general.layout.vertical.option_3.label"
				}
			],
			"default": "center",
			"label": "t:general.layout.vertical.label"
		},
		{
			"type": "header",
			"content": "t:general.padding.header_padding.content"
		},
		{
			"type": "range",
			"id": "padding_top",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 50,
			"unit": "px",
			"label": "t:general.padding.top.label"
		},
		{
			"type": "range",
			"id": "padding_bottom",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 50,
			"unit": "px",
			"label": "t:general.padding.bottom.label"
		},
		{
			"type": "paragraph",
			"content": "t:general.padding.paragraph_mobile.content"
		},
		{
			"type": "range",
			"id": "padding_top_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 20,
			"unit": "px",
			"label": "t:general.padding.top.label"
		},
		{
			"type": "range",
			"id": "padding_bottom_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 20,
			"unit": "px",
			"label": "t:general.padding.bottom.label"
		}
	],
	"blocks": [
		{
			"type": "@app"
		},
		{
			"type": "text",
			"name": "t:sections.featured-product-slider.blocks.text.name",
			"settings": [
				{
					"type": "text",
					"id": "text",
					"default": "Text block",
					"label": "t:sections.featured-product-slider.blocks.text.settings.text.label"
				},
				{
					"type": "range",
					"id": "padding_bottom",
					"min": 0,
					"max": 100,
					"step": 1,
					"default": 20,
					"unit": "px",
					"label": "t:sections.featured-product-slider.settings.padding_bottom.label"
				}
			]
		},
		{
			"type": "button-link",
			"name": "t:sections.featured-product-slider.blocks.button-link.name",
			"settings": [
				{
					"type": "text",
					"id": "text",
					"default": "View Full Details",
					"label": "t:sections.featured-product-slider.blocks.button-link.settings.link.label"
				},
				{
					"type": "range",
					"id": "padding_bottom",
					"min": 0,
					"max": 100,
					"step": 1,
					"default": 20,
					"unit": "px",
					"label": "t:sections.featured-product-slider.settings.padding_bottom.label"
				}
			]
		},
		{
			"type": "vendor",
			"name": "t:sections.featured-product-slider.blocks.vendor.name",
			"limit": 1,
			"settings": [
				{
					"type": "range",
					"id": "padding_bottom",
					"min": 0,
					"max": 100,
					"step": 1,
					"default": 20,
					"unit": "px",
					"label": "t:sections.featured-product-slider.settings.padding_bottom.label"
				}
			]
		},
		{
			"type": "title",
			"name": "t:sections.featured-product-slider.blocks.title.name",
			"limit": 1,
			"settings": [
				{
					"type": "select",
					"id": "font_size",
					"options": [
						{
							"value": "h4",
							"label": "t:general.typography.heading_size.option_1.label"
						},
						{
							"value": "h3",
							"label": "t:general.typography.heading_size.option_2.label"
						},
						{
							"value": "h2",
							"label": "t:general.typography.heading_size.option_3.label"
						}
					],
					"default": "h3",
					"label": "t:general.typography.font_size.label"
				},
				{
					"type": "range",
					"id": "padding_bottom",
					"min": 0,
					"max": 100,
					"step": 1,
					"default": 20,
					"unit": "px",
					"label": "t:sections.featured-product-slider.settings.padding_bottom.label"
				}
			]
		},
		{
			"type": "pickup-availability",
			"name": "t:sections.featured-product-slider.blocks.pickup-availability.name",
			"limit": 1,
			"settings": [
				{
					"type": "paragraph",
					"content": "t:sections.featured-product-slider.blocks.pickup-availability.settings.info.content"
				},
				{
					"type": "range",
					"id": "padding_bottom",
					"min": 0,
					"max": 100,
					"step": 1,
					"default": 20,
					"unit": "px",
					"label": "t:sections.featured-product-slider.settings.padding_bottom.label"
				}
			]
		},
		{
			"type": "price",
			"name": "t:sections.featured-product-slider.blocks.price.name",
			"limit": 1,
			"settings": [
				{
					"type": "select",
					"id": "font_size",
					"options": [
						{
							"value": "h6",
							"label": "t:general.typography.heading_size.option_1.label"
						},
						{
							"value": "h5",
							"label": "t:general.typography.heading_size.option_2.label"
						},
						{
							"value": "h4",
							"label": "t:general.typography.heading_size.option_3.label"
						}
					],
					"default": "h5",
					"label": "t:general.typography.font_size.label"
				},
				{
					"type": "range",
					"id": "padding_bottom",
					"min": 0,
					"max": 100,
					"step": 1,
					"default": 20,
					"unit": "px",
					"label": "t:sections.featured-product-slider.settings.padding_bottom.label"
				}
			]
		},
		{
			"type": "add-to-cart",
			"name": "t:sections.featured-product-slider.blocks.add-to-cart.name",
			"limit": 1,
			"settings": [
				{
					"type": "select",
					"id": "text_transform",
					"options": [
						{
							"value": "none",
							"label": "t:sections.featured-product-slider.blocks.add-to-cart.settings.text_transform.options__1.label"
						},
						{
							"value": "uppercase",
							"label": "t:sections.featured-product-slider.blocks.add-to-cart.settings.text_transform.options__2.label"
						},
						{
							"value": "capitalize",
							"label": "t:sections.featured-product-slider.blocks.add-to-cart.settings.text_transform.options__3.label"
						}
					],
					"default": "capitalize",
					"label": "t:sections.featured-product-slider.blocks.add-to-cart.settings.text_transform.label"
				},
				{
					"type": "checkbox",
					"id": "quantity_selector",
					"default": true,
					"label": "t:sections.featured-product-slider.blocks.add-to-cart.settings.quantity_selector.label"
				},
				{
					"type": "checkbox",
					"id": "dynamic_checkout",
					"default": true,
					"label": "t:sections.featured-product-slider.blocks.add-to-cart.settings.dynamic_checkout.label",
					"info": "t:sections.featured-product-slider.blocks.add-to-cart.settings.dynamic_checkout.info"
				},
				{
					"type": "checkbox",
					"id": "show_gift_card",
					"default": true,
					"label": "t:sections.featured-product-slider.blocks.add-to-cart.settings.show_gift_card.label",
					"info": "t:sections.featured-product-slider.blocks.add-to-cart.settings.show_gift_card.info"
				},
				{
					"type": "range",
					"id": "padding_bottom",
					"min": 0,
					"max": 100,
					"step": 1,
					"default": 20,
					"unit": "px",
					"label": "t:sections.featured-product-slider.settings.padding_bottom.label"
				}
			]
		},
		{
			"type": "description",
			"name": "t:sections.featured-product-slider.blocks.description.name",
			"limit": 1,
			"settings": [
				{
					"type": "range",
					"id": "padding_bottom",
					"min": 0,
					"max": 100,
					"step": 1,
					"default": 28,
					"unit": "px",
					"label": "t:sections.featured-product-slider.settings.padding_bottom.label"
				}
			]
		},
		{
			"type": "custom-liquid",
			"name": "t:sections.featured-product-slider.blocks.custom-liquid.name",
			"settings": [
				{
					"type": "liquid",
					"id": "custom-liquid",
					"label": "t:sections.featured-product-slider.blocks.custom-liquid.settings.custom-liquid.label",
					"info": "t:sections.featured-product-slider.blocks.custom-liquid.settings.custom-liquid.info"
				},
				{
					"type": "range",
					"id": "padding_bottom",
					"min": 0,
					"max": 100,
					"step": 1,
					"default": 28,
					"unit": "px",
					"label": "t:sections.featured-product-slider.settings.padding_bottom.label"
				}
			]
		},
		{
			"type": "collapsible-tab",
			"name": "t:sections.featured-product-slider.blocks.collapsible-tab.name",
			"settings": [
				{
					"type": "inline_richtext",
					"id": "heading",
					"default": "Collapsible tab",
					"info": "t:sections.featured-product-slider.blocks.collapsible-tab.settings.heading.info",
					"label": "t:sections.featured-product-slider.blocks.collapsible-tab.settings.heading.label"
				},
				{
					"type": "select",
					"id": "font_size",
					"options": [
						{
							"value": "h5",
							"label": "t:general.typography.heading_size.option_1.label"
						},
						{
							"value": "h4",
							"label": "t:general.typography.heading_size.option_2.label"
						},
						{
							"value": "h3",
							"label": "t:general.typography.heading_size.option_3.label"
						}
					],
					"default": "h4",
					"label": "t:general.typography.heading_size.label"
				},
				{
					"type": "richtext",
					"id": "content",
					"label": "t:sections.featured-product-slider.blocks.collapsible-tab.settings.content.label"
				},
				{
