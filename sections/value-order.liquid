{% stylesheet %}
  .problems-solution-section {
    background-color: #ffffff;
    padding: 60px 40px;
    max-width: 1400px;
    margin: 0 auto;
  }

  .problems-solution-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }

  .problems-solution-left {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .problems-solution-item {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .problems-solution-value {
    flex-shrink: 0;
    min-width: 60px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .problems-solution-value__amount {
    font-size: 20px;
    font-weight: 800;
    color: #033770;
    line-height: 1;
    margin-bottom: 2px;
  }

  .problems-solution-value__label {
    font-size: 11px;
    font-weight: 600;
    color: #033770;
    text-transform: lowercase;
  }

  .problems-solution-text {
    flex: 1;
  }

  .problems-solution-text__title {
    font-size: 20px;
    font-weight: 600;
    color: #1f2937;
    line-height: 1.4;
  }

  .problems-solution-right {
    display: flex;
    flex-direction: column;
    gap: 32px;
    align-items: flex-start;
  }

  .problems-solution-right__title {
    font-size: 48px;
    font-weight: 800;
    line-height: 1.1;
    color: #1f2937;
  }

  .problems-solution-right__highlight {
    color: #033770;
  }

  .problems-solution-right__subtitle {
    font-size: 18px;
    font-weight: 600;
    color: #1f2937;
    margin-top: -16px;
  }

  .problems-solution-right__subtext {
    font-size: 16px;
    font-weight: 400;
    color: #6b7280;
    font-style: italic;
    margin-top: -8px;
  }

  .problems-solution-right__cta {
    background-color: #033770;
    color: white;
    padding: 16px 32px;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: background-color 0.3s ease;
    text-decoration: none;
    display: inline-block;
  }

  .problems-solution-right__cta:hover {
    background-color:#042e5a;
  }

  /* Tablet Responsive (1024px and below) */
  @media (max-width: 1024px) {
    .problems-solution-section {
      padding: 40px 32px;
    }

    .problems-solution-container {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .problems-solution-right__title {
      font-size: 36px;
    }
  }

  /* Mobile Large (768px and below) */
  @media (max-width: 768px) {
    .problems-solution-section {
      padding: 32px 20px;
    }

    .problems-solution-container {
      gap: 32px;
    }

    .problems-solution-left {
      gap: 20px;
    }

    .problems-solution-item {
      gap: 12px;
    }

    .problems-solution-value__amount {
      font-size: 18px;
    }

    .problems-solution-value__label {
      font-size: 10px;
    }

    .problems-solution-text__title {
      font-size: 18px;
    }

    .problems-solution-right__title {
      font-size: 32px;
    }

    .problems-solution-right__subtitle {
      font-size: 16px;
    }

    .problems-solution-right__subtext {
      font-size: 14px;
    }

    .problems-solution-right__cta {
      padding: 14px 28px;
      font-size: 13px;
    }
  }

  /* Mobile Small (480px and below) */
  @media (max-width: 480px) {
    .problems-solution-section {
      padding: 24px 16px;
    }

    .problems-solution-container {
      gap: 28px;
    }

    .problems-solution-left {
      gap: 18px;
    }

    .problems-solution-item {
      gap: 12px;
      flex-direction: column;
      align-items: flex-start;
    }

    .problems-solution-value {
      min-width: auto;
    }

    .problems-solution-value__amount {
      font-size: 16px;
    }

    .problems-solution-value__label {
      font-size: 9px;
    }

    .problems-solution-text__title {
      font-size: 16px;
    }

    .problems-solution-right__title {
      font-size: 28px;
    }

    .problems-solution-right__subtitle {
      font-size: 15px;
    }

    .problems-solution-right__subtext {
      font-size: 13px;
    }

    .problems-solution-right__cta {
      padding: 12px 24px;
      font-size: 12px;
      width: 100%;
      text-align: center;
    }
  }
{% endstylesheet %}

<div class="problems-solution-section">
  <div class="problems-solution-container">
    <div class="problems-solution-left">
      {% for block in section.blocks %}
        <div class="problems-solution-item">
          <div class="problems-solution-value">
            <div class="problems-solution-value__amount">${{ block.settings.value_amount }}</div>
            <div class="problems-solution-value__label">value</div>
          </div>
          <div class="problems-solution-text">
            <div class="problems-solution-text__title">{{ block.settings.problem_title }}</div>
          </div>
        </div>
      {% endfor %}
    </div>

    <div class="problems-solution-right">
      <h2 class="problems-solution-right__title">
        <span class="problems-solution-right__highlight">{{ section.settings.highlight_text }}</span>
        {{ section.settings.main_heading }}
      </h2>

      <div class="problems-solution-right__subtitle">
        {{ section.settings.subtitle_text }}
      </div>

      <div class="problems-solution-right__subtext">
        {{ section.settings.subtext }}
      </div>

      <a href="{{ section.settings.cta_link }}" class="problems-solution-right__cta">
        {{ section.settings.cta_text }}
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Value Orders",
  "settings": [
    {
      "type": "text",
      "id": "highlight_text",
      "label": "Highlighted Text (purple)",
      "default": "$5,000"
    },
    {
      "type": "text",
      "id": "main_heading",
      "label": "Main Heading (after highlight)",
      "default": "in added value on every order"
    },
    {
      "type": "text",
      "id": "subtitle_text",
      "label": "Subtitle",
      "default": "No platform fee. Pay only your unit price"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext (italic)",
      "default": "(Typically 15%+ below market rates)"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "COMPARE YOUR PRICES →"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Button Link"
    }
  ],
  "blocks": [
    {
      "type": "problem_item",
      "name": "Value Item",
      "settings": [
        {
          "type": "text",
          "id": "value_amount",
          "label": "Value Amount (without $)",
          "default": "1200"
        },
        {
          "type": "text",
          "id": "problem_title",
          "label": "Service Title",
          "default": "Service text here"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Value Orders",
      "settings": {
        "highlight_text": "$5,000",
        "main_heading": "in added value on every order",
        "subtitle_text": "No platform fee. Pay only your unit price",
        "subtext": "(Typically 15%+ below market rates)",
        "cta_text": "COMPARE YOUR PRICES →"
      },
      "blocks": [
        {"type": "problem_item", "settings": {"value_amount": "1200", "problem_title": "24/7 dedicated support"}},
        {"type": "problem_item", "settings": {"value_amount": "1100", "problem_title": "Insurance on every shipment"}},
        {"type": "problem_item", "settings": {"value_amount": "800", "problem_title": "3rd Party Inspection"}},
        {"type": "problem_item", "settings": {"value_amount": "600", "problem_title": "FREE packaging cost audit"}},
        {"type": "problem_item", "settings": {"value_amount": "700", "problem_title": "Compliance certifications"}},
        {"type": "problem_item", "settings": {"value_amount": "500", "problem_title": "Custom Sample Credit"}},
        {"type": "problem_item", "settings": {"value_amount": "100", "problem_title": "Priority production queue"}}
      ]
    }
  ]
}
{% endschema %}