        resultsContainer.style.display = 'none';
      }

      // Load product data
      function loadProductData(productHandle) {
        console.log('📦 Loading product data for:', productHandle);

        // Find product in all collections
        currentProduct = null;

        for (const collectionHandle in allProductsData) {
          const collection = allProductsData[collectionHandle];
          if (collection && collection.products) {
            const foundProduct = collection.products.find((p) => p.handle === productHandle);
            if (foundProduct) {
              currentProduct = foundProduct;
              console.log('✅ Product found:', currentProduct.title);
              break;
            }
          }
        }

        if (!currentProduct) {
          console.error('❌ Product not found:', productHandle);
          alert('Error: Product data not found');
          return;
        }

        // Update product image
        updateProductImage();

        // Parse pricing data from metafields
        parsePricingData();

        // Enable controls
        quantityInput.disabled = false;
        quantityInput.min = 1;
        quantityInput.value = 1;
        calculateBtn.disabled = false;

        // Auto-calculate
        calculatePrice();
      }

      // Update product image function
      function updateProductImage() {
