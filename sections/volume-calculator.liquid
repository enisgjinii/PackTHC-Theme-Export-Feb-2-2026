      }

      // Parse pricing data from metafields - UPDATED
      function parsePricingData() {
        console.log('💰 Parsing pricing data for:', currentProduct.title);

        const qtyData = currentProduct.qty_table;
        const unitData = currentProduct.unit_table;
        const priceData = currentProduct.price_table;

        console.log('Raw metafields:', {
          qtyData: qtyData,
          unitData: unitData,
          priceData: priceData,
        });

        // Parse arrays from metafields
        const quantities = parseMetafieldArray(qtyData);
        const unitPrices = parseMetafieldArray(unitData);
        const casePrices = parseMetafieldArray(priceData);

        console.log('Parsed arrays:', {
          quantities: quantities,
          unitPrices: unitPrices,
          casePrices: casePrices,
        });

        // Build pricing tiers
        pricingTiers = [];

        // Check if we have valid data
        if (quantities.length === 0 || casePrices.length === 0) {
          console.log('⚠️ No pricing data, using default price');

          // Create default tier
          pricingTiers = [
            {
              minQty: 1,
              maxQty: null,
              pricePerCase: currentProduct.price / 100,
              pricePerPiece: currentProduct.price / 100,
              description: '1 CASE+',
            },
          ];
        } else {
          // Build tiers from parsed data
          for (let i = 0; i < Math.min(quantities.length, casePrices.length); i++) {
            const qtyStr = String(quantities[i]).trim();
            const casePriceStr = String(casePrices[i]).trim();

            // Get unit price if available, otherwise use 0
            let unitPriceStr = '';
            if (i < unitPrices.length) {
              unitPriceStr = String(unitPrices[i]).trim();
            }

            // Extract quantity range
            let minQty = 1;
            let maxQty = null;
            let description = qtyStr;

            if (qtyStr.includes('-')) {
              const parts = qtyStr.split('-');
              minQty = parseInt(parts[0].replace(/[^0-9]/g, '')) || 1;
              const secondPart = parts[1].replace(/[^0-9]/g, '');
              maxQty = secondPart ? parseInt(secondPart) : null;
            } else if (qtyStr.includes('+')) {
              minQty = parseInt(qtyStr.replace(/[^0-9]/g, '')) || 1;
              maxQty = null;
              description = `${minQty} CASES+`;
            } else {
              minQty = parseInt(qtyStr.replace(/[^0-9]/g, '')) || 1;
              // Try to get max from next tier
              if (i < quantities.length - 1) {
                const nextQtyStr = String(quantities[i + 1]).trim();
                if (nextQtyStr.includes('-')) {
                  maxQty = parseInt(nextQtyStr.split('-')[0].replace(/[^0-9]/g, '')) - 1 || null;
                }
              }
            }

            // Extract prices
            const pricePerCase = parseFloat(casePriceStr.replace(/[^0-9.]/g, '')) || 0;

            // Price per piece comes directly from unit_table (custom.unit_price)
            let pricePerPiece = 0;
            if (unitPriceStr) {
              pricePerPiece = parseFloat(unitPriceStr.replace(/[^0-9.]/g, '')) || 0;
            }

            console.log(`Tier ${i}:`, {
              description,
              minQty,
              maxQty,
              pricePerCase,
              pricePerPiece: pricePerPiece || 'Not set in unit_table',
            });

            pricingTiers.push({
              minQty: minQty,
              maxQty: maxQty,
              pricePerCase: pricePerCase,
              pricePerPiece: pricePerPiece, // Direct from unit_table
              description: description,
            });
          }
        }

        console.log('✅ Final pricing tiers:', pricingTiers);
      }

      // Helper function to parse metafield arrays
      function parseMetafieldArray(data) {
        if (!data || data === '' || data === '[]' || data === '""') {
          return [];
        }

        // If it's already an array
        if (Array.isArray(data)) {
          return data.map((item) => String(item).trim()).filter((item) => item !== '');
        }

        // If it's a string
        if (typeof data === 'string') {
          // Try to parse as JSON first
          try {
            const parsed = JSON.parse(data);
            if (Array.isArray(parsed)) {
              return parsed.map((item) => String(item).trim()).filter((item) => item !== '');
            }
          } catch (e) {
            // If not JSON, split by comma
            return data
              .split(',')
              .map((item) => item.trim())
              .filter((item) => item !== '');
          }
        }

        return [];
      }

      // Calculate price based on quantity - UPDATED
      function calculatePrice() {
        console.log('🧮 Calculating price...');

        const quantity = parseInt(quantityInput.value) || 1;

        if (quantity < 1) {
          quantityInput.value = 1;
          return;
        }

        if (!currentProduct) {
          console.error('❌ No product selected');
          return;
        }

        if (pricingTiers.length === 0) {
          console.error('❌ No pricing tiers available');
          alert('Pricing information not available for this product');
          return;
        }

        // Find applicable tier
        let applicableTier = null;
        for (const tier of pricingTiers) {
          if (quantity >= tier.minQty && (tier.maxQty === null || quantity <= tier.maxQty)) {
            applicableTier = tier;
            break;
          }
        }

        // If no tier found, use last tier
        if (!applicableTier) {
          applicableTier = pricingTiers[pricingTiers.length - 1];
        }

        console.log('💰 Applicable tier:', applicableTier);

        // Calculate total price
        const totalPrice = quantity * applicableTier.pricePerCase;
        const pricePerPiece = applicableTier.pricePerPiece;

        // Update summary - FIXED: Use pricePerPiece from tier directly
        if (totalPriceEl) totalPriceEl.textContent = formatCurrency(totalPrice);
        if (pricePerCaseEl) pricePerCaseEl.textContent = formatCurrency(applicableTier.pricePerCase);
        if (pricePerPieceEl) pricePerPieceEl.textContent = formatCurrency(pricePerPiece);

        // Render pricing table
        renderPricingTable(quantity);

        // Show results and enable action buttons
        resultsContainer.style.display = 'block';
        addToCartBtn.disabled = false;
        buyNowBtn.disabled = false;

        // Smooth scroll to results
        setTimeout(() => {
          resultsContainer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }, 100);

        console.log('✅ Calculation complete');
      }

      // Render pricing table - UPDATED
      function renderPricingTable(currentQty) {
        console.log('📊 Rendering pricing table...');

        if (!pricingTableBody) {
          console.error('❌ Pricing table body not found');
          return;
        }

        pricingTableBody.innerHTML = '';

        if (pricingTiers.length === 0) {
          pricingTableBody.innerHTML =
            '<tr><td colspan="3" style="text-align: center; padding: 20px;">No pricing information available</td></tr>';
          return;
        }

        pricingTiers.forEach((tier) => {
          const row = document.createElement('tr');

          // Check if this tier is active for current quantity
          const isActive = currentQty >= tier.minQty && (tier.maxQty === null || currentQty <= tier.maxQty);

          if (isActive) {
            row.classList.add('active-tier');
          }

          // Create quantity cell
          const qtyCell = document.createElement('td');
          qtyCell.textContent = tier.description;
          if (isActive) {
            qtyCell.innerHTML = `<strong>${tier.description}</strong>`;
          }

          // Create price per case cell
          const casePriceCell = document.createElement('td');
          casePriceCell.textContent = formatCurrency(tier.pricePerCase);

          // Create price per piece cell - DIRECT FROM unit_table
          const piecePriceCell = document.createElement('td');
          // If pricePerPiece is 0, it means unit_table was empty
          if (tier.pricePerPiece > 0) {
            piecePriceCell.textContent = formatCurrency(tier.pricePerPiece);
          } else {
            piecePriceCell.textContent = 'N/A';
            piecePriceCell.style.color = '#999';
          }

          row.appendChild(qtyCell);
          row.appendChild(casePriceCell);
          row.appendChild(piecePriceCell);

          pricingTableBody.appendChild(row);
        });

        console.log(`✅ Rendered ${pricingTiers.length} pricing tiers`);
      }

      // Add to cart function
      async function handleAddToCart() {
        const quantity = parseInt(quantityInput.value) || 1;

        if (!currentProduct || !currentProduct.variant_id) {
          alert('Please select a product first');
          return;
        }

        // Disable button and show loading
        const originalText = addToCartBtn.textContent;
        addToCartBtn.textContent = 'Adding...';
        addToCartBtn.disabled = true;

        try {
          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              items: [
                {
                  id: currentProduct.variant_id,
                  quantity: quantity,
                },
              ],
            }),
          });

          if (!response.ok) {
            throw new Error('Failed to add to cart');
          }

          const result = await response.json();

          // Success
          addToCartBtn.textContent = 'Added!';
          addToCartBtn.style.backgroundColor = '#4CAF50';

          // Update cart count
          updateCartCount();

          setTimeout(() => {
            window.location.href = '/cart';
          }, 500);
          /*
          // Reset button after 2 seconds
          setTimeout(() => {
            addToCartBtn.textContent = originalText;
            addToCartBtn.style.backgroundColor = '';
            addToCartBtn.disabled = false;
          }, 2000);
          */
        } catch (error) {
          console.error('Error adding to cart:', error);
          alert('Failed to add item to cart. Please try again.');

          // Reset button
          addToCartBtn.textContent = originalText;
          addToCartBtn.disabled = false;
        }
      }

      // Buy now function
      async function handleBuyNow() {
        const quantity = parseInt(quantityInput.value) || 1;

        if (!currentProduct || !currentProduct.variant_id) {
          alert('Please select a product first');
          return;
        }

        // Disable button and show loading
        const originalText = buyNowBtn.textContent;
        buyNowBtn.textContent = 'Processing...';
        buyNowBtn.disabled = true;

        try {
          // First add to cart
          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              items: [
                {
                  id: currentProduct.variant_id,
                  quantity: quantity,
                },
              ],
            }),
          });

          if (!response.ok) {
            throw new Error('Failed to add to cart');
          }

          // Then redirect to checkout
          window.location.href = '/cart';
        } catch (error) {
          console.error('Error in buy now:', error);
          alert('Failed to process order. Please try again.');

          // Reset button
          buyNowBtn.textContent = originalText;
          buyNowBtn.disabled = false;
        }
      }

      // Update cart count
      function updateCartCount() {
        // Try to update cart count if theme has cart count element
        const cartCountElements = document.querySelectorAll('.cart-count, #CartCount, .header__cart-count');
        if (cartCountElements.length > 0) {
          fetch('/cart.js')
            .then((response) => response.json())
            .then((cart) => {
              cartCountElements.forEach((el) => {
                el.textContent = cart.item_count;
              });
            })
            .catch(console.error);
        }
      }
      quantityInput.addEventListener('input', function () {
        const s = JSON.parse(localStorage.getItem(`vc_${sectionId}`) || '{}');
        localStorage.setItem(`vc_${sectionId}`, JSON.stringify({ ...s, qty: this.value })); // ADD
        if (currentProduct && resultsContainer.style.display === 'block') calculatePrice();
      });

      // Reset form
      function resetForm() {
        productSelect.innerHTML = '<option value="">Select a collection first...</option>';
        productSelect.disabled = true;
        quantityInput.disabled = true;
        quantityInput.value = 1;
        calculateBtn.disabled = true;
        resultsContainer.style.display = 'none';
        addToCartBtn.disabled = true;
        buyNowBtn.disabled = true;
        currentProduct = null;
        pricingTiers = [];
      }

      // Format currency
      function formatCurrency(amount) {
        if (isNaN(amount) || amount === 0) return '$0.00';
        return '$' + amount.toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,');
      }

      // Public API for debugging
      window.volumeCalculatorDebug = {
        getState: () => ({
          currentProduct,
          pricingTiers,
          allProductsData: Object.keys(allProductsData),
        }),
        forceCalculate: () => calculatePrice(),
        loadCollection: (handle) => loadProductsForCollection(handle),
      };

      console.log('✅ Volume Calculator initialized successfully');
    })();
  </script>
