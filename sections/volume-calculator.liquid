          // Build card HTML
          card.innerHTML = `
      <div class="volume-calculator__product-card-check">✓</div>
      ${imageHTML}
      <div class="volume-calculator__product-card-content">
        <div class="volume-calculator__product-card-title">${product.title}</div>
        ${stockHTML}
        ${unitPriceHTML || casePriceHTML ? '<div class="volume-calculator__product-card-pricing">' : ''}
          ${unitPriceHTML}
          ${casePriceHTML}
        ${unitPriceHTML || casePriceHTML ? '</div>' : ''}
      </div>
