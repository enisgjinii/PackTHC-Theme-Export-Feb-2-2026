          productImage.src = currentProduct.image_url;
          productImage.alt = currentProduct.image_alt || currentProduct.title;
          productImage.style.display = 'block';
          noImageMessage.style.display = 'none';
          console.log('✅ Image loaded:', currentProduct.image_url);
        } else {
          productImage.style.display = 'none';
          noImageMessage.style.display = 'flex';
          console.log('ℹ️ No image available for product');
        }
      }

      // Select product card
      function selectProductCard(cardElement, handle) {
        // Remove previous selection
        if (selectedProductCard) {
          selectedProductCard.classList.remove('selected');
        }

        // Add new selection
        cardElement.classList.add('selected');
        selectedProductCard = cardElement;

        // Update native select
        productSelect.value = handle;

        // Load product data
        loadProductData(handle);

        // Scroll to quantity input
        setTimeout(() => {
          quantityInput.focus();
          quantityInput.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }, 300);

        loadProductData(handle);

        const s = JSON.parse(localStorage.getItem(`vc_${sectionId}`) || '{}');
        localStorage.setItem(`vc_${sectionId}`, JSON.stringify({ ...s, prod: handle })); // ADD

        setTimeout(() => {
          /* scroll code */
        }, 300);
      }

      // Reset form function में image reset add करें
      function resetForm() {
        productSelect.innerHTML = '<option value="">Select a collection first...</option>';
        productSelect.disabled = true;

        productGrid.innerHTML = `
    <div class="volume-calculator__product-grid-empty">
      Please select a collection first
    </div>
  `;

  // Reset search
if (productSearchInput) {
  productSearchInput.value = '';
}

        selectedProductCard = null;

        quantityInput.disabled = true;
        quantityInput.value = 1;
        calculateBtn.disabled = true;
