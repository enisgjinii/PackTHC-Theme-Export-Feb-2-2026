      // Close dropdown on outside click
      document.addEventListener('click', function (e) {
        if (!e.target.closest('.volume-calculator__custom-select')) {
          productSelectStyled.classList.remove('active');
          productSelectOptions.classList.remove('show');
        }
      });

      // Select product function
      function selectProduct(handle, title) {
        // Update native select
        productSelect.value = handle;

        // Update styled select
        productSelectStyled.textContent = title;
        productSelectStyled.classList.remove('active');
        productSelectOptions.classList.remove('show');

        // Load product data
