{% comment %}
Shopify section: Gift Grid (5 tiles)
Matches layout from reference image:
- 1 large left tile
- 2 center stacked tiles
- 2 right stacked tiles
{% endcomment %}

<section class="gift-grid-section" data-section-id="gift-grid-{{ section.id }}">
  <style>
    .gift-grid-section { padding: 40px; }
    .gift-grid { display: grid; grid-template-columns: 48% 26% 26%; gap: 16px; align-items: stretch; width: 100%; }
    .gift-grid__left { border-radius: 12px; overflow: hidden; position: relative; background: #1a1a1a; width: 100%}
    .gift-grid__center, .gift-grid__right { display: grid; grid-template-rows: 1fr 1fr; gap: 16px; }
    .tile { position: relative; border-radius: 12px; overflow: hidden; background: #333; }
    .tile__img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .tile__content { position: absolute; left: 20px; top: 20px; z-index: 2; color: #fff; text-shadow: 0 3px 10px rgba(0,0,0,0.4); }
    .tile__content h2, .tile__content h3, .tile__content strong { color: #fff; margin: 0; }
    .gift-grid .btn { display: inline-block; margin-top: 10px; padding: 8px 16px; border-radius: 20px; background: #fff; color: #111; text-decoration: none; font-weight: 600; }
    @media (max-width: 900px) {
      .gift-grid-section { padding: 15px; }
      .gift-grid { grid-template-columns: 1fr; }
      .gift-grid__left { height: auto; }
      .gift-grid__center, .gift-grid__right { grid-template-rows: auto auto; }
    }
  </style>

  <div class="gift-grid">
    <!-- LEFT large -->
    <div class="gift-grid__left tile">
      {% if section.settings.image_large %}
        {% if section.settings.product_large != blank %}
          {% assign tp = all_products[section.settings.product_large] %}
          {% assign tc = collections[section.settings.collection_large] %}
          {% if tp %}
            {% if tc %}
              {% assign target_href = "/pages/collection-acrylic-boxes" %}
            {% else %}
              {% assign target_href = "/pages/collection-acrylic-boxes" %}
            {% endif %}
            <a href="{{ target_href }}" class="pcg-product-link" data-target-href="{{ target_href }}" data-product-handle="{{ tp.handle }}" data-collection-handle="{% if tc %}{{ tc.handle }}{% endif %}">
              <img src="{{ section.settings.image_large | img_url: '2048x2048' }}" alt="{{ section.settings.image_large_alt }}" class="tile__img" width="2048" height="2048" />
            </a>
          {% else %}
            {% if section.settings.link_large != blank %}
              <a href="{{ section.settings.link_large }}" class="pcg-product-link" data-target-href="{{ section.settings.link_large }}">
                <img src="{{ section.settings.image_large | img_url: '2048x2048' }}" alt="{{ section.settings.image_large_alt }}" class="tile__img" width="2048" height="2048" />
              </a>
            {% else %}
              <img src="{{ section.settings.image_large | img_url: '2048x2048' }}" alt="{{ section.settings.image_large_alt }}" class="tile__img" width="2048" height="2048" />
            {% endif %}
          {% endif %}
        {% elsif section.settings.link_large != blank %}
          <a href="{{ section.settings.link_large }}" class="pcg-product-link" data-target-href="{{ section.settings.link_large }}">
            <img src="{{ section.settings.image_large | img_url: '2048x2048' }}" alt="{{ section.settings.image_large_alt }}" class="tile__img" width="2048" height="2048" />
          </a>
        {% else %}
          <img src="{{ section.settings.image_large | img_url: '2048x2048' }}" alt="{{ section.settings.image_large_alt }}" class="tile__img" width="2048" height="2048" />
        {% endif %}
      {% endif %}
      <div class="tile__content">
        <h2>{{ section.settings.title_large }}</h2>
        {% if section.settings.link_large != blank %}<a href="{{ section.settings.link_large }}" class="btn">{{ section.settings.link_text_large }}</a>{% endif %}
      </div>
    </div>

    <!-- CENTER top -->
    <div class="gift-grid__center">
      <div class="tile">
        {% if section.settings.image_center_top %}
          {% if section.settings.product_center_top != blank %}
            {% assign tp = all_products[section.settings.product_center_top] %}
            {% assign tc = collections[section.settings.collection_center_top] %}
            {% if tp %}
              {% if tc %}
                {% assign target_href = "/pages/collection-pop-top-tube" %}
              {% else %}
                {% assign target_href = "/pages/collection-pop-top-tube" %}
              {% endif %}
              <a href="{{ target_href }}" class="pcg-product-link" data-target-href="{{ target_href }}" data-product-handle="{{ tp.handle }}" data-collection-handle="{% if tc %}{{ tc.handle }}{% endif %}">
                <img src="{{ section.settings.image_center_top | img_url: '1024x1024' }}" alt="{{ section.settings.image_center_top_alt }}" class="tile__img" width="1024" height="1024" />
              </a>
            {% else %}
              {% if section.settings.link_center_top != blank %}
                <a href="{{ section.settings.link_center_top }}" class="pcg-product-link" data-target-href="{{ section.settings.link_center_top }}">
                  <img src="{{ section.settings.image_center_top | img_url: '1024x1024' }}" alt="{{ section.settings.image_center_top_alt }}" class="tile__img" width="1024" height="1024" />
                </a>
              {% else %}
                <img src="{{ section.settings.image_center_top | img_url: '1024x1024' }}" alt="{{ section.settings.image_center_top_alt }}" class="tile__img" width="1024" height="1024" />
              {% endif %}
            {% endif %}
          {% elsif section.settings.link_center_top != blank %}
            <a href="{{ section.settings.link_center_top }}" class="pcg-product-link" data-target-href="{{ section.settings.link_center_top }}">
              <img src="{{ section.settings.image_center_top | img_url: '1024x1024' }}" alt="{{ section.settings.image_center_top_alt }}" class="tile__img" width="1024" height="1024" />
            </a>
          {% else %}
            <img src="{{ section.settings.image_center_top | img_url: '1024x1024' }}" alt="{{ section.settings.image_center_top_alt }}" class="tile__img" width="1024" height="1024" />
          {% endif %}
        {% endif %}
        <div class="tile__content">
          <strong>{{ section.settings.title_center_top }}</strong><br>
          {% if section.settings.link_center_top != blank %}<a href="{{ section.settings.link_center_top }}" class="btn">{{ section.settings.link_text_center_top }}</a>{% endif %}
        </div>
      </div>

      <!-- CENTER bottom -->
      <div class="tile">
        {% if section.settings.image_center_bottom %}
          {% if section.settings.product_center_bottom != blank %}
            {% assign tp = all_products[section.settings.product_center_bottom] %}
            {% assign tc = collections[section.settings.collection_center_bottom] %}
            {% if tp %}
              {% if tc %}
                {% assign target_href = "/pages/collection-mylar-bags" %}
              {% else %}
                {% assign target_href = "/pages/collection-mylar-bags" %}
              {% endif %}
              <a href="{{ target_href }}" class="pcg-product-link" data-target-href="{{ target_href }}" data-product-handle="{{ tp.handle }}" data-collection-handle="{% if tc %}{{ tc.handle }}{% endif %}">
                <img src="{{ section.settings.image_center_bottom | img_url: '1024x1024' }}" alt="{{ section.settings.image_center_bottom_alt }}" class="tile__img" width="1024" height="1024" />
              </a>
            {% else %}
              {% if section.settings.link_center_bottom != blank %}
                <a href="{{ section.settings.link_center_bottom }}" class="pcg-product-link" data-target-href="{{ section.settings.link_center_bottom }}">
                  <img src="{{ section.settings.image_center_bottom | img_url: '1024x1024' }}" alt="{{ section.settings.image_center_bottom_alt }}" class="tile__img" width="1024" height="1024" />
                </a>
              {% else %}
                <img src="{{ section.settings.image_center_bottom | img_url: '1024x1024' }}" alt="{{ section.settings.image_center_bottom_alt }}" class="tile__img" width="1024" height="1024" />
              {% endif %}
            {% endif %}
          {% elsif section.settings.link_center_bottom != blank %}
            <a href="{{ section.settings.link_center_bottom }}" class="pcg-product-link" data-target-href="{{ section.settings.link_center_bottom }}">
              <img src="{{ section.settings.image_center_bottom | img_url: '1024x1024' }}" alt="{{ section.settings.image_center_bottom_alt }}" class="tile__img" width="1024" height="1024" />
            </a>
          {% else %}
            <img src="{{ section.settings.image_center_bottom | img_url: '1024x1024' }}" alt="{{ section.settings.image_center_bottom_alt }}" class="tile__img" width="1024" height="1024" />
          {% endif %}
        {% endif %}
        <div class="tile__content">
          <strong>{{ section.settings.title_center_bottom }}</strong><br>
          {% if section.settings.link_center_bottom != blank %}<a href="{{ section.settings.link_center_bottom }}" class="btn">{{ section.settings.link_text_center_bottom }}</a>{% endif %}
        </div>
      </div>
    </div>

    <!-- RIGHT top -->
    <div class="gift-grid__right">
      <div class="tile">
        {% if section.settings.image_right_top %}
          {% if section.settings.product_right_top != blank %}
            {% assign tp = all_products[section.settings.product_right_top] %}
            {% assign tc = collections[section.settings.collection_right_top] %}
            {% if tp %}
              {% if tc %}
                {% assign target_href = "/pages/collection-pop-top-tube" %}
              {% else %}
                {% assign target_href = "/pages/collection-pop-top-tube" %}
              {% endif %}
              <a href="{{ target_href }}" class="pcg-product-link" data-target-href="{{ target_href }}" data-product-handle="{{ tp.handle }}" data-collection-handle="{% if tc %}{{ tc.handle }}{% endif %}">
                <img src="{{ section.settings.image_right_top | img_url: '1024x1024' }}" alt="{{ section.settings.image_right_top_alt }}" class="tile__img" width="1024" height="1024" />
              </a>
            {% else %}
              {% if section.settings.link_right_top != blank %}
                <a href="{{ section.settings.link_right_top }}" class="pcg-product-link" data-target-href="{{ section.settings.link_right_top }}">
                  <img src="{{ section.settings.image_right_top | img_url: '1024x1024' }}" alt="{{ section.settings.image_right_top_alt }}" class="tile__img" width="1024" height="1024" />
                </a>
              {% else %}
                <img src="{{ section.settings.image_right_top | img_url: '1024x1024' }}" alt="{{ section.settings.image_right_top_alt }}" class="tile__img" width="1024" height="1024" />
              {% endif %}
            {% endif %}
          {% elsif section.settings.link_right_top != blank %}
            <a href="{{ section.settings.link_right_top }}" class="pcg-product-link" data-target-href="{{ section.settings.link_right_top }}">
              <img src="{{ section.settings.image_right_top | img_url: '1024x1024' }}" alt="{{ section.settings.image_right_top_alt }}" class="tile__img" width="1024" height="1024" />
            </a>
          {% else %}
            <img src="{{ section.settings.image_right_top | img_url: '1024x1024' }}" alt="{{ section.settings.image_right_top_alt }}" class="tile__img" width="1024" height="1024" />
          {% endif %}
        {% endif %}
        <div class="tile__content">
          <strong>{{ section.settings.title_right_top }}</strong><br>
          {% if section.settings.link_right_top != blank %}<a href="{{ section.settings.link_right_top }}" class="btn">{{ section.settings.link_text_right_top }}</a>{% endif %}
        </div>
      </div>

      <!-- RIGHT bottom -->
      <div class="tile">
        {% if section.settings.image_right_bottom %}
          {% if section.settings.product_right_bottom != blank %}
            {% assign tp = all_products[section.settings.product_right_bottom] %}
            {% assign tc = collections[section.settings.collection_right_bottom] %}
            {% if tp %}
              {% if tc %}
                {% assign target_href = "/pages/collection-grinder-glass-jars" %}
              {% else %}
                {% assign target_href = "/pages/collection-grinder-glass-jars" %}
              {% endif %}
              <a href="{{ target_href }}" class="pcg-product-link" data-target-href="{{ target_href }}" data-product-handle="{{ tp.handle }}" data-collection-handle="{% if tc %}{{ tc.handle }}{% endif %}">
                <img src="{{ section.settings.image_right_bottom | img_url: '1024x1024' }}" alt="{{ section.settings.image_right_bottom_alt }}" class="tile__img" width="1024" height="1024" />
              </a>
            {% else %}
              {% if section.settings.link_right_bottom != blank %}
                <a href="{{ section.settings.link_right_bottom }}" class="pcg-product-link" data-target-href="{{ section.settings.link_right_bottom }}">
                  <img src="{{ section.settings.image_right_bottom | img_url: '1024x1024' }}" alt="{{ section.settings.image_right_bottom_alt }}" class="tile__img" width="1024" height="1024" />
                </a>
              {% else %}
                <img src="{{ section.settings.image_right_bottom | img_url: '1024x1024' }}" alt="{{ section.settings.image_right_bottom_alt }}" class="tile__img" width="1024" height="1024" />
              {% endif %}
            {% endif %}
          {% elsif section.settings.link_right_bottom != blank %}
            <a href="{{ section.settings.link_right_bottom }}" class="pcg-product-link" data-target-href="{{ section.settings.link_right_bottom }}">
              <img src="{{ section.settings.image_right_bottom | img_url: '1024x1024' }}" alt="{{ section.settings.image_right_bottom_alt }}" class="tile__img" width="1024" height="1024" />
            </a>
          {% else %}
            <img src="{{ section.settings.image_right_bottom | img_url: '1024x1024' }}" alt="{{ section.settings.image_right_bottom_alt }}" class="tile__img" width="1024" height="1024" />
          {% endif %}
        {% endif %}
        <div class="tile__content">
          <strong>{{ section.settings.title_right_bottom }}</strong><br>
          {% if section.settings.link_right_bottom != blank %}<a href="{{ section.settings.link_right_bottom }}" class="btn">{{ section.settings.link_text_right_bottom }}</a>{% endif %}
        </div>
      </div>
    </div>
  </div>

  {% schema %}
  {
    "name": "Gift grid (5 tiles)",
    "settings": [
      { "type": "image_picker", "id": "image_large", "label": "Large left image" },
      { "type": "text", "id": "image_large_alt", "label": "Large image alt text" },
      { "type": "text", "id": "title_large", "label": "Large tile heading", "default": "Gifts for her" },
      { "type": "url", "id": "link_large", "label": "Large tile link" },
      { "type": "text", "id": "link_text_large", "label": "Large link text", "default": "Shop now" },
      { "type": "product", "id": "product_large", "label": "Large tile: Product (optional)" },
      { "type": "collection", "id": "collection_large", "label": "Large tile: Collection (optional)" },

      { "type": "image_picker", "id": "image_center_top", "label": "Center top image" },
      { "type": "text", "id": "image_center_top_alt", "label": "Center top alt text" },
      { "type": "text", "id": "title_center_top", "label": "Center top title", "default": "Gifts for the kiddos" },
      { "type": "url", "id": "link_center_top", "label": "Center top link" },
      { "type": "text", "id": "link_text_center_top", "label": "Center top link text", "default": "Shop now" },
      { "type": "product", "id": "product_center_top", "label": "Center top: Product (optional)" },
      { "type": "collection", "id": "collection_center_top", "label": "Center top: Collection (optional)" },

      { "type": "image_picker", "id": "image_center_bottom", "label": "Center bottom image" },
      { "type": "text", "id": "image_center_bottom_alt", "label": "Center bottom alt text" },
      { "type": "text", "id": "title_center_bottom", "label": "Center bottom title", "default": "Gifts for teens" },
      { "type": "url", "id": "link_center_bottom", "label": "Center bottom link" },
      { "type": "text", "id": "link_text_center_bottom", "label": "Center bottom link text", "default": "Shop now" },
      { "type": "product", "id": "product_center_bottom", "label": "Center bottom: Product (optional)" },
      { "type": "collection", "id": "collection_center_bottom", "label": "Center bottom: Collection (optional)" },

      { "type": "image_picker", "id": "image_right_top", "label": "Right top image" },
      { "type": "text", "id": "image_right_top_alt", "label": "Right top alt text" },
      { "type": "text", "id": "title_right_top", "label": "Right top title", "default": "Baby & toddler gifts" },
      { "type": "url", "id": "link_right_top", "label": "Right top link" },
      { "type": "text", "id": "link_text_right_top", "label": "Right top link text", "default": "Shop now" },
      { "type": "product", "id": "product_right_top", "label": "Right top: Product (optional)" },
      { "type": "collection", "id": "collection_right_top", "label": "Right top: Collection (optional)" },

      { "type": "image_picker", "id": "image_right_bottom", "label": "Right bottom image" },
      { "type": "text", "id": "image_right_bottom_alt", "label": "Right bottom alt text" },
      { "type": "text", "id": "title_right_bottom", "label": "Right bottom title", "default": "Gifts for him" },
      { "type": "url", "id": "link_right_bottom", "label": "Right bottom link" },
      { "type": "text", "id": "link_text_right_bottom", "label": "Right bottom link text", "default": "Shop now" },
      { "type": "product", "id": "product_right_bottom", "label": "Right bottom: Product (optional)" },
      { "type": "collection", "id": "collection_right_bottom", "label": "Right bottom: Collection (optional)" }
    ],
    "presets": [{ "name": "Gift grid (5 tiles)" }]
  }
  {% endschema %}
</section>
