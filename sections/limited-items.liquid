{%- comment -%}
limited-items.liquid
Optimized for 2-3 limited products.
Admin adds products as blocks in the theme editor (product picker).
Features:
 - max_blocks = 3
 - large image, center-aligned layout (desktop single row)
 - "Limited" badge, low-stock indicator, optional countdown
 - settings for heading, footer, button text, low stock threshold, countdown date
{%- endcomment -%}

<section id="limited-items-{{ section.id }}" class="limited-items-section section" aria-label="Limited items">
  <div class="container">
    {%- if section.settings.section_heading != blank -%}
      <h2 class="limited-items__heading">{{ section.settings.section_heading }}</h2>
    {%- endif -%}

    {%- if section.settings.countdown_date != blank -%}
      {% assign cd_date = section.settings.countdown_date | date: "%s" | plus: 0 %}
      <div class="limited-items__countdown" data-countdown="{{ section.settings.countdown_date }}">
        Offer ends on <time datetime="{{ section.settings.countdown_date }}">{{ section.settings.countdown_date | date: "%B %d, %Y" }}</time>
      </div>
    {%- endif -%}

    <div class="limited-items__row">
      {%- for block in section.blocks -%}
        {%- assign product_handle = block.settings.product -%}
        {%- if product_handle != blank -%}
          {%- assign product = all_products[product_handle] -%}
          {%- if product -%}
            {%- assign first_variant = product.selected_or_first_available_variant -%}
            <article class="limited-item-card" id="product-card-{{ product.id }}" itemscope itemtype="http://schema.org/Product">
              <a class="limited-item-card__media" href="{{ product.url }}" itemprop="url" aria-label="View {{ product.title }}">
                {%- if product.featured_image -%}
                  <img src="{{ product.featured_image | img_url: '900x900' }}" alt="{{ product.featured_image.alt | escape }}" itemprop="image">
                {%- else -%}
                  <div class="limited-item-card__noimage">No image</div>
                {%- endif -%}
                <div class="limited-item-badge">Limited</div>
              </a>

              <div class="limited-item-card__body">
                <a class="limited-item-card__title" href="{{ product.url }}" itemprop="name">{{ product.title }}</a>

                <div class="limited-item-card__price" itemprop="offers" itemscope itemtype="http://schema.org/Offer">
                  {%- if first_variant.compare_at_price > first_variant.price -%}
                    <span class="price--compare">{{ first_variant.compare_at_price | money }}</span>
                  {%- endif -%}
                  <span class="price" itemprop="price">{{ first_variant.price | money }}</span>
                  <meta itemprop="priceCurrency" content="{{ shop.currency }}">
                </div>

                <div class="limited-item-card__meta">
                  {%- if product.available -%}
                    <span class="availability in-stock" aria-hidden="true">In stock</span>
                  {%- else -%}
                    <span class="availability out-of-stock">Sold out</span>
                  {%- endif -%}

                  {%- comment -%}
                    Show low-stock only if inventory is managed and quantity is known.
                    Using selected_or_first_available_variant.inventory_management and inventory_quantity.
                  {%- endcomment -%}
                  {%- if first_variant.inventory_management and first_variant.inventory_quantity != blank and first_variant.inventory_quantity <= section.settings.low_stock_threshold and first_variant.inventory_quantity > 0 -%}
                    <span class="low-stock">Only {{ first_variant.inventory_quantity }} left</span>
                  {%- endif -%}
                </div>

                <div class="limited-item-card__actions">
                  {%- if product.available -%}
                    <form method="post" action="/cart/add" class="limited-add-form" data-product-id="{{ product.id }}">
                      <input type="hidden" name="id" value="{{ first_variant.id }}">
                      <button type="submit" class="button button--primary" aria-label="Add {{ product.title }} to cart">{{ section.settings.cta_text }}</button>
                    </form>
                  {%- else -%}
                    <a class="button button--outline" href="{{ product.url }}">View product</a>
                  {%- endif -%}
                </div>
              </div>
            </article>
          {%- endif -%}
        {%- endif -%}
      {%- else -%}
        <p class="limited-items__empty">No products added yet. Add products in the theme editor.</p>
      {%- endfor -%}
    </div>

    {%- if section.settings.footer_text != blank -%}
      <div class="limited-items__footer">{{ section.settings.footer_text }}</div>
    {%- endif -%}
  </div>

  <style>
    /* Design tuned for 2-3 items: wide cards, centered row */
    #limited-items-{{ section.id }} { padding: 48px 0; background: linear-gradient(180deg, #fafafa 0%, #ffffff 100%); }
    .limited-items__heading { font-size: 30px; margin: 0 0 18px; text-align:center; font-weight:700; letter-spacing: -0.02em; }
    .limited-items__countdown { text-align:center; margin-bottom:18px; color:#6b6b6b; font-size:14px; }

    .limited-items__row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 22px;
      align-items: start;
      justify-items: center;
      max-width: 1200px;
      margin: 0 auto;
    }

    .limited-item-card {
      width: 100%;
      max-width: 380px;
      background: #fff;
      border-radius: 14px;
      overflow: hidden;
      box-shadow: 0 6px 20px rgba(33,33,33,0.06);
      transition: transform .28s cubic-bezier(.2,.9,.2,1), box-shadow .28s;
      display: flex;
      flex-direction: column;
    }
    .limited-item-card:hover { transform: translateY(-6px) scale(1.01); box-shadow: 0 14px 40px rgba(33,33,33,0.12); }

    .limited-item-card__media {
      position: relative;
      display:block;
      width:100%;
      padding-top:78%; /* wide image */
      overflow:hidden;
    }
    .limited-item-card__media img { position:absolute; top:0; left:0; width:100%; height:100%; object-fit:cover; transition: transform .7s ease; }
    .limited-item-card:hover .limited-item-card__media img { transform: scale(1.04); }

    .limited-item-badge {
      position:absolute; left:14px; top:14px;
      background:linear-gradient(180deg,#ff5b4a,#e63b2a);
      color:#fff; padding:8px 12px; font-size:12px; border-radius:10px; font-weight:700;
      box-shadow: 0 6px 18px rgba(230,59,42,0.18); text-transform:uppercase;
    }

    .limited-item-card__body { padding:18px; display:flex; flex-direction:column; gap:12px; }
    .limited-item-card__title { font-size:18px; font-weight:700; color:#111; text-decoration:none; line-height:1.2; display:block; }
    .limited-item-card__price { font-size:16px; font-weight:700; color:#111; }
    .price--compare { text-decoration:line-through; margin-right:8px; color:#999; font-weight:400; }

    .limited-item-card__meta { display:flex; gap:12px; align-items:center; font-size:13px; color:#6b6b6b; margin-top:4px; flex-wrap:wrap; }
    .availability.in-stock { color:#2aa55a; font-weight:600; }
    .availability.out-of-stock { color:#d14444; font-weight:700; }
    .low-stock { color:#d9534f; font-weight:700; }

    .limited-item-card__actions { margin-top:10px; }
    .button { display:inline-block; padding:11px 18px; border-radius:10px; text-decoration:none; border:1px solid transparent; cursor:pointer; font-weight:700; }
    .button--primary { background:#111; color:#fff; }
    .button--outline { background:transparent; border:1px solid #e6e6e6; color:#111; }

    .limited-items__footer { margin-top:20px; text-align:center; color:#777; font-size:14px; }

    @media (min-width:1000px) {
      /* For large screens prefer 3 items centered */
      .limited-items__row { grid-template-columns: repeat(3, 1fr); }
    }

    @media (max-width:600px) {
      #limited-items-{{ section.id }} { padding: 28px 12px; }
      .limited-items__heading { font-size:22px; }
      .limited-item-card { max-width: 100%; border-radius:10px; }
    }
  </style>

  <script>
    /* Simple countdown (client-side) - shows days/hours/mins if countdown_date is set on the section element */
    (function(){
      var countdownEl = document.querySelector('#limited-items-{{ section.id }} .limited-items__countdown');
      if (!countdownEl) return;
      var target = new Date("{{ section.settings.countdown_date }}").getTime();
      function update() {
        var now = new Date().getTime();
        var diff = target - now;
        if (diff <= 0) {
          countdownEl.textContent = "Offer ended";
          return;
        }
        var days = Math.floor(diff / (1000*60*60*24));
        var hrs  = Math.floor((diff % (1000*60*60*24)) / (1000*60*60));
        var mins = Math.floor((diff % (1000*60*60)) / (1000*60));
        countdownEl.textContent = "Offer ends in " + days + "d " + hrs + "h " + mins + "m";
      }
      update();
      setInterval(update, 60000);
    })();
  </script>
</section>

{%- schema -%}
{
  "name": "Limited items",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "section_heading",
      "label": "Heading",
      "default": "Limited items — grab them before they're gone"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA button text",
      "default": "Add to cart"
    },
    {
      "type": "text",
      "id": "footer_text",
      "label": "Footer text",
      "default": "Limited quantities. While stocks last."
    },
    {
      "type": "number",
      "id": "low_stock_threshold",
      "label": "Low stock threshold (show 'Only X left' when quantity ≤)",
      "default": 5,
    },
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select product"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Limited items (2-3 products)",
      "category": "Products"
    }
  ]
}
{%- endschema -%}
