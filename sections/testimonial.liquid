{%- liquid
	assign section_id   = '#shopify-section-' | append: section.id
	assign animation    = settings.section_animation
	assign full         = section.settings.full
	assign layout       = section.settings.layout
	assign heading      = section.settings.heading
	assign heading_size = section.settings.heading_size
-%}

<style>
	{{ section_id }} .section-wrapper {
		padding-top: {{ section.settings.padding_top_mobile }}px;
		padding-bottom: {{ section.settings.padding_bottom_mobile }}px;

		{%- if section.settings.background != blank -%}
			background-image: url({{ section.settings.background | image_url: width: 1920 }});
			background-repeat: no-repeat;
			background-size: cover;
		{%- endif -%}
	}

	{%- if layout == 'layout-2' and section.settings.card_bg != blank -%}
		.testimonial-section .testimonial.layout-2 .slide-content {
			background-color: {{ section.settings.card_bg }};
		}
	{%- endif -%}

	@media (min-width: 992px) {
		{{ section_id }} .section-wrapper {
			padding-top: {{ section.settings.padding_top }}px;
			padding-bottom: {{ section.settings.padding_bottom }}px;
		}
	}

	{%- for block in section.blocks -%}
		{%- liquid
			assign card_bg         = block.settings.card_bg
			assign card_color      = block.settings.card_color
			assign card_sale_color = card_color | color_lighten: 5
		-%}

		{{ section_id }} .swiper-slide[data-{{ block.id }}] .product-card {
			{%- if card_bg != blank -%}
				--product-card-bg: {{ card_bg.red }}, {{ card_bg.green }}, {{ card_bg.blue }};
			{%- endif -%}

			{%- if card_color != blank -%}
				--text-color: {{ card_color.red }}, {{ card_color.green }}, {{ card_color.blue }};
			{%- endif -%}
		}
	{%- endfor -%}
</style>




<div class="section-wrapper color-{{ section.settings.color_scheme }}">
	<div class="{% if full %}stretch-section stretch-padding{% else %}container{% endif %}">
		<div class="testimonial {{ layout }}">
			{%- if heading != blank -%}
				<div class="heading-wrapper{% if animation %} scroll-trigger{% endif %}">
					<h2 class="heading rte {{ heading_size }}">
						{{- heading -}}
					</h2>

					{%- if section.settings.button_text != blank -%}
						<a class="show-more-button link-underline" href="{{ section.settings.button_link | default: '#' }}">{{- section.settings.button_text -}}</a>
					{%- endif -%}
				</div>
			{%- endif -%}

			<div class="carousel-swiper{% if animation %} scroll-trigger{% endif %}">
				<template data-options data-pagination-mobile data-css-mode="off">
					{
						{% if layout == 'layout-1' %}"loop": true,{% endif %}
						"navigation": {
							"nextEl": "{{ section_id }} .swiper-button-next",
							"prevEl": "{{ section_id }} .swiper-button-prev"
						},
						"pagination":  {
							"el": "{{ section_id }} .swiper-pagination",
							"clickable": true
						},
						"slidesPerView": 1,
						{% if layout == 'layout-1' %}"centeredSlides": true,{% endif %}
						"breakpoints": {
							"240": {
								"slidesPerView": 1,
								"spaceBetween": 20
							},
							"992": {
								"slidesPerView": {% if layout == 'layout-2' %}"auto"{% else %}1.75{% endif %},
								"spaceBetween": {% if layout == 'layout-2' %}32{% else %}60{% endif %}
							}
						}
					}
				</template>

				<div class="swiper">
					<div class="swiper-wrapper">
						{%- for block in section.blocks -%}
							<div class="swiper-slide" {{ block.shopify_attributes }} data-{{ block.id }} class="rte"{% if request.design_mode %} data-index="{{ forloop.index0 }}"{% endif %}>
								<div class="slide-content">
									{%- liquid
										assign head_text    = block.settings.head_text
										assign body_text    = block.settings.body_text
										assign footer_text  = block.settings.footer_text
										assign product      = block.settings.product
										assign rating       = block.settings.rating
										assign author_image = block.settings.author_image
										assign verify_buyer = block.settings.verify_buyer
									-%}

									{%- if head_text != blank -%}
										<div class="testi-head rte">
											{{- head_text -}}
										</div>
									{%- endif -%}

									{%- unless rating == '0' -%}
										<div class="ratings-stars">
											{%- for i in (1..rating) -%}
												<span class="star">
													{%- render 'icon', code: 'star' -%}
												</span>
											{%- endfor -%}
										</div>
									{%- endunless -%}

									{%- if body_text != blank -%}
										<div class="testi-body {{ block.settings.font_size }}">
											{{- body_text -}}
										</div>
									{%- endif -%}

									{%- if footer_text != blank or author_image != blank -%}
										<div class="testi-footer">
											{%- if author_image != blank -%}
												<div class="author-image adapt-media">
													<div class="image{% if settings.image_lazy and author_image != blank %} lazy-image{% endif %}">
														{%- liquid
															if author_image != blank
																render 'lazy-image', image: author_image, width: 50
															endif
														-%}
													</div>
												</div>
											{%- endif -%}

											{%- if footer_text != blank -%}
												<div class="author-info h4">
													{{- footer_text -}}
													{%- if verify_buyer -%}
														<div class="author-verify">
															{%- render 'icon', code: 'verify' -%}
															{{ 'sections.testimonial.verify_buyer' | t }}
														</div>
													{%- endif -%}
												</div>
											{%- endif -%}
										</div>
									{%- endif -%}

									{%- if product != blank -%}
										<div class="product-card">
											{%- liquid
												assign featured_image = product.selected_or_first_available_variant.featured_image | default: product.featured_media
											-%}

											{% comment %} Media {% endcomment %}
											{%- if featured_image != blank -%}
												<div class="product-media-wrap">
													<a href="{{ product.url | split: '?' | first }}"{% if settings.image_lazy %} class="product-image lazy-image"{% endif %} arial-label="{{ product.title }}">
														{%- liquid
															assign image_key = featured_image.src | handle

															render 'lazy-image', image: featured_image, width: 200, height: 200, class: 'product-first-image', data-key: image_key
														-%}
													</a>
												</div>
											{%- endif -%}

											<div class="product-content">
												{% comment %} Heading {% endcomment %}
												<h2 class="product-title link-underline-transparent">
													<a href="{{ product.url | split: '?' | first }}">{{- product.title | escape -}}</a>
												</h2>

												{%- render 'price', product: product -%}

												{% comment %} Add to cart {% endcomment %}
												{%- form 'product', product, class: 'form-add-to-cart', novalidate: 'novalidate', data-type: 'add-to-cart-form', id: nil -%}
													<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

													{%- if product.available -%}
														<button type="submit" name="add" class="button primary-button add-to-cart-button">
															{{- 'products.product.add_to_cart' | t -}}

															{% if settings.select_button == 'direction' %}
																{%- render 'icon', code: 'direction-button' -%}
															{% elsif settings.select_button == 'arrow' %}
																{%- render 'icon', code: 'arrow-button' -%}
															{% endif %}
														</button>
													{%- else -%}
														<button type="submit" name="add" class="add-to-cart-button" disabled>
															{{- 'products.product.sold_out' | t -}}
														</button>
													{%- endif -%}
												{%- endform -%}
											</div>
										</div>
									{%- endif -%}
								</div>
							</div>
						{%- else -%}
							{%- for i in (1..3) -%}
								<div class="swiper-slide" data-id="{{ forloop.index }}">
									<div class="testi-body">{{- 'onboarding.testimonial.body_text_html' | t -}}</div>
									<div class="testi-footer">{{- 'onboarding.testimonial.footer_text_html' | t -}}</div>
								</div>
							{%- endfor -%}
						{%- endfor -%}
					</div>
				</div>

				<div class="swiper-controls">
					<button class="swiper-button-prev" title ="{{ 'general.swipper.prev' | t }}" aria-label="{{ 'general.swipper.prev' | t }}" id="{{ 'general.swipper.prev' | t }}" aria-labelledby="{{ 'general.swipper.prev' | t }}">{%- render 'icon', code: 'arrow-left-slider' -%}</button>
					<div class="swiper-pagination" tabindex="-1"></div>
					<button class="swiper-button-next" title ="{{ 'general.swipper.next' | t }}" aria-label="{{ 'general.swipper.next' | t }}" id="{{ 'general.swipper.next' | t }}" aria-labelledby="{{ 'general.swipper.next' | t }}">{%- render 'icon', code: 'arrow-right-slider' -%}</button>
				</div>
			</div>
		</div>
	</div>
</div>

{% schema %}
{
	"name": "t:sections.testimonial.name",
	"tag": "section",
	"class": "testimonial-section",
	"disabled_on": {
		"groups": ["header", "footer"]
	},
	"settings": [
		{
			"type": "checkbox",
			"id": "full",
			"default": false,
			"label": "t:general.layout.full.label"
		},
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"label": "t:settings_schema.colors.label",
			"default": "scheme-1"
		},
		{
			"type": "image_picker",
			"id": "background",
			"label": "t:general.background.image.label"
		},
		{
			"type": "select",
			"id": "layout",
			"default": "layout-1",
			"label": "t:sections.testimonial.settings.layout.label",
			"options": [
				{
					"value": "layout-1",
					"label": "t:sections.testimonial.settings.layout.option_1.label"
				},
				{
					"value": "layout-2",
					"label": "t:sections.testimonial.settings.layout.option_2.label"
				}
			]
		},
		{
			"type": "color",
			"id": "card_bg",
			"default": "#FFFFFF",
			"label": "t:sections.testimonial.settings.card_background.label",
			"info": "t:sections.testimonial.settings.card_background.info"
		},
		{
			"type": "header",
			"content": "t:general.typography.heading.label"
		},
		{
			"type": "inline_richtext",
			"id": "heading",
			"label": "t:general.typography.text.label"
		},
		{
			"type": "select",
			"id": "heading_size",
			"options": [
				{
					"value": "h2",
					"label": "t:general.typography.heading_size.option_4.label"
				},
				{
					"value": "h3",
					"label": "t:general.typography.heading_size.option_3.label"
				},
				{
					"value": "h4",
					"label": "t:general.typography.heading_size.option_2.label"
				}
			],
			"default": "h3",
			"label": "t:general.typography.font_size.label"
		},
		{
			"type": "text",
			"id": "button_text",
			"label": "t:general.typography.button_text.label"
		},
		{
			"type": "url",
			"id": "button_link",
			"label": "t:general.typography.button_link.label"
		},
		{
			"type": "header",
			"content": "t:general.padding.header_padding.content"
		},
		{
			"type": "range",
			"id": "padding_top",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 50,
			"unit": "px",
			"label": "t:general.padding.top.label"
		},
		{
			"type": "range",
			"id": "padding_bottom",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 50,
			"unit": "px",
			"label": "t:general.padding.bottom.label"
		},
		{
			"type": "paragraph",
			"content": "t:general.padding.paragraph_mobile.content"
		},
		{
			"type": "range",
			"id": "padding_top_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 40,
			"unit": "px",
			"label": "t:general.padding.top.label"
		},
		{
			"type": "range",
			"id": "padding_bottom_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 40,
			"unit": "px",
			"label": "t:general.padding.bottom.label"
		}
	],
	"blocks": [
		{
			"type": "slide",
			"name": "t:general.slider.slide.label",
			"settings": [
				{
					"type": "text",
					"id": "head_text",
					"default": "Heading Testimonial",
					"label": "t:general.typography.heading.label"
				},
				{
					"type": "select",
					"id": "rating",
					"default": "5",
					"label": "t:sections.testimonial.settings.rating.label",
					"options": [
						{
							"value": "5",
							"label": "t:sections.testimonial.settings.rating.star_5.label"
						},
						{
							"value": "4",
							"label": "t:sections.testimonial.settings.rating.star_4.label"
						},
						{
							"value": "3",
							"label": "t:sections.testimonial.settings.rating.star_3.label"
						},
						{
							"value": "2",
							"label": "t:sections.testimonial.settings.rating.star_2.label"
						},
						{
							"value": "1",
							"label": "t:sections.testimonial.settings.rating.star_1.label"
						},
						{
							"value": "0",
							"label": "t:sections.testimonial.settings.rating.none.label"
						}
					]
				},
				{
					"type": "richtext",
					"id": "body_text",
					"default": "<p>Add customer reviews and testimonials to showcase your store’s happy customers.</p>",
					"label": "t:general.typography.content.label"
				},
				{
					"type": "select",
					"id": "font_size",
					"options": [
						{
							"value": "h4",
							"label": "t:general.typography.heading_size.option_1.label"
						},
						{
							"value": "h3",
							"label": "t:general.typography.heading_size.option_2.label"
						},
						{
							"value": "h2",
							"label": "t:general.typography.heading_size.option_3.label"
						}
					],
					"default": "h4",
					"label": "t:general.typography.font_size.label"
				},
				{
					"type": "image_picker",
					"id": "author_image",
					"label": "t:sections.testimonial.settings.author_image.label"
				},
				{
					"type": "inline_richtext",
					"id": "footer_text",
					"default": "— Buyer's name",
					"label": "t:sections.testimonial.settings.author_info.label"
				},
				{
					"type": "checkbox",
					"id": "verify_buyer",
					"default": false,
					"label": "t:sections.testimonial.settings.verify_buyer.label"
				},
				{
					"type": "product",
					"id": "product",
					"label": "t:settings_schema.product.name"
				},
				{
					"type": "header",
					"content": "t:settings_schema.product-card.name"
				},
				{
					"type": "color",
					"id": "card_bg",
					"label": "t:general.background.color.label"
				},
				{
					"type": "color",
					"id": "card_color",
					"label": "t:general.colors.text.label"
				}
			]
		}
	],
	"presets": [
		{
			"name": "t:sections.testimonial.name",
			"blocks": [
				{
					"type": "slide"
				},
				{
					"type": "slide"
				},
				{
					"type": "slide"
				}
			]
		}
	]
}
{% endschema %}
