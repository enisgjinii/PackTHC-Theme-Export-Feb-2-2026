{% comment %}
  Section: Grower-Breeder Developed with Circular Rotating Images
  Usage: Add this file to sections folder as 'grower-breeder.liquid'
{% endcomment %}

<style>
  #shopify-section-{{ section.id }} {
    padding: 80px 0;
    background-color: {{ section.settings.background_color }};
  }

  #shopify-section-{{ section.id }} .container {
    max-width: 1500px;
    margin: 0 auto;
    padding: 0 40px;
  }

  #shopify-section-{{ section.id }} .section-header {
    text-align: center;
    margin-bottom: 60px;
  }

  #shopify-section-{{ section.id }} .pre-title {
    font-size: 14px;
    font-weight: 600;
    color: {{ section.settings.pre_title_color }};
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 15px;
  }

  #shopify-section-{{ section.id }} .main-title {
    font-size: 52px;
    font-weight: 800;
    color: {{ section.settings.title_color }};
    margin: 0;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .content-wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .image-section {
    position: relative;
    width: 100%;
    height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .circular-border {
    position: relative;
    width: 400px;
    height: 400px;
    border: 2px solid {{ section.settings.circle_border_color }};
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.5);
  }

  #shopify-section-{{ section.id }} .rotating-image {
    position: absolute;
    width: 140px;
    height: 140px;
    border-radius: 50%;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0,0,0,0.2);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border: 4px solid #fff;
  }

  #shopify-section-{{ section.id }} .rotating-image:hover {
    transform: scale(1.1);
    box-shadow: 0 6px 25px rgba(0,0,0,0.3);
    z-index: 10;
  }

  #shopify-section-{{ section.id }} .rotating-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .text-section {
    padding-left: 20px;
  }

  #shopify-section-{{ section.id }} .icon-wrapper {
    width: 60px;
    height: 60px;
    margin-bottom: 30px;
  }

  #shopify-section-{{ section.id }} .icon-wrapper img,
  #shopify-section-{{ section.id }} .icon-wrapper svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .content-title {
    font-size: 42px;
    font-weight: 700;
    color: {{ section.settings.content_title_color }};
    margin: 0 0 25px 0;
    line-height: 1.3;
  }

  #shopify-section-{{ section.id }} .content-description {
    font-size: 16px;
    color: {{ section.settings.description_color }};
    line-height: 1.7;
    margin-bottom: 30px;
  }

  #shopify-section-{{ section.id }} .features-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .features-list li {
    font-size: 16px;
    color: {{ section.settings.description_color }};
    line-height: 1.8;
    padding-left: 25px;
    position: relative;
    margin-bottom: 12px;
  }

  #shopify-section-{{ section.id }} .features-list li:before {
    content: "•";
    position: absolute;
    left: 0;
    font-weight: bold;
    font-size: 20px;
    color: {{ section.settings.bullet_color }};
  }

  @media (max-width: 1024px) {
    #shopify-section-{{ section.id }} .content-wrapper {
      gap: 50px;
    }

    #shopify-section-{{ section.id }} .main-title {
      font-size: 42px;
    }

    #shopify-section-{{ section.id }} .content-title {
      font-size: 36px;
    }

    #shopify-section-{{ section.id }} .circular-border {
      width: 350px;
      height: 350px;
    }
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding: 50px 0;
    }

    #shopify-section-{{ section.id }} .container {
      padding: 0 20px;
    }

    #shopify-section-{{ section.id }} .content-wrapper {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    #shopify-section-{{ section.id }} .main-title {
      font-size: 32px;
    }

    #shopify-section-{{ section.id }} .content-title {
      font-size: 28px;
    }

    #shopify-section-{{ section.id }} .text-section {
      padding-left: 0;
    }

    #shopify-section-{{ section.id }} .image-section {
      height: 400px;
    }

    #shopify-section-{{ section.id }} .circular-border {
      width: 300px;
      height: 300px;
    }

    #shopify-section-{{ section.id }} .rotating-image {
      width: 80px;
      height: 80px;
    }
  }
</style>

<div class="container">
  {% if section.settings.pre_title != blank or section.settings.main_title != blank %}
    <div class="section-header">
      {% if section.settings.pre_title != blank %}
        <div class="pre-title">{{ section.settings.pre_title }}</div>
      {% endif %}
      {% if section.settings.main_title != blank %}
        <h2 class="main-title">{{ section.settings.main_title }}</h2>
      {% endif %}
    </div>
  {% endif %}

  <div class="content-wrapper">
    <div class="image-section">
      <div class="circular-border" id="circular-container-{{ section.id }}">
        <div class="rotating-image" id="img1-{{ section.id }}">
          {% if section.settings.image_1 != blank %}
            {{ section.settings.image_1 | image_url: width: 200 | image_tag: alt: 'Image 1' }}
          {% else %}
            {{ 'product-1' | placeholder_svg_tag }}
          {% endif %}
        </div>
        <div class="rotating-image" id="img2-{{ section.id }}">
          {% if section.settings.image_2 != blank %}
            {{ section.settings.image_2 | image_url: width: 200 | image_tag: alt: 'Image 2' }}
          {% else %}
            {{ 'product-2' | placeholder_svg_tag }}
          {% endif %}
        </div>
        <div class="rotating-image" id="img3-{{ section.id }}">
          {% if section.settings.image_3 != blank %}
            {{ section.settings.image_3 | image_url: width: 200 | image_tag: alt: 'Image 3' }}
          {% else %}
            {{ 'product-3' | placeholder_svg_tag }}
          {% endif %}
        </div>
      </div>
    </div>

    <div class="text-section">
      {% if section.settings.icon != blank %}
        <div class="icon-wrapper">
          {{ section.settings.icon | image_url: width: 120 | image_tag: alt: 'California Icon' }}
        </div>
      {% elsif section.settings.icon_svg != blank %}
        <div class="icon-wrapper">
          {{ section.settings.icon_svg }}
        </div>
      {% endif %}

      {% if section.settings.content_title != blank %}
        <h3 class="content-title">{{ section.settings.content_title }}</h3>
      {% endif %}

      {% if section.settings.content_description != blank %}
        <div class="content-description">
          {{ section.settings.content_description }}
        </div>
      {% endif %}

      {% if section.settings.feature_list != blank %}
        <ul class="features-list">
          {% assign features = section.settings.feature_list | split: '|' %}
          {% for feature in features %}
            <li>{{ feature | strip }}</li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  </div>
</div>

<script>
(function() {
  const sectionId = '{{ section.id }}';
  const container = document.getElementById('circular-container-' + sectionId);
  const img1 = document.getElementById('img1-' + sectionId);
  const img2 = document.getElementById('img2-' + sectionId);
  const img3 = document.getElementById('img3-' + sectionId);
  
  let angle1 = 0;
  let angle2 = 120;
  let angle3 = 240;
  
  const speed = {{ section.settings.rotation_speed | default: 0.3 }};
  const radius = 190;
  
  function animate() {
    angle1 += speed;
    angle2 += speed;
    angle3 += speed;
    
    const centerX = container.offsetWidth / 2;
    const centerY = container.offsetHeight / 2;
    
    const x1 = centerX + radius * Math.cos(angle1 * Math.PI / 180) - 70;
    const y1 = centerY + radius * Math.sin(angle1 * Math.PI / 180) - 70;
    img1.style.left = x1 + 'px';
    img1.style.top = y1 + 'px';
    
    const x2 = centerX + radius * Math.cos(angle2 * Math.PI / 180) - 70;
    const y2 = centerY + radius * Math.sin(angle2 * Math.PI / 180) - 70;
    img2.style.left = x2 + 'px';
    img2.style.top = y2 + 'px';
    
    const x3 = centerX + radius * Math.cos(angle3 * Math.PI / 180) - 70;
    const y3 = centerY + radius * Math.sin(angle3 * Math.PI / 180) - 70;
    img3.style.left = x3 + 'px';
    img3.style.top = y3 + 'px';
    
    requestAnimationFrame(animate);
  }
  
  animate();
})();
</script>

{% schema %}
{
  "name": "Grower-Breeder Section",
  "tag": "section",
  "class": "grower-breeder-section",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "pre_title",
      "label": "Pre-Title",
      "default": "GROWER-BREEDER DEVELOPED"
    },
    {
      "type": "text",
      "id": "main_title",
      "label": "Main Title",
      "default": "FEMINIZED F1 HYBRID CANNABIS SEEDS"
    },
    {
      "type": "header",
      "content": "Circular Rotating Images"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1",
      "info": "First rotating image"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2",
      "info": "Second rotating image"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image 3",
      "info": "Third rotating image"
    },
    {
      "type": "range",
      "id": "rotation_speed",
      "min": 0.1,
      "max": 2,
      "step": 0.1,
      "label": "Rotation Speed",
      "default": 0.5,
      "info": "Control how fast images rotate"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "icon",
      "label": "Icon/Logo"
    },
    {
      "type": "html",
      "id": "icon_svg",
      "label": "Icon SVG Code",
      "info": "Use SVG if no image selected"
    },
    {
      "type": "text",
      "id": "content_title",
      "label": "Content Title",
      "default": "California cannabis growers, seed breeders, and producers."
    },
    {
      "type": "textarea",
      "id": "content_description",
      "label": "Description",
      "default": "Atlas Seed is a California based cannabis seed genetics development company. Our breeding and seed production programs are based on our experience as long time indoor growers and outdoor farmers navigating the licensed market in California."
    },
    {
      "type": "textarea",
      "id": "feature_list",
      "label": "Feature List",
      "info": "Separate items with | symbol",
      "default": "Specializing in breeding and seed production programs. | First to market with feminized F1 hybrid cannabis autoflowers. | Innovated novel cannabis genetics, seed types, processes, and terminology"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#f8f8f8"
    },
    {
      "type": "color",
      "id": "circle_border_color",
      "label": "Circle Border Color",
      "default": "#cccccc"
    },
    {
      "type": "color",
      "id": "pre_title_color",
      "label": "Pre-Title Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Main Title Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "content_title_color",
      "label": "Content Title Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "bullet_color",
      "label": "Bullet Point Color",
      "default": "#1a1a1a"
    }
  ],
  "presets": [
    {
      "name": "Grower-Breeder Section"
    }
  ]
}
{% endschema %}