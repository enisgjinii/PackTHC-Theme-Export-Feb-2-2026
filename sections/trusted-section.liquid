{% stylesheet %}
  .trust-section {
    background: #033770;
    padding: 60px 40px;
    margin: 0 auto;
  }

  .trust-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: start;
    margin-bottom: 60px;
  }

  .trust-left {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .trust-title {
    font-size: 48px;
    font-weight: 800;
    color: white;
    line-height: 1.1;
    text-decoration: underline;
    text-decoration-color: white;
    text-decoration-thickness: 3px;
    text-underline-offset: 8px;
  }

  .trust-right {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
  }

  .trust-stat {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .trust-stat-number {
    font-size: 56px;
    font-weight: 800;
    color: white;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .trust-stat-circle {
    width: 50px;
    height: 50px;
    border: 4px solid #7c3aed;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    font-weight: 700;
    color: #ffffff;
    position: relative;
    background: conic-gradient(#7c3aed 0deg, #7c3aed var(--percentage), transparent var(--percentage));
  }

  .trust-stat-label {
    font-size: 16px;
    color: #d1d5db;
    line-height: 1.5;
  }

  .trust-reviews {
    text-align: center;
  }

  .trust-reviews-stars {
    display: flex;
    justify-content: center;
    gap: 4px;
    margin-bottom: 8px;
  }

  .trust-reviews-star {
    color: #fbbf24;
    font-size: 18px;
  }

  .trust-reviews-text {
    font-size: 14px;
    color: #9ca3af;
    font-style: italic;
  }

  /* Tablet Responsive (1024px and below) */
  @media (max-width: 1024px) {
    .trust-section {
      padding: 40px 32px;
    }

    .trust-container {
      grid-template-columns: 1fr;
      gap: 40px;
      margin-bottom: 40px;
    }

    .trust-title {
      font-size: 36px;
    }

    .trust-right {
      gap: 32px;
    }

    .trust-stat-number {
      font-size: 48px;
    }
  }

  /* Mobile Large (768px and below) */
  @media (max-width: 768px) {
    .trust-section {
      padding: 32px 20px;
    }

    .trust-container {
      gap: 32px;
      margin-bottom: 32px;
    }

    .trust-title {
      font-size: 28px;
      text-decoration-thickness: 2px;
    }

    .trust-right {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .trust-stat-number {
      font-size: 40px;
    }

    .trust-stat-label {
      font-size: 14px;
    }
  }

  /* Mobile Small (480px and below) */
  @media (max-width: 480px) {
    .trust-section {
      padding: 24px 16px;
    }

    .trust-container {
      gap: 28px;
      margin-bottom: 28px;
    }

    .trust-title {
      font-size: 24px;
      text-decoration-thickness: 2px;
      text-underline-offset: 6px;
    }

    .trust-right {
      gap: 20px;
    }

    .trust-stat-number {
      font-size: 32px;
      gap: 6px;
    }

    .trust-stat-circle {
      width: 40px;
      height: 40px;
      font-size: 10px;
    }

    .trust-stat-label {
      font-size: 13px;
    }

    .trust-reviews-text {
      font-size: 12px;
    }
  }
{% endstylesheet %}

<div class="trust-section">
  <div class="trust-container">
    <div class="trust-left">
      <h2 class="trust-title">{{ section.settings.main_title }}</h2>
    </div>

    <div class="trust-right">
      {% for block in section.blocks %}
        {% if block.type == 'stat_block' %}
          <div class="trust-stat">
            <div class="trust-stat-number">
              {{ block.settings.stat_number }}
              <div class="trust-stat-circle" style="--percentage: {{ block.settings.percentage }}%;">
                {{ block.settings.percentage }}%
              </div>
            </div>
            <div class="trust-stat-label">{{ block.settings.stat_label }}</div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <div class="trust-reviews">
    <div class="trust-reviews-stars">
      <span class="trust-reviews-star">★</span>
      <span class="trust-reviews-star">★</span>
      <span class="trust-reviews-star">★</span>
      <span class="trust-reviews-star">★</span>
      <span class="trust-reviews-star">★</span>
    </div>
    <div class="trust-reviews-text">{{ section.settings.reviews_text }}</div>
  </div>
</div>

{% schema %}
{
  "name": "Trust Section",
  "settings": [
    {
      "type": "text",
      "id": "main_title",
      "label": "Main Title",
      "default": "Trusted by 1,847+ FMCG Brands Worldwide"
    },
    {
      "type": "text",
      "id": "reviews_text",
      "label": "Reviews Text",
      "default": "★★★★★ Verified Client Reviews"
    }
  ],
  "blocks": [
    {
      "type": "stat_block",
      "name": "Stat Block",
      "settings": [
        {
          "type": "text",
          "id": "stat_number",
          "label": "Stat Number",
          "default": "23%"
        },
        {
          "type": "range",
          "id": "percentage",
          "label": "Circle Fill Percentage",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 23,
          "unit": "%"
        },
        {
          "type": "text",
          "id": "stat_label",
          "label": "Stat Label",
          "default": "average cost reduction"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Section",
      "settings": {
        "main_title": "Trusted by 1,847+ FMCG Brands Worldwide",
        "reviews_text": "★★★★★ Verified Client Reviews"
      },
      "blocks": [
        {"type": "stat_block", "settings": {"stat_number": "23%", "percentage": 23, "stat_label": "average cost reduction"}},
        {"type": "stat_block", "settings": {"stat_number": "98%", "percentage": 98, "stat_label": "on-time delivery rate"}},
        {"type": "stat_block", "settings": {"stat_number": "99%", "percentage": 99, "stat_label": "production & shipping complications mitigated"}},
        {"type": "stat_block", "settings": {"stat_number": "100%", "percentage": 100, "stat_label": "of orders covered by our Triple Guarantee"}}
      ]
    }
  ]
}
{% endschema %}