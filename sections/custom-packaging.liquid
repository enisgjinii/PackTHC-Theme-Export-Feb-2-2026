<!-- Product Page Template for Shopify -->
<div class="product-container">
  <div class="product-section">
    <!-- Left Side - Product Image -->
    <div class="product-image">
      {% if product.featured_media %}
        <img src="{{ product.featured_media | image_url: width: 600 }}" 
             alt="{{ product.featured_media.alt | escape }}"
             loading="lazy">
      {% else %}
        <img src="{{ 'placeholder.svg' | asset_url }}" alt="{{ product.title | escape }}">
      {% endif %}
      
      <!-- Thumbnail gallery (optional) -->
      {% if product.media.size > 1 and section.settings.show_thumbnails %}
        <div class="thumbnail-gallery">
          {% for media in product.media limit: 4 %}
            <img src="{{ media | image_url: width: 100 }}" 
                 alt="{{ media.alt | escape }}"
                 onclick="changeMainImage(this)"
                 class="thumbnail {% if forloop.first %}active{% endif %}">
          {% endfor %}
        </div>
      {% endif %}
    </div>
    
    <!-- Right Side - Product Details -->
    <div class="product-details">
      <h1 class="product-title">{{ product.title }}</h1>
      
      <div class="price-section">
        {% if product.compare_at_price > product.price %}
          <div class="unit-price">
            <span class="original-price">${{ product.compare_at_price | money_without_currency }}</span>
            <span class="sale-badge">SALE</span>
          </div>
        {% endif %}
        
        <div class="total-price" id="product-price">
          ${{ product.price | money_without_currency }}
        </div>
        
        {% if product.available %}
          <div class="stock-status in-stock">✓ In stock</div>
        {% else %}
          <div class="stock-status out-of-stock">✗ Out of stock</div>
        {% endif %}
      </div>
      
      <!-- Product Description -->
      {% if product.description != blank and section.settings.show_description %}
        <div class="product-description">
          {{ product.description | truncate: section.settings.description_length }}
        </div>
      {% endif %}
      
      <!-- Product Form -->
      <form action="/cart/add" method="post" enctype="multipart/form-data" id="AddToCartForm">
        <!-- Variant Selection -->
        {% unless product.has_only_default_variant %}
          {% for option in product.options_with_values %}
            <div class="variant-selector">
              <label for="Option{{ forloop.index }}">{{ option.name }}</label>
              <select name="id" id="Option{{ forloop.index }}" onchange="updateVariant()">
                {% for value in option.values %}
                  {% for variant in product.variants %}
                    {% if variant.option1 == value or variant.option2 == value or variant.option3 == value %}
                      <option value="{{ variant.id }}" 
                              {% if variant == product.selected_or_first_available_variant %}selected{% endif %}
                              {% unless variant.available %}disabled{% endunless %}>
                        {{ value }} 
                        {% unless variant.available %}- Sold Out{% endunless %}
                      </option>
                      {% break %}
                    {% endif %}
                  {% endfor %}
                {% endfor %}
              </select>
            </div>
          {% endfor %}
        {% else %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        {% endunless %}
        
        <!-- Quantity Section -->
        <div class="quantity-section">
          <div class="quantity-label">Quantity</div>
          <div class="quantity-controls">
            <button type="button" class="quantity-btn" onclick="decreaseQuantity()">−</button>
            <input type="number" 
                   id="quantity" 
                   name="quantity" 
                   class="quantity-input" 
                   value="1" 
                   min="1" 
                   onchange="updatePrice()">
            <button type="button" class="quantity-btn" onclick="increaseQuantity()">+</button>
          </div>
        </div>
        
        <!-- Add to Cart Button -->
        <button type="submit" 
                class="add-to-cart" 
                {% unless product.available %}disabled{% endunless %}
                id="AddToCart">
          {% if product.available %}
            {{ section.settings.add_to_cart_text | default: "Add to Cart" }}
          {% else %}
            {{ section.settings.sold_out_text | default: "Sold Out" }}
          {% endif %}
        </button>
      </form>
      
      <!-- Shipping Info -->
      {% if section.settings.show_shipping_info %}
        <div class="shipping-info">
          <h4>🚚 Free Shipping For Orders Over {{ section.settings.free_shipping_amount | default: "$2,000" }}</h4>
          {% assign shipping_lines = section.settings.shipping_text | newline_to_br | split: '<br />' %}
          {% for line in shipping_lines %}
            <p>{{ line }}</p>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</div>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

.product-container {
    max-width: 1200px;
    margin: 0 auto;
    background: white;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.1);
    overflow: hidden;
}

.product-section {
    display: flex;
    gap: 40px;
    padding: 40px;
}

.product-image {
    flex: 1;
    max-width: 500px;
}

.product-image img {
    width: 100%;
    height: auto;
    border-radius: 8px;
    box-shadow: 0 2px 15px rgba(0,0,0,0.1);
}

.thumbnail-gallery {
    display: flex;
    gap: 10px;
    margin-top: 15px;
}

.thumbnail {
    width: 80px;
    height: 80px;
    object-fit: cover;
    border-radius: 4px;
    cursor: pointer;
    opacity: 0.7;
    transition: opacity 0.3s;
}

.thumbnail.active, .thumbnail:hover {
    opacity: 1;
    border: 2px solid #3498db;
}

.product-details {
    flex: 1;
    padding: 20px 0;
}

.product-title {
    font-size: 2rem;
    font-weight: 700;
    color: #2c3e50;
    margin-bottom: 20px;
    line-height: 1.3;
}

.price-section {
    margin: 30px 0;
}

.unit-price {
    font-size: 1.1rem;
    color: #666;
    margin-bottom: 5px;
    display: flex;
    align-items: center;
    gap: 10px;
}

.original-price {
    text-decoration: line-through;
    color: #999;
}

.sale-badge {
    background: #c0392b;
    color: white;
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 0.8rem;
    font-weight: bold;
}

.total-price {
    font-size: 2.2rem;
    font-weight: 700;
    color: #c0392b;
    margin-bottom: 10px;
}

.stock-status {
    font-weight: 500;
    font-size: 1.1rem;
    margin-bottom: 20px;
}

.stock-status.in-stock {
    color: #27ae60;
}

.stock-status.out-of-stock {
    color: #c0392b;
}

.product-description {
    margin: 20px 0;
    color: #666;
    line-height: 1.6;
}

.variant-selector {
    margin: 20px 0;
}

.variant-selector label {
    display: block;
    font-weight: 600;
    margin-bottom: 8px;
    color: #2c3e50;
}

.variant-selector select {
    width: 100%;
    padding: 12px;
    border: 2px solid #ddd;
    border-radius: 8px;
    font-size: 1rem;
    outline: none;
}

.variant-selector select:focus {
    border-color: #3498db;
}

.quantity-section {
    margin: 30px 0;
}

.quantity-label {
    font-size: 1.2rem;
    font-weight: 600;
    color: #2c3e50;
    margin-bottom: 15px;
}

.quantity-controls {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 30px;
}

.quantity-btn {
    width: 45px;
    height: 45px;
    border: 2px solid #3498db;
    background: white;
    color: #3498db;
    font-size: 1.5rem;
    font-weight: bold;
    border-radius: 8px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
}

.quantity-btn:hover {
    background: #3498db;
    color: white;
}

.quantity-input {
    width: 80px;
    height: 45px;
    text-align: center;
    font-size: 1.2rem;
    border: 2px solid #ddd;
    border-radius: 8px;
    outline: none;
}

.quantity-input:focus {
    border-color: #3498db;
}

.add-to-cart {
    width: 100%;
    padding: 18px 30px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border: none;
    border-radius: 10px;
    font-size: 1.3rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.add-to-cart:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4);
}

.add-to-cart:disabled {
    background: #ccc;
    cursor: not-allowed;
    transform: none;
}

.shipping-info {
    margin-top: 25px;
    padding: 20px;
    background: #f8f9fa;
    border-radius: 8px;
    border-left: 4px solid #3498db;
}

.shipping-info h4 {
    color: #2c3e50;
    margin-bottom: 10px;
    font-size: 1.1rem;
}

.shipping-info p {
    color: #666;
    font-size: 0.9rem;
    margin-bottom: 5px;
}

@media (max-width: 768px) {
    .product-section {
        flex-direction: column;
        padding: 20px;
        gap: 30px;
    }
    
    .product-title {
        font-size: 1.5rem;
    }
    
    .total-price {
        font-size: 1.8rem;
    }
    
    .thumbnail-gallery {
        justify-content: center;
    }
}
</style>

<script>
// Shopify product data
const productData = {{ product | json }};
let currentVariant = {{ product.selected_or_first_available_variant | json }};

function updatePrice() {
    const quantity = parseInt(document.getElementById('quantity').value) || 1;
    const priceElement = document.getElementById('product-price');
    const totalPrice = (currentVariant.price * quantity / 100).toFixed(2);
    priceElement.textContent = '$' + totalPrice;
}

function increaseQuantity() {
    const quantityInput = document.getElementById('quantity');
    const newValue = parseInt(quantityInput.value) + 1;
    quantityInput.value = newValue;
    updatePrice();
}

function decreaseQuantity() {
    const quantityInput = document.getElementById('quantity');
    const currentValue = parseInt(quantityInput.value);
    if (currentValue > 1) {
        quantityInput.value = currentValue - 1;
        updatePrice();
    }
}

function updateVariant() {
    const selectElement = document.querySelector('select[name="id"]');
    if (selectElement) {
        const selectedVariantId = selectElement.value;
        currentVariant = productData.variants.find(variant => variant.id == selectedVariantId);
        
        // Update price display
        updatePrice();
        
        // Update add to cart button
        const addToCartBtn = document.getElementById('AddToCart');
        if (currentVariant.available) {
            addToCartBtn.disabled = false;
            addToCartBtn.textContent = 'Add to Cart';
        } else {
            addToCartBtn.disabled = true;
            addToCartBtn.textContent = 'Sold Out';
        }
        
        // Update stock status
        const stockStatus = document.querySelector('.stock-status');
        if (currentVariant.available) {
            stockStatus.className = 'stock-status in-stock';
            stockStatus.innerHTML = '✓ In stock';
        } else {
            stockStatus.className = 'stock-status out-of-stock';
            stockStatus.innerHTML = '✗ Out of stock';
        }
    }
}

function changeMainImage(thumbnail) {
    const mainImage = document.querySelector('.product-image img');
    const thumbnails = document.querySelectorAll('.thumbnail');
    
    mainImage.src = thumbnail.src.replace('_100x100', '_600x600');
    
    thumbnails.forEach(thumb => thumb.classList.remove('active'));
    thumbnail.classList.add('active');
}

// Initialize price on page load
document.addEventListener('DOMContentLoaded', function() {
    updatePrice();
});

// Handle form submission
document.getElementById('AddToCartForm').addEventListener('submit', function(e) {
    e.preventDefault();
    
    const formData = new FormData(this);
    
    fetch('/cart/add.js', {
        method: 'POST',
        body: formData
    })
    .then(response => response.json())
    .then(data => {
        // Success - you can customize this
        alert('Product added to cart!');
        // Optional: Update cart drawer/icon
        // window.location.href = '/cart';
    })
    .catch(error => {
        console.error('Error:', error);
        alert('Error adding product to cart');
    });
});
</script>

{% schema %}
{
  "name": "Product Pagessss",
  "tag": "section",
  "class": "product-section",
  "settings": [
    {
      "type": "header",
      "content": "Product Display Settings"
    },
    {
      "type": "checkbox",
      "id": "show_thumbnails",
      "label": "Show thumbnail gallery",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show product description",
      "default": true
    },
    {
  "type": "range",
  "id": "description_length",
  "min": 100,
  "max": 500,
  "step": 50,
  "unit": "ch",  // Shortened unit
  "label": "Description length",
  "default": 200
},

    {
      "type": "header",
      "content": "Shipping Settings"
    },
    {
      "type": "checkbox",
      "id": "show_shipping_info",
      "label": "Show shipping information",
      "default": true
    },
    {
      "type": "text",
      "id": "free_shipping_amount",
      "label": "Free shipping minimum amount",
      "default": "$2,000"
    },
    {
      "type": "textarea",
      "id": "shipping_text",
      "label": "Shipping information text",
      "default": "*Only valid in the contiguous USA*\n*Excludes pallet orders of a single SKU*"
    },
    {
      "type": "header",
      "content": "Button Settings"
    },
    {
      "type": "text",
      "id": "add_to_cart_text",
      "label": "Add to cart button text",
      "default": "Add to Cart"
    },
    {
      "type": "text",
      "id": "sold_out_text",
      "label": "Sold out button text",
      "default": "Sold Out"
    },
    {
      "type": "header",
      "content": "Style Settings"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button background color",
      "default": "#667eea"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Price text color",
      "default": "#c0392b"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Product title color",
      "default": "#2c3e50"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Product image ratio",
      "options": [
        {
          "value": "square",
          "label": "Square (1:1)"
        },
        {
          "value": "portrait",
          "label": "Portrait (3:4)"
        },
        {
          "value": "landscape",
          "label": "Landscape (4:3)"
        },
        {
          "value": "auto",
          "label": "Original"
        }
      ],
      "default": "auto"
    },
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Desktop layout",
      "options": [
        {
          "value": "50-50",
          "label": "Image 50% - Details 50%"
        },
        {
          "value": "60-40",
          "label": "Image 60% - Details 40%"
        },
        {
          "value": "40-60",
          "label": "Image 40% - Details 60%"
        }
      ],
      "default": "50-50"
    },
    {
      "type": "checkbox",
      "id": "enable_zoom",
      "label": "Enable image zoom on hover",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Product Page"
    }
  ]
}
{% endschema %}