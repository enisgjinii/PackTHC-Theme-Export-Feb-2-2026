{% schema %}
{
  "name": "Collection Grid",
  "settings": [
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 5,
      "label": "Collections per row (Desktop)"
    }
  ],
  "blocks": [
    {
      "type": "collection_block",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select a Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Grid",
      "category": "Custom"
    }
  ]
}
{% endschema %}

{% style %}
.collection-grid-wrapper {
  display: grid;
  gap: 20px;
  padding: 30px;
  grid-template-columns: repeat({{ section.settings.columns }}, 1fr);
  max-width: 1762px;
  margin: 0 auto;
}

.collection-item {
  text-align: center;
}

.collection-image img {
  width: 100%;
  height: 200px;
  object-fit: contain;
  border-radius: 8px;
  background: #fff;
  transition: transform 0.15s ease-in-out; /* Smooth zoom effect */
}

.collection-info h3 {
  margin: 10px 0 4px;
  font-size: 16px;
  font-weight: 600;
}

.collection-info p {
  font-size: 14px;
  color: #666;
}

.collection-image:hover img {
  transform: scale(1.1); /* Zoom in */
}

@media (max-width: 767px) {
  .collection-grid-wrapper {
    grid-template-columns: 1fr 1fr;
  }
}
{% endstyle %}

<div class="collection-title-grid-wrap">
  <div class="container">
    <div class="collection-title-grid">
      {% for block in section.blocks %}
        {% assign collection = block.settings.collection %}
        {% if collection %}
          <div class="collection-title-box">
            <a href="{{ collection.url }}">{{ collection.title }}</a>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% comment %} grid start {% endcomment %}
<div class="collection-grid-wrapper">
  {% for block in section.blocks %}
    {% assign collection = block.settings.collection %}
    {% if collection != blank %}
      <div class="collection-item">
        <div class="collection-image">
          <a href="{{ collection.url }}">
            <img 
              src="{{ collection.image | img_url: '400x400' }}" 
              alt="{% if collection.title != blank %}{{ collection.title }}{% else %}Child-Resistant Packaging Solutions{% endif %}" 
              loading="lazy"
              width="400"
              height="400"
            >
          </a>
        </div>
        <div class="collection-info">
          <h3>{{ collection.title }}</h3>
          <p>{{ collection.products_count }} products</p>
        </div>
      </div>
    {% endif %}
  {% endfor %}
</div>

<style>
  .collection-title-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    align-items: center;
    margin: 10px;
  }
  .collection-title-box {
    border: 1px solid #004A26;
    padding: 10px 16px;
    border-radius: 6px;
    background: #fff;
    white-space: nowrap;
    width: fit-content;
    transition: 0.3s;
  }
  .collection-title-box:hover {
    background: #004A26;
  }
  .collection-title-box a {
    color: #004A26;
    text-decoration: none;
    font-weight: 600;
    font-family: "ITC Avant Garde Gothic", sans-serif;
  }
  .collection-title-box:hover a {
    color: #fff;
  }
</style>