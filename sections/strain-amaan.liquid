{% comment %}
  Product Details Section with Grid Layout
{% endcomment %}

<style>
    .product-details-section {
      max-width: 1400px;
      margin: 0 auto;
    }

    .product-detail-block {
      margin-bottom: 60px;
      background: #fff;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

    /* Block 1 - Main Product Info */
    .block-main-info {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      padding: 20px;
    }

    .trichome-image {
      width: 100%;
      border-radius: 12px;
    }

    .product-info-content h1 {
      font-size: 48px;
      font-weight: 800;
      margin: 0 0 10px 0;
    }

    .genetics-info {
      color: #666;
      margin-bottom: 20px;
      font-size: 16px;
    }

    .info-badges {
      display: flex;
      gap: 12px;
      margin-bottom: 30px;
    }

    .badge {
      padding: 10px 20px;
      border: 2px solid #e5e5e5;
      border-radius: 25px;
      font-weight: 600;
      font-size: 14px;
    }

    .effects-tabs {
      display: flex;
      gap: 20px;
      margin-bottom: 20px;
      border-bottom: 2px solid #e5e5e5;
    }

    .tab {
      padding: 10px 0;
      font-weight: 600;
      cursor: pointer;
      border-bottom: 3px solid transparent;
    }

    .tab.active {
      border-bottom-color: #000;
    }

    .effects-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 15px;
      margin-bottom: 30px;
    }

    .effect-item {
      padding: 15px;
      background: #f9f9f9;
      border-radius: 8px;
    }

    .terpenes-section h3 {
      font-size: 20px;
      font-weight: 700;
      margin-bottom: 15px;
    }

    .terpene-list {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 20px;
    }

    .terpene-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 16px;
      background: #f5f5f5;
      border-radius: 20px;
      font-size: 14px;
      font-weight: 600;
    }

    .terpene-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
    }

    .thc-scale {
      margin-top: 20px;
    }

    .scale-bar {
      height: 8px;
      background: #e5e5e5;
      border-radius: 4px;
      margin: 10px 0;
      position: relative;
      overflow: hidden;
    }

    .scale-fill {
      height: 100%;
      background: #000;
      border-radius: 4px;
    }

    .scale-labels {
      display: flex;
      justify-content: space-between;
      font-size: 12px;
      color: #666;
    }
    .thc-scale {
  margin-top: 20px;
}

.scale-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}

.scale-header h4 {
  font-size: 14px;
  font-weight: 700;
  margin: 0;
}

.scale-bar {
  height: 8px;
  background: #e5e5e5;
  border-radius: 4px;
  margin: 10px 0 5px 0;
  position: relative;
  overflow: hidden;
  cursor: pointer;
}

.scale-fill {
  height: 100%;
  background: linear-gradient(90deg, #4CAF50 0%, #FFA726 50%, #FF5722 100%);
  border-radius: 4px;
  position: relative;
}

.scale-handle {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 20px;
  height: 20px;
  background: #000;
  border-radius: 50%;
  border: 3px solid #fff;
  box-shadow: 0 2px 6px rgba(0,0,0,0.3);
  cursor: grab;
}

.scale-handle:active {
  cursor: grabbing;
}

.scale-labels {
  display: flex;
  justify-content: space-between;
  font-size: 12px;
  color: #666;
}

    /* Block 2 - Description */
    .block-description {
      padding: 10px 20px;
    }

    .block-description h2 {
      font-size: 32px;
      font-weight: 800;
      margin-bottom: 20px;
    }

    .description-text {
      font-size: 16px;
      line-height: 1.8;
      color: #555;
      margin-bottom: 20px;
    }

    .features-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
      margin: 20px 0;
    }

    .feature-item {
      text-align: center;
    }

    .feature-item h4 {
      font-size: 16px;
      font-weight: 700;
      margin-bottom: 10px;
    }

    .feature-item p {
      font-size: 14px;
      color: #666;
      line-height: 1.6;
    }

    /* Block 2.5 - Product Selection Grid Layout */
    .block-product-selection {
      padding: 10px 20px;
      background: #fafafa;
    }

    .grid-layout-container {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 30px;
      margin-top: 40px;
    }

    /* Left Column */
    .left-column {
      display: grid;
      grid-template-rows: auto 1fr;
      gap: 30px;
    }

    .top-products {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .bottom-content {
      background: #fff;
      border: 2px solid #e5e5e5;
      border-radius: 12px;
      padding: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .bottom-content-inner h3 {
      font-size: 24px;
      font-weight: 800;
      margin-bottom: 15px;
    }

    .bottom-content-inner p {
      color: #666;
      line-height: 1.6;
    }

    /* Right Column */
    .right-column {
      display: grid;
      grid-template-rows: 1fr auto;
      gap: 30px;
    }

    .top-content {
      background: #fff;
      border: 2px solid #e5e5e5;
      border-radius: 12px;
      padding: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .top-content-inner h3 {
      font-size: 24px;
      font-weight: 800;
      margin-bottom: 15px;
    }

    .top-content-inner p {
      color: #666;
      line-height: 1.6;
    }

    .bottom-products {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    /* Product Card Styles */
    .product-card {
      background: #fff;
      border: 2px solid #e5e5e5;
      border-radius: 12px;
      overflow: hidden;
      transition: all 0.3s ease;
    }

    .product-card:hover {
      border-color: #000;
      transform: translateY(-5px);
      box-shadow: 0 8px 20px rgba(0,0,0,0.1);
    }

    .product-card-image {
      width: 100%;
      height: 200px;
      object-fit: cover;
    }

    .product-card-content {
      padding: 15px;
      text-align: center;
    }

    .product-card-title {
      font-size: 14px;
      font-weight: 700;
      margin: 10px;
    }

    .view-product-btn {
      display: inline-block;
      padding: 8px 20px;
      background: #000;
      color: #ffffff !important;
      text-decoration: none;
      border-radius: 20px;
      font-weight: 600;
      font-size: 12px;
      transition: all 0.3s ease;
      border: none;
      cursor: pointer;
    }

    .view-product-btn:hover {
      background: #333;
      transform: scale(1.05);
    }

    /* Block 3 - Category Buttons & Basic Info */
    .block-categories {
      padding: 10px 20px;
      background: #fff;
    }

    .section-header {
      text-align: center;
      margin-bottom: 30px;
    }

    .section-header small {
      color: #666;
      text-transform: uppercase;
      letter-spacing: 1px;
      font-size: 12px;
    }

    .section-header h2 {
      font-size: 36px;
      font-weight: 800;
      margin: 10px 0;
    }

    .category-buttons {
      display: flex;
      justify-content: center;
      gap: 15px;
      margin-bottom: 40px;
    }

    .category-btn {
      padding: 12px 30px;
      background: #fff;
      border: 2px solid #e5e5e5;
      border-radius: 25px;
      font-weight: 600;
      cursor: pointer;
    }

    .basic-info-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
      max-width: 900px;
      margin: 0 auto;
    }

    .info-card {
      background: #fff;
      padding: 25px;
      border-radius: 12px;
      border: 1px solid #e5e5e5;
    }

    .info-card small {
      color: #999;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .info-card strong {
      display: block;
      font-size: 18px;
      font-weight: 700;
      margin-top: 8px;
    }

    /* Block 4 - Effects & Yield */
    .block-effects-yield {
      padding: 10px 20px;
    }

    .two-column-layout {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 40px;
      margin-bottom: 40px;
    }

    .column-section h3 {
      font-size: 28px;
      font-weight: 800;
      margin-bottom: 20px;
    }

    .effect-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 20px;
    }

    .tag {
      padding: 10px 20px;
      border-radius: 25px;
      font-weight: 600;
      font-size: 14px;
    }

    .tag-dark {
      background: #000;
      color: #fff;
    }

    .tag-light {
      background: #FFE5E5;
      color: #FF6B6B;
    }

    .tag-cyan {
      background: #E0F7FA;
      color: #00ACC1;
    }

    .yield-info-box {
      background: #f9f9f9;
      padding: 25px;
      border-radius: 12px;
      margin-top: 30px;
    }

    .yield-info-box small {
      color: #999;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .yield-info-box strong {
      display: block;
      font-size: 18px;
      margin-top: 8px;
    }

    @media (max-width: 768px) {
      .block-main-info,
      .two-column-layout,
      .basic-info-grid,
      .features-grid,
      .grid-layout-container {
        grid-template-columns: 1fr;
      }

      .top-products,
      .bottom-products {
        grid-template-columns: 1fr;
      }
    }

    .bud-images-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-top: 40px;
  }

  .bud-image-item {
    width: 100%;
    max-width: 100%;
    height: 300px;
    object-fit: cover;
    border-radius: 12px;
  }
  @media (max-width: 768px) {
    .bud-images-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  /* Tablet */
@media (max-width: 1024px) {
  .product-card-image {
    height: 300px;
  }
}

/* Mobile */
@media (max-width: 767px) {
  .product-card-image {
    height: 300px;
  }
}
</style>

<div class="product-details-section">
  {% for block in section.blocks %}
    {% case block.type %}
      {% when 'main_info' %}
        <div class="product-detail-block block-main-info" {{ block.shopify_attributes }}>
          <div class="image-column">
            {% if block.settings.trichome_image %}
              <img
                src="{{ block.settings.trichome_image | img_url: 'master' }}"
                
                class="trichome-image"
              >
            {% endif %}
            <p style="margin-top: 20px; color: #666;">{{ block.settings.image_description }}</p>
          </div>

          <div class="product-info-content">
            <h1>{{ block.settings.product_name }}</h1>
            <p class="genetics-info">{{ block.settings.genetics }}</p>

            <div class="info-badges">
  {% if block.settings.badge_1 != blank %}
    <span class="badge">{{ block.settings.badge_1 }}</span>
  {% endif %}
  {% if block.settings.badge_2 != blank %}
    <span class="badge">{{ block.settings.badge_2 }}</span>
  {% endif %}
  {% if block.settings.badge_3 != blank %}
    <span class="badge">{{ block.settings.badge_3 }}</span>
  {% endif %}
</div>

            <div class="effects-tabs">
              <div class="tab active">Top effects & flavors</div>
            </div>

            <div class="effects-grid">
              {% if block.settings.effect_1 != blank %}
              <div class="effect-item">• {{ block.settings.effect_1 }}</div>
              {% endif %}
              {% if block.settings.effect_2 != blank %}
              <div class="effect-item">• {{ block.settings.effect_2 }}</div>
              {% endif %}
              {% if block.settings.effect_3 != blank %}
              <div class="effect-item">• {{ block.settings.effect_3 }}</div>
              {% endif %}
              {% if block.settings.effect_4 != blank %}
              <div class="effect-item">• {{ block.settings.effect_4 }}</div>
              {% endif %}
              {% if block.settings.effect_5 != blank %}
              <div class="effect-item">• {{ block.settings.effect_5 }}</div>
              {% endif %}
            </div>

            <div class="terpenes-section">
              <h3>Terpenes</h3>
              <div class="terpene-list">
                {% if block.settings.terpene_1 != blank %}
                <span class="terpene-badge">
                  <span class="terpene-dot" style="background: #9C27B0;"></span>
                  {{ block.settings.terpene_1 }}
                </span>
                {% endif %}
                {% if block.settings.terpene_2 != blank %}
                <span class="terpene-badge">
                  <span class="terpene-dot" style="background: #FFA726;"></span>
                  {{ block.settings.terpene_2 }}
                </span>
                {% endif %}
                {% if block.settings.terpene_3 != blank %}
                <span class="terpene-badge">
                  <span class="terpene-dot" style="background: #42A5F5;"></span>
                  {{ block.settings.terpene_3 }}
                </span>
                {% endif %}
                {% if block.settings.terpene_4 != blank %}
                <span class="terpene-badge">
                  <span class="terpene-dot" style="background: #AB47BC;"></span>
                  {{ block.settings.terpene_4 }}
                </span>
                {% endif %}
                {% if block.settings.terpene_5 != blank %}
                <span class="terpene-badge">
                  <span class="terpene-dot" style="background: #FFCA28;"></span>
                  {{ block.settings.terpene_5 }}
                </span>
                {% endif %}
                {% if block.settings.terpene_6 != blank %}
                <span class="terpene-badge">
                  <span class="terpene-dot" style="background: #5C6BC0;"></span>
                  {{ block.settings.terpene_6 }}
                </span>
                {% endif %}
              </div>

              <div class="thc-scale">
  <div class="scale-header">
    <h4>Energy Level</h4>
  </div>
  <div class="scale-labels">
    <span>calming</span>
    <span>energizing</span>
  </div>
  <div class="scale-bar" data-scale="energy">
    <div class="scale-fill" style="width: {{ block.settings.energy_level | default: 30 }}%;">
      <div class="scale-handle"></div>
    </div>
  </div>

  <div class="scale-header" style="margin-top: 20px;">
    <h4>THC Potency</h4>
  </div>
  <div class="scale-labels">
    <span>low THC</span>
    <span>high THC</span>
  </div>
  <div class="scale-bar" data-scale="thc">
    <div class="scale-fill" style="width: {{ block.settings.thc_level | default: 85 }}%;">
      <div class="scale-handle"></div>
    </div>
  </div>
</div>
            </div>
          </div>
        </div>

      {% when 'description' %}
        <div class="product-detail-block block-description" {{ block.shopify_attributes }}>
          <h2>{{ block.settings.title }}</h2>
{% if block.settings.description_1 != blank %}
          <p class="description-text">{{ block.settings.description_1 }}</p>
          {% endif %}
          {% if block.settings.description_1 != blank %}
          <p class="description-text">{{ block.settings.description_2 }}</p>
          {% endif %}

          <div class="features-grid">
            {% if block.settings.feature_1_title != blank %}
            <div class="feature-item">
              <h4>{{ block.settings.feature_1_title }}</h4>
              <p>{{ block.settings.feature_1_desc }}</p>
            </div>
            {% endif %}
            {% if block.settings.feature_2_title != blank %}
            <div class="feature-item">
              <h4>{{ block.settings.feature_2_title }}</h4>
              <p>{{ block.settings.feature_2_desc }}</p>
            </div>
            {% endif %}
            {% if block.settings.feature_3_title != blank %}
            <div class="feature-item">
              <h4>{{ block.settings.feature_3_title }}</h4>
              <p>{{ block.settings.feature_3_desc }}</p>
            </div>
            {% endif %}
            {% if block.settings.feature_4_title != blank %}
            <div class="feature-item">
              <h4>{{ block.settings.feature_4_title }}</h4>
              <p>{{ block.settings.feature_4_desc }}</p>
            </div>
            {% endif %}
          </div>

          <!-- 4 Images in a row -->
          <div class="bud-images-grid">
            {% if block.settings.bud_image %}
              <img src="{{ block.settings.bud_image | img_url: 'medium' }}"  class="bud-image-item">
            {% endif %}
            {% if block.settings.bud_image_2 %}
              <img
                src="{{ block.settings.bud_image_2 | img_url: 'medium' }}"
               
                class="bud-image-item"
              >
            {% endif %}
            {% if block.settings.bud_image_3 %}
              <img
                src="{{ block.settings.bud_image_3 | img_url: 'medium' }}"
            
                class="bud-image-item"
              >
            {% endif %}
            {% if block.settings.bud_image_4 %}
              <img
                src="{{ block.settings.bud_image_4 | img_url: 'medium' }}"
               
                class="bud-image-item"
              >
            {% endif %}
          </div>
        </div>

      {% when 'product_selection' %}
        <div class="product-detail-block block-product-selection" {{ block.shopify_attributes }}>
          <div class="section-header">
            <small>{{ block.settings.header_small }}</small>
            <h2>{{ block.settings.header_title }}</h2>
            <p>{{ block.settings.header_description }}</p>
          </div>

          <div class="grid-layout-container">
            <!-- Left Column -->
            <div class="left-column">
              <!-- Top 3 Products -->
              <div class="top-products">
                {% if block.settings.product_1 != blank %}
                  <div class="product-card">
                    {% if block.settings.product_1.featured_image %}
                      <img
                        src="{{ block.settings.product_1.featured_image | img_url: 'medium' }}"
                        alt="{{ block.settings.product_1.title }}"
                        class="product-card-image"
                      >
                    {% endif %}
                    <div class="product-card-content">
                      <h3 class="product-card-title">{{ block.settings.product_1.title }}</h3>
                      <a href="{{ block.settings.product_1.url }}" class="view-product-btn">View Product</a>
                    </div>
                  </div>
                {% endif %}

                {% if block.settings.product_2 != blank %}
                  <div class="product-card">
                    {% if block.settings.product_2.featured_image %}
                      <img
                        src="{{ block.settings.product_2.featured_image | img_url: 'medium' }}"
                        alt="{{ block.settings.product_2.title }}"
                        class="product-card-image"
                      >
                    {% endif %}
                    <div class="product-card-content">
                      <h3 class="product-card-title">{{ block.settings.product_2.title }}</h3>
                      <a href="{{ block.settings.product_2.url }}" class="view-product-btn">View Product</a>
                    </div>
                  </div>
                {% endif %}

                {% if block.settings.product_3 != blank %}
                  <div class="product-card">
                    {% if block.settings.product_3.featured_image %}
                      <img
                        src="{{ block.settings.product_3.featured_image | img_url: 'medium' }}"
                        alt="{{ block.settings.product_3.title }}"
                        class="product-card-image"
                      >
                    {% endif %}
                    <div class="product-card-content">
                      <h3 class="product-card-title">{{ block.settings.product_3.title }}</h3>
                      <a href="{{ block.settings.product_3.url }}" class="view-product-btn">View Product</a>
                    </div>
                  </div>
                {% endif %}
              </div>

              <!-- Bottom Content Area -->
              <div class="bottom-content">
                <div class="bottom-content-inner">
                  <h3>{{ block.settings.left_content_title }}</h3>
                  <p>{{ block.settings.left_content_description }}</p>
                </div>
              </div>
            </div>

            <!-- Right Column -->
            <div class="right-column">
              <!-- Top Content Area -->
              <div class="top-content">
                <div class="top-content-inner">
                  <h3>{{ block.settings.right_content_title }}</h3>
                  <p>{{ block.settings.right_content_description }}</p>
                </div>
              </div>

              <!-- Bottom 3 Products -->
              <div class="bottom-products">
                {% if block.settings.product_4 != blank %}
                  <div class="product-card">
                    {% if block.settings.product_4.featured_image %}
                      <img
                        src="{{ block.settings.product_4.featured_image | img_url: 'medium' }}"
                        alt="{{ block.settings.product_4.title }}"
                        class="product-card-image"
                      >
                    {% endif %}
                    <div class="product-card-content">
                      <h3 class="product-card-title">{{ block.settings.product_4.title }}</h3>
                      <a href="{{ block.settings.product_4.url }}" class="view-product-btn">View Product</a>
                    </div>
                  </div>
                {% endif %}

                {% if block.settings.product_5 != blank %}
                  <div class="product-card">
                    {% if block.settings.product_5.featured_image %}
                      <img
                        src="{{ block.settings.product_5.featured_image | img_url: 'medium' }}"
                        alt="{{ block.settings.product_5.title }}"
                        class="product-card-image"
                      >
                    {% endif %}
                    <div class="product-card-content">
                      <h3 class="product-card-title">{{ block.settings.product_5.title }}</h3>
                      <a href="{{ block.settings.product_5.url }}" class="view-product-btn">View Product</a>
                    </div>
                  </div>
                {% endif %}

                {% if block.settings.product_6 != blank %}
                  <div class="product-card">
                    {% if block.settings.product_6.featured_image %}
                      <img
                        src="{{ block.settings.product_6.featured_image | img_url: 'medium' }}"
                        alt="{{ block.settings.product_6.title }}"
                        class="product-card-image"
                      >
                    {% endif %}
                    <div class="product-card-content">
                      <h3 class="product-card-title">{{ block.settings.product_6.title }}</h3>
                      <a href="{{ block.settings.product_6.url }}" class="view-product-btn">View Product</a>
                    </div>
                  </div>
                {% endif %}
              </div>
            </div>
          </div>
        </div>

      {% when 'categories_info' %}
        <div class="product-detail-block block-categories" {{ block.shopify_attributes }}>
          <div class="section-header">
            <h2>{{ block.settings.info_title }}</h2>
          </div>

          <div class="basic-info-grid">
            {% if block.settings.info_1_label != blank %}
            <div class="info-card">
              <small>{{ block.settings.info_1_label }}</small>
              <strong>{{ block.settings.info_1_value }}</strong>
            </div>
            {% endif %}
