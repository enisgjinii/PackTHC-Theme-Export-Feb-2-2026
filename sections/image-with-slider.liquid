{%- liquid
	assign section_id  = '#shopify-section-' | append: section.id
	assign animation   = settings.section_animation
	assign full        = section.settings.full
	assign layout      = section.settings.layout
	assign show_arrows = section.settings.show_arrows
	assign show_dots   = section.settings.show_dots
	assign show_number = section.settings.show_number
-%}

<style>
	{{ section_id }} .section-wrapper {
		padding-top: {{ section.settings.padding_top_mobile }}px;
		padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
	}

	{%- if section.settings.number_color != blank -%}
		{{ section_id }} .number {
			color: {{ section.settings.number_color }};
		}
	{%- endif -%}

	@media (min-width: 992px) {
		{{ section_id }} .section-wrapper {
			padding-top: {{ section.settings.padding_top }}px;
			padding-bottom: {{ section.settings.padding_bottom }}px;
		}

		{{ section_id }} .image {
			width: {{ section.settings.width }}%;
		}

		{{ section_id }} .content {
			width: {{ 100 | minus: section.settings.width }}%;
		}
	}
</style>

<div class="section-wrapper">
	<div class="{% if full %}stretch-section{% else %}container{% endif %}">
		<div class="image-with-text-slider {{ layout }}-first color-{{ section.settings.color_scheme }}">
			<div class="content carousel-swiper">
				<template data-options>
					{
						{%- if section.settings.loop -%}
							"loop": true,
						{%- endif -%}

						{%- if section.settings.autoplay -%}
							"autoplay": {
								"delay": {{ section.settings.delay | times: 1000 }},
								"disableOnInteraction": false,
								"pauseOnMouseEnter": true
							},
						{%- endif -%}

						{%- if show_arrows -%}
							"navigation": {
								"nextEl": "{{ section_id }} .swiper-button-next",
								"prevEl": "{{ section_id }} .swiper-button-prev"
							},
						{%- endif -%}

						{%- if show_dots -%}
							"pagination": {
								"el": "{{ section_id }} .swiper-pagination",
								"clickable": true
							},
						{%- endif -%}

						"allowTouchMove": false,
						"effect": "fade",
						"direction": "vertical",
						"breakpoints": {
							"240": {
								"slidesPerView": 1,
								"direction": "horizontal"
							},
							"992": {
								"slidesPerView": 1
							}
						}
					}
				</template>

				<div class="swiper">
					<div class="swiper-wrapper">
						{%- for block in section.blocks -%}
							{%- liquid
								assign heading       = block.settings.heading_text
								assign heading_size  = block.settings.heading_size
								assign description   = block.settings.text
							-%}

							<div class="swiper-slide content-inner text-center flex-align-center" data-slider="{{- forloop.index -}}">
								{%- if show_number -%}
									<div class="number rte{% if animation %} scroll-trigger{% endif %}">{%- if forloop.index < 10 -%}0{%- endif -%}{{- forloop.index -}}</div>
								{%- endif -%}

								{%- if heading != blank -%}
									<h2 class="heading {{ heading_size }} rte{% if animation %} scroll-trigger{% endif %}">{{- heading -}}</h2>
								{%- endif -%}

								{%- if description != blank -%}
									<div class="description rte{% if animation %} scroll-trigger{% endif %}">{{- description -}}</div>
								{%- endif -%}

								{%- if block.settings.button_label != blank -%}
								<div class="button-link">
									<a class="button primary-button" href="{{ block.settings.button_link | default: '#' }}">
										{{- block.settings.button_label -}}

										{% if settings.select_button == 'direction' %}
											{%- render 'icon', code: 'direction-button' -%}
										{% elsif settings.select_button == 'arrow' %}
											{%- render 'icon', code: 'arrow-button' -%}
										{% endif %}
									</a>
								</div>
								{%- endif -%}
							</div>
						{%- endfor -%}
					</div>
				</div>

				{%- if show_arrows or show_dots -%}
					<div class="swiper-controls">
						{%- if show_arrows -%}
							<button class="swiper-button-prev" title ="{{ 'general.swipper.prev' | t }}" aria-label="{{ 'general.swipper.prev' | t }}" id="{{ 'general.swipper.prev' | t }}" aria-labelledby="{{ 'general.swipper.prev' | t }}">{%- render 'icon', code: 'arrow-left-slider' -%}</button>
						{%- endif -%}

						{%- if show_dots -%}
							<div class="swiper-pagination" tabindex="-1"></div>
						{%- endif -%}

						{%- if show_arrows -%}
							<button class="swiper-button-next" title ="{{ 'general.swipper.next' | t }}" aria-label="{{ 'general.swipper.next' | t }}" id="{{ 'general.swipper.next' | t }}" aria-labelledby="{{ 'general.swipper.next' | t }}">{%- render 'icon', code: 'arrow-right-slider' -%}</button>
						{%- endif -%}
					</div>
				{%- endif -%}
			</div>

			<div class="image adapt-media{% if animation %} scroll-trigger{% endif %} carousel-swiper">
				<template data-options data-css-mode="off">
					{
						{%- if section.settings.loop -%}
							"loop": true,
						{%- endif -%}

						{%- if section.settings.autoplay -%}
							"autoplay": {
								"delay": {{ section.settings.delay | times: 1000 }},
								"disableOnInteraction": false,
								"pauseOnMouseEnter": true
							},
						{%- endif -%}

						{%- if show_arrows -%}
							"navigation": {
								"nextEl": "{{ section_id }} .swiper-button-next",
								"prevEl": "{{ section_id }} .swiper-button-prev"
							},
						{%- endif -%}

						{%- if show_dots -%}
							"pagination": {
								"el": "{{ section_id }} .swiper-pagination",
								"clickable": true
							},
						{%- endif -%}

						"effect": "fade",
						"allowTouchMove": false,
						"breakpoints": {
							"240": {
								"slidesPerView": 1
							},
							"992": {
								"slidesPerView": 1
							}
						}
					}
				</template>
				<div class="swiper">
					<div class="swiper-wrapper">
						{%- for block in section.blocks -%}
							{% assign image = block.settings.image %}

							<div class="swiper-slide {% if image == blank %}adapt-svg-placeholder{% endif %}{% if settings.image_lazy and image %} lazy-image{% endif %}" data-image={{- forloop.index -}}>
								{%- liquid
									if image != blank
										render 'lazy-image', image: image, width: 1200
									else
										render 'icon', code: 'placeholder'
									endif
								-%}
							</div>
						{%- endfor -%}
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

{% schema %}
{
	"name": "t:sections.image-with-text-slider.name",
	"tag": "section",
	"class": "image-with-text-slider-section",
	"disabled_on": {
		"groups": ["header", "footer"]
	},
	"settings": [
		{
			"type": "checkbox",
			"id": "full",
			"default": false,
			"label": "t:general.layout.full.label"
		},
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"label": "t:settings_schema.colors.label",
			"default": "scheme-1"
		},
		{
			"type": "range",
			"id": "width",
			"min": 0,
			"max": 80,
			"step": 1,
			"default": 50,
			"unit": "%",
			"label": "t:general.dimensions.width.label"
		},
		{
			"type": "header",
			"content": "t:sections.image-with-text-slider.settings.header_content.content"
		},
		{
			"type": "checkbox",
			"id": "show_number",
			"default": true,
			"label": "t:sections.image-with-text-slider.settings.show_number.label"
		},
		{
			"type": "color",
			"id": "number_color",
			"label": "t:settings_schema.colors.name"
		},
		{
			"type": "header",
			"content": "t:general.slider.options.label"
		},
		{
			"type": "checkbox",
			"id": "show_arrows",
			"default": true,
			"label": "t:general.slider.show_arrows.label"
		},
		{
			"type": "checkbox",
			"id": "show_dots",
			"default": true,
			"label": "t:general.slider.show_dots.label"
		},
		{
			"type": "checkbox",
			"id": "loop",
			"default": false,
			"label": "t:general.slider.loop.label"
		},
		{
			"type": "checkbox",
			"id": "autoplay",
			"default": false,
			"label": "t:general.slider.autoplay.label"
		},
		{
			"type": "range",
			"id": "delay",
			"min": 3,
			"max": 20,
			"step": 1,
			"default": 5,
			"label": "t:general.slider.delay.label"
		},
		{
			"type": "header",
			"content": "t:general.padding.header_padding.content"
		},
		{
			"type": "range",
			"id": "padding_top",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 50,
			"unit": "px",
			"label": "t:general.padding.top.label"
		},
		{
			"type": "range",
			"id": "padding_bottom",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 50,
			"unit": "px",
			"label": "t:general.padding.bottom.label"
		},
		{
			"type": "paragraph",
			"content": "t:general.padding.paragraph_mobile.content"
		},
		{
			"type": "range",
			"id": "padding_top_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 20,
			"unit": "px",
			"label": "t:general.padding.top.label"
		},
		{
			"type": "range",
			"id": "padding_bottom_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 20,
			"unit": "px",
			"label": "t:general.padding.bottom.label"
		}
	],
	"blocks": [
	{
		"type": "item",
			"name": "t:sections.map.blocks.item.name",
			"settings": [
				{
					"type": "image_picker",
					"id": "image",
					"label": "t:general.image.label"
				},
				{
					"type": "inline_richtext",
					"id": "heading_text",
					"default": "Image with text",
					"label": "t:general.typography.heading.label"
				},
				{
					"type": "select",
					"id": "heading_size",
					"options": [
						{
							"value": "h4",
							"label": "t:general.typography.heading_size.option_1.label"
						},
						{
							"value": "h3",
							"label": "t:general.typography.heading_size.option_2.label"
						},
						{
							"value": "h2",
							"label": "t:general.typography.heading_size.option_3.label"
						}
					],
					"default": "h3",
					"label": "t:general.typography.heading_size.label"
				},
				{
					"type": "richtext",
					"id": "text",
					"default": "<p>Pair text with an image to focus on your chosen product, collection, or blog post. Add details on availability, style, or even provide a review.</p>",
					"label": "t:general.typography.description.label"
				},
				{
					"type": "text",
					"id": "button_label",
					"default": "Button label",
					"label": "t:general.typography.button_label.label"
				},
				{
					"type": "url",
					"id": "button_link",
					"label": "t:general.typography.link.label"
				}
			]
		}
	],
	"presets": [
		{
			"name": "t:sections.image-with-text-slider.presets.name",
			"blocks": [
				{
					"type": "item"
				},
				{
					"type": "item"
				},
				{
					"type": "item"
				}
			]
		}
	]
}
{% endschema %}
