    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#0a2e2e"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "step_label",
          "label": "Step Label",
          "default": "STEP 1"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "TALK TO US"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "WHERE ARE YOU AT AND WHAT'S KEEPING YOU UP?"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "We've heard it all before and nothing shocks us. We'll figure out exactly what needs fixing and how we'll fix it together."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Illustration"
        },
        {
          "type": "color",
          "id": "card_bg",
          "label": "Card Background",
          "default": "#f5ede0"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "How It Works Stack",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "step_label": "STEP 1",
            "title": "TALK TO US",
            "subtitle": "WHERE ARE YOU AT AND WHAT'S KEEPING YOU UP?",
            "description": "We've heard it all before and nothing shocks us. We'll figure out exactly what needs fixing and how we'll fix it together.",
            "card_bg": "#f5ede0"
          }
        },
        {
          "type": "step",
          "settings": {
            "step_label": "STEP 2",
            "title": "WE DIAGNOSE",
            "subtitle": "DEEP DIVE INTO YOUR NUMBERS AND SYSTEMS",
            "description": "We audit your books, identify the gaps and build a clear picture of where you stand financially.",
            "card_bg": "#fde0e8"
          }
        },
        {
          "type": "step",
          "settings": {
            "step_label": "STEP 3",
            "title": "BUILD THE PLAN",
            "subtitle": "A ROADMAP BUILT AROUND YOUR CREATIVE GOALS",
            "description": "We create a custom financial strategy tailored to how you work, earn and grow.",
            "card_bg": "#a8f5c8"
          }
        },
        {
          "type": "step",
          "settings": {
