

<div class="container">
  <div class="left-section">
    <div class="image-container">
      {% if section.settings.left_image != blank %}
        <img src="{{ section.settings.left_image | image_url }}" alt="Left Image">
      {% else %}
        <div class="image-placeholder"></div>
      {% endif %}
    </div>
  </div>

  <div class="right-section">
    <h1 class="main-title">{{ section.settings.main_heading }}</h1>
    <p class="description">{{ section.settings.main_description }}</p>

    {% for block in section.blocks %}
      <div class="section" id="section-{{ forloop.index }}">
        <div class="section-header" onclick="toggleSection('block-{{ forloop.index }}')">
          <h2 class="section-title">{{ block.settings.title }}</h2>
          <svg class="chevron" id="block-{{ forloop.index }}-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </div>
        <div class="section-content" id="block-{{ forloop.index }}-content">
          <p class="section-text">{{ block.settings.content }}</p>
          {% if block.settings.link != blank %}
            <div class="learn-more-container">
              <a href="{{ block.settings.link }}" class="learn-more" target="_blank">
                Learn More <span class="arrow">↗</span>
              </a>
            </div>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</div>


<style>
   
       

        .container {
            width: 100%;
            margin: 0 auto;
            background: white;
            padding: 40px;
            display: flex;
            gap: 40px;
            align-items: stretch;
            min-height: 80vh;
        }

        .left-section {
            width: 30%;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .right-section {
            width: 70%;
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
        }

        .image-container {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 4px;
            overflow: hidden;
            background: #f8f9fa;
        }

        .image-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 4px;
        }

        .image-placeholder {
            width: 100%;
            height: 100%;
            background: #f8f9fa;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #1e40af;
            font-size: 18px;
            font-weight: 600;
            text-align: center;
            border-radius: 4px;
            background-image: url('faq.webp');
            background-repeat: no-repeat;
            background-position: center;
        }

        .main-title {
            font-size: 48px;
            font-weight: 700;
            color: #1e40af;
            margin-bottom: 30px;
            letter-spacing: -0.5px;
        }

        .description {
            font-size: 18px;
            color: #1e40af;
            margin-bottom: 50px;
            line-height: 1.7;
        }

        .section {
            border-bottom: 2px solid #1e40af;
            margin-bottom: 0;
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 25px 0;
            cursor: pointer;
            user-select: none;
        }

        .section-title {
            font-size: 32px;
            font-weight: 700;
            color: #1e40af;
            letter-spacing: -0.3px;
        }

        .chevron {
            width: 24px;
            height: 24px;
            transition: transform 0.3s ease;
            color: #1e40af;
        }

        .chevron.rotated {
            transform: rotate(180deg);
        }

        .section-content {
            overflow: hidden;
            max-height: 0;
            transition: max-height 0.3s ease, padding 0.3s ease;
        }

        .section-content.expanded {
            max-height: 500px;
            padding: 20px 0 25px 0;
        }

        .section-text {
            font-size: 16px;
            color: #374151;
            line-height: 1.6;
            margin-bottom: 20px;
        }

        .learn-more-container {
            text-align: right;
        }

        .learn-more {
            color: #60a5fa;
            font-size: 16px;
            text-decoration: none;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .learn-more:hover {
            color: #3b82f6;
            text-decoration: underline;
        }

        .arrow {
            font-size: 14px;
        }

        .industry-content {
            display: block;
            padding: 20px 0 25px 0;
        }

        @media (max-width: 1024px) {
            body {
                padding: 40px 50px;
            }
        }

        @media (max-width: 768px) {
            body {
                padding: 40px 20px;
            }
            
            .container {
                flex-direction: column;
                padding: 30px 20px;
            }
            
            .left-section, .right-section {
                width: 100%;
                position: static;
            }
            
            .image-container {
                height: 300px;
                margin-bottom: 30px;
            }
            
            .main-title {
                font-size: 36px;
            }
            
            .section-title {
                font-size: 24px;
                right: -30px;
            animation-delay: 2s;
            }
        
            
        

        .floating-3 {
            width: 40px;
            height: 40px;
            top: 60%;
            right: -20px;
            animation-delay: 4s;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-20px) rotate(180deg); }
        }

        @media (max-width: 1024px) {
            body {
                padding: 30px 40px;
            }
            
            .container {
                padding: 40px;
            }
        }

        @media (max-width: 768px) {
            body {
                padding: 20px;
            }
            
            .container {
                flex-direction: column;
                padding: 30px 20px;
                gap: 30px;
                min-height: auto;
            }
            
            .left-section, .right-section {
                width: 100%;
            }
            
            .image-container {
                height: 300px;
                margin-bottom: 0;
            }
            
            .main-title {
                font-size: 36px;
            }
            
            .section-title {
                font-size: 24px;
            }
            
            .floating-element {
                display: none;
            }
        }
    </style>






{% schema %}
{
  "name": "The Gamut Difference",
  "tag": "section",
  "class": "gamut-difference",
  "settings": [
    {
      "type": "image_picker",
      "id": "left_image",
      "label": "Left Section Image"
    },
    {
      "type": "text",
      "id": "main_heading",
      "label": "Main Title",
      "default": "The Gamut Difference"
    },
    {
      "type": "textarea",
      "id": "main_description",
      "label": "Description",
      "default": "At Gamut Packaging, our specialized expertise, unique solutions, and end-to-end support go above and beyond, delivering tailored products crafted for your business needs."
    }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Accordion Title",
          "default": "Product Catalog"
        },
        {
          "type": "textarea",
          "id": "content",
          "label": "Accordion Content",
          "default": "With over 3,000 SKUs, Gamut Packaging offers a wide selection of standard and custom solutions tailored to your unique packaging needs."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Learn More Link"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "The Gamut Difference",
      "category": "Custom"
    }
  ]
}
{% endschema %}

<script>
  function toggleSection(id) {
    const content = document.getElementById(id + '-content');
    const chevron = document.getElementById(id + '-chevron');

    if (content.classList.contains('expanded')) {
      content.classList.remove('expanded');
      chevron.classList.remove('rotated');
    } else {
      content.classList.add('expanded');
      chevron.classList.add('rotated');
    }
  }
</script>
