{%- liquid
	assign section_id = '#shopify-section-' | append: section.id
	assign delay_time = section.settings.delay_time | times: 1000
	assign form_class = 'newsletter-popup-form'

	if section.settings.first_visit
		assign form_class = 'newsletter-popup-form first-visit'
	endif
-%}

<style>
	{%- for block in section.blocks -%}
		{%- if block.type != 'image' -%}
			{{ section_id }} [data-id="{{ block.id }}"] {
				padding-top: {{ block.settings.padding_top }}px;
				padding-bottom: {{ block.settings.padding_bottom }}px;
			}
		{%- endif -%}
	{%- endfor -%}
</style>

{%- form 'customer', id: nil, class: form_class, data-delay: delay_time, data-mode: section.settings.mode, data-id: section_id -%}
	<input type="hidden" name="contact[tags]" value="newsletter">

	<div class="newsletter-inner color-{{ section.settings.color_scheme }}">
		{%- for block in section.blocks -%}
			{%- if block.type == 'image' -%}
				<div class="newsletter-image">
					{%- assign image = block.settings.image -%}

					<div class="popup-media popup-item popup-{{ block.type }}" data-id="{{ block.id }}" {{ block.shopify_attributes }}>
						<div class="popup-media-inner{% if settings.image_lazy and image != blank %} lazy-image{% endif %}">
							{%- liquid
								if image != blank
									render 'lazy-image', image: image, width: 960
								else
									render 'icon', code: 'placeholder'
								endif
							-%}
						</div>
					</div>
				</div>
			{%- endif -%}
		{%- endfor -%}

		<div class="newsletter-content text-center">
			{% comment %} Logo {% endcomment %}
				{%- assign logo = section.settings.logo -%}

				{%- if logo != blank -%}
					<a class="logo" href="{{ routes.root_url }}">
						{{- logo | image_url: width: logo.width | image_tag -}}

						<span class="sr-only">{{- shop.name -}}</span>
					</a>
				{%- endif -%}

			{%- for block in section.blocks -%}
				{%- if block.type != 'image' -%}
					<div class="popup-item popup-{{ block.type }}" data-id="{{ block.id }}" {{ block.shopify_attributes }}>
						{%- case block.type -%}
							{%- when '@app' -%}
								{%- render block -%}
							{%- when 'sub-heading' -%}
								<div class="sub-heading">{{- block.settings.text -}}</div>
							{%- when 'heading' -%}
								<div class="heading">{{- block.settings.text -}}</div>
							{%- when 'description' -%}
								<div class="description rte">{{- block.settings.text -}}</div>
							{%- when 'form' -%}
								<div class="field-form">
									<label for="{{ section.id }}-field" class="field-input-wrapper">
										<span class="sr-only">{{- 'templates.form.email' | t -}}</span>

										<input class="field-input"
											id="{{ section.id }}-field"
											type="email"
											name="contact[email]"
											value="{{ form.email }}"
											aria-required="true"
											autocorrect="off"
											autocapitalize="off"
											autocomplete="email"
											{% if form.errors %}
												autofocus
												aria-invalid="true"
												aria-describedby="contact-error"
											{% elsif form.posted_successfully? %}
												aria-describedby="contact-success"
											{% endif %}
											placeholder="{{ block.settings.placeholder }}"
											pattern="^([a-zA-Z0-9_\-\.]+)@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.)|(([a-zA-Z0-9\-]+\.)+))([a-zA-Z]{2,4}|[0-9]{1,3})(\]?)$"
											required />

										{%- render 'icon', code: 'email' -%}
									</label>

									<button type="submit" class="button primary-button">
										<span class="button-text">{{- block.settings.button -}}</span>

										{% if settings.select_button == 'direction' %}
											{%- render 'icon', code: 'direction-button' -%}
										{% elsif settings.select_button == 'arrow' %}
											{%- render 'icon', code: 'arrow-button' -%}
										{% endif %}
									</button>
								</div>

								{%- if block.settings.form_description != blank -%}
									<div class="field-form-description">
										{{- block.settings.form_description -}}
									</div>
								{%- endif -%}
						{%- endcase -%}
					</div>
				{%- endif -%}
			{%- endfor -%}

			<span class="close-popup close-button">{{- 'templates.form.popup_close' | t -}}</span>
		</div>

		{%- if form.errors -%}
			<small class="message error-message" id="{{ section.id }}-contact-error">
				{%- liquid
					render 'icon', code: 'error'

					echo form.errors.translated_fields['email'] | capitalize
					echo form.errors.messages['email']
				-%}
			</small>
		{%- endif -%}

		{%- if form.posted_successfully? -%}
			<h3 class="message success-message" id="{{ section.id }}-contact-success" tabindex="-1" autofocus>
				{%- liquid
					render 'icon', code: 'success'

					echo 'newsletter.success' | t
				-%}
			</h3>
		{%- endif -%}
	</div>
{%- endform -%}

{% schema %}
{
	"name": "t:sections.newsletter-popup.name",
	"tag": "section",
	"class": "newsletter-popup-section closed",
	"limit": 1,
	"enabled_on": {
		"groups": ["footer"]
	},
	"settings": [
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"label": "t:settings_schema.colors.label",
			"default": "scheme-1"
		},
		{
			"type": "select",
			"id": "mode",
			"options": [
				{
					"value": "test",
					"label": "t:general.mode.option_1.label"
				},
				{
					"value": "",
					"label": "t:general.mode.option_2.label"
				}
			],
			"default": "test",
			"label": "t:general.mode.label",
			"info": "t:general.mode.info"
		},
		{
			"type": "checkbox",
			"id": "first_visit",
			"label": "t:sections.newsletter-popup.settings.first_visit.label",
			"info": "t:sections.newsletter-popup.settings.first_visit.info",
			"default": true
		},
		{
			"type": "range",
			"id": "delay_time",
			"label": "t:sections.newsletter-popup.settings.delay_time.label",
			"info": "t:sections.newsletter-popup.settings.delay_time.info",
			"default": 3,
			"min": 0,
			"max": 10,
			"step": 1,
			"unit": "s"
		},
		{
			"type": "image_picker",
			"id": "logo",
			"label": "t:sections.footer.settings.ft_logo.label"
		},
	],
	"blocks": [
		{
			"type": "@app"
		},
		{
			"type": "image",
			"name": "t:general.image.label",
			"settings": [
				{
					"type": "image_picker",
					"id": "image",
					"label": "t:general.image.label"
				}
			]
		},
		{
			"type": "heading",
			"name": "t:general.typography.heading.label",
			"settings": [
				{
					"type": "richtext",
					"id": "text",
					"default": "<h4>Heading</h4>",
					"label": "t:general.typography.text.label"
				},
				{
					"type": "range",
					"id": "padding_top",
					"min": 0,
					"max": 100,
					"step": 1,
					"default": 20,
					"unit": "px",
					"label": "t:general.padding.padding_top.label"
				},
				{
					"type": "range",
					"id": "padding_bottom",
					"min": 0,
					"max": 100,
					"step": 1,
					"default": 20,
					"unit": "px",
					"label": "t:general.padding.padding_bottom.label"
				}
			]
		},
		{
			"type": "description",
			"name": "t:general.typography.description.label",
			"settings": [
				{
					"type": "richtext",
					"id": "text",
					"default": "<p>Be the first to know about new collections and exclusive offers.</p>",
					"label": "t:general.typography.text.label"
				},
				{
					"type": "range",
					"id": "padding_top",
					"min": 0,
					"max": 100,
					"step": 1,
					"default": 0,
					"unit": "px",
					"label": "t:general.padding.padding_top.label"
				},
				{
					"type": "range",
					"id": "padding_bottom",
					"min": 0,
					"max": 100,
					"step": 1,
					"default": 20,
					"unit": "px",
					"label": "t:general.padding.padding_bottom.label"
				}
			]
		},
		{
			"type": "form",
			"name": "t:sections.newsletter-popup.settings.form.label",
			"limit": 1,
			"settings": [
				{
					"type": "text",
					"id": "placeholder",
					"default": "Placeholder text",
					"label": "t:sections.newsletter-popup.settings.placeholder.label"
				},
				{
					"type": "text",
					"id": "button",
					"default": "Button label",
					"label": "t:general.typography.button_label.label"
				},
				{
					"type": "range",
					"id": "padding_top",
					"min": 0,
					"max": 100,
					"step": 1,
					"default": 0,
					"unit": "px",
					"label": "t:general.padding.padding_top.label"
				},
				{
					"type": "range",
					"id": "padding_bottom",
					"min": 0,
					"max": 100,
					"step": 1,
					"default": 20,
					"unit": "px",
					"label": "t:general.padding.padding_bottom.label"
				}
			]
		}
	],
	"presets": [
		{
			"name": "t:sections.newsletter-popup.presets.name",
			"blocks": [
				{
					"type": "image"
				},
				{
					"type": "heading"
				},
				{
					"type": "description"
				},
				{
					"type": "form"
				}
			]
		}
	]
}
{% endschema %}