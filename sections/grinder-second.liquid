{% comment %}
  Who It's For — Scroll-Jacked Sticky Card Fan Section
{% endcomment %}

<section
  id="wif-{{ section.id }}"
  class="wif-section"
  style="
    --wif-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --wif-text: {{ section.settings.text_color | default: '#0a2e2e' }};
    --wif-accent: {{ section.settings.accent_color | default: '#d6ffe8' }};
    --total-cards: {{ section.blocks.size }};
  "
>
  <div class="wif-sticky">
    <div class="wif-inner">
      <!-- Header -->
      <div class="wif-header">
        <span class="wif-badge">{{ section.settings.badge_text | default: 'ACCOUNTING FOR CREATIVES' }}</span>
        <h2 class="wif-title">{{ section.settings.title | default: "WHO IT'S FOR" }}</h2>
        <p class="wif-subtitle">{{ section.settings.subtitle | default: 'CREATIVES CREATE, WE CALCULATE' }}</p>
      </div>

      <!-- Cards Container -->
      <div class="wif-cards" id="wif-cards-{{ section.id }}">
        {% for block in section.blocks %}
          <div
            class="wif-card"
            data-card-index="{{ forloop.index0 }}"
            style="
              --card-bg: {{ block.settings.card_color | default: '#fde0e8' }};
              --card-index: {{ forloop.index0 }};
              z-index: {{ forloop.index }};
            "
          >
            <h3 class="wif-card__title">{{ block.settings.card_title }}</h3>
            {% if block.settings.card_image %}
              <img
                src="{{ block.settings.card_image | img_url: '400x' }}"
                alt="{{ block.settings.card_title }}"
                class="wif-card__img"
              >
            {% endif %}
            <p class="wif-card__desc">{{ block.settings.card_description }}</p>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<style>
    .wif-section {
      background: var(--wif-bg);
      color: var(--wif-text);
      height: calc(var(--total-cards) * 500px + 100vh);
      position: relative;
    }

    .wif-sticky {
      position: sticky;
      top: 0;
      height: 100vh;
      width: 100%;
      overflow: hidden;
    }

    .wif-inner {
      height: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 60px 20px 80px;
      position: relative;
    }

    /* ── HEADER ── */
    .wif-header {
      text-align: center;
      margin-bottom: 60px;
      position: relative;
      z-index: 10;
    }

    .wif-badge {
      display: inline-block;
      background: var(--wif-accent);
      color: var(--wif-text);
      font-size: 14px;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      padding: 6px 16px;
      border-radius: 4px;
      margin-bottom: 12px;
    }

    .wif-title {
      font-size: clamp(60px, 8vw, 140px);
      font-weight: 900;
      line-height: 0.95;
      letter-spacing: -2px;
      text-transform: uppercase;
      margin: 0;
      color: #000000;
    }

    .wif-subtitle {
      font-size: clamp(12px, 1vw, 18px);
      font-weight: 700;
      letter-spacing: 3px;
      text-transform: uppercase;
      margin-top: 10px;
      color: #000000;
    }

    /* ── CARDS CONTAINER ── */
    .wif-cards {
      position: relative;
      width: 100%;
      max-width: 1200px;
      height: 420px;
      margin-top: 50px;
    }

    /* ── INDIVIDUAL CARD ── */
    .wif-card {
      position: absolute;
      bottom: 0;
      left: 50%;
      width: 260px;
      height: 440px;
      background: var(--card-bg);
      border-radius: 20px;
      padding: 36px 28px;
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      gap: 12px;
      transform-origin: bottom center;
      transform: translateX(-50%) translateY(120%) rotate(0deg);
      opacity: 0;
      transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1),
                  opacity 0.4s ease,
                  box-shadow 0.3s ease;
      pointer-events: auto;
      box-shadow: 0 10px 40px rgba(0,0,0,0.08);
      overflow: hidden;
    }

    .wif-card__title {
      font-size: clamp(24px, 3vw, 32px);
      font-weight: 900;
      text-transform: uppercase;
      line-height: 1.05;
      color: var(--wif-text);
      margin: 0;
    }

    .wif-card__desc {
      font-size: 14px;
      line-height: 1.5;
      font-style: italic;
      color: var(--wif-text);
      opacity: 0.8;
      margin: 0;
    }

    /* ── MOBILE ── */
    @media (max-width: 768px) {
    .wif-section {
      height: calc(var(--total-cards) * 300px + 100vh);  /* 250px tha → 300px */
    }

    .wif-sticky {
      position: sticky;
      top: 0;
      height: 100vh;
      overflow: visible;   /* hidden tha → visible karo */
    }

    .wif-inner {
      height: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      padding: 40px 20px 20px;
      gap: 0;
      overflow: hidden;
    }

    .wif-header {
      margin-bottom: 16px;
      z-index: 100;
      position: relative;
      flex-shrink: 0;
    }

    .wif-title {
      font-size: clamp(32px, 9vw, 52px);
    }

    .wif-subtitle {
      font-size: 11px;
    }

    .wif-badge {
      font-size: 11px;
      padding: 4px 12px;
    }

    .wif-cards {
      position: relative;
      width: 100%;

      flex-shrink: 0;
      z-index: 1;
    }

    .wif-card {
      width: 88vw;          /* 78vw tha → badhaao */
      max-width: 340px;     /* 300px tha → badhaao */
      height: 450px;
      padding: 20px 18px;
      left: 50%;
      bottom: 0;
    }

    .wif-card__title { font-size: 30px; }
    .wif-card__desc  { font-size: 18px; }
  }

  .wif-card__img {
    width: 100%;
    height: 160px;
    object-fit: cover;
    border-radius: 12px;
    margin-bottom: 12px;
  }

  @media (max-width: 768px) {
    .wif-card__img {
      height: 240px;
      margin-bottom: 8px;
    }
  }
  
</style>

<script>
  (function () {
    const sectionId = '{{ section.id }}';
    const sectionEl = document.querySelector('#wif-' + sectionId);
    const cards = Array.from(document.querySelectorAll('#wif-cards-' + sectionId + ' .wif-card'));
    const totalCards = cards.length;

    if (!totalCards || !sectionEl) return;

    function isMobile() {
      return window.innerWidth <= 768;
    }

    const fanConfig = {
      totalArc: 70,
      ySpread: 30,
      xSpread: 100,
    };

    function getDesktopTransform(index, total) {
      const mid = (total - 1) / 2;
      const norm = total > 1 ? (index - mid) / mid : 0;
      return {
        xVal: -50 + norm * fanConfig.xSpread,
        y: Math.abs(norm) * fanConfig.ySpread,
        r: norm * (fanConfig.totalArc / 2),
      };
    }

    function getMobileTransform(index) {
  const stackOffset = 18;
  return {
    xVal: -50,
    y: index * stackOffset,  // positive = neeche jaata hai
    r: 0,
  };
}

    let visibleCount = 0;

    function updateCards(newVisible) {
      newVisible = Math.max(0, Math.min(totalCards, newVisible));
      if (newVisible === visibleCount) return;

      const mobile = isMobile();

      cards.forEach(function (card, i) {
        if (i < newVisible) {
          const tf = mobile ? getMobileTransform(i) : getDesktopTransform(i, totalCards);
          card.style.transform = 'translateX(' + tf.xVal + '%) translateY(' + tf.y + 'px) rotate(' + tf.r + 'deg)';
          card.style.opacity = '1';
          card.style.zIndex = i + 1;
        } else {
          card.style.transform = 'translateX(-50%) translateY(120%) rotate(0deg)';
          card.style.opacity = '0';
          card.style.zIndex = i + 1;
        }
      });

      visibleCount = newVisible;
    }

    // Hover effect — desktop only
    cards.forEach(function (card, i) {
      card.addEventListener('mouseenter', function () {
        if (i < visibleCount && !isMobile()) {
          const tf = getDesktopTransform(i, totalCards);
          card.style.transform =
            'translateX(' + tf.xVal + '%) translateY(' + (tf.y - 25) + 'px) rotate(' + tf.r + 'deg)';
          card.style.zIndex = 999;
          card.style.boxShadow = '0 30px 60px rgba(0,0,0,0.18)';
        }
      });

      card.addEventListener('mouseleave', function () {
        if (i < visibleCount && !isMobile()) {
          const tf = getDesktopTransform(i, totalCards);
          card.style.transform = 'translateX(' + tf.xVal + '%) translateY(' + tf.y + 'px) rotate(' + tf.r + 'deg)';
          card.style.zIndex = i + 1;
          card.style.boxShadow = '';
        }
      });
    });

    // Scroll handler
    function onScroll() {
      const rect = sectionEl.getBoundingClientRect();
      const scrolled = -rect.top;
      const stepHeight = 500;

      if (scrolled < 0) {
        updateCards(0);
        return;
      }

      const newVisible = Math.floor(scrolled / stepHeight) + 1;
      updateCards(newVisible);
    }

    window.addEventListener('scroll', onScroll, { passive: true });

    // Re-calculate on resize
    window.addEventListener('resize', function () {
      visibleCount = 0;
      onScroll();
    });

    onScroll();
  })();
</script>

{% schema %}
{
  "name": "Who It's For Cards",
  "tag": "section",
  "class": "wif-section-wrapper",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#0a2e2e"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Badge Background",
      "default": "#d6ffe8"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "ACCOUNTING FOR CREATIVES"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "WHO IT'S FOR"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "CREATIVES CREATE, WE CALCULATE"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "text",
          "id": "card_title",
          "label": "Card Title",
          "default": "Creative Freelancers"
        },
        {
          "type": "textarea",
          "id": "card_description",
          "label": "Card Description",
          "default": "Providing support and expertise to clients, solo managing all deadlines."
        },
        {
          "type": "image_picker",
          "id": "card_image",
          "label": "Card Image"
        },
        {
          "type": "color",
          "id": "card_color",
          "label": "Card Background Color",
          "default": "#fde0e8"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Who It's For Cards",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "card_title": "Creative Freelancers",
            "card_description": "Providing support and expertise to clients, solo managing all deadlines.",
            "card_color": "#fde0e8"
          }
        },
        {
          "type": "card",
          "settings": {
            "card_title": "Studios and Agencies",
            "card_description": "Creative experiences that connect, convert and inspire audiences.",
            "card_color": "#a8f5c8"
          }
        },
        {
          "type": "card",
          "settings": {
            "card_title": "Creative Collectives",
            "card_description": "All-in-one creative workflows from concept to launch.",
            "card_color": "#f2a0b5"
          }
        },
        {
          "type": "card",
          "settings": {
            "card_title": "Production Houses",
            "card_description": "Turning ideas into reality, defining brand values.",
            "card_color": "#d6ffe8"
          }
        },
        {
          "type": "card",
          "settings": {
            "card_title": "Creative Contractors",
            "card_description": "Expertly advising clients with creative leadership.",
            "card_color": "#f5e6d8"
          }
        },
        {
          "type": "card",
          "settings": {
            "card_title": "Media Businesses",
            "card_description": "Guiding clients to their milestones through media management.",
            "card_color": "#fde0e8"
          }
        }
      ]
    }
  ]
}
{% endschema %}
