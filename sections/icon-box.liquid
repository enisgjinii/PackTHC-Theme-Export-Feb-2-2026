{%- liquid
	assign section_id = '#shopify-section-' | append: section.id
	assign animation  = settings.section_animation
	assign full       = section.settings.full
	assign align      = section.settings.align
-%}

<style>
	{{ section_id }} .section-wrapper {
		padding-top: {{ section.settings.padding_top_mobile }}px;
		padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
	}

	@media (min-width: 992px) {
		{{ section_id }} .section-wrapper {
			padding-top: {{ section.settings.padding_top }}px;
			padding-bottom: {{ section.settings.padding_bottom }}px;
		}
	}

	{%- if section.settings.background_color != blank -%}
		{{ section_id }} .icon-item {
			background-color: {{ section.settings.background_color }};
		}
	{%- endif -%}

	{{ section_id }} .icon-item {
		padding: {{ section.settings.item_padding }}px;
	}

	{%- if section.settings.item_padding > 0 -%}
		@media (max-width: 991px) {
			{{ section_id }} .icon-item {
				padding: {{ section.settings.item_padding | times: 0.7 }}px;
			}
		}
	{%- endif -%}

	{{ section_id }} .icon-image {
		width: {{ section.settings.width_icon }}px;
	}
</style>

<div class="section-wrapper color-{{ section.settings.color_scheme }}">
	<div class="{% if full %}stretch-section stretch-padding{% else %}container{% endif %}">
		<div class="section-icon-box">
			<div class="icon-box{% if section.settings.column_gap_mobile == '2' %} mobile-grid-2{% endif %}">
				{%- for block in section.blocks -%}
					<div class="icon-item{% if animation %} scroll-trigger{% endif %} text-{{ align }}" {{ block.shopify_attributes }}>
						{%- case block.type -%}
							{%- when '@app' -%}
								{%- render block -%}

							{%- when 'box' -%}
								{%- assign image = block.settings.icon_img -%}

								<div class="image-wrap adapt-media">
									<div class="icon-image{% if settings.image_lazy and image != blank %} lazy-image{% endif %}">
										{%- liquid
											if image != blank
												render 'lazy-image', image: image, width: 294
											else
												render 'icon', code: 'placeholder'
											endif
										-%}
									</div>
								</div>

								{%- if block.settings.heading_text != blank -%}
									<div class="heading rte">{{- block.settings.heading_text -}}</div>
								{%- endif -%}

								{% if block.settings.text != blank %}
									<div class="text rte">{{- block.settings.text -}}</div>
								{% endif %}
						{%- endcase -%}
					</div>
				{%- endfor -%}
			</div>
		</div>
	</div>
</div>

{% schema %}
{
	"name": "t:sections.icon-box.name",
	"class": "icon-box-section",
	"tag": "section",
	"disabled_on": {
		"groups": ["header", "footer"]
	},
	"settings": [
		{
			"type": "checkbox",
			"id": "full",
			"default": false,
			"label": "t:general.layout.full.label"
		},
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"label": "t:settings_schema.colors.label",
			"default": "scheme-1"
		},
		{
			"type": "header",
			"content": "t:sections.icon-box.settings.item.content"
		},
		{
			"type": "color",
			"id": "background_color",
			"label": "t:general.background.label",
			"default": "#FFFFFF"
		},
		{
			"type": "select",
			"id": "align",
			"options": [
				{
					"value": "left",
					"label": "t:general.layout.alignment.option_1.label"
				},
				{
					"value": "center",
					"label": "t:general.layout.alignment.option_2.label"
				},
				{
					"value": "right",
					"label": "t:general.layout.alignment.option_3.label"
				}
			],
			"default": "left",
			"label": "t:general.layout.alignment.label"
		},
		{
			"type": "range",
			"id": "item_padding",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 15,
			"unit": "px",
			"label": "t:sections.icon-box.settings.item_padding.label"
		},
		{
			"type": "range",
			"id": "width_icon",
			"min": 20,
			"max": 100,
			"step": 1,
			"default": 64,
			"unit": "px",
			"label": "t:sections.icon-box.settings.icon_width.label"
		},
		{
			"type": "header",
			"content": "t:general.layout.mobile_layout.content"
		},
		{
			"type": "select",
			"id": "column_gap_mobile",
			"default": "1",
			"options": [
				{
					"value": "1",
					"label": "t:general.layout.mobile_layout.option_1.label"
				},
				{
					"value": "2",
					"label": "t:general.layout.mobile_layout.option_2.label"
				}
			],
			"label": "t:general.layout.mobile_layout.label"
		},
		{
			"type": "header",
			"content": "t:general.padding.header_padding.content"
		},
		{
			"type": "range",
			"id": "padding_top",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 50,
			"unit": "px",
			"label": "t:general.padding.top.label"
		},
		{
			"type": "range",
			"id": "padding_bottom",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 50,
			"unit": "px",
			"label": "t:general.padding.bottom.label"
		},
		{
			"type": "paragraph",
			"content": "t:general.padding.paragraph_mobile.content"
		},
		{
			"type": "range",
			"id": "padding_top_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 20,
			"unit": "px",
			"label": "t:general.padding.top.label"
		},
		{
			"type": "range",
			"id": "padding_bottom_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 20,
			"unit": "px",
			"label": "t:general.padding.bottom.label"
		}
	],
	"blocks": [
		{
			"type": "@app"
		},
		{
			"type": "box",
			"name": "t:sections.icon-box.blocks.box.name",
			"limit": 4,
			"settings": [
				{
					"type":"image_picker",
					"id":"icon_img",
					"label": "t:general.image.label"
				},
				{
					"type": "richtext",
					"id": "heading_text",
					"default": "<h4>Box</h4>",
					"label": "t:general.typography.heading.label"
				},
				{
					"type": "richtext",
					"id": "text",
					"default": "<p>Pair text with an image to focus on your chosen product, collection, or blog post. Add details on availability, style, or even provide a review.</p>",
					"label": "t:general.typography.text.label"
				}
			]
		}
	],
	"presets": [
		{
			"name": "t:sections.icon-box.presets.name",
			"blocks": [
				{
					"type": "box"
				},
				{
					"type": "box"
				},
				{
					"type": "box"
				},
				{
					"type": "box"
				}
			]
		}
	]
}
{% endschema %}
