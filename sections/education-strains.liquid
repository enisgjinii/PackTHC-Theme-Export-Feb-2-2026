{% comment %}
  Section: Product Carousel with Navigation
  Usage: Add this file to sections folder as 'product-carousel.liquid'
{% endcomment %}

<style>
  #shopify-section-{{ section.id }} {
    padding: 40px 0;
    background-color: {{ section.settings.background_color }};
  }

  #shopify-section-{{ section.id }} .container {
    max-width: 1500px;
    margin: 0 auto;
    padding: 0 20px;
  }

  #shopify-section-{{ section.id }} .header {
    margin-bottom: 40px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  #shopify-section-{{ section.id }} .header-content {
    flex: 1;
  }

  #shopify-section-{{ section.id }} .subtitle {
    font-size: 14px;
    color: {{ section.settings.subtitle_color }};
    margin-bottom: 10px;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 400;
  }

  #shopify-section-{{ section.id }} .title {
    font-size: 48px;
    font-weight: 700;
    color: {{ section.settings.title_color }};
    margin-bottom: 0;
    line-height: 1.2;
    margin-top: 0;
  }

  #shopify-section-{{ section.id }} .header-nav {
    display: flex;
    gap: 12px;
  }

  #shopify-section-{{ section.id }} .header-nav-btn {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: {{ section.settings.button_color }};
    border: none;
    color: white;
    font-size: 24px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    box-shadow: 0 2px 8px rgba(0,0,0,0.2);
  }

  #shopify-section-{{ section.id }} .header-nav-btn:hover {
    background: {{ section.settings.button_hover_color }};
    transform: scale(1.1);
  }

  #shopify-section-{{ section.id }} .header-nav-btn:active {
    transform: scale(0.95);
  }

  #shopify-section-{{ section.id }} .header-nav-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  #shopify-section-{{ section.id }} .carousel-wrapper {
    position: relative;
    padding: 0px 0;
  }

  #shopify-section-{{ section.id }} .carousel-container {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
  }

  #shopify-section-{{ section.id }} .carousel-container::-webkit-scrollbar {
    display: none;
  }

  #shopify-section-{{ section.id }} .card {
    flex: 0 0 280px;
    background: {{ section.settings.card_background }};
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    cursor: pointer;
    text-decoration: none;
    color: inherit;
    display: block;
    scroll-snap-align: start;
  }

  #shopify-section-{{ section.id }} .card:hover {
    transform: translateY(-5px);
    box-shadow: 0 4px 16px rgba(0,0,0,0.15);
  }

  #shopify-section-{{ section.id }} .card-image {
    width: 100%;
    height: 280px;
    background: #000;
    position: relative;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  #shopify-section-{{ section.id }} .card:hover .card-image img {
    transform: scale(1.05);
  }

  #shopify-section-{{ section.id }} .card-content {
    padding: 20px;
  }

  #shopify-section-{{ section.id }} .card-title {
    font-size: 14px;
    font-weight: 600;
    color: {{ section.settings.card_text_color }};
    text-transform: uppercase;
    letter-spacing: 0.5px;
    line-height: 1.4;
    margin-bottom: 8px;
  }

  #shopify-section-{{ section.id }} .card-price {
    font-size: 16px;
    font-weight: 600;
    color: {{ section.settings.price_color }};
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .title {
      font-size: 32px;
    }

    #shopify-section-{{ section.id }} .container {
      padding: 0 15px;
    }

    #shopify-section-{{ section.id }} .carousel-container {
      gap: 15px;
      padding: 0 5px;
    }

    #shopify-section-{{ section.id }} .card {
      flex: 0 0 calc(100vw - 50px);
      max-width: 320px;
    }

    #shopify-section-{{ section.id }} .header {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }

    #shopify-section-{{ section.id }} .header-nav-btn {
      width: 40px;
      height: 40px;
      font-size: 20px;
    }
  }
</style>

<div class="container">
  <div class="header">
    <div class="header-content">
      {% if section.settings.subtitle != blank %}
        <div class="subtitle">{{ section.settings.subtitle }}</div>
      {% endif %}
      {% if section.settings.title != blank %}
        <h2 class="title">{{ section.settings.title }}</h2>
      {% endif %}
    </div>
    <div class="header-nav">
      <button class="header-nav-btn carousel-prev-{{ section.id }}" aria-label="Previous">‹</button>
      <button class="header-nav-btn carousel-next-{{ section.id }}" aria-label="Next">›</button>
    </div>
  </div>

  <div class="carousel-wrapper">
    <div class="carousel-container carousel-{{ section.id }}">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'product' %}
              {% if block.settings.product != blank %}
                {% assign product = block.settings.product %}
                <a href="{{ product.url }}" class="card" {{ block.shopify_attributes }}>
                  <div class="card-image">
                    {% if product.featured_image %}
                      {{ product.featured_image | image_url: width: 600 | image_tag: alt: product.title, loading: 'lazy' }}
                    {% else %}
                      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    {% endif %}
                  </div>
                  <div class="card-content">
                    {% if block.settings.show_title %}
                      <div class="card-title">{{ product.title }}</div>
                    {% endif %}
                    {% if block.settings.show_price %}
                      <div class="card-price">{{ product.price | money }}</div>
                    {% endif %}
                  </div>
                </a>
              {% endif %}
            
            {% when 'custom' %}
              <a href="{{ block.settings.link }}" class="card" {{ block.shopify_attributes }}>
                <div class="card-image">
                  {% if block.settings.image != blank %}
                    {{ block.settings.image | image_url: width: 600 | image_tag: alt: block.settings.title, loading: 'lazy' }}
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {% endif %}
                </div>
                <div class="card-content">
                  {% if block.settings.show_title %}
                    <div class="card-title">{{ block.settings.title }}</div>
                  {% endif %}
                  {% if block.settings.show_price and block.settings.price != blank %}
                    <div class="card-price">{{ block.settings.price }}</div>
                  {% endif %}
                </div>
              </a>
          {% endcase %}
        {% endfor %}
      {% else %}
        {% comment %} Default placeholder cards {% endcomment %}
        {% for i in (1..6) %}
          <div class="card">
            <div class="card-image">
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
            <div class="card-content">
              <div class="card-title">Product {{ i }}</div>
              <div class="card-price">$29.99</div>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>

<script>
  (function() {
    const carousel = document.querySelector('.carousel-{{ section.id }}');
    const prevBtn = document.querySelector('.carousel-prev-{{ section.id }}');
    const nextBtn = document.querySelector('.carousel-next-{{ section.id }}');
    
    // Calculate scroll amount based on card width + gap
    function getScrollAmount() {
      const card = carousel.querySelector('.card');
      if (!card) return 300;
      const cardWidth = card.offsetWidth;
      const gap = 20; // matches CSS gap
      return cardWidth + gap;
    }

    prevBtn.addEventListener('click', () => {
      carousel.scrollBy({
        left: -getScrollAmount(),
        behavior: 'smooth'
      });
    });

    nextBtn.addEventListener('click', () => {
      carousel.scrollBy({
        left: getScrollAmount(),
        behavior: 'smooth'
      });
    });

    // Disable buttons when at start/end
    function updateButtons() {
      const maxScroll = carousel.scrollWidth - carousel.clientWidth;
      prevBtn.disabled = carousel.scrollLeft <= 0;
      nextBtn.disabled = carousel.scrollLeft >= maxScroll - 1;
    }

    carousel.addEventListener('scroll', updateButtons);
    window.addEventListener('resize', updateButtons);
    updateButtons();
  })();
</script>

{% schema %}
{
  "name": "Education Strains",
  "tag": "section",
  "class": "product-carousel-section",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button Color",
      "default": "#2d7a5e"
    },
    {
      "type": "color",
      "id": "button_hover_color",
      "label": "Button Hover Color",
      "default": "#246952"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card Background",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Heading Settings"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Fresh from the Field"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle Color",
      "default": "#666666"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Discover Our Latest Strains"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Card Text Colors"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card Title Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Price Color",
      "default": "#2d7a5e"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "checkbox",
          "id": "show_title",
          "label": "Show Title",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_price",
          "label": "Show Price",
          "default": true
        }
      ]
    },
    {
      "type": "custom",
      "name": "Custom Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Product Title"
        },
        {
          "type": "checkbox",
          "id": "show_title",
          "label": "Show Title",
          "default": true
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$29.99"
        },
        {
          "type": "checkbox",
          "id": "show_price",
          "label": "Show Price",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Education Strains",
      "blocks": [
        {
          "type": "custom"
        },
        {
          "type": "custom"
        },
        {
          "type": "custom"
        },
        {
          "type": "custom"
        },
        {
          "type": "custom"
        },
        {
          "type": "custom"
        }
      ]
    }
  ]
}
{% endschema %}