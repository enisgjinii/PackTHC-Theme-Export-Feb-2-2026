{% comment %}
  Section: Premium Split Content with Image Slider - FIXED
  File: sections/premium-split-content.liquid
{% endcomment %}

<style>
    .premium-split-{{ section.id }} {
        background: {{ section.settings.background_color }};
        color: {{ section.settings.text_color }};
        position: relative;
        overflow: hidden;
    }

    .premium-split-{{ section.id }} .section-wrapper {
        display: grid;
        grid-template-columns: 1fr 1fr;
        min-height: {{ section.settings.section_height }}vh;
        max-width: 1600px;
        margin: 0 auto;
        align-items: center;
        gap: 60px;
        padding: 80px 60px;
    }

    .premium-split-{{ section.id }} .content-side {
        position: relative;
        z-index: 2;
        padding-right: 40px;
    }

    .premium-split-{{ section.id }} .heading {
        font-size: clamp(40px, 5vw, {{ section.settings.heading_size }}px);
        font-weight: 900;
        margin-bottom: 30px;
        letter-spacing: -1px;
        line-height: 1.1;
        background: {{ section.settings.heading_gradient }};
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        position: relative;
        display: inline-block;
    }

    .premium-split-{{ section.id }} .heading::after {
        content: '';
        position: absolute;
        bottom: -10px;
        left: 0;
        width: 80px;
        height: 4px;
        background: {{ section.settings.accent_color }};
        border-radius: 2px;
    }

    .premium-split-{{ section.id }} .description {
        font-size: clamp(16px, 1.2vw, {{ section.settings.text_size }}px);
        line-height: 1.8;
        color: {{ section.settings.description_color }};
        margin-top: 40px;
    }

    .premium-split-{{ section.id }} .image-side {
        position: relative;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .premium-split-{{ section.id }} .slider-container {
        position: relative;
        width: 100%;
        max-width: 600px;
        height: 600px;
        overflow: hidden;
        border-radius: {{ section.settings.image_radius }}px;
    }

    .premium-split-{{ section.id }} .slider-track {
        display: flex;
        transition: transform 0.5s ease-in-out;
        height: 100%;
        width: 100%;
    }

    .premium-split-{{ section.id }} .slide {
        min-width: 100%;
        height: 100%;
        position: relative;
        flex-shrink: 0;
    }

    .premium-split-{{ section.id }} .slide img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: {{ section.settings.image_radius }}px;
        box-shadow: 0 30px 60px rgba(0, 0, 0, 0.5);
        display: block;
    }

    .premium-split-{{ section.id }} .slide .placeholder-svg {
        width: 100%;
        height: 100%;
        border-radius: {{ section.settings.image_radius }}px;
    }

    .premium-split-{{ section.id }} .image-bg-shape {
        position: absolute;
        width: 120%;
        height: 120%;
        top: -10%;
        left: -10%;
        background: {{ section.settings.shape_gradient }};
        border-radius: 50%;
        filter: blur(80px);
        opacity: 0.3;
        z-index: -1;
        animation: pulse-{{ section.id }} 4s ease-in-out infinite;
    }

    @keyframes pulse-{{ section.id }} {
        0%, 100% { transform: scale(1); opacity: 0.3; }
        50% { transform: scale(1.1); opacity: 0.5; }
    }

    .premium-split-{{ section.id }} .slider-nav {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        width: 50px;
        height: 50px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        z-index: 10;
        transition: all 0.3s ease;
        color: #fff;
        font-size: 24px;
        font-weight: bold;
    }

    .premium-split-{{ section.id }} .slider-nav:hover {
        background: rgba(255, 255, 255, 0.25);
        transform: translateY(-50%) scale(1.1);
    }

    .premium-split-{{ section.id }} .slider-nav.prev {
        left: 20px;
    }

    .premium-split-{{ section.id }} .slider-nav.next {
        right: 20px;
    }

    .premium-split-{{ section.id }} .slider-dots {
        position: absolute;
        bottom: 20px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: 10px;
        z-index: 10;
    }

    .premium-split-{{ section.id }} .dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.4);
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .premium-split-{{ section.id }} .dot.active {
        background: {{ section.settings.accent_color }};
        width: 30px;
        border-radius: 5px;
    }

    .premium-split-{{ section.id }} .decorative-dots {
        position: absolute;
        width: 100px;
        height: 100px;
        background-image: radial-gradient(circle, {{ section.settings.accent_color }} 2px, transparent 2px);
        background-size: 20px 20px;
        opacity: 0.3;
        z-index: -1;
    }

    .premium-split-{{ section.id }} .dots-1 {
        top: -50px;
        right: -50px;
    }

    .premium-split-{{ section.id }} .dots-2 {
        bottom: -50px;
        left: -50px;
    }

    @media (max-width: 1024px) {
        .premium-split-{{ section.id }} .section-wrapper {
            grid-template-columns: 1fr;
            gap: 50px;
            padding: 60px 40px;
        }

        .premium-split-{{ section.id }} .content-side {
            padding-right: 0;
        }

        .premium-split-{{ section.id }} .slider-container {
            max-width: 500px;
            margin: 0 auto;
            height: 500px;
        }
    }

    @media (max-width: 768px) {
        .premium-split-{{ section.id }} .section-wrapper {
            padding: 40px 20px;
        }

        .premium-split-{{ section.id }} .slider-container {
            height: 400px;
        }

        .premium-split-{{ section.id }} .heading::after {
            width: 60px;
        }

        .premium-split-{{ section.id }} .slider-nav {
            width: 40px;
            height: 40px;
            font-size: 20px;
        }
    }
</style>

<div class="premium-split-{{ section.id }}">
    <div class="section-wrapper">
        <div class="content-side">
            <h2 class="heading">{{ section.settings.heading }}</h2>
            {% if section.settings.description != blank %}
                <div class="description">{{ section.settings.description }}</div>
            {% endif %}
        </div>

        <div class="image-side">
            <div class="decorative-dots dots-1"></div>
            <div class="decorative-dots dots-2"></div>
            <div class="slider-container">
                <div class="image-bg-shape"></div>
                
                <div class="slider-track" id="sliderTrack-{{ section.id }}">
                    {% for block in section.blocks %}
                        <div class="slide" {{ block.shopify_attributes }}>
                            {% if block.settings.image %}
                                <img src="{{ block.settings.image | image_url: width: 1200 }}" 
                                     alt="{{ block.settings.image.alt | escape }}" 
                                     loading="lazy">
                            {% else %}
                                {{ 'product-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg' }}
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>

                {% if section.blocks.size > 1 %}
                    <button class="slider-nav prev" data-slider-id="{{ section.id }}" data-direction="-1" type="button">‹</button>
                    <button class="slider-nav next" data-slider-id="{{ section.id }}" data-direction="1" type="button">›</button>
                    
                    <div class="slider-dots" id="sliderDots-{{ section.id }}">
                        {% for block in section.blocks %}
                            <span class="dot {% if forloop.first %}active{% endif %}" 
                                  data-slider-id="{{ section.id }}"
                                  data-slide="{{ forloop.index0 }}"></span>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<script>
(function() {
    const sectionId = '{{ section.id }}';
    const track = document.getElementById('sliderTrack-' + sectionId);
    
    if (!track) return;
    
    const slides = track.querySelectorAll('.slide');
    const dotsContainer = document.getElementById('sliderDots-' + sectionId);
    const dots = dotsContainer ? dotsContainer.querySelectorAll('.dot') : [];
    const totalSlides = slides.length;
    
    let currentSlide = 0;

    function updateSlider() {
        if (!track || totalSlides === 0) return;
        
        const offset = currentSlide * 100;
        track.style.transform = 'translateX(-' + offset + '%)';
        
        // Update dots
        dots.forEach(function(dot, index) {
            if (index === currentSlide) {
                dot.classList.add('active');
            } else {
                dot.classList.remove('active');
            }
        });
    }

    function moveSlide(direction) {
        currentSlide += direction;
        
        if (currentSlide < 0) {
            currentSlide = totalSlides - 1;
        } else if (currentSlide >= totalSlides) {
            currentSlide = 0;
        }
        
        updateSlider();
    }

    function goToSlide(index) {
        currentSlide = index;
        updateSlider();
    }

    // Event listeners for navigation buttons
    document.querySelectorAll('.slider-nav[data-slider-id="' + sectionId + '"]').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            const direction = parseInt(this.getAttribute('data-direction'));
            moveSlide(direction);
        });
    });

    // Event listeners for dots
    document.querySelectorAll('.dot[data-slider-id="' + sectionId + '"]').forEach(function(dot) {
        dot.addEventListener('click', function() {
            const slideIndex = parseInt(this.getAttribute('data-slide'));
            goToSlide(slideIndex);
        });
    });

    // Initialize
    updateSlider();
})();
</script>

{% schema %}
{
  "name": "Premium Split Content",
  "tag": "section",
  "class": "section-premium-split",
  "settings": [
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "range",
      "id": "section_height",
      "label": "Section Height",
      "min": 60,
      "max": 100,
      "step": 5,
      "default": 90,
      "unit": "vh"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Main Heading",
      "default": "Experience The Ultimate Quality"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Size",
      "min": 40,
      "max": 100,
      "step": 5,
      "default": 70,
      "unit": "px"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover a world of exceptional quality and craftsmanship. Our products are carefully curated to deliver an unparalleled experience that exceeds expectations.</p>"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text Size",
      "min": 14,
      "max": 24,
      "step": 1,
      "default": 18,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Image Slider Settings"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image Border Radius",
      "min": 0,
      "max": 50,
      "step": 5,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#ff6b00"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color",
      "default": "#cccccc"
    },
    {
      "type": "text",
      "id": "heading_gradient",
      "label": "Heading Gradient",
      "default": "linear-gradient(135deg, #ffffff 0%, #999999 100%)",
      "info": "CSS gradient value"
    },
    {
      "type": "text",
      "id": "shape_gradient",
      "label": "Background Shape Gradient",
      "default": "linear-gradient(135deg, #ff6b00 0%, #ffd700 100%)",
      "info": "CSS gradient value"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Image Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Slide Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Premium Split Content",
      "category": "Custom",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}