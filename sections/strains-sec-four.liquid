<div class="strain-science-container">
  <h2 class="ss-main-heading">{{ section.settings.strain_name }} strain science</h2>

  <div class="ss-content-wrapper">
    <div class="ss-left-section">
      <div class="ss-phenotype-box">
        <h3 class="ss-section-title">Phenotype</h3>
        <div class="ss-phenotype-item">
          <span class="ss-pheno-icon" style="background-color: {{ section.settings.phenotype_color }};"></span>
          <span class="ss-pheno-label">{{ section.settings.phenotype }}</span>
        </div>
      </div>

      <div class="ss-dominant-terpene-box">
        <h3 class="ss-section-title">Dominant terpene</h3>
        <div class="ss-terpene-item">
          <span class="ss-terpene-icon" style="background-color: {{ section.settings.dominant_terpene_color }};"></span>
          <span class="ss-terpene-name">{{ section.settings.dominant_terpene }}</span>
          <span class="ss-terpene-type">({{ section.settings.dominant_terpene_type }})</span>
        </div>
      </div>
    </div>

    <div class="ss-right-section">
      <h3 class="ss-terpenes-heading">{{ section.settings.strain_name }} terpenes</h3>
      <p class="ss-terpenes-intro">{{ section.settings.terpenes_intro }}</p>

      <div class="ss-terpenes-list">
        {% for block in section.blocks %}
          {% if block.type == 'terpene' %}
            <div class="ss-terpene-detail">
              <div class="ss-terpene-header">
                <span class="ss-terpene-dot" style="background-color: {{ block.settings.color }};"></span>
                <h4 class="ss-terpene-title">{{ block.settings.name }}</h4>
                <span class="ss-terpene-flavor">({{ block.settings.flavor }})</span>
              </div>
              <p class="ss-terpene-description">{{ block.settings.description }}</p>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<style>
  .strain-science-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 20px;
  }

  .ss-main-heading {
    font-size: 28px;
    font-weight: 600;
    color: #333;
    margin-bottom: 30px;
  }

  .ss-content-wrapper {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 60px;
  }

  .ss-left-section {
    display: flex;
    flex-direction: column;
    gap: 25px;
  }

  .ss-section-title {
    font-size: 16px;
    font-weight: 600;
    color: #333;
    margin-bottom: 12px;
  }

  .ss-phenotype-item,
  .ss-terpene-item {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .ss-pheno-icon,
  .ss-terpene-icon {
    width: 16px;
    height: 16px;
    border-radius: 3px;
  }

  .ss-pheno-label,
  .ss-terpene-name {
    font-size: 15px;
    color: #333;
    font-weight: 500;
  }

  .ss-terpene-type {
    font-size: 15px;
    color: #666;
  }

  .ss-right-section {
  }

  .ss-terpenes-heading {
    font-size: 20px;
    font-weight: 600;
    color: #333;
    margin-bottom: 10px;
  }

  .ss-terpenes-intro {
    font-size: 14px;
    color: #666;
    line-height: 1.6;
    margin-bottom: 25px;
  }

  .ss-terpenes-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ss-terpene-detail {
  }

  .ss-terpene-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }

  .ss-terpene-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .ss-terpene-title {
    font-size: 16px;
    font-weight: 600;
    color: #333;
  }

  .ss-terpene-flavor {
    font-size: 15px;
    color: #666;
  }

  .ss-terpene-description {
    font-size: 14px;
    color: #666;
    line-height: 1.6;
    padding-left: 20px;
  }

  @media (max-width: 968px) {
    .ss-content-wrapper {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>

{% schema %}
{
  "name": "Strain Science",
  "settings": [
    {
      "type": "text",
      "id": "strain_name",
      "label": "Strain Name",
      "default": "Bubba Kush"
    },
    {
      "type": "text",
      "id": "phenotype",
      "label": "Phenotype",
      "default": "Indica"
    },
    {
      "type": "color",
      "id": "phenotype_color",
      "label": "Phenotype Color",
      "default": "#7c5ac2"
    },
    {
      "type": "text",
      "id": "dominant_terpene",
      "label": "Dominant Terpene",
      "default": "Caryophyllene"
    },
    {
      "type": "text",
      "id": "dominant_terpene_type",
      "label": "Dominant Terpene Type",
      "default": "pepper"
    },
    {
      "type": "color",
      "id": "dominant_terpene_color",
      "label": "Dominant Terpene Color",
      "default": "#d946ef"
    },
    {
      "type": "textarea",
      "id": "terpenes_intro",
      "label": "Terpenes Introduction",
      "default": "The most abundant terpene in Bubba Kush is caryophyllene, followed by limonene and myrcene."
    }
  ],
  "blocks": [
    {
      "type": "terpene",
      "name": "Terpene",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Terpene Name",
          "default": "Caryophyllene"
        },
        {
          "type": "text",
          "id": "flavor",
          "label": "Flavor Profile",
          "default": "pepper"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color",
          "default": "#d946ef"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Spicy, peppery terpene that may have anti-inflammatory benefits."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Strain Science",
      "settings": {
        "strain_name": "Bubba Kush",
        "phenotype": "Indica",
        "phenotype_color": "#7c5ac2",
        "dominant_terpene": "Caryophyllene",
        "dominant_terpene_type": "pepper",
        "dominant_terpene_color": "#d946ef",
        "terpenes_intro": "The most abundant terpene in Bubba Kush is caryophyllene, followed by limonene and myrcene."
      },
      "blocks": [
        {
          "type": "terpene",
          "settings": {
            "name": "Caryophyllene",
            "flavor": "pepper",
            "color": "#d946ef",
            "description": "Spicy, peppery terpene that may have anti-inflammatory benefits."
          }
        },
        {
          "type": "terpene",
          "settings": {
            "name": "Limonene",
            "flavor": "citrus",
            "color": "#fbbf24",
            "description": "Citrusy terpene that may provide mood-enhancing effects."
          }
        },
        {
          "type": "terpene",
          "settings": {
            "name": "Myrcene",
            "flavor": "herbal",
            "color": "#1e3a8a",
            "description": "Herbal terpene that may promote relaxation and sedation."
          }
        }
      ]
    }
  ]
}
{% endschema %}