{% comment %}
  Coming Soon Page Template for Shopify
  File: sections/coming-soon.liquid
{% endcomment %}

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    .coming-soon-wrapper {
        font-family: {{ section.settings.font_family }}, 'Arial', sans-serif;
        background-color: {{ section.settings.background_color }};
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        padding: 20px;
    }

    .coming-soon-container {
        width: 100%;
        max-width: 1200px;
        text-align: center;
    }

    .cs-welcome-text {
        font-size: {{ section.settings.welcome_font_size }}px;
        color: {{ section.settings.welcome_text_color }};
        margin-bottom: 10px;
    }

    .cs-brand-text {
        font-size: {{ section.settings.brand_font_size }}px;
        color: {{ section.settings.brand_text_color }};
        margin-bottom: 20px;
    }

    .cs-main-heading {
        font-size: {{ section.settings.heading_font_size }}px;
        font-weight: 900;
        letter-spacing: -2px;
        margin-bottom: 40px;
        display: inline-block;
        position: relative;
    }

    .cs-main-heading span {
        display: inline-block;
        transition: transform 0.3s ease, color 0.3s ease;
        cursor: default;
        position: relative;
        color: {{ section.settings.heading_text_color }};
    }

    .cs-main-heading span:hover {
        transform: scale(1.2);
        color: {{ section.settings.hover_color }} !important;
    }

    .cs-main-heading span:hover ~ span {
        transform: translateX(5px);
    }

    .cs-main-heading span:has(~ span:hover) {
        transform: translateX(-5px);
    }

    .cs-countdown-box {
        background: linear-gradient(135deg, {{ section.settings.gradient_color_1 }} 0%, {{ section.settings.gradient_color_2 }} 50%, {{ section.settings.gradient_color_3 }} 100%);
        border-radius: 20px;
        padding: 60px 40px;
        position: relative;
        overflow: hidden;
    }

    {% if section.settings.background_image != blank %}
    .cs-countdown-box::before {
        content: '';
        position: absolute;
        top: 0;
        right: 0;
        width: 100%;
        height: 100%;
        background-image: url('{{ section.settings.background_image | img_url: '1200x1200' }}');
        background-size: cover;
        background-position: center;
        opacity: {{ section.settings.background_image_opacity | divided_by: 100.0 }};
        z-index: 0;
    }
    {% endif %}

    .cs-countdown {
        display: flex;
        justify-content: center;
        gap: 30px;
        margin-bottom: 60px;
        position: relative;
        z-index: 1;
    }

    .cs-time-unit {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .cs-time-number {
        font-size: 72px;
        font-weight: 700;
        color: {{ section.settings.countdown_number_color }};
        line-height: 1;
        margin-bottom: 10px;
    }

    .cs-time-label {
        font-size: 14px;
        color: {{ section.settings.countdown_label_color }};
        text-transform: uppercase;
        letter-spacing: 2px;
    }

    .cs-separator {
        font-size: 48px;
        color: {{ section.settings.countdown_separator_color }};
        align-self: center;
        margin-top: -20px;
    }

    .cs-newsletter-section {
        position: relative;
        z-index: 1;
    }

    .cs-newsletter-text {
        font-size: 18px;
        color: {{ section.settings.newsletter_text_color }};
        margin-bottom: 25px;
        line-height: 1.6;
    }

    @media (max-width: 768px) {
        .cs-main-heading {
            font-size: 60px;
        }

        .cs-countdown {
            gap: 15px;
        }

        .cs-time-number {
            font-size: 48px;
        }

        .cs-time-label {
            font-size: 10px;
        }

        .cs-separator {
            font-size: 32px;
        }

        .cs-countdown-box::before {
            width: 100%;
            opacity: 0.3;
        }
    }
</style>

<div class="coming-soon-wrapper">
    <div class="coming-soon-container">
        <p class="cs-welcome-text">{{ section.settings.welcome_text }}</p>
        <h2 class="cs-brand-text">{{ section.settings.brand_text }}</h2>
        
        <h1 class="cs-main-heading">
            {% assign heading = section.settings.main_heading %}
            {% assign letters = heading | split: '' %}
            {% for letter in letters %}
                <span>{{ letter }}</span>
            {% endfor %}
        </h1>

        <div class="cs-countdown-box">
            <div class="cs-countdown" id="cs-countdown-{{ section.id }}">
                <div class="cs-time-unit">
                    <div class="cs-time-number" data-unit="days">00</div>
                    <div class="cs-time-label">{{ section.settings.days_label }}</div>
                </div>
                <div class="cs-separator">:</div>
                <div class="cs-time-unit">
                    <div class="cs-time-number" data-unit="hours">00</div>
                    <div class="cs-time-label">{{ section.settings.hours_label }}</div>
                </div>
                <div class="cs-separator">:</div>
                <div class="cs-time-unit">
                    <div class="cs-time-number" data-unit="minutes">00</div>
                    <div class="cs-time-label">{{ section.settings.minutes_label }}</div>
                </div>
                <div class="cs-separator">:</div>
                <div class="cs-time-unit">
                    <div class="cs-time-number" data-unit="seconds">00</div>
                    <div class="cs-time-label">{{ section.settings.seconds_label }}</div>
                </div>
            </div>

            <div class="cs-newsletter-section">
                <p class="cs-newsletter-text">
                    {{ section.settings.page_coming_text }}
                </p>
            </div>
        </div>
    </div>
</div>

<script>
(function() {
    const sectionId = '{{ section.id }}';
    const countdownElement = document.getElementById('cs-countdown-' + sectionId);
    
    // Calculate target date based on settings
    const now = new Date().getTime();
    const days = {{ section.settings.countdown_days | default: 26 }};
    const hours = {{ section.settings.countdown_hours | default: 21 }};
    const minutes = {{ section.settings.countdown_minutes | default: 52 }};
    const seconds = {{ section.settings.countdown_seconds | default: 50 }};
    
    const targetDate = now + (days * 24 * 60 * 60 * 1000) + (hours * 60 * 60 * 1000) + (minutes * 60 * 1000) + (seconds * 1000);

    function updateCountdown() {
        const now = new Date().getTime();
        const distance = targetDate - now;

        const d = Math.floor(distance / (1000 * 60 * 60 * 24));
        const h = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const m = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
        const s = Math.floor((distance % (1000 * 60)) / 1000);

        countdownElement.querySelector('[data-unit="days"]').textContent = d.toString().padStart(2, '0');
        countdownElement.querySelector('[data-unit="hours"]').textContent = h.toString().padStart(2, '0');
        countdownElement.querySelector('[data-unit="minutes"]').textContent = m.toString().padStart(2, '0');
        countdownElement.querySelector('[data-unit="seconds"]').textContent = s.toString().padStart(2, '0');

        if (distance < 0) {
            clearInterval(countdownInterval);
            countdownElement.innerHTML = '<h2 style="color: white;">{{ section.settings.live_text }}</h2>';
        }
    }

    const countdownInterval = setInterval(updateCountdown, 1000);
    updateCountdown();
})();
</script>

{% schema %}
