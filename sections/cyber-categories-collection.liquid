{% schema %}
{
  "name": "cyber categories",
  "settings": [],
  "blocks": [
    {
      "type": "category",
      "name": "Category Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Category Title",
          "default": "New Arrivals"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Category Link"
        },
        {
          "type": "image_picker",
          "id": "background_image",
          "label": "Background Image"
        },
        {
          "type": "color",
          "id": "gradient_color_start",
          "label": "Gradient Start Color",
          "default": "#1e3a8a"
        },
        {
          "type": "color",
          "id": "gradient_color_end",
          "label": "Gradient End Color",
          "default": "#3b82f6"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "cyber-categories-collection",
      "category": "Custom",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "New Arrivals"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Best Sellers"
          }
        }
      ]
    }
  ]
}
{% endschema %}

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  .shop-by-category {
    font-family: 'Inter', 'Segoe UI', sans-serif;
    background: #ffffff;
    padding: 80px 0 80px 60px;
    position: relative;
    overflow: hidden;
  }

  .shop-by-category::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: 
      radial-gradient(circle at 20% 30%, rgba(255, 0, 255, 0.08) 0%, transparent 35%),
      radial-gradient(circle at 80% 70%, rgba(0, 255, 255, 0.08) 0%, transparent 35%),
      radial-gradient(circle at 50% 50%, rgba(255, 0, 128, 0.05) 0%, transparent 40%),
      radial-gradient(circle at 70% 20%, rgba(0, 255, 150, 0.06) 0%, transparent 30%);
    pointer-events: none;
    animation: neonPulse 6s ease-in-out infinite;
  }

  .shop-by-category::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: 
      repeating-linear-gradient(
        0deg,
        rgba(0, 255, 255, 0.02) 0px,
        transparent 2px,
        transparent 4px
      );
    pointer-events: none;
    animation: scanlines 8s linear infinite;
  }

  @keyframes neonPulse {
    0%, 100% { opacity: 0.8; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.03); }
  }

  @keyframes scanlines {
    0% { transform: translateY(0); }
    100% { transform: translateY(20px); }
  }

  .shop-by-category__content {
    position: relative;
    z-index: 1;
  }

  .shop-by-category__header {
    margin-bottom: 50px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-right: 60px;
  }

  .shop-by-category__title-wrapper {
    position: relative;
  }

  .shop-by-category__title {
    font-size: 56px;
    font-weight: 900;
    background: linear-gradient(90deg, #ff0080, #7928ca, #00ffff, #ff0080);
    background-size: 300% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -2px;
    line-height: 1.1;
    filter: drop-shadow(0 0 30px rgba(255, 0, 128, 0.6)) 
            drop-shadow(0 0 50px rgba(0, 255, 255, 0.4))
            drop-shadow(0 0 70px rgba(121, 40, 202, 0.3));
    animation: neonGlow 4s linear infinite;
  }

  @keyframes neonGlow {
    0% { 
      background-position: 0% center; 
      filter: drop-shadow(0 0 30px rgba(255, 0, 128, 0.8)) 
              drop-shadow(0 0 50px rgba(0, 255, 255, 0.5))
              drop-shadow(0 0 70px rgba(121, 40, 202, 0.4));
    }
    50% { 
      background-position: 100% center; 
      filter: drop-shadow(0 0 40px rgba(0, 255, 255, 0.8)) 
              drop-shadow(0 0 60px rgba(255, 0, 128, 0.5))
              drop-shadow(0 0 80px rgba(121, 40, 202, 0.4));
    }
    100% { 
      background-position: 0% center; 
      filter: drop-shadow(0 0 30px rgba(255, 0, 128, 0.8)) 
              drop-shadow(0 0 50px rgba(0, 255, 255, 0.5))
              drop-shadow(0 0 70px rgba(121, 40, 202, 0.4));
    }
  }

  .shop-by-category__title::after {
    content: '';
    position: absolute;
    bottom: -10px;
    left: 0;
    width: 120px;
    height: 4px;
    background: linear-gradient(90deg, #ff0080, #7928ca, #00ffff);
    border-radius: 2px;
    box-shadow: 0 0 15px #ff0080, 0 0 30px #00ffff, 0 0 45px #7928ca;
    animation: lineGlow 2s ease-in-out infinite;
  }

  @keyframes lineGlow {
    0%, 100% { 
      box-shadow: 0 0 15px #ff0080, 0 0 30px #00ffff, 0 0 45px #7928ca;
      filter: brightness(1);
    }
    50% { 
      box-shadow: 0 0 25px #ff0080, 0 0 50px #00ffff, 0 0 70px #7928ca;
      filter: brightness(1.5);
    }
  }

  .shop-by-category__nav-buttons {
    display: flex;
    gap: 15px;
  }

  .shop-by-category__nav-btn {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(10px);
    border: 2px solid rgba(255, 0, 128, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    color: #ff0080;
    font-size: 20px;
    box-shadow: 0 5px 20px rgba(255, 0, 128, 0.2),
                inset 0 0 10px rgba(255, 0, 128, 0.1);
  }

  .shop-by-category__nav-btn:hover {
    background: rgba(255, 255, 255, 1);
    border-color: #ff0080;
    transform: scale(1.15);
    box-shadow: 0 0 30px rgba(255, 0, 128, 0.8), 
                0 0 50px rgba(0, 255, 255, 0.5),
                0 0 70px rgba(121, 40, 202, 0.4),
                inset 0 0 20px rgba(255, 0, 128, 0.2);
    color: #ff0080;
  }

  .shop-by-category__nav-btn:active {
    transform: scale(0.95);
  }

  .shop-by-category__scroll-container {
    position: relative;
    margin-right: 60px;
  }

  .shop-by-category__cards-wrapper {
    display: flex;
    gap: 30px;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: grab;
    padding-right: 0;
  }

  .shop-by-category__cards-wrapper:active {
    cursor: grabbing;
  }

  .shop-by-category__card {
    min-width: 350px;
    height: 450px;
    border-radius: 25px;
    position: relative;
    overflow: hidden;
    cursor: pointer;
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    flex-shrink: 0;
    border: 3px solid transparent;
    background-clip: padding-box;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15),
                0 0 0 1px rgba(255, 0, 128, 0.3),
                inset 0 0 30px rgba(255, 0, 128, 0.05);
  }

  .shop-by-category__card::before {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 25px;
    padding: 3px;
    background: linear-gradient(135deg, #ff0080, #7928ca, #00ffff, #ff0080);
    background-size: 400% 400%;
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    animation: borderRotate 4s linear infinite;
    z-index: 0;
    pointer-events: none;
  }

  @keyframes borderRotate {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  .shop-by-category__card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.3) 100%);
    opacity: 0.8;
    transition: opacity 0.5s ease;
    z-index: 1;
  }

  .shop-by-category__card::after {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: linear-gradient(
      45deg,
      transparent 30%,
      rgba(0, 255, 255, 0.15) 50%,
      transparent 70%
    );
    transform: rotate(45deg);
    animation: neonShine 4s infinite;
    z-index: 2;
  }

  @keyframes neonShine {
    0% { transform: translateX(-100%) translateY(-100%) rotate(45deg); }
    100% { transform: translateX(100%) translateY(100%) rotate(45deg); }
  }

  .shop-by-category__card:hover {
    transform: translateY(-15px) scale(1.02);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.9),
                0 0 50px rgba(0, 255, 255, 0.4),
                0 0 80px rgba(255, 0, 255, 0.3),
                inset 0 0 30px rgba(0, 255, 255, 0.1);
    border-color: rgba(0, 255, 255, 0.6);
  }

  .shop-by-category__card:hover::before {
    opacity: 0.5;
  }

  .shop-by-category__card-link {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
    color: inherit;
    position: relative;
    z-index: 3;
  }

  .shop-by-category__card-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 40px;
    z-index: 4;
  }

  .shop-by-category__card-title {
    color: white;
    font-size: 32px;
    font-weight: 800;
    text-shadow: 0 4px 20px rgba(0,0,0,0.8);
    margin-bottom: 15px;
    letter-spacing: -1px;
    line-height: 1.2;
    transform: translateY(0);
    transition: transform 0.5s ease;
  }

  .shop-by-category__card:hover .shop-by-category__card-title {
    transform: translateY(-10px);
  }

  .shop-by-category__card-subtitle {
    color: rgba(255, 255, 255, 0.8);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 2px;
    text-transform: uppercase;
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.5s ease;
  }

  .shop-by-category__card:hover .shop-by-category__card-subtitle {
    opacity: 1;
    transform: translateY(0);
  }

  .shop-by-category__arrow-icon {
    position: absolute;
    top: 30px;
    right: 30px;
    width: 50px;
    height: 50px;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    border: 2px solid rgba(255, 0, 128, 0.4);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ff0080;
    font-size: 24px;
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 5;
    box-shadow: 0 5px 20px rgba(255, 0, 128, 0.3),
                inset 0 0 10px rgba(255, 0, 128, 0.1);
  }

  .shop-by-category__card:hover .shop-by-category__arrow-icon {
    background: rgba(255, 255, 255, 1);
    border-color: #ff0080;
    transform: rotate(45deg) scale(1.15);
    box-shadow: 0 0 30px rgba(255, 0, 128, 1), 
                0 0 50px rgba(0, 255, 255, 0.8),
                0 0 70px rgba(121, 40, 202, 0.6),
                inset 0 0 20px rgba(255, 0, 128, 0.3);
  }

  .shop-by-category__dots {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 50px;
    padding-right: 60px;
  }

  .shop-by-category__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(150, 150, 150, 0.3);
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .shop-by-category__dot::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 2px solid transparent;
    transition: all 0.4s ease;
  }

  .shop-by-category__dot:hover {
    background: rgba(255, 0, 128, 0.5);
    transform: scale(1.3);
    box-shadow: 0 0 15px rgba(255, 0, 128, 0.5);
  }

  .shop-by-category__dot--active {
    background: linear-gradient(135deg, #ff0080, #7928ca, #00ffff);
    background-size: 200% 200%;
    width: 30px;
    border-radius: 5px;
    box-shadow: 0 0 25px rgba(255, 0, 128, 0.8), 
                0 0 40px rgba(0, 255, 255, 0.6),
                0 0 55px rgba(121, 40, 202, 0.5);
    animation: dotPulse 2s ease-in-out infinite;
  }

  @keyframes dotPulse {
    0%, 100% { 
      background-position: 0% 50%;
      box-shadow: 0 0 25px rgba(255, 0, 128, 0.8), 
                  0 0 40px rgba(0, 255, 255, 0.6),
                  0 0 55px rgba(121, 40, 202, 0.5);
    }
    50% { 
      background-position: 100% 50%;
      box-shadow: 0 0 35px rgba(255, 0, 128, 1), 
                  0 0 60px rgba(0, 255, 255, 0.8),
                  0 0 80px rgba(121, 40, 202, 0.7);
    }
  }

  .shop-by-category__dot--active::before {
    border-color: rgba(255, 0, 128, 0.5);
  }

  @media (max-width: 768px) {
    .shop-by-category {
      padding: 50px 0 50px 30px;
    }

    .shop-by-category__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 30px;
      padding-right: 30px;
      margin-bottom: 40px;
    }

    .shop-by-category__title {
      font-size: 42px;
    }
    
    .shop-by-category__scroll-container {
      margin-right: 30px;
    }
    
    .shop-by-category__card {
      min-width: 280px;
      height: 380px;
    }
    
    .shop-by-category__card-title {
      font-size: 26px;
    }

    .shop-by-category__dots {
      padding-right: 30px;
    }
  }

  @media (max-width: 480px) {
    .shop-by-category {
      padding: 40px 0 40px 20px;
    }

    .shop-by-category__header {
      padding-right: 20px;
    }

    .shop-by-category__title {
      font-size: 36px;
    }
    
    .shop-by-category__scroll-container {
      margin-right: 20px;
    }
    
    .shop-by-category__card {
      min-width: 240px;
      height: 320px;
    }
    
    .shop-by-category__card-title {
      font-size: 22px;
    }
    
    .shop-by-category__card-overlay {
      padding: 25px;
    }

    .shop-by-category__nav-btn {
      width: 45px;
      height: 45px;
      font-size: 18px;
    }

    .shop-by-category__dots {
      padding-right: 20px;
      margin-top: 40px;
    }
  }
</style>

<div class="shop-by-category">
  <div class="shop-by-category__content">
    <div class="shop-by-category__header">
      <div class="shop-by-category__title-wrapper">
        <h1 class="shop-by-category__title">Shop By Category</h1>
      </div>
      <div class="shop-by-category__nav-buttons">
        <div class="shop-by-category__nav-btn" id="prevBtn" aria-label="Previous">←</div>
        <div class="shop-by-category__nav-btn" id="nextBtn" aria-label="Next">→</div>
      </div>
    </div>

    <div class="shop-by-category__scroll-container">
      <div class="shop-by-category__cards-wrapper" id="shopByCategoryCardsWrapper">
        {% for block in section.blocks %}
          {% assign bg_image = block.settings.background_image | img_url: '800x' %}
          {% assign gradient_start = block.settings.gradient_color_start | default: '#1e3a8a' %}
          {% assign gradient_end = block.settings.gradient_color_end | default: '#3b82f6' %}
          
          <div class="shop-by-category__card"
            style="background-image:
              {% if bg_image != blank %}url({{ bg_image }}){% else %}linear-gradient(135deg, {{ gradient_start }}, {{ gradient_end }}){% endif %};"
            aria-label="{{ block.settings.title | escape }}"
            {{ block.shopify_attributes }}>
            <a href="{{ block.settings.link | default: '#' }}" class="shop-by-category__card-link">
              <div class="shop-by-category__arrow-icon" aria-hidden="true">→</div>
              <div class="shop-by-category__card-overlay">
                <div class="shop-by-category__card-content">
                  <div class="shop-by-category__card-subtitle">Explore Now</div>
                  <h3 class="shop-by-category__card-title">{{ block.settings.title | newline_to_br }}</h3>
                </div>
              </div>
            </a>
          </div>
        {% endfor %}
      </div>
    </div>

    <div class="shop-by-category__dots" id="shopByCategoryDots">
      <!-- Dots will be generated dynamically -->
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const wrapper = document.getElementById('shopByCategoryCardsWrapper');
  const container = document.querySelector('.shop-by-category__scroll-container');
  const dotsContainer = document.getElementById('shopByCategoryDots');
  const prevBtn = document.getElementById('prevBtn');
  const nextBtn = document.getElementById('nextBtn');
  
  let currentSlide = 0;
  let isDragging = false;
  let startPos = 0;
  let currentTranslate = 0;
  let prevTranslate = 0;
  let maxSlides = 0;
  let totalCards = 0;
  let visibleCards = 0;
  
  function calculateMaxSlides() {
    const containerWidth = container.offsetWidth;
    const cardWidth = getCardWidth();
    visibleCards = Math.floor(containerWidth / cardWidth);
    totalCards = wrapper.children.length;
    maxSlides = Math.max(0, totalCards - visibleCards);
    
    generateDots();
    
    if (maxSlides === 0) {
      dotsContainer.style.display = 'none';
      prevBtn.style.opacity = '0.3';
      nextBtn.style.opacity = '0.3';
      prevBtn.style.pointerEvents = 'none';
      nextBtn.style.pointerEvents = 'none';
    } else {
      dotsContainer.style.display = 'flex';
      prevBtn.style.pointerEvents = 'auto';
      nextBtn.style.pointerEvents = 'auto';
      updateNavButtons();
    }
    
    return maxSlides;
  }
  
  function updateNavButtons() {
    if (currentSlide === 0) {
      prevBtn.style.opacity = '0.3';
      prevBtn.style.pointerEvents = 'none';
    } else {
      prevBtn.style.opacity = '1';
      prevBtn.style.pointerEvents = 'auto';
    }
    
    if (currentSlide >= maxSlides) {
      nextBtn.style.opacity = '0.3';
      nextBtn.style.pointerEvents = 'none';
    } else {
      nextBtn.style.opacity = '1';
      nextBtn.style.pointerEvents = 'auto';
    }
  }
  
  function generateDots() {
    dotsContainer.innerHTML = '';
    const totalDots = maxSlides + 1;
    
    for (let i = 0; i < totalDots; i++) {
      const dot = document.createElement('div');
      dot.className = 'shop-by-category__dot';
      if (i === currentSlide) {
        dot.classList.add('shop-by-category__dot--active');
      }
      dot.dataset.slide = i;
      dot.setAttribute('aria-label', 'Go to slide ' + (i + 1));
      
      dot.addEventListener('click', function() {
        const targetSlide = parseInt(this.dataset.slide);
        if (targetSlide <= maxSlides) {
          currentSlide = targetSlide;
          updateSlide();
        }
      });
      
      dotsContainer.appendChild(dot);
    }
  }
  
  function getCardWidth() {
    const card = document.querySelector('.shop-by-category__card');
    if (!card) return 380;
    return card.offsetWidth + parseInt(window.getComputedStyle(wrapper).gap || '30');
  }
  
  function updateSlide() {
    maxSlides = calculateMaxSlides();
    
    if (currentSlide > maxSlides) {
      currentSlide = maxSlides;
    }
    
    const cardWidth = getCardWidth();
    const translateX = -currentSlide * cardWidth;
    wrapper.style.transform = `translateX(${translateX}px)`;
    
    const dots = dotsContainer.querySelectorAll('.shop-by-category__dot');
    dots.forEach((dot, index) => {
      dot.classList.toggle('shop-by-category__dot--active', index === currentSlide);
    });
    
    updateNavButtons();
  }
  
  // Navigation buttons
  prevBtn.addEventListener('click', function() {
    if (currentSlide > 0) {
      currentSlide--;
      updateSlide();
    }
  });
  
  nextBtn.addEventListener('click', function() {
    if (currentSlide < maxSlides) {
      currentSlide++;
      updateSlide();
    }
  });
  
  let touchStartTime = 0;
  let hasMoved = false;
  
  wrapper.addEventListener('touchstart', touchStart, { passive: true });
  wrapper.addEventListener('touchend', touchEnd, { passive: false });
  wrapper.addEventListener('touchmove', touchMove, { passive: false });
  
  wrapper.addEventListener('mousedown', touchStart);
  wrapper.addEventListener('mouseup', touchEnd);
  wrapper.addEventListener('mouseleave', touchEnd);
  wrapper.addEventListener('mousemove', touchMove);
  
  function touchStart(e) {
    touchStartTime = Date.now();
    hasMoved = false;
    
    if (e.type === 'touchstart') {
      startPos = e.touches[0].clientX;
    } else {
      isDragging = true;
      startPos = e.clientX;
    }
    
    prevTranslate = currentTranslate;
    wrapper.style.transition = 'none';
  }
  
  function touchEnd(e) {
    const touchEndTime = Date.now();
    const touchDuration = touchEndTime - touchStartTime;
    
    if (!hasMoved && touchDuration < 200) {
      isDragging = false;
      wrapper.style.transition = 'transform 0.6s cubic-bezier(0.4, 0, 0.2, 1)';
      updateSlide();
      return;
    }
    
    if (hasMoved) {
      e.preventDefault();
    }
    
    isDragging = false;
    wrapper.style.transition = 'transform 0.6s cubic-bezier(0.4, 0, 0.2, 1)';
    
    const movedBy = currentTranslate - prevTranslate;
    
    if (Math.abs(movedBy) > 50) {
      if (movedBy < 0 && currentSlide < maxSlides) {
        currentSlide++;
      } else if (movedBy > 0 && currentSlide > 0) {
        currentSlide--;
      }
    }
    
    currentTranslate = 0;
    prevTranslate = 0;
    updateSlide();
  }
  
  function touchMove(e) {
    let currentPosition;
    
    if (e.type === 'touchmove') {
      currentPosition = e.touches[0].clientX;
      const diff = Math.abs(currentPosition - startPos);
      
      if (diff > 10) {
        hasMoved = true;
        isDragging = true;
        e.preventDefault();
      }
      
      if (!isDragging) return;
    } else {
      if (!isDragging) return;
      currentPosition = e.clientX;
      hasMoved = true;
    }
    
    const diff = currentPosition - startPos;
    const cardWidth = getCardWidth();
    const maxTranslate = -maxSlides * cardWidth;
    
    let newTranslate = -currentSlide * cardWidth + diff;
    
    if (newTranslate > 0) {
      newTranslate = diff * 0.3;
    } else if (newTranslate < maxTranslate) {
      newTranslate = maxTranslate + (diff * 0.3);
    }
    
    wrapper.style.transform = `translateX(${newTranslate}px)`;
    currentTranslate = diff;
  }
  
  let resizeTimer;
  window.addEventListener('resize', function() {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(updateSlide, 100);
  });
  
  setTimeout(() => {
    updateSlide();
  }, 100);
});
</script>