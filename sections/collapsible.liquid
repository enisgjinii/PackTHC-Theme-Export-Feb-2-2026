{%- liquid
	assign section_id   = '#shopify-section-' | append: section.id
	assign animation    = settings.section_animation
	assign heading      = section.settings.heading_text
	assign heading_size = section.settings.heading_size
	assign sub_heading  = section.settings.sub_heading_text
	assign description  = section.settings.description
	assign align        = section.settings.text_align
	assign image        = section.settings.image
-%}

<style>
	{{ section_id }} .section-wrapper {
		padding-top: {{ section.settings.padding_top_mobile }}px;
		padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
	}

	@media (min-width: 992px) {
		{{ section_id }} .section-wrapper {
			padding-top: {{ section.settings.padding_top }}px;
			padding-bottom: {{ section.settings.padding_bottom }}px;
		}
	}

	{{ section_id }} .collapsible-item {
		padding-left: {{ section.settings.space }}px;
		padding-right: {{ section.settings.space }}px;
	}

	{%- for scheme in settings.color_schemes -%}
		{%- assign input_bg_color = scheme.settings.background_color | color_lighten: 8 -%}

		{{ section_id }} .color-{{ scheme.id }} {
			--input-bg-color: {{ input_bg_color.red }}, {{ input_bg_color.green }}, {{ input_bg_color.blue }};
		}
	{%- endfor -%}
</style>

<div class="section-wrapper color-{{ section.settings.color_scheme }}">
	<div class="container">
		<div class="collapsible-wrapper{% if image != blank %} has-image{% endif %}">
			{%- if image != blank -%}
				<div class="collabsible-image">
					<div class="image adapt-media{% if animation %} scroll-trigger{% endif %}">
						<div class="{% if settings.image_lazy and image %} lazy-image{% endif %}">
							{%- liquid
								if image != blank
									render 'lazy-image', image: image, width: 1200
								endif
							-%}
						</div>
					</div>
				</div>
			{%- endif -%}

			<div class="collapsible-content">
				<div class="collapsible-content-inner">
					<div class="collapsible-top text-{{ align }}">
						{%- if heading != blank or sub_heading != blank -%}
							<div class="title-wrapper{% if animation %} scroll-trigger{% endif %}">
								{%- if sub_heading != blank -%}
									<div class="sub-heading badge-heading rte">{{- sub_heading -}}</div>
								{%- endif -%}

								{%- if heading != blank -%}
									<h2 class="heading rte {{ heading_size }}">{{- heading -}}</h2>
								{%- endif -%}

								{%- if description != blank -%}
									<div class="description rte">{{- description -}}</div>
								{%- endif -%}
							</div>
						{%- endif -%}
					</div>

					{%- for block in section.blocks -%}
						{%- liquid
							assign tab_heading = block.settings.heading_size
						-%}

						{%- case block.type -%}
							{%- when '@app' -%}
								<div class="collapsible-item{% if animation %} scroll-trigger{% endif %}" {{ block.shopify_attributes }}>
									{%- render block -%}
								</div>

							{%- when 'tab' -%}
								<details class="collapsible-item{% if animation %} scroll-trigger{% endif %}" {{ block.shopify_attributes }}>
									<summary class="collapsible-summary" aria-expanded="false">
										{%- if section.settings.ordinal_number -%}
											<div class="line-order">{{- forloop.index -}}</div>
										{%- else -%}
											{%- render 'icon', code: 'checkmark-circle' -%}
										{%- endif -%}
										<h4 class="collapsible-title {{ tab_heading }}">
											{%- liquid
												echo block.settings.heading | default: block.settings.page.title | replace: '{product_title}', product.title
											-%}
										</h4>

										<span class="accordion-caret">
											<span class="plus">
												{%- render 'icon', code: 'caret-down' -%}
											</span>

											<span class="minus">
												{%- render 'icon', code: 'caret-up' -%}
											</span>
										</span>
									</summary>

									<div class="details-content">
										{%- liquid
											echo block.settings.content
											echo block.settings.page.content
										-%}
									</div>
								</details>

							{%- when 'text' -%}
								<div class="collapsible-info text-{{ align }}">
									{%- liquid
										if block.settings.icon != 'none'
											render 'icon-accordion', icon: block.settings.icon
										endif

										echo block.settings.info_text
									-%}
								</div>

							{%- when 'button' -%}
								<div class="content-buttons flex-justify-{% if align == 'left' %}start{% elsif align == 'right' %}end {% else %}center{% endif %}">
									{%- if block.settings.button_label != blank -%}
										<a class="button primary-button" href="{{ block.settings.button_link | default: '#' }}">
											{{- block.settings.button_label -}}

											{% if settings.select_button == 'direction' %}
												{%- render 'icon', code: 'direction-button' -%}
											{% elsif settings.select_button == 'arrow' %}
												{%- render 'icon', code: 'arrow-button' -%}
											{% endif %}
										</a>
									{%- endif -%}

									{%- if block.settings.second_button_label != blank -%}
										<a class="button secondary-button" href="{{ block.settings.second_button_link | default: '#' }}">
											{{- block.settings.second_button_label -}}

											{% if settings.select_button == 'direction' %}
												{%- render 'icon', code: 'direction-button' -%}
											{% elsif settings.select_button == 'arrow' %}
												{%- render 'icon', code: 'arrow-button' -%}
											{% endif %}
										</a>
									{%- endif -%}
								</div>
						{%- endcase -%}
					{%- endfor -%}
				</div>
			</div>
		</div>
	</div>
</div>

{% schema %}
{
	"name": "t:sections.collapsible.name",
	"class": "collapsible-section has-accordion-style",
	"tag": "section",
	"disabled_on": {
		"groups": ["header", "footer"]
	},
	"settings": [
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"label": "t:settings_schema.colors.label",
			"default": "scheme-1"
		},
		{
			"type": "image_picker",
			"id": "image",
			"label": "t:general.image.label"
		},
		{
			"type": "select",
			"id": "text_align",
			"options": [
				{
					"value": "left",
					"label": "t:general.layout.alignment.option_1.label"
				},
				{
					"value": "center",
					"label": "t:general.layout.alignment.option_2.label"
				},
				{
					"value": "right",
					"label": "t:general.layout.alignment.option_3.label"
				}
			],
			"default": "center",
			"label": "t:general.layout.alignment.label"
		},
		{
			"type": "text",
			"id": "sub_heading_text",
			"default": "Sub heading",
			"label": "t:general.typography.sub_heading.label"
		},
		{
			"type": "inline_richtext",
			"id": "heading_text",
			"default": "Heading",
			"label": "t:general.typography.heading.label"
		},
		{
			"type": "select",
			"id": "heading_size",
			"options": [
				{
					"value": "h4",
					"label": "t:general.typography.heading_size.option_1.label"
				},
				{
					"value": "h3",
					"label": "t:general.typography.heading_size.option_2.label"
				},
				{
					"value": "h2",
					"label": "t:general.typography.heading_size.option_3.label"
				}
			],
			"default": "h2",
			"label": "t:general.typography.heading_size.label"
		},
		{
			"type": "richtext",
			"id": "description",
			"default": "<p>Pair text with an image to focus on your chosen product, collection, or blog post. Add details on availability, style, or even provide a review.</p>",
			"label": "t:general.typography.description.label"
		},
		{
			"type": "header",
			"content": "t:sections.collapsible.settings.tab.content"
		},
		{
			"type": "checkbox",
			"id": "ordinal_number",
			"default": false,
			"label": "t:sections.collapsible.settings.ordinal_number.label"
		},
		{
			"type": "range",
			"id": "space",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 0,
			"unit": "px",
			"label": "t:sections.collapsible.settings.space_left_right.label"
		},
		{
			"type": "header",
			"content": "t:general.padding.header_padding.content"
		},
		{
			"type": "range",
			"id": "padding_top",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 50,
			"unit": "px",
			"label": "t:general.padding.top.label"
		},
		{
			"type": "range",
			"id": "padding_bottom",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 50,
			"unit": "px",
			"label": "t:general.padding.bottom.label"
		},
		{
			"type": "paragraph",
			"content": "t:general.padding.paragraph_mobile.content"
		},
		{
			"type": "range",
			"id": "padding_top_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 50,
			"unit": "px",
			"label": "t:general.padding.top.label"
		},
		{
			"type": "range",
			"id": "padding_bottom_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 50,
			"unit": "px",
			"label": "t:general.padding.bottom.label"
		}
	],
	"blocks": [
		{
			"type": "@app"
		},
		{
			"type": "tab",
			"name": "t:sections.collapsible.blocks.tab.name",
			"settings": [
				{
					"type": "inline_richtext",
					"id": "heading",
					"default": "Collapsible tab",
					"info": "t:sections.collapsible.blocks.tab.settings.heading.info",
					"label": "t:sections.collapsible.blocks.tab.settings.heading.label"
				},
				{
					"type": "select",
					"id": "heading_size",
					"options": [
						{
							"value": "h6",
							"label": "t:general.typography.heading_size.option_1.label"
						},
						{
							"value": "h5",
							"label": "t:general.typography.heading_size.option_2.label"
						},
						{
							"value": "h4",
							"label": "t:general.typography.heading_size.option_3.label"
						}
					],
					"default": "h6",
					"label": "t:general.typography.heading_size.label"
				},
				{
					"type": "inline_richtext",
					"id": "content",
					"default": "Collapsible content text",
					"label": "t:sections.collapsible.blocks.tab.settings.content.label"
				},
				{
					"type": "page",
					"id": "page",
					"label": "t:sections.collapsible.blocks.tab.settings.page.label"
				}
			]
		},
		{
			"type": "text",
			"name": "t:general.typography.text.label",
			"settings": [
				{
					"type": "select",
					"id": "icon",
					"options": [
						{
							"value": "none",
							"label": "t:sections.collapsible.blocks.tab.settings.icon.options__1.label"
						},
						{
							"value": "box",
							"label": "t:sections.collapsible.blocks.tab.settings.icon.options__2.label"
						},
						{
							"value": "chat_bubble",
							"label": "t:sections.collapsible.blocks.tab.settings.icon.options__3.label"
						},
						{
							"value": "check_mark",
							"label": "t:sections.collapsible.blocks.tab.settings.icon.options__4.label"
						},
						{
							"value": "dryer",
							"label": "t:sections.collapsible.blocks.tab.settings.icon.options__5.label"
						},
						{
							"value": "eye",
							"label": "t:sections.collapsible.blocks.tab.settings.icon.options__6.label"
						},
						{
							"value": "heart",
							"label": "t:sections.collapsible.blocks.tab.settings.icon.options__7.label"
						},
						{
							"value": "iron",
							"label": "t:sections.collapsible.blocks.tab.settings.icon.options__8.label"
						},
						{
							"value": "leaf",
							"label": "t:sections.collapsible.blocks.tab.settings.icon.options__9.label"
						},
						{
							"value": "leather",
							"label": "t:sections.collapsible.blocks.tab.settings.icon.options__10.label"
						},
						{
							"value": "lock",
							"label": "t:sections.collapsible.blocks.tab.settings.icon.options__11.label"
						},
						{
							"value": "map_pin",
							"label": "t:sections.collapsible.blocks.tab.settings.icon.options__12.label"
						},
						{
							"value": "pants",
							"label": "t:sections.collapsible.blocks.tab.settings.icon.options__13.label"
						},
						{
							"value": "plane",
							"label": "t:sections.collapsible.blocks.tab.settings.icon.options__14.label"
						},
						{
							"value": "price_tag",
							"label": "t:sections.collapsible.blocks.tab.settings.icon.options__15.label"
						},
						{
							"value": "question_mark",
							"label": "t:sections.collapsible.blocks.tab.settings.icon.options__16.label"
						},
						{
							"value": "return",
							"label": "t:sections.collapsible.blocks.tab.settings.icon.options__17.label"
						},
						{
							"value": "ruler",
							"label": "t:sections.collapsible.blocks.tab.settings.icon.options__18.label"
						},
						{
							"value": "shirt",
							"label": "t:sections.collapsible.blocks.tab.settings.icon.options__19.label"
						},
						{
							"value": "shoe",
							"label": "t:sections.collapsible.blocks.tab.settings.icon.options__20.label"
						},
						{
							"value": "silhouette",
							"label": "t:sections.collapsible.blocks.tab.settings.icon.options__21.label"
