					"default": "none",
					"label": "t:sections.collapsible.blocks.tab.settings.icon.label"
				},
				{
					"type": "inline_richtext",
					"id": "info_text",
					"default": "Contact information",
					"label": "t:general.typography.text.label"
				}
			]
		},
		{
			"type": "button",
			"name": "t:general.typography.button.label",
			"settings": [
				{
					"type": "text",
					"id": "button_label",
