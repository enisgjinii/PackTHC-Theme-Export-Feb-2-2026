{%- liquid
	assign section_id = '#shopify-section-' | append: section.id
	assign delay_time = section.settings.delay_time | times: 1000
	assign form_class = 'age-verification-popup'
	assign image = section.settings.image
-%}

<style>
	{{section_id}} {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: rgba(0, 0, 0, 0.85);
		z-index: 99999;
		display: none;
		align-items: center;
		justify-content: center;
	}

	{{section_id}}.show {
		display: flex;
	}

	{{section_id}} .age-popup-container {
		background: white;
		border-radius: 8px;
		max-width: 500px;
		width: 90%;
		max-height: 90vh;
		overflow-y: auto;
		box-shadow: 0 10px 50px rgba(0,0,0,0.3);
        margin: 0 auto;
		transition: all 0.3s ease;
	}

	{{section_id}} .age-popup-image {
		width: 100%;
		height: 250px;
		overflow: hidden;
		border-radius: 8px 8px 0 0;
	}

	{{section_id}} .age-popup-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	{{section_id}} .age-popup-content {
		padding: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
		text-align: center;
	}

	{{section_id}} .age-heading {
		font-size: 28px;
		font-weight: bold;
		margin-bottom: 15px;
		color: #000;
	}

	{{section_id}} .age-description {
		font-size: 16px;
		color: #666;
		margin-bottom: 25px;
		line-height: 1.5;
	}

	{{section_id}} .button-container {
		display: flex;
		gap: 15px;
		justify-content: center;
		margin-top: 30px;
	}

	{{section_id}} .age-button {
		padding: 16px 40px;
		font-size: 16px;
		font-weight: 600;
		border: none;
		border-radius: 6px;
		cursor: pointer;
		transition: all 0.3s ease;
		flex: 1;
		max-width: 200px;
	}

	{{section_id}} .no-button {
		background: white;
		color: #000;
		border: 2px solid #ddd;
		order: 1;
	}

	{{section_id}} .no-button:hover {
		background: #f5f5f5;
		border-color: #000;
		transform: translateY(-2px);
	}

	{{section_id}} .yes-button {
		background: #033770;
		color: white;
		order: 2;
	}

	{{section_id}} .yes-button:hover {
		background: #033770;
		transform: translateY(-2px);
		box-shadow: 0 4px 12px rgba(45, 95, 63, 0.3);
	}

	@media (max-width: 768px) {
		{{section_id}} .age-popup-content {
			padding: {{ section.settings.padding_top_mobile }}px {{ section.settings.padding_bottom_mobile }}px;
		}

		{{section_id}} .age-heading {
			font-size: 24px;
		}

		{{section_id}} .button-container {
			flex-direction: column;
		}

		{{section_id}} .age-button {
			max-width: 100%;
		}
	}
</style>

<div class="{{ form_class }}" data-delay="{{ delay_time }}" data-section-id="{{ section_id }}">
	<div class="age-popup-container">
		{% if image %}
		<div class="age-popup-image">
			{{ image | image_url: width: 500 | image_tag }}
		</div>
		{% endif %}

		<div class="age-popup-content">
			<h2 class="age-heading">{{ section.settings.heading | default: "Are you 21 or older?" }}</h2>
			<p class="age-description">{{ section.settings.description | default: "You must be 21 years of age or older to enter this site. Please confirm your age." }}</p>
			
			<div class="button-container">
				<button class="age-button no-button" data-action="redirect-google">{{ section.settings.decline_button | default: "NO" }}</button>
				<button class="age-button yes-button" data-action="verify-yes">{{ section.settings.approve_button | default: "YES" }}</button>
			</div>
		</div>
	</div>
</div>

<script>
(function() {
	const popup = document.querySelector('{{ section_id }}');
	if (!popup) return;

	// Check if we're on homepage only
	const isHomepage = window.location.pathname === '/' || window.location.pathname === '/index.html' || window.location.pathname === '';
	if (!isHomepage) return;

	const delay = parseInt(popup.querySelector('[data-delay]').getAttribute('data-delay')) || 3000;

	// Check if user verified in this session
	function isAgeVerified() {
		return sessionStorage.getItem('ageVerified') === 'true';
	}

	// Show popup after delay
	function showPopup() {
		if (isAgeVerified()) return;
		
		setTimeout(() => {
			popup.classList.add('show');
		}, delay);
	}

	// Event delegation for all buttons
	popup.addEventListener('click', function(e) {
		const action = e.target.getAttribute('data-action');
		
		if (action === 'verify-yes') {
			// User confirmed they are 21+
			sessionStorage.setItem('ageVerified', 'true');
			popup.classList.remove('show');
		}
		else if (action === 'redirect-google') {
			// User clicked NO - redirect to Google
			window.location.href = 'https://www.google.com';
		}
	});

	// Initialize
	showPopup();
})();
</script>

{% schema %}
{
	"name": "Age Verification Popup",
	"tag": "section",
	"class": "age-verification-section",
	"limit": 1,
	"enabled_on": {
		"groups": ["footer"]
	},
	"settings": [
		{
			"type": "header",
			"content": "Settings"
		},
		{
			"type": "range",
			"id": "delay_time",
			"label": "Delay before showing (seconds)",
			"info": "Time to wait before displaying the popup",
			"default": 3,
			"min": 0,
			"max": 10,
			"step": 1,
			"unit": "s"
		},
		{
			"type": "image_picker",
			"id": "image",
			"label": "Popup Image"
		},
		{
			"type": "header",
			"content": "Content"
		},
		{
			"type": "text",
			"id": "heading",
			"default": "Are you 21 or older?",
			"label": "Heading"
		},
		{
			"type": "textarea",
			"id": "description",
			"default": "You must be 21 years of age or older to enter this site. Please confirm your age.",
			"label": "Description"
		},
		{
			"type": "text",
			"id": "approve_button",
			"default": "YES",
			"label": "Yes Button Text"
		},
		{
			"type": "text",
			"id": "decline_button",
			"default": "NO",
			"label": "No Button Text"
		},
		{
			"type": "header",
			"content": "Padding"
		},
		{
			"type": "range",
			"id": "padding_top",
			"min": 20,
			"max": 100,
			"step": 5,
			"default": 40,
			"unit": "px",
			"label": "Top Padding"
		},
		{
			"type": "range",
			"id": "padding_bottom",
			"min": 20,
			"max": 100,
			"step": 5,
			"default": 40,
			"unit": "px",
			"label": "Bottom Padding"
		},
		{
			"type": "range",
			"id": "padding_top_mobile",
			"min": 15,
			"max": 60,
			"step": 5,
			"default": 30,
			"unit": "px",
			"label": "Top Padding (Mobile)"
		},
		{
			"type": "range",
			"id": "padding_bottom_mobile",
			"min": 15,
			"max": 60,
			"step": 5,
			"default": 30,
			"unit": "px",
			"label": "Bottom Padding (Mobile)"
		}
	],
	"presets": [
		{
			"name": "Age Verification Popup"
		}
	]
}
{% endschema %}