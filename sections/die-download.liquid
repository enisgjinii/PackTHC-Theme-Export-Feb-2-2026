{% comment %}
  Easy Die Lines Page Template for Shopify
  Save as: sections/die-lines.liquid
{% endcomment %}

<style>
    .die-lines-page {
        font-family: 'Poppins', sans-serif;
        line-height: 1.6;
        color: {{ section.settings.text_color | default: '#333' }};
        background: {{ section.settings.background_color | default: '#ffffff' }};
        min-height: 100vh;
    }

    .die-lines-container {
        max-width: {{ section.settings.container_width | default: '1200px' }};
        margin: 0 auto;
        padding: 20px;
    }

    .die-lines-header {
        text-align: center;
        margin-bottom: 40px;
        background: {{ section.settings.header_background | default: '#ffffff' }};
        padding: 30px;
    }

    .die-lines-title {
        color: {{ section.settings.primary_color | default: '#004A26' }};
        font-size: {{ section.settings.heading_size | default: '2.5em' }};
        margin-bottom: 15px;
    }

    .die-lines-description {
        font-size: 1.1em;
        color: {{ section.settings.description_color | default: '#666' }};
        margin-bottom: 20px;
    }

    .die-section {
        background: {{ section.settings.section_background | default: '#ffffff' }};
        margin: 30px 0;
        padding: 30px;
        border-radius: 15px;
        box-shadow: 0 8px 25px rgba(0, 74, 38, 0.1);
        border: 2px solid {{ section.settings.primary_color | default: '#004A26' }};
    }

    .die-section-title {
        color: {{ section.settings.primary_color | default: '#004A26' }};
        font-size: 1.8em;
        margin-bottom: 20px;
        border-bottom: 2px solid {{ section.settings.primary_color | default: '#004A26' }};
        padding-bottom: 10px;
    }

    .die-links-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 15px;
        margin-top: 20px;
    }

    .die-link {
        display: flex;
        align-items: center;
        padding: 15px 20px;
        background: {{ section.settings.primary_color | default: '#004A26' }};
        color: white;
        text-decoration: none;
        border-radius: 10px;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(0, 74, 38, 0.2);
    }

    .die-link:hover {
        transform: translateY(-3px);
        background: {{ section.settings.hover_color | default: '#005A30' }};
        color: white;
        text-decoration: none;
    }

    .die-link i {
        margin-right: 10px;
        font-size: 1.2em;
    }

    .die-link-text {
        font-weight: 500;
        flex: 1;
    }

    .die-link-icon {
        font-size: 1.3em;
    }

    @media (max-width: 768px) {
        .die-lines-container {
            padding: 10px;
        }
        
        .die-lines-title {
            font-size: 2em;
        }
        
        .die-links-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

