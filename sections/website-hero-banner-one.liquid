{% schema %}
{
  "name": "main page hero banner",
  "settings": [
    {
      "type": "range",
      "id": "auto_scroll_time",
      "label": "Auto Scroll Time (seconds)",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "background_image_desktop",
          "label": "Desktop Background Image"
        },
        {
          "type": "image_picker",
          "id": "background_image_mobile",
          "label": "Mobile Background Image"
        },
        {
          "type": "url",
          "id": "slide_link",
          "label": "Slide Link"
        },
        {
          "type": "collection",
          "id": "linked_collection",
          "label": "Linked Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "main page hero banner",
      "category": "Image"
    }
  ]
}
{% endschema %}

<style>
.hero-banner{aspect-ratio:1762/577;margin:5px auto 0;position:relative;background:center/cover #f8f8f8;transition:background-image .5s}
.hero-banner a{position:absolute;inset:0;z-index:2}
.dots{margin:15px auto 0;display:flex;justify-content:center;gap:8px}
.dot{width:10px;height:10px;border-radius:50%;background:#999;cursor:pointer;transition:background .3s}
.dot.active,.dot:hover{background:#202425}
@media(max-width:768px){.hero-banner{aspect-ratio:1080/1920;background-image:var(--mb)!important}}
@media(prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
{% if section.blocks.size > 0 %}
  {% assign hero_desktop = section.blocks.first.settings.background_image_desktop | img_url: '1762x577' %}
  {% assign hero_mobile  = section.blocks.first.settings.background_image_mobile  | img_url: '800x' %}

  {% if hero_desktop != blank %}
    <link rel="preload" as="image" href="{{ hero_desktop }}" media="(min-width: 769px)" fetchpriority="high">
  {% endif %}
  {% if hero_mobile != blank %}
    <link rel="preload" as="image" href="{{ hero_mobile }}" media="(max-width: 768px)" fetchpriority="high">
  {% endif %}
{% endif %}
<div class="hero-banner" id="h" style="background-image:url('{{ section.blocks.first.settings.background_image_desktop | img_url: '1762x577' }}');--mb:url('{{ section.blocks.first.settings.background_image_mobile | img_url: '800x' }}')">
  <a href="{{ section.blocks.first.settings.slide_link | default: section.blocks.first.settings.linked_collection.url }}" id="l"></a>
</div>

{% if section.blocks.size > 1 %}
<div class="dots" id="d">
  {% for block in section.blocks %}
  <div class="dot{% if forloop.first %} active{% endif %}" onclick="s({{ forloop.index0 }})"></div>
  {% endfor %}
</div>

<script>
{%- assign slides_json = '' -%}
{%- for block in section.blocks -%}
  {%- assign desktop_url = block.settings.background_image_desktop | img_url: '1762x577' -%}
  {%- assign mobile_url = block.settings.background_image_mobile | img_url: '800x' -%}
  {%- assign link_url = block.settings.slide_link | default: block.settings.linked_collection.url -%}
  {%- assign slide_data = desktop_url | append: '|' | append: mobile_url | append: '|' | append: link_url -%}
  {%- if forloop.first -%}
    {%- assign slides_json = slide_data -%}
  {%- else -%}
    {%- assign slides_json = slides_json | append: ',' | append: slide_data -%}
  {%- endif -%}
{%- endfor -%}

(function(){
var h=document.getElementById('h'),l=document.getElementById('l'),d=document.getElementById('d'),
slides='{{ slides_json }}'.split(',').map(s=>s.split('|')),
i=0,t,auto={{ section.settings.auto_scroll_time | times: 1000 }};

function u(){
h.style.backgroundImage='url('+slides[i][0]+')';
h.style.setProperty('--mb','url('+slides[i][1]+')');
l.href=slides[i][2];
if(d){
d.children[i].className='dot active';
for(var j=0;j<slides.length;j++)if(j!==i)d.children[j].className='dot';
}
}

function n(){i=(i+1)%slides.length;u()}

function s(x){i=x;u();clearInterval(t);t=setInterval(n,auto)}

window.s=s;
u();
if(slides.length>1){
t=setInterval(n,auto);
h.onmouseenter=()=>clearInterval(t);
h.onmouseleave=()=>t=setInterval(n,auto);
}
})();
</script>
{% endif %}