{% comment %}
  Section: Product Strains - Simple Gallery with Expanding Images
  File: sections/product-strains-simple.liquid
{% endcomment %}

<style>
  .ps-section {
    padding: 60px 0;
    background-color: {{ section.settings.background_color }};
  }

  .ps-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ps-hero-content {
    text-align: center;
    margin-bottom: 50px;
  }

  .ps-title {
    font-size: 48px;
    font-weight: 700;
    color: {{ section.settings.title_color }};
    margin: 0 0 15px 0;
  }

  .ps-label {
    font-size: 13px;
    font-weight: 600;
    color: {{ section.settings.label_color }};
    margin: 0 0 20px 0;
    text-transform: uppercase;
    letter-spacing: 2px;
    opacity: 0.8;
  }

  .ps-description {
    font-size: 15px;
    color: {{ section.settings.description_color }};
    line-height: 1.7;
    margin: 0 auto 30px auto;
    max-width: 800px;
  }

  .ps-cta-button {
    display: inline-block;
    padding: 14px 40px;
    background: {{ section.settings.button_background }};
    color: {{ section.settings.button_text_color }};
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 30px;
    letter-spacing: 1px;
    transition: all 0.3s ease;
  }

  .ps-cta-button:hover {
    background: {{ section.settings.button_hover_background }};
    transform: translateY(-2px);
  }

  .ps-gallery-wrapper {
    position: relative;
    width: 100%;
    height: 450px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ps-gallery-container {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    height: 100%;
  }

  .ps-gallery-item {
    position: relative;
    height: 100%;
    flex-shrink: 0;
    border-radius: 20px;
    overflow: hidden;
    cursor: pointer;
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    width: 140px;
  }

  .ps-gallery-item.ps-expanded {
    width: 400px;
    z-index: 10;
  }

  .ps-gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .ps-gallery-item.ps-expanded img {
    transform: scale(1.05);
  }

  .ps-gallery-item::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 0%;
    background: linear-gradient(to top, rgba(0,0,0,0.6), transparent);
    transition: height 0.5s ease;
    pointer-events: none;
  }

  .ps-gallery-item.ps-expanded::after {
    height: 40%;
  }

  .ps-image-caption {
    position: absolute;
    bottom: 25px;
    left: 25px;
    right: 25px;
    color: white;
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.5s ease;
    z-index: 2;
  }

  .ps-gallery-item.ps-expanded .ps-image-caption {
    opacity: 1;
    transform: translateY(0);
  }

  .ps-image-caption h3 {
    font-size: 22px;
    font-weight: 600;
    margin: 0 0 5px 0;
  }

  .ps-image-caption p {
    font-size: 13px;
    margin: 0;
    opacity: 0.9;
  }

  @media (max-width: 1024px) {
    .ps-section {
      padding: 50px 0;
    }

    .ps-title {
      font-size: 40px;
    }

    .ps-gallery-wrapper {
      height: 380px;
    }

    .ps-gallery-item {
      width: 110px;
    }

    .ps-gallery-item.ps-expanded {
      width: 320px;
    }
  }

  @media (max-width: 768px) {
    .ps-section {
      padding: 40px 0;
    }

    .ps-title {
      font-size: 32px;
    }

    .ps-description {
      font-size: 14px;
    }

    .ps-gallery-wrapper {
      height: 320px;
    }

    .ps-gallery-item {
      width: 90px;
      border-radius: 15px;
    }

    .ps-gallery-item.ps-expanded {
      width: 240px;
    }

    .ps-gallery-container {
      gap: 8px;
    }
  }

  @media (max-width: 480px) {
    .ps-gallery-wrapper {
      height: 280px;
    }

    .ps-gallery-item {
      width: 70px;
      border-radius: 12px;
    }

    .ps-gallery-item.ps-expanded {
      width: 180px;
    }

    .ps-image-caption h3 {
      font-size: 16px;
    }

    .ps-image-caption p {
      font-size: 11px;
    }
  }
</style>

<div class="ps-section">
  <div class="ps-container">
    <div class="ps-hero-content">
      {% if section.settings.title != blank %}
        <h2 class="ps-title">{{ section.settings.title }}</h2>
      {% endif %}

      {% if section.settings.label != blank %}
        <div class="ps-label">{{ section.settings.label }}</div>
      {% endif %}

      {% if section.settings.description != blank %}
        <p class="ps-description">{{ section.settings.description }}</p>
      {% endif %}

      {% if section.settings.button_text != blank and section.settings.button_link != blank %}
        <a href="{{ section.settings.button_link }}" class="ps-cta-button">
          {{ section.settings.button_text }}
        </a>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="ps-gallery-wrapper">
        <div class="ps-gallery-container" id="psGalleryContainer-{{ section.id }}">
          {% for block in section.blocks %}
            <div class="ps-gallery-item {% if forloop.index == 2 %}ps-expanded{% endif %}" 
                 data-index="{{ forloop.index0 }}"
                 {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 800 | image_tag: alt: block.settings.caption, loading: 'lazy' }}
              {% else %}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}
              
              {% if block.settings.caption != blank or block.settings.subcaption != blank %}
                <div class="ps-image-caption">
                  {% if block.settings.caption != blank %}
                    <h3>{{ block.settings.caption }}</h3>
                  {% endif %}
                  {% if block.settings.subcaption != blank %}
                    <p>{{ block.settings.subcaption }}</p>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </div>
</div>

<script>
(function() {
  const sectionId = '{{ section.id }}';
  const container = document.getElementById('psGalleryContainer-' + sectionId);
  
  if (!container) return;
  
  const items = container.querySelectorAll('.ps-gallery-item');
  
  items.forEach(function(item) {
    item.addEventListener('mouseenter', function() {
      items.forEach(function(otherItem) {
        otherItem.classList.remove('ps-expanded');
      });
      this.classList.add('ps-expanded');
    });
  });
  
  container.addEventListener('mouseleave', function() {
    items.forEach(function(item, index) {
      item.classList.remove('ps-expanded');
      if (index === 1) {
        item.classList.add('ps-expanded');
      }
    });
  });
})();
</script>

{% schema %}
{
  "name": "Product Strains",
  "tag": "section",
  "class": "product-strains-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Product Title",
      "default": "Fried Bananas"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Section Label",
      "default": "Description"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Freshly fried flavor, bred from Apples & Bananas x Gelato 41 by the team at Cookies' One Log HQ in Humboldt and selected by Berner."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Label Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color",
      "default": "#cccccc"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_hover_background",
      "label": "Button Hover Background",
      "default": "#f0f0f0"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Gallery Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Vertical/portrait images work best"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Image Caption (Optional)",
          "info": "Shows when image is expanded"
        },
        {
          "type": "text",
          "id": "subcaption",
          "label": "Image Subcaption (Optional)",
          "info": "Shows below caption when expanded"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Strains",
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ]
    }
  ]
}
{% endschema %}