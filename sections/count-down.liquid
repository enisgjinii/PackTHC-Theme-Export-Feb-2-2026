{%- comment -%}
  SECTION: us-countdown-timer.liquid
  Desktop-only countdown: active at widths >= 1025px (hidden & inert on smaller screens)
  Fixed bottom-left countdown to Nov 15, 2025 00:00:00 (US timezone)
  - Black Friday sale vibe: dark + neon accent
  - Compact and responsive on desktop, hidden on mobile
{%- endcomment -%}

<section id="us-countdown-timer-{{ section.id }}" class="us-countdown-fixed" aria-live="polite" aria-atomic="true">
  <div class="us-countdown-wrap" role="region" aria-label="Countdown to November 15">
    <div class="bf-badge" aria-hidden="true">BLACK FRIDAY</div>

    <div class="us-countdown-display" aria-hidden="false">
      <span class="time-seg days" aria-label="days">--</span>
      <span class="sep">:</span>
      <span class="time-seg hours" aria-label="hours">--</span>
      <span class="sep">:</span>
      <span class="time-seg minutes" aria-label="minutes">--</span>
      <span class="sep">:</span>
      <span class="time-seg seconds" aria-label="seconds">--</span>
    </div>
  </div>
<style>
  :root {
    --bf-bg: #0b0b0c;
    --bf-panel: linear-gradient(180deg,#0f0f10 0%, #0b0b0c 100%);
    --neon: #ffcc00;
    --neon-2: #ff6a00;
    --glow: rgba(255,204,0,0.12);
  }

  /* Mobile-first: show on right side by default (phone view) */
  .us-countdown-fixed {
    display: block;
    position: fixed;
    bottom: 20px;
    right: 10px; /* mobile: anchor to right */
    z-index: 999999;
    -webkit-tap-highlight-color: transparent;
    font-family: 'Segoe UI', Roboto, Arial, sans-serif;
  }

  /* Desktop breakpoint: show & anchor to left at widths >= 1025px */
  @media (min-width: 1025px) {
    .us-countdown-fixed {
      display: block;
      left: 20px;  /* desktop: anchor to left */
      right: auto; /* remove mobile right anchor */
    }

    .us-countdown-wrap {
      position: relative; /* ensure ::after glow positions correctly */
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 8px;
      border-radius: 14px;
      background: var(--bf-panel);
      min-width: 220px;
      transition: transform 0.14s ease, box-shadow 0.14s ease;
    }

   
    .bf-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 6px 8px;
      border-radius: 8px;
      font-size: 11px;
      font-weight: 800;
      color: #0b0b0c;
      background: linear-gradient(90deg, var(--neon), var(--neon-2));
      text-transform: uppercase;
      letter-spacing: 0.12em;
      margin-left: 6px; /* badge sits to the right of timer on desktop */
    }

    .us-countdown-display {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px;
      border-radius: 10px;
      background: rgba(255,255,255,0.03);
      color: #fff;
      font-weight: 700;
      letter-spacing: 1.5px;
      box-shadow: inset 0 -2px 8px rgba(0,0,0,0.45);
    }

    .time-seg {
      display: inline-flex;
      justify-content: center;
      align-items: center;
      min-width: 38px;
      padding: 6px 8px;
      border-radius: 8px;
      background: linear-gradient(180deg, rgba(255,255,255,0.02), rgba(0,0,0,0.18));
      font-size: 14px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.5);
    }

    .time-seg.days { min-width: 56px; font-size: 13px; letter-spacing: 1px; }

    .sep {
      color: rgba(255,255,255,0.72);
      font-size: 16px;
      transform: translateY(-1px);
    }

    /* neon underline glow */
    .us-countdown-wrap::after {
      content: '';
      position: absolute;
      left: 12px;
      right: 12px;
      bottom: -8px;
      height: 6px;
      background: linear-gradient(90deg, rgba(255,204,0,0.08), rgba(255,106,0,0.05));
      border-radius: 10px;
      filter: blur(6px);
      pointer-events: none;
    }
  }

  /* keep compact on very small screens if CSS fallback shown for any reason */
  @media (max-width: 520px) {
    .us-countdown-wrap { min-width: 160px; gap: 8px; padding: 6px; }
    .bf-badge { display: none; }
    .time-seg { min-width: 30px; padding: 5px 6px; font-size: 13px; }
    .time-seg.days { min-width: 44px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .us-countdown-wrap { transition: none; transform: none; }
  }
</style>



  <script>
(function () {
  // Wait until DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

  function init() {
    const container = document.getElementById('us-countdown-timer-{{ section.id }}');
    if (!container) return console.warn('Countdown: container not found');

    // Target: Nov 15, 2025 00:00:00 in selected timezone
    const year = 2025, month = 11, day = 28;
    const tz = "{{ section.settings.timezone | default: 'America/New_York' }}";

    const tzOffsetMap = {
      'America/New_York': '-05:00',
      'America/Chicago': '-06:00',
      'America/Denver': '-07:00',
      'America/Los_Angeles': '-08:00'
    };

    const offset = tzOffsetMap[tz] || '-05:00';
    const targetIso = `${year}-${String(month).padStart(2,'0')}-${String(day).padStart(2,'0')}T00:00:00${offset}`;
    const targetMs = new Date(targetIso).getTime();

    if (isNaN(targetMs)) {
      console.error('Countdown: Invalid date', targetIso);
      return;
    }

    // DOM elements
    const display = container.querySelector('.us-countdown-display');
    const daysEl = display?.querySelector('.days');
    const hoursEl = display?.querySelector('.hours');
    const minsEl = display?.querySelector('.minutes');
    const secsEl = display?.querySelector('.seconds');
    if (!daysEl || !hoursEl || !minsEl || !secsEl) {
      console.warn('Countdown: missing display elements');
      return;
    }

    const pad = (n) => String(n).padStart(2, '0');

    function update() {
      const now = Date.now();
      let diff = targetMs - now;

      if (diff <= 0) {
        daysEl.textContent = '00';
        hoursEl.textContent = '00';
        minsEl.textContent = '00';
        secsEl.textContent = '00';
        const wrap = container.querySelector('.us-countdown-wrap');
        if (wrap) wrap.style.boxShadow = '0 6px 24px rgba(0,0,0,0.7)';
        return;
      }

      const sec = 1000;
      const minute = 60 * sec;
      const hour = 60 * minute;
      const day = 24 * hour;

      const d = Math.floor(diff / day);
      diff -= d * day;
      const h = Math.floor(diff / hour);
      diff -= h * hour;
      const m = Math.floor(diff / minute);
      diff -= m * minute;
      const s = Math.floor(diff / sec);

      daysEl.textContent = pad(d);
      hoursEl.textContent = pad(h);
      minsEl.textContent = pad(m);
      secsEl.textContent = pad(s);
    }

    // Start timer
    update();
    setInterval(update, 1000);
  }
})();
</script>

</section>

{% schema %}
{
  "name": "Countdown",
  "settings": [
    {
      "type": "select",
      "id": "timezone",
      "label": "Select US Timezone (countdown target interprets Nov 15 in this zone)",
      "default": "America/New_York",
      "options": [
        { "value": "America/New_York", "label": "Eastern Time" },
        { "value": "America/Chicago", "label": "Central Time" },
        { "value": "America/Denver", "label": "Mountain Time" },
        { "value": "America/Los_Angeles", "label": "Pacific Time" }
      ]
    }
  ],
  "presets": [
    { "name": "Countdown" }
  ]
}
{% endschema %}
