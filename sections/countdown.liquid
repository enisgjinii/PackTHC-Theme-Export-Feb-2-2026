{%- liquid
	assign section_id    = '#shopify-section-' | append: section.id
	assign animation     = settings.section_animation
	assign overlay       = section.settings.overlay
	assign heading       = section.settings.heading_text
	assign heading_size  = section.settings.heading_size
	assign description   = section.settings.text
	assign button        = section.settings.button
	assign image_desktop = section.settings.image
	assign image_mobile  = section.settings.mobile_image
	assign alignment     = section.settings.alignment
	assign full          = section.settings.full
	assign one_week      = 7 | times: 24 | times: 60 | times: 60
	assign future_time   = 'now' | date: '%s' | plus: one_week | date: '%-m/%-d/%y %-H:%M:%S'
-%}

<style>
	{{ section_id }} .section-wrap {
		padding-top: {{ section.settings.padding_top_mobile }}px;
		padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
	}

	{{ section_id }} .section-wrap:before {
		background: linear-gradient(to bottom,{%- if overlay == 100 -%}rgb(0,0,0){%- else -%}rgba(0,0,0,0.{{ overlay }}){%- endif -%},{%- if overlay == 100 -%}rgb(0,0,0){%- else -%}rgba(0,0,0,0.{{ overlay }}){%- endif -%});
	}

	@media (min-width: 992px) {
		{{ section_id }} .section-wrap {
			padding-top: {{ section.settings.padding_top }}px;
			padding-bottom: {{ section.settings.padding_bottom }}px;
		}
	}
</style>

<div class="section-wrap color-{{ section.settings.color_scheme }}">
	<div class="content-wrap">
		<div class="{% if full %}stretch-section stretch-padding{% else %}container{% endif %}">
			{%- if heading != blank or button != blank -%}
				<div class="content-top flex-justify-{{ section.settings.position_x }}">
					<div class="title-wrapper text-{{ alignment }}">
						{%- if heading != blank -%}
							<div class="heading rte {{ heading_size }}">{{- heading -}}</div>
						{%- endif -%}

						{%- if description != blank -%}
							<div class="description rte{% if animation %} scroll-trigger{% endif %}">{{- description -}}</div>
						{%- endif -%}

						{%- if button != blank -%}
							<a class="button primary-button" href="{{ section.settings.button_link | default: '#' }}">
								{{- button -}}

								{% if settings.select_button == 'direction' %}
									{%- render 'icon', code: 'direction-button' -%}
								{% elsif settings.select_button == 'arrow' %}
									{%- render 'icon', code: 'arrow-button' -%}
								{% endif %}
							</a>
						{%- endif -%}
					</div>
				</div>
			{%- endif -%}

			{%- if section.settings.show_countdown -%}
				<div class="box-countdown">
					<div class="countdown-time-wrap flat-countdown hidden flex-justify-{% if alignment == 'left' %}start{% elsif alignment == 'right' %}end{% else %}center{% endif %}">
						<div class="countdown-time" data-time="{% if section.settings.countdown_time != blank %}{{ section.settings.countdown_time }}{% else %}{{ future_time }}{% endif %}">
							<div class="time-block">
								<span class="time-number days"></span>
								<span class="time-text">{{- 'general.time.days' | t -}}</span>
							</div>

							<div class="time-block">
								<span class="time-number hours"></span>
								<span class="time-text">{{- 'general.time.hours' | t -}}</span>
							</div>

							<div class="time-block">
								<span class="time-number minutes"></span>
								<span class="time-text">{{- 'general.time.mins' | t -}}</span>
							</div>

							<div class="time-block">
								<span class="time-number seconds"></span>
								<span class="time-text">{{- 'general.time.seconds' | t -}}</span>
							</div>
						</div>
					</div>
				</div>
			{%- endif -%}
		</div>
	</div>

		<div class="image{% if animation %} scroll-trigger{% endif %}{% if image_mobile != blank %} hidden-tablet hidden-mobile{% endif %}{% if settings.image_lazy and image_desktop != blank %} lazy-image{% endif %}">
			{%- liquid
				if image_desktop != blank
					render 'lazy-image', image: image_desktop, width: 1920
				else
					render 'icon', code: 'placeholder'
				endif
			-%}
		</div>

		{%- if image_mobile != blank -%}
			<div class="image hidden-desktop{% if settings.image_lazy %} lazy-image{% endif %}">
				{%- render 'lazy-image', image: image_mobile, width: 991 -%}
			</div>
		{%- endif -%}
</div>

{% schema %}
{
	"name": "t:sections.count-down.name",
	"tag": "section",
	"class": "countdown-section",
	"disabled_on": {
		"groups": ["header", "footer"]
	},
	"settings": [
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"label": "t:settings_schema.colors.label",
			"default": "scheme-1"
		},
		{
			"type": "header",
			"content": "t:general.image.label"
		},
		{
			"type": "image_picker",
			"id": "image",
			"label": "t:sections.count-down.settings.desktop_image.label"
		},
		{
			"type": "image_picker",
			"id": "mobile_image",
			"label": "t:sections.count-down.settings.mobile_image.label"
		},
		{
			"type": "range",
			"id": "overlay",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 20,
			"unit": "%",
			"label": "t:sections.video-background.settings.overlay.label",
			"info": "t:sections.video-background.settings.overlay.info"
		},
		{
			"type": "header",
			"content": "t:general.typography.content.label"
		},
		{
			"type": "select",
			"id": "position_x",
			"options": [
				{
					"value": "start",
					"label": "t:sections.slider.blocks.slider.settings.position_x.options__1.label"
				},
				{
					"value": "center",
					"label": "t:sections.slider.blocks.slider.settings.position_x.options__2.label"
				},
				{
					"value": "end",
					"label": "t:sections.slider.blocks.slider.settings.position_x.options__3.label"
				}
			],
			"default": "end",
			"label": "t:sections.slider.blocks.slider.settings.position_x.label",
			"info": "t:general.layout.alignment.mobile_center.label"
		},
		{
			"type": "select",
			"id": "alignment",
			"options": [
				{
					"value": "left",
					"label": "t:general.layout.alignment.option_1.label"
				},
				{
					"value": "center",
					"label": "t:general.layout.alignment.option_2.label"
				},
				{
					"value": "right",
					"label": "t:general.layout.alignment.option_3.label"
				}
			],
			"default": "left",
			"label": "t:general.layout.alignment.label",
			"info": "t:general.layout.alignment.mobile_center.label"
		},
		{
			"type": "richtext",
			"id": "heading_text",
			"default": "<p>Heading</p>",
			"label": "t:general.typography.heading.label"
		},
		{
			"type": "select",
			"id": "heading_size",
			"options": [
				{
					"value": "h4",
					"label": "t:general.typography.heading_size.option_1.label"
				},
				{
					"value": "h3",
					"label": "t:general.typography.heading_size.option_2.label"
				},
				{
					"value": "h2",
					"label": "t:general.typography.heading_size.option_3.label"
				}
			],
			"default": "h2",
			"label": "t:general.typography.heading_size.label"
		},
		{
			"type": "richtext",
			"id": "text",
			"default": "<p>Use this text to share information about your brand with your customers.</p>",
			"label": "t:general.typography.description.label"
		},
		{
			"type": "text",
			"id": "button",
			"default": "Button label",
			"label": "t:general.typography.button_label.label"
		},
		{
			"type": "url",
			"id": "button_link",
			"label": "t:general.typography.button_link.label"
		},
		{
			"type": "header",
			"content": "t:sections.count-down.name"
		},
		{
			"type": "checkbox",
			"id": "show_countdown",
			"default": true,
			"label": "t:sections.count-down.settings.show-countdown.label"
		},
		{
			"type": "checkbox",
			"id": "full",
			"default": true,
			"label": "t:general.layout.full.label"
		},
		{
			"type": "text",
			"id": "countdown_time",
			"label": "t:sections.count-down.settings.time-countdown.label",
			"info": "t:sections.count-down.settings.time-countdown.info"
		},
		{
			"type": "header",
			"content": "t:general.padding.header_padding.content"
		},
		{
			"type": "range",
			"id": "padding_top",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 100,
			"unit": "px",
			"label": "t:general.padding.top.label"
		},
		{
			"type": "range",
			"id": "padding_bottom",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 100,
			"unit": "px",
			"label": "t:general.padding.bottom.label"
		},
		{
			"type": "paragraph",
			"content": "t:general.padding.paragraph_mobile.content"
		},
		{
			"type": "range",
			"id": "padding_top_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 60,
			"unit": "px",
			"label": "t:general.padding.top.label"
		},
		{
			"type": "range",
			"id": "padding_bottom_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 60,
			"unit": "px",
			"label": "t:general.padding.bottom.label"
		}
	],
	"presets": [
		{
			"name": "t:sections.count-down.name"
		}
	]
}
{% endschema %}