    }

    .chubby-about-age-policy-item {
      padding: 25px;
    }
  }

  @media (max-width: 480px) {
    .chubby-about-hero-content h1 {
      font-size: 25px;
    }
    .chubby-about-hero-content p {
      font-size: 13px;
    }

    .chubby-about-main-title {
      font-size: 26px;
    }

    .chubby-about-features {
      grid-template-columns: 1fr;
    }

    .chubby-about-cta-button {
      padding: 15px 30px;
      font-size: 16px;
    }

    .chubby-about-vision-mission-item {
      padding: 25px 20px;
    }

    .chubby-about-vision-mission-item h3 {
      font-size: 22px;
    }

    .chubby-about-age-policy-notice {
      padding: 20px 25px;
    }

    .chubby-about-age-policy-notice::before {
      font-size: 50px;
      right: 15px;
    }

    .chubby-about-age-policy-main {
      font-size: 15px;
    }

    .chubby-about-age-policy-item {
      padding: 20px;
    }

    .chubby-about-age-policy-item h4 {
      font-size: 20px;
    }

    .chubby-about-age-policy-item p {
      font-size: 15px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    // Animated counter for stats
    function animateStats() {
      const statNumbers = document.querySelectorAll('.chubby-about-stat-number');

      statNumbers.forEach((stat) => {
        const target = parseInt(stat.getAttribute('data-target'));
        const increment = target / 80;
        let current = 0;

        const timer = setInterval(() => {
          current += increment;
          if (current >= target) {
            current = target;
            clearInterval(timer);
          }

          if (target === 99) {
            stat.textContent = Math.floor(current) + '%';
          } else {
            stat.textContent = Math.floor(current) + '+';
          }
        }, 25);
      });
    }

    // Intersection Observer for stats animation
    const statsObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          animateStats();
          statsObserver.unobserve(entry.target);
        }
      });
    });

    // Observe stats section
    const statsSection = document.querySelector('.chubby-about-stats');
    if (statsSection) {
      statsObserver.observe(statsSection);
    }

    // Smooth scroll animation for feature cards
    const featureCards = document.querySelectorAll('.chubby-about-feature-card');

    const cardObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry, index) => {
        if (entry.isIntersecting) {
          setTimeout(() => {
            entry.target.style.opacity = '1';
            entry.target.style.transform = 'translateY(0)';
          }, index * 100);
          cardObserver.unobserve(entry.target);
        }
      });
    });

    featureCards.forEach((card) => {
      card.style.opacity = '0';
      card.style.transform = 'translateY(30px)';
      card.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
      cardObserver.observe(card);
    });

    // Animation for Vision & Mission cards
    const visionMissionCards = document.querySelectorAll('.chubby-about-vision-mission-item');

    const vmObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry, index) => {
        if (entry.isIntersecting) {
          setTimeout(() => {
            entry.target.style.opacity = '1';
            entry.target.style.transform = 'translateX(0)';
          }, index * 200);
          vmObserver.unobserve(entry.target);
        }
      });
    });

    visionMissionCards.forEach((card, index) => {
      card.style.opacity = '0';
      card.style.transform = index % 2 === 0 ? 'translateX(-30px)' : 'translateX(30px)';
      card.style.transition = 'opacity 0.8s ease, transform 0.8s ease';
      vmObserver.observe(card);
    });

    // Animation for Age Policy cards
    const agePolicyCards = document.querySelectorAll('.chubby-about-age-policy-item');

    const apObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry, index) => {
        if (entry.isIntersecting) {
          setTimeout(() => {
            entry.target.style.opacity = '1';
            entry.target.style.transform = 'translateY(0)';
          }, index * 150);
          apObserver.unobserve(entry.target);
        }
      });
    });

    agePolicyCards.forEach((card) => {
      card.style.opacity = '0';
      card.style.transform = 'translateY(30px)';
      card.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
      apObserver.observe(card);
    });
  });
</script>

