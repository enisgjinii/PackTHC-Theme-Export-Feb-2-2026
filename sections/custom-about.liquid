<!-- about.liquid -->
<div class="chubby-about-wrapper">
  <!-- Hero Section -->
  <section class="chubby-about-hero">
    <div class="chubby-about-container">
      <div class="chubby-about-hero-content">
        <h1>{{ section.settings.hero_title }}</h1>
        <p>{{ section.settings.hero_subtitle }}</p>
        <div class="chubby-about-tagline">{{ section.settings.hero_tagline }}</div>
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section class="chubby-about-main">
    <div class="chubby-about-container">
      <h2 class="chubby-about-main-title">{{ section.settings.about_title }}</h2>
      <p class="chubby-about-main-subtitle">{{ section.settings.about_subtitle }}</p>

      <div class="chubby-about-content">
        <div class="chubby-about-text">
          <h3>{{ section.settings.expertise_title }}</h3>
          <p>{{ section.settings.expertise_description }}</p>
          <p>{{ section.settings.expertise_additional }}</p>
        </div>
        <div class="chubby-about-text">
          <h3>{{ section.settings.commitment_title }}</h3>
          <p>{{ section.settings.commitment_description }}</p>
          <p>{{ section.settings.commitment_additional }}</p>
        </div>
      </div>

      <!-- Vision & Mission Section -->
      <div class="chubby-about-vision-mission">
        <div class="chubby-about-vision-mission-item">
          <h3>{{ section.settings.vision_title }}</h3>
          <p>{{ section.settings.vision_description }}</p>
        </div>
        <div class="chubby-about-vision-mission-item">
          <h3>{{ section.settings.mission_title }}</h3>
          <p>{{ section.settings.mission_description }}</p>
          <ul class="chubby-about-mission-list">
            <li>{{ section.settings.mission_point_1 }}</li>
            <li>{{ section.settings.mission_point_2 }}</li>
            <li>{{ section.settings.mission_point_3 }}</li>
            <li>{{ section.settings.mission_point_4 }}</li>
          </ul>
        </div>
      </div>

      <!-- Age Policy Section -->
      <div class="chubby-about-age-policy">
        <div class="chubby-about-age-policy-notice">
          <p class="chubby-about-age-policy-main">
            PackTHC does not sell any products to individuals under the age of 21, and every order is subject to strict
            age verification and compliance checks with applicable laws in the regions we serve.
          </p>
        </div>

        <div class="chubby-about-age-policy-details">
          <div class="chubby-about-age-policy-item">
            <h4>About our age policy</h4>
            <p>
              PackTHC is a 21+ brand, and our website, marketing, and sales channels are intended solely for adults of
              legal age to purchase cannabis-related packaging and accessories. By using our site or placing an order,
              customers confirm that they are at least 21 years old and legally allowed to purchase these products in
              their jurisdiction.
            </p>
          </div>

          <div class="chubby-about-age-policy-item">
            <h4>How we verify and monitor</h4>
            <p>
              To prevent underage access, PackTHC uses an age‑gate on our website and requires visitors to confirm they are of legal age before viewing age‑restricted cannabis packaging products. 
            </p>
          </div>

          <div class="chubby-about-age-policy-item">
            <h4>Our commitment to compliance</h4>
            <p>
              PackTHC follows strict industry and regulatory standards for age‑restricted goods and continuously updates internal protocols to stay aligned with evolving cannabis, packaging, and age‑verification rules.​
All products are designed and sourced with child‑resistant, tamper‑evident, and clear warning requirements in mind to help customers meet local and federal cannabis packaging laws.
            </p>
          </div>
        </div>
      </div>

      <!-- Features Grid -->
      <div class="chubby-about-features">
        {% for block in section.blocks %}
          {% if block.type == 'feature' %}
            <div class="chubby-about-feature-card">
              <div class="chubby-about-feature-icon">{{ block.settings.icon }}</div>
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.description }}</p>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="chubby-about-stats">
    <div class="chubby-about-container">
      <h2 style="font-size: 40px; margin-bottom: 20px; color: #ffffff">{{ section.settings.stats_title }}</h2>
      <p style="font-size: 19px; opacity: 0.9;">{{ section.settings.stats_subtitle }}</p>

      <div class="chubby-about-stats-grid">
        {% for block in section.blocks %}
          {% if block.type == 'stat' %}
            <div class="chubby-about-stat-item">
              <span class="chubby-about-stat-number" data-target="{{ block.settings.number }}">0</span>
              <span class="chubby-about-stat-label">{{ block.settings.label }}</span>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="chubby-about-cta">
    <div class="chubby-about-container">
      <h2 class="chubby-about-cta-title">{{ section.settings.cta_title }}</h2>
      <p class="chubby-about-cta-text">{{ section.settings.cta_description }}</p>
      <a href="{{ section.settings.cta_link }}" class="chubby-about-cta-button">
        {{- section.settings.cta_button_text -}}
      </a>
    </div>
  </section>
</div>

<style>
  .chubby-about-wrapper * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  .chubby-about-wrapper {
    font-family: "ITC Avant Garde Gothic", sans-serif;
    line-height: 1.6;
    color: #202425;
    background: #f8f9fa;
  }

  .chubby-about-hero {
    background: #004A26;
    color: white;
    padding: 80px 0;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .chubby-about-hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grain" width="100" height="100" patternUnits="userSpaceOnUse"><circle cx="25" cy="25" r="1" fill="rgba(255,255,255,0.1)"/><circle cx="75" cy="75" r="1" fill="rgba(255,255,255,0.05)"/><circle cx="50" cy="10" r="0.5" fill="rgba(255,255,255,0.08)"/></pattern></defs><rect width="100" height="100" fill="url(%23grain)"/></svg>');
    opacity: 0.3;
  }

  .chubby-about-container {
    max-width: 1500px;
    margin: 0 auto;
    padding: 0 20px;
    position: relative;
    z-index: 1;
  }

  .chubby-about-hero-content h1 {
    font-size: 56px;
    font-weight: 700;
    margin-bottom: 20px;
    color: #ffffff;
    animation: chubby-about-slideInDown 1s ease-out;
  }

  .chubby-about-hero-content p {
    font-size: 22px;
    margin-bottom: 30px;
    opacity: 0.95;
    animation: chubby-about-slideInUp 1s ease-out 0.3s both;
  }

  .chubby-about-tagline {
    font-size: 18px;
    color: #ecf0f1;
    font-style: italic;
    animation: chubby-about-fadeIn 1s ease-out 0.6s both;
  }

  .chubby-about-main {
    padding: 80px 0;
    background: white;
  }

  .chubby-about-main-title {
    text-align: center;
    font-size: 45px;
    color: #202425;
    margin-bottom: 20px;
    position: relative;
  }

  .chubby-about-main-title::after {
    content: '';
    position: absolute;
    bottom: -15px;
    left: 50%;
    transform: translateX(-50%);
    width: 100px;
    height: 4px;
    background: #004A26;
    border-radius: 2px;
  }

  .chubby-about-main-subtitle {
    text-align: center;
    font-size: 19px;
    color: #666;
    margin-bottom: 60px;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .chubby-about-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
    margin-bottom: 60px;
  }

  .chubby-about-text {
    font-size: 18px;
    color: #555;
    line-height: 1.8;
  }

  .chubby-about-text h3 {
    color: #202425;
    font-size: 24px;
    margin-bottom: 20px;
    font-weight: 600;
  }

  .chubby-about-text p {
    margin-bottom: 20px;
  }

  /* Vision & Mission Styles */
  .chubby-about-vision-mission {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    margin-bottom: 60px;
    padding: 50px 0;
    border-top: 2px solid #f0f0f0;
    border-bottom: 2px solid #f0f0f0;
  }

  .chubby-about-vision-mission-item {
    background: #ffffff;
    padding: 40px;
    border-radius: 15px;
    box-shadow: 0 8px 25px rgba(0,0,0,0.08);
    border-left: 5px solid #004A26;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .chubby-about-vision-mission-item::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(0, 74, 38, 0.02), rgba(0, 74, 38, 0.05));
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .chubby-about-vision-mission-item:hover::before {
    opacity: 1;
  }

  .chubby-about-vision-mission-item:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 35px rgba(0,0,0,0.12);
    border-left-color: #003520;
  }

  .chubby-about-vision-mission-item h3 {
    color: #004A26;
    font-size: 28px;
    margin-bottom: 20px;
    font-weight: 700;
    position: relative;
    z-index: 1;
  }

  .chubby-about-vision-mission-item p {
    color: #555;
    font-size: 18px;
    line-height: 1.8;
    margin-bottom: 20px;
    position: relative;
    z-index: 1;
  }

  .chubby-about-mission-list {
    list-style: none;
    padding: 0;
    position: relative;
    z-index: 1;
  }

  .chubby-about-mission-list li {
    color: #555;
    font-size: 16px;
    line-height: 1.7;
    margin-bottom: 12px;
    padding-left: 25px;
    position: relative;
  }

  .chubby-about-mission-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    top: 0;
    color: #004A26;
    font-weight: bold;
    font-size: 18px;
  }

  /* Age Policy Styles */
  .chubby-about-age-policy {
    margin: 60px 0;
    padding: 50px 0;
    border-top: 2px solid #f0f0f0;
    border-bottom: 2px solid #f0f0f0;
  }

  .chubby-about-age-policy-notice {
    background: linear-gradient(135deg, #004A26, #003520);
    padding: 30px 40px;
    border-radius: 12px;
    margin-bottom: 40px;
    box-shadow: 0 8px 25px rgba(0, 74, 38, 0.2);
    position: relative;
    overflow: hidden;
  }

  .chubby-about-age-policy-notice::before {
    content: '21+';
    position: absolute;
    right: 30px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 80px;
    font-weight: 900;
    color: rgba(255, 255, 255, 0.1);
    line-height: 1;
  }

  .chubby-about-age-policy-main {
    color: #ffffff;
    font-size: 19px;
    line-height: 1.8;
    font-weight: 500;
    position: relative;
    z-index: 1;
    margin: 0;
  }

  .chubby-about-age-policy-details {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
  }

  .chubby-about-age-policy-item {
    background: #ffffff;
    padding: 35px;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    border-top: 4px solid #004A26;
    transition: all 0.3s ease;
  }

  .chubby-about-age-policy-item:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 30px rgba(0,0,0,0.12);
    border-top-color: #003520;
  }

  .chubby-about-age-policy-item h4 {
    color: #004A26;
    font-size: 22px;
    margin-bottom: 15px;
    font-weight: 700;
  }

  .chubby-about-age-policy-item p {
    color: #555;
    font-size: 16px;
    line-height: 1.8;
    margin: 0;
  }

  .chubby-about-features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 30px;
  }

  .chubby-about-feature-card {
    background: #ffffff;
    padding: 40px 30px;
    border-radius: 12px;
    text-align: center;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    transition: all 0.3s ease;
    border-top: 4px solid #004A26;
    position: relative;
    overflow: hidden;
  }

  .chubby-about-feature-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(0, 74, 38, 0.1), transparent);
    transition: left 0.5s ease;
  }

  .chubby-about-feature-card:hover::before {
    left: 100%;
  }

  .chubby-about-feature-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 8px 30px rgba(0,0,0,0.15);
    border-top-color: #003520;
  }

  .chubby-about-feature-icon {
    width: 80px;
    height: 80px;
    background: #004A26;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 25px;
    font-size: 32px;
    color: white;
    transition: all 0.3s ease;
  }

  .chubby-about-feature-card:hover .chubby-about-feature-icon {
    background: #003520;
    transform: scale(1.1);
  }

  .chubby-about-feature-card h3 {
    font-size: 22px;
    color: #202425;
    margin-bottom: 15px;
    font-weight: 600;
  }

  .chubby-about-feature-card p {
    color: #666;
    font-size: 16px;
  }

  .chubby-about-stats {
    background: #004A26;
    padding: 80px 0;
    color: white;
    text-align: center;
  }

  .chubby-about-stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 40px;
    margin-top: 40px;
  }

  .chubby-about-stat-item {
    padding: 30px 20px;
    background: rgba(255,255,255,0.1);
    border-radius: 12px;
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255,255,255,0.2);
    transition: transform 0.3s ease;
  }

  .chubby-about-stat-item:hover {
    transform: scale(1.05);
    background: rgba(255,255,255,0.15);
  }

  .chubby-about-stat-number {
    font-size: 48px;
    font-weight: bold;
    display: block;
    margin-bottom: 10px;
    color: #ecf0f1;
  }

  .chubby-about-stat-label {
    font-size: 18px;
    color: #bdc3c7;
  }

  .chubby-about-cta {
    padding: 80px 0;
    text-align: center;
    background: #f8f9fa;
  }

  .chubby-about-cta-title {
    font-size: 40px;
    color: #202425;
    margin-bottom: 20px;
  }

  .chubby-about-cta-text {
    font-size: 19px;
    color: #666;
    margin-bottom: 40px;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .chubby-about-cta-button {
    display: inline-block;
    padding: 18px 45px;
    background: #004A26;
    color: white;
    text-decoration: none;
    border-radius: 8px;
    font-size: 19px;
    font-weight: 600;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 1px;
    box-shadow: 0 4px 15px rgba(0, 74, 38, 0.3);
  }

  .chubby-about-cta-button:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 30px rgba(0, 74, 38, 0.4);
    background: #003520;
  }

  @keyframes chubby-about-slideInDown {
    from {
      opacity: 0;
      transform: translateY(-50px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes chubby-about-slideInUp {
    from {
      opacity: 0;
      transform: translateY(50px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes chubby-about-fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (max-width: 1024px) {
    .chubby-about-hero-content h1 {
      font-size: 45px;
    }

    .chubby-about-main-title {
      font-size: 38px;
    }

    .chubby-about-features {
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    }

    .chubby-about-vision-mission {
      gap: 40px;
    }

    .chubby-about-vision-mission-item {
      padding: 30px;
    }

    .chubby-about-age-policy-details {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .chubby-about-hero-content h1 {
      font-size: 30px;
    }

    .chubby-about-hero-content p {
      font-size: 15px;
    }

    .chubby-about-content {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .chubby-about-vision-mission {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .chubby-about-main-title {
      font-size: 30px;
    }

    .chubby-about-features {
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }

    .chubby-about-feature-card {
      padding: 30px 20px;
    }

    .chubby-about-vision-mission-item h3 {
      font-size: 24px;
    }

    .chubby-about-vision-mission-item p {
      font-size: 16px;
    }

    .chubby-about-age-policy-notice {
      padding: 25px 30px;
    }

    .chubby-about-age-policy-notice::before {
