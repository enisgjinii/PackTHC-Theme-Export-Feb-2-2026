<div class="pcg-wrapper">
  <div class="pcg-container">
    <div class="pcg-left-section">
      <!-- Gallery Container -->
      <div class="pcg-gallery-container">
        <div class="pcg-thumbnail-column" id="pcgThumbnailColumn">
          <!-- Thumbnails will be loaded here when product is selected -->
        </div>
        
        <div class="pcg-main-image">
          <div id="pcgMainImageContainer">
            <!-- Default product image when none selected -->
            {% if section.settings.default_product != blank %}
              {% assign default_product = all_products[section.settings.default_product] %}
              <img src="{{ default_product.featured_image | img_url: '600x600' }}" 
                   alt="{{ default_product.title }}" 
                   id="pcgMainProductImage"
                   class="default-product-image">
            {% endif %}
          </div>
        </div>
      </div>

      <div class="pcg-mobile-variants-toggle">
  <div class="pcg-hamburger-icon">
    <span></span>
    <span></span>
    <span></span>
  </div>
  <span class="pcg-toggle-text">Product Variants</span>
</div>

      <!-- Product Segments Container - Now separate -->
      <div class="pcg-segments-container">
        <div class="pcg-product-segments" id="pcgProductSegments" style="display: none;">
          <div class="pcg-segments-header">
            <h4>Product Variants</h4>
          </div>
          <div class="pcg-segments-tabs-wrapper">
            <div class="pcg-segments-tabs" id="pcgSegmentsTabs">
              <!-- Product segment tabs will be populated here -->
            </div>
          </div>
        </div>

        


        
      </div>
    </div>

    <div class="pcg-right-section">
      <div class="pcg-product-header">
        <h1 class="pcg-section-title" id="pcgSelectedProductTitle">
          {% if section.settings.default_product != blank %}
            {{ all_products[section.settings.default_product].title }}
          {% else %}
            Select a product
          {% endif %}
        </h1>
      </div>
      
      <!-- Collections Tabs -->
      <div class="pcg-collections-tabs">
        {% for block in section.blocks %}
          {% if block.type == 'collection' %}
            {% assign collection = collections[block.settings.collection] %}
            {% if collection != blank %}
              <button class="pcg-collection-tab {% if forloop.first %}pcg-active{% endif %}" 
                      data-collection="{{ collection.handle }}"
                      data-collection-id="{{ collection.id }}">
                <span class="pcg-tab-dram">{{ block.settings.tab_dram | default: '13 dram' }}</span>
                <span class="pcg-tab-count">{{ collection.products_count | default: '315 count' }}</span>
              </button>
            {% endif %}
          {% endif %}
        {% endfor %}
      </div>
      
      <!-- Products Grid -->
      <div class="pcg-products-container">
        {% for block in section.blocks %}
          {% if block.type == 'collection' %}
            {% assign collection = collections[block.settings.collection] %}
            {% if collection != blank %}
              <div class="pcg-collection-products {% if forloop.first %}pcg-active{% endif %}" 
                   data-collection="{{ collection.handle }}">
                <div class="pcg-products-grid">
                  {% for product in collection.products limit: block.settings.products_limit %}
                    <div class="pcg-product-card" data-product-handle="{{ product.handle }}" data-product-available="{{ product.available }}">
                      <!-- Product Tooltip HTML -->
                      <div class="pcg-product-tooltip">
                        <div class="pcg-tooltip-content">
                        <!--  <div class="pcg-tooltip-title">{{ product.title }}</div> -->
                          <div class="pcg-tooltip-price">
                            {% if product.metafields.custom.unit_price != blank %}
                              {% if product.metafields.custom.unit_price.type == 'money' %}
                                {{ product.metafields.custom.unit_price | money }}
                              {% else %}
                                {{ product.metafields.custom.unit_price }}
                              {% endif %}
                            {% else %}
                              {{ product.price | money }}
                            {% endif %}
                          </div>
                          <div class="pcg-tooltip-status">
                            {% if product.available %}
                              <span class="status-available">In Stock</span>
                            {% else %}
                              <span class="status-unavailable">Out of Stock</span>
                            {% endif %}
                          </div>
                        </div>
                      </div>
                      
                      <div class="pcg-product-image">
                        {% if product.featured_image %}
                          <img src="{{ product.featured_image | img_url: '200x200' }}" 
                               alt="{{ product.title }}" 
                               loading="lazy">
                        {% endif %}
                      </div>
                    </div>
                  {% endfor %}
                </div>
              </div>
            {% endif %}
          {% endif %}
        {% endfor %}
      </div>
      
      <!-- Buy Now Section with Quantity -->
      <div class="pcg-buy-now-container" id="pcgBuyNowContainer" style="{% unless section.settings.default_product != blank %}display: none;{% endunless %}">
        <div class="pcg-quantity-section">
          <label for="pcgQuantity" class="pcg-quantity-label">Quantity:</label>
          <div class="pcg-quantity-controls">
            <button type="button" class="pcg-quantity-btn pcg-quantity-minus" onclick="pcgChangeQuantity(-1)">-</button>
            <input type="number" id="pcgQuantity" class="pcg-quantity-input" value="1" min="1">
            <button type="button" class="pcg-quantity-btn pcg-quantity-plus" onclick="pcgChangeQuantity(1)">+</button>
          </div>
        </div>
        <div class="pcg-buttons-container">
  
  <button class="pcg-buy-now-button" id="pcgBuyNowButton">Buy Now</button>
          <button class="pcg-add-to-cart-button" id="pcgAddToCartButton">Add to Cart</button>
</div>

        <div class="pcg-pricing-table-container" id="pcgPricingTableContainer">
          <!-- Table will be populated here via JavaScript -->
        </div>

        <div class="pcg-collection-image-container" id="pcgCollectionImageContainer">
          {% if section.settings.default_product != blank %}
            {% assign default_collection = all_products[section.settings.default_product].collections.first %}
            {% for block in section.blocks %}
              {% if block.settings.collection == default_collection.handle and block.settings.collection_image != blank %}
                <img src="{{ block.settings.collection_image | img_url: '800x' }}" 
                     alt="{{ default_collection.title }}" 
                     class="pcg-collection-image"
                     loading="lazy">
              {% endif %}
            {% endfor %}
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Contact Modal for Sold Out Products -->
<div id="pcgContactModal" class="pcg-modal">
  <div class="pcg-modal-content">
    <div class="pcg-modal-header">
      <h3>Product Currently Unavailable</h3>
      <span class="pcg-close">&times;</span>
    </div>
    <div class="pcg-modal-body">
      <p>This product is currently unavailable. If you are interested in purchasing it, please contact us.</p>
      <div class="pcg-modal-buttons">
        <a href="{{ section.settings.contact_form_url | default: '/pages/contact' }}" class="pcg-contact-btn">Contact Now</a>
        <button class="pcg-close-btn" onclick="pcgCloseModal()">Close</button>
      </div>
    </div>
  </div>
</div>

<style>










  
.pcg-wrapper * {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

.pcg-wrapper {
  padding: 20px 5px;
  background: #f5f5f5;
}

.pcg-container {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  gap: 40px;
  background: white;
  border-radius: 15px;
  padding: 30px;
  box-shadow: 0 10px 30px rgba(0,0,0,0.1);
}

.pcg-left-section {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.pcg-thumbnail-column {
  display: flex;
  flex-direction: column;
  gap: 15px;
}
  /* Gallery Container */
.pcg-gallery-container {
  display: flex;
  gap: 20px;
  align-items: flex-start;
}

.pcg-thumbnail {
  width: 60px;
  height: 60px;
  border: 2px solid transparent;
  border-radius: 10px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
  overflow: hidden;
}

.pcg-thumbnail.pcg-active {
  border-color: #004A26;
  background: #e6f0ed;
}

.pcg-thumbnail:hover {
  border-color: #004A26;
  background: #e6f0ed;
}

.pcg-thumbnail img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.pcg-main-image {
  flex: 1;
  display: flex;
  align-items: flex-start; /* Changed from center to flex-start */
  justify-content: center;
  background: #f8f9fa;
  border-radius: 15px;
  /*  min-height: 400px; */
}

.pcg-main-image img {
  align-self: flex-start;
  margin-top: 0;
  transition: opacity 0.3s ease, transform 0.3s ease;
}
  .pcg-main-image img.pcg-loading {
  opacity: 0.5;
  transform: scale(0.95);
}

.pcg-right-section {
  flex: 1;
  padding-left: 20px;
  display: flex;
  flex-direction: column;
}

.pcg-product-header {
  margin-bottom: 30px;
}

.pcg-section-title {
  font-size: 28px;
  font-weight: 600;
  color: #333;
  margin-bottom: 10px;
  line-height: 1.3;
  transition: all 0.3s ease;
  display: -webkit-box;
  -webkit-line-clamp: 4;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.pcg-collections-tabs {
  display: flex;
  gap: 10px;
  margin-bottom: 30px;
  flex-wrap: wrap;
}

.pcg-collection-tab {
  padding: 12px 10px;
  border: 2px solid #e0e0e0;
  border-radius: 25px;
  background: white;
  cursor: pointer;
  transition: all 0.3s ease;
  font-size: 14px;
  font-weight: 500;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 100px;
}

.pcg-collection-tab.pcg-active {
  border-color: #004A26;
  background: #e6f0ed;
  color: #004A26;
}

.pcg-collection-tab:hover {
  border-color: #004A26; 
  background: #e6f0ed;
}

.pcg-tab-dram {
  font-weight: 600;
  font-size: 16px;
}

.pcg-tab-count {
  font-size: 12px;
  color: #666;
}

.pcg-products-container {
  position: relative;
  flex-grow: 1;
  overflow-x: hidden;
  max-height: 400px;
  padding-right: 10px;
}

.pcg-collection-products {
  display: none;
}

.pcg-collection-products.pcg-active {
  display: block;
}

.pcg-products-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
  gap: 15px;
}

.pcg-product-card {
  border: 1px solid #e0e0e0;
  border-radius: 10px;
  padding: 10px;
  cursor: pointer;
  transition: all 0.3s ease;
  background: white;
  aspect-ratio: 1/1;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: visible;
  /* Ensure z-index for proper layering */
  z-index: 1;
}

.pcg-product-card:hover {
  border-color: #004A26; 
  transform: translateY(-2px);
  box-shadow: 0 5px 15px rgba(0, 74, 38, 0.2); 
  z-index: 10; /* Increase z-index on hover */
}

.pcg-product-image {
  width: 100%;
  height: 100%;
  border-radius: 8px;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pcg-product-image img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.pcg-buy-now-container {
  margin-top: auto;
  padding-top: 20px;
  text-align: start;
  opacity: 1;
  transition: all 0.3s ease;
}

.pcg-quantity-section {
  display: flex;
  align-items: center;
  justify-content: start;
  gap: 10px;
  margin-bottom: 15px;
  flex-wrap: wrap;
}

.pcg-quantity-label {
  font-size: 14px;
  font-weight: 600;
  color: #333;
  margin-right: 5px;
}

.pcg-quantity-controls {
  display: flex;
  align-items: center;
  border: 2px solid #e0e0e0;
  border-radius: 25px;
  background: white;
  overflow: hidden;
  transition: all 0.3s ease;
}

.pcg-quantity-controls:focus-within {
  border-color: #004A26; 
  box-shadow: 0 0 0 3px rgba(0, 74, 38, 0.1); 
}

.pcg-quantity-btn {
  background: transparent;
  border: none;
  width: 35px;
  height: 35px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  font-size: 18px;
  font-weight: bold;
  color: #666;
  transition: all 0.3s ease;
}

.pcg-quantity-btn:hover {
  background: #e6f0ed; 
  color: #004A26;
}

.pcg-quantity-btn:active {
  transform: scale(0.95);
}

.pcg-quantity-input {
  border: none;
  outline: none;
  width: 60px;
  height: 35px;
  text-align: center;
  font-size: 16px;
  font-weight: 600;
  color: #333;
  background: transparent;
}

.pcg-quantity-input::-webkit-outer-spin-button,
.pcg-quantity-input::-webkit-inner-spin-button {
  -webkit-appearance: none;
  margin: 0;
}

.pcg-quantity-input[type=number] {
  -moz-appearance: textfield;
}

/* Replace existing .pcg-buy-now-button CSS and add these: */

.pcg-buttons-container {
  display: flex;
  gap: 12px;
  width: 100%;
  max-width: 400px;
  margin-bottom: 15px;
}

.pcg-add-to-cart-button {
  background-color: transparent;
  color: #004A26;
  border: 2px solid #004A26;
  padding: 12px 20px;
  font-size: 16px;
  font-weight: 600;
  border-radius: 25px;
  cursor: pointer;
  flex: 1;
  transition: all 0.3s ease;
  box-shadow: 0 2px 4px rgba(0, 74, 38, 0.1);
}

.pcg-add-to-cart-button:hover {
  background-color: #004A26;
  color: white;
  transform: translateY(-2px);
  box-shadow: 0 6px 12px rgba(0, 74, 38, 0.2);
}

.pcg-buy-now-button {
  background-color: #004A26;
  color: white;
  border: 2px solid #004A26;
  padding: 12px 20px;
  font-size: 16px;
  font-weight: 600;
  border-radius: 25px;
  cursor: pointer;
  flex: 1;
  transition: all 0.3s ease;
  box-shadow: 0 4px 6px rgba(0, 74, 38, 0.2);
}

.pcg-buy-now-button:hover {
  background-color: #00381D;
  transform: translateY(-2px);
  box-shadow: 0 6px 12px rgba(0, 74, 38, 0.3);
}

/* Mobile responsive */
@media (max-width: 768px) {
  .pcg-gallery-container {
  display: block;
}
  .pcg-buttons-container {
    flex-direction: column;
    max-width: 100%;
  }
  
  .pcg-add-to-cart-button,
  .pcg-buy-now-button {
    width: 100%;
    margin-bottom: 8px;
    max-width: 250px;
  }
}
.pcg-collection-image{
  margin-top: 20px;
}
/* New Sold Out Styles with Blur Effect */
.pcg-product-card.sold-out {
  cursor: pointer;
  position: relative;
}

.pcg-product-card.sold-out .pcg-product-image {
  filter: blur(3px);
  opacity: 0.6;
  transition: all 0.3s ease;
}

.pcg-product-card.sold-out:hover .pcg-product-image {
  filter: blur(2px);
  opacity: 0.8;
}

.pcg-product-card.sold-out:hover {
  border-color: #ff6b6b;
  transform: translateY(-1px);
  box-shadow: 0 3px 10px rgba(255, 107, 107, 0.2);
}

/* Modal Styles */
.pcg-modal {
  display: none;
  position: fixed;
  z-index: 1000;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  overflow: auto;
  background-color: rgba(0,0,0,0.5);
  backdrop-filter: blur(5px);
}

.pcg-modal-content {
  background-color: #fefefe;
  margin: 10% auto;
  padding: 0;
  border: none;
  border-radius: 15px;
  width: 90%;
  max-width: 500px;
  box-shadow: 0 20px 40px rgba(0,0,0,0.3);
  animation: pcgModalSlideIn 0.3s ease-out;
}

@keyframes pcgModalSlideIn {
  from {
    transform: translateY(-50px);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.pcg-modal-header {
  background: #004A26;
  color: white;
  padding: 20px 25px;
  border-radius: 15px 15px 0 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.pcg-modal-header h3 {
  margin: 0;
  font-size: 20px;
  font-weight: 600;
  color: #ffffff
}

.pcg-close {
  color: white;
  font-size: 28px;
  font-weight: bold;
  cursor: pointer;
  line-height: 1;
  transition: all 0.3s ease;
}

.pcg-close:hover {
  transform: scale(1.1);
  opacity: 0.8;
}

.pcg-modal-body {
  padding: 25px;
  text-align: center;
}

.pcg-modal-body p {
  font-size: 16px;
  color: #555;
  margin-bottom: 25px;
  line-height: 1.6;
}

.pcg-modal-buttons {
  display: flex;
  gap: 15px;
  justify-content: center;
  flex-wrap: wrap;
}

.pcg-contact-btn {
  background: linear-gradient(135deg, #004A26, #00381D); 
  color: white;
  padding: 12px 25px;
  border: none;
  border-radius: 25px;
  font-size: 16px;
  font-weight: 600;
  text-decoration: none;
  cursor: pointer;
  transition: all 0.3s ease;
  box-shadow: 0 4px 6px rgba(0, 74, 38, 0.2);
}

.pcg-contact-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 12px rgba(0, 74, 38, 0.3);
  color: white;
  text-decoration: none;
}

.pcg-close-btn {
  background: #e0e0e0;
  color: #666;
  padding: 12px 25px;
  border: none;
  border-radius: 25px;
  font-size: 16px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.3s ease;
}

.pcg-close-btn:hover {
  background: #d0d0d0;
  transform: translateY(-1px);
}

@media (max-width: 768px) {
  .pcg-container {
    flex-direction: column;
    padding: 20px;
  }

  .pcg-left-section {
    flex-direction: column;
  }

  .pcg-thumbnail-column {
    flex-direction: row;
    justify-content: center;
  }

  .pcg-products-grid {
    grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
    gap: 10px;
  }

  .pcg-collections-tabs {
    justify-content: center;
  }
  
  .pcg-right-section {
    padding-left: 0;
  }

  .pcg-modal-content {
    margin: 20% auto;
    width: 95%;
  }

  .pcg-modal-buttons {
    flex-direction: column;
    align-items: center;
  }

  .pcg-quantity-section {
    flex-direction: column;
    gap: 8px;
    align-items: start;
  }

  .pcg-buy-now-button {
    width: 100%;
    max-width: 250px;
  }

  .pcg-contact-btn,
  .pcg-close-btn {
    width: 100%;
    max-width: 200px;
  }
}


  .pcg-pricing-table-container {
  margin-top: 20px;
  background: #f8f9fa;
  border-radius: 10px;
  border: 1px solid #e0e0e0;
}

.pcg-pricing-table-container table {
  width: 100%;
  border-collapse: collapse;
  margin: 0;
  font-size: 12px;
  background: white;
  border-radius: 8px;
  overflow: hidden;
  box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}

.pcg-pricing-table-container th,
.pcg-pricing-table-container td {
  font-size: 11px;
  text-align: center;
  padding: 8px;
  border: 1px solid #ddd;
}

.pcg-pricing-table-container th {
  background: #004A26;
  color: white;
  font-weight: 600;
}

.pcg-pricing-table-container .email,
.pcg-pricing-table-container .mob {
  color: #E0131A;
  font-size: 12px;
  text-decoration: none;
  font-weight: 600;
}

.pcg-pricing-table-container .email:hover,
.pcg-pricing-table-container .mob:hover {
  text-decoration: underline;
}

@media (max-width: 768px) {
  .pcg-pricing-table-container th,
  .pcg-pricing-table-container td {
    font-size: 10px;
    padding: 6px;
  }
  
  .pcg-pricing-table-container .email,
  .pcg-pricing-table-container .mob {
    font-size: 11px;
  }
}





  /* Professional Tooltip Styles */
.pcg-product-tooltip {
  position: absolute;
  top: 100px;
  left: 50%;
  transform: translateX(-50%) translateY(-100%);
  background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
  color: white;
  padding: 0;
  border-radius: 12px;
  font-size: 13px;
  white-space: nowrap;
  z-index: 9999;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
  pointer-events: none;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
  border: 1px solid rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(10px);
  min-width: 100px;
  max-width: 250px;
}

.pcg-tooltip-content {
  padding: 12px 16px;
  position: relative;
}

.pcg-product-tooltip::before {
  content: '';
  position: absolute;
  top: 100%;
  left: 50%;
  transform: translateX(-50%);
  border: 8px solid transparent;
  border-top-color: #2c3e50;
  z-index: 1;
}

.pcg-product-tooltip::after {
  content: '';
  position: absolute;
  top: 100%;
  left: 50%;
  transform: translateX(-50%);
  border: 7px solid transparent;
  border-top-color: #34495e;
  z-index: 2;
  margin-top: -1px;
}

.pcg-product-card:hover .pcg-product-tooltip {
  opacity: 1;
  visibility: visible;
  transform: translateX(-50%) translateY(-100%) translateY(-8px);
}

.pcg-tooltip-title {
  font-weight: 600;
  font-size: 14px;
  margin-bottom: 6px;
  color: #ffffff;
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 220px;
}

.pcg-tooltip-price {
  font-size: 13px;
  color: #4CAF50;
  font-weight: 700;
  margin-bottom: 4px;
  display: flex;
  align-items: center;
  gap: 4px;
}

.pcg-tooltip-price::before {
  content: '💰';
  font-size: 12px;
