{%- liquid
	assign section_id   = '#shopify-section-' | append: section.id
	assign space        = section.settings.space
	assign scale        = section.settings.scale | divided_by: 100.0
	assign scale_mobile = section.settings.scale_mobile | divided_by: 100.0
-%}

<style>
	{{ section_id }} .section-wrapper {
		padding-top: {{ section.settings.padding_top_mobile }}px;
		padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
	}

	{{ section_id }} .marquee-content {
		margin-right: {{ space }}px;
	}

	{{ section_id }} .background-section{
		width: {{ section.settings.width }}%;
	}

	{{ section_id }} .marquee {
		--marquee-time: {{ section.settings.time }}s;
		--marquee-scale: {{ scale_mobile }};
	}

	{{ section_id }} .marquee-content img,
	{{ section_id }} .marquee-content svg {
		margin-right: {{ space }}px;
	}

	{%- if section.settings.direction == 'ltr' -%}
		{{ section_id }} .marquee-wrapper {
			animation-direction: reverse;
		}
	{%- endif -%}

	@media (max-width: 991px) {
		{{ section_id }} .marquee-wrapper-item {
			width: 100%;
			align-items: flex-start;
			height: auto;
		}

		{{ section_id }} .background-section{
			width: 100%;
		}
	}

	@media (min-width: 992px) {
		{{ section_id }} .section-wrapper {
			padding-top: {{ section.settings.padding_top }}px;
			padding-bottom: {{ section.settings.padding_bottom }}px;
		}

		{{ section_id }} .marquee {
			--marquee-scale: {{ scale }};
		}
	}
</style>

{%- for block in section.blocks -%}
  {%- assign img = block.settings.image_background -%}
  <div class="background-item{% if forloop.index == 1 %} active{% endif %}" data-bg="{{ forloop.index }}">
    {%- if img != blank -%}
      {%- assign auto_alt = img.alt | default: block.settings.heading | default: section.settings.title | default: 'wholesale child resistant packaging' -%}
      {%- if forloop.index == 1 -%}
        {{ img 
          | image_url: width: 1920
          | image_tag:
              alt: auto_alt,
              loading: 'eager',
              fetchpriority: 'high',
              decoding: 'async',
              sizes: '100vw',
              widths: '800,1200,1600,1920' }}
      {%- else -%}
        {{ img 
          | image_url: width: 1920
          | image_tag:
              alt: auto_alt,
              loading: 'lazy',
              decoding: 'async',
              sizes: '100vw',
              widths: '800,1200,1600,1920' }}
      {%- endif -%}
    {%- else -%}
      {%- render 'icon', code: 'placeholder' -%}
    {%- endif -%}
  </div>
{%- endfor -%}

{% schema %}
{
	"name": "t:sections.img_text_hover.name",
	"tag": "section",
	"class": "image-with-text-hover",
	"disabled_on": {
		"groups": ["header", "footer"]
	},
	"settings": [
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"label": "t:settings_schema.colors.label",
			"default": "scheme-1"
		},
		{
			"type": "range",
			"id": "width",
			"min": 30,
			"max": 80,
			"step": 1,
			"default": 60,
			"unit": "%",
			"label": "t:general.dimensions.width.label"
		},
		{
			"type": "inline_richtext",
			"id": "heading",
			"default": "Heading",
			"label": "t:general.typography.text.label"
		},
		{
			"type": "text",
			"id": "button_label",
			"default": "Button label",
			"label": "t:general.typography.button_label.label"
		},
		{
			"type": "url",
			"id": "button_link",
			"label": "t:general.typography.link.label"
		},
		{
			"type": "select",
			"id": "alignment",
			"default": "left",
			"label": "t:general.layout.alignment.label",
			"info": "t:general.layout.alignment.mobile_center.label",
			"options": [
				{
					"value": "left",
					"label": "t:general.layout.alignment.option_1.label"
				},
				{
					"value": "center",
					"label": "t:general.layout.alignment.option_2.label"
				},
				{
					"value": "right",
					"label": "t:general.layout.alignment.option_3.label"
				}
			]
		},
		{
			"type": "header",
			"content": "t:general.padding.header_padding.content"
		},

		{
			"type": "range",
			"id": "padding_top",
			"min": 20,
			"max": 120,
			"step": 1,
			"default": 60,
			"unit": "px",
			"label": "t:general.padding.top.label"
		},
		{
			"type": "range",
			"id": "padding_bottom",
			"min": 20,
			"max": 120,
			"step": 1,
			"default": 60,
			"unit": "px",
			"label": "t:general.padding.bottom.label"
		},
		{
			"type": "paragraph",
			"content": "t:general.padding.paragraph_mobile.content"
		},
		{
			"type": "range",
			"id": "padding_top_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 20,
			"unit": "px",
			"label": "t:general.padding.top.label"
		},
		{
			"type": "range",
			"id": "padding_bottom_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 20,
			"unit": "px",
			"label": "t:general.padding.bottom.label"
		}
	],
	"blocks": [
		{
			"type": "text",
			"name": "t:general.typography.text.label",
			"settings": [
				{
					"type": "inline_richtext",
					"id": "text",
					"default": "Text block",
					"label": "t:general.typography.text.label"
				},
				{
					"type": "select",
					"id": "heading_size",
					"options": [
						{
							"value": "h3",
							"label": "t:general.typography.heading_size.option_1.label"
						},
						{
							"value": "h2",
							"label": "t:general.typography.heading_size.option_2.label"
						},
						{
							"value": "h1",
							"label": "t:general.typography.heading_size.option_3.label"
						}
					],
					"default": "h2",
					"label": "t:general.typography.heading_size.label"
				},
				{
					"type": "image_picker",
					"id": "image_background",
					"label": "t:general.background.image.label"
				}
			]
		}
	],
	"presets": [
		{
			"name": "t:sections.img_text_hover.name",
			"blocks": [
				{
					"type": "text"
				},
				{
					"type": "text"
				},
				{
					"type": "text"
				},
				{
					"type": "text"
				}
			]
		}
	]
}
{% endschema %}
