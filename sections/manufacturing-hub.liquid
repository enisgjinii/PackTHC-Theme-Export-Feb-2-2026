{% comment %}
  Manufacturing Capabilities Section
  Displays in-house manufacturing advantages and capabilities
{% endcomment %}

<style>
  .manufacturing-section {
    background-color: #ffffff;
    padding: 40px 0;
  }
  
  .manufacturing-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }
  
  .manufacturing-hero {
    text-align: center;
    margin-bottom: 60px;
  }
  
  .manufacturing-hero h2 {
    color: {{ section.settings.main_color }};
    font-size: 30px;
    font-weight: 700;
    margin-bottom: 40px;
    line-height: 1.2;
  }
  
  .manufacturing-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 30px;
    margin-bottom: 30px;
  }
  
  .manufacturing-card {
    background: white;
    padding: 30px;
    border-radius: 12px;
    box-shadow: rgba(0, 0, 0, 0.24) 0px 3px 8px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    margin-bottom: 20px;
  }

  
  .manufacturing-card h3 {
    color: {{ section.settings.main_color }};
    font-size: 24px;
    font-weight: 600;
    margin-bottom: 20px;
  }
  
  .manufacturing-card ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  
  .manufacturing-card li {
    padding: 8px 0;
    padding-left: 25px;
    position: relative;
    color: #333;
    line-height: 1.6;
    text-align: left;
  }
  
  .manufacturing-card li:before {
    content: "✓";
    position: absolute;
    left: 0;
    color: {{ section.settings.main_color }};
    font-weight: bold;
  }
  
  .manufacturing-card p {
    color: #666;
    line-height: 1.8;
    margin-top: 15px;
  }
  
  .manufacturing-highlight {
    background: #033770;
    color: white;
    padding: 50px;
    border-radius: 12px;
    text-align: center;
    margin: 50px 0;
  }
  
  .manufacturing-highlight h3 {
    font-size: 32px;
    margin-bottom: 25px;
    font-weight: 700;
    color: #ffffff;
  }
  
  .manufacturing-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-top: 30px;
  }
  
  .stat-item {
    padding: 20px;
  }
  
  .stat-item strong {
    display: block;
    font-size: 28px;
    margin-bottom: 10px;
  }
  
  .cta-section {
    background: #033770;
    color: white;
    padding: 50px;
    border-radius: 12px;
    text-align: center;
    margin-top: 50px;
  }
  
  .cta-section h3 {
    font-size: 32px;
    margin-bottom: 20px;
    color: #ffffff;
  }
  
  .cta-section p {
    font-size: 18px;
    margin-bottom: 30px;
    opacity: 0.95;
  }
  
  .cta-button {
    display: inline-block;
    background: white;
    color: {{ section.settings.main_color }};
    padding: 15px 40px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    font-size: 16px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  
  .cta-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(0,0,0,0.2);
  }
  
  .advantage-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin: 40px 0;
  }
  
  .advantage-item {
    background: white;
    padding: 25px;
    border-radius: 8px;
    text-align: center;
    border: 2px solid #e8e8e8;
  }
  
  .advantage-item span {
    font-size: 40px;
    display: block;
    margin-bottom: 15px;
  }
  
  .advantage-item strong {
    color: {{ section.settings.main_color }};
    font-size: 18px;
    display: block;
  }
  
  @media (max-width: 768px) {
    .manufacturing-grid,
    .manufacturing-stats,
    .advantage-grid {
      grid-template-columns: 1fr;
    }
    
    .manufacturing-hero h2 {
      font-size: 32px;
    }
    
    .manufacturing-card {
      padding: 20px;
    }
  }
</style>

<section class="manufacturing-section">
  <div class="manufacturing-container">
    
    {% for block in section.blocks %}
      {% case block.type %}
        
        {% when 'block_one' %}
          <div class="manufacturing-hero" {{ block.shopify_attributes }}>
            <h2>{{ block.settings.heading }}</h2>
            <div class="manufacturing-grid">
              <div class="manufacturing-card">
                <h3>{{ block.settings.problem_title }}</h3>
                <ul>
                  {% assign problem_items = block.settings.problem_list | newline_to_br | split: '<br />' %}
                  {% for item in problem_items %}
                    {% if item != blank %}
                      <li>{{ item | strip }}</li>
                    {% endif %}
                  {% endfor %}
                </ul>
              </div>
              <div class="manufacturing-card">
                <h3>{{ block.settings.solution_title }}</h3>
                <ul>
                  {% assign solution_items = block.settings.solution_list | newline_to_br | split: '<br />' %}
                  {% for item in solution_items %}
                    {% if item != blank %}
                      <li>{{ item | strip }}</li>
                    {% endif %}
                  {% endfor %}
                </ul>
              </div>
            </div>
          </div>
        
        {% when 'block_two' %}
          <div class="manufacturing-card" {{ block.shopify_attributes }}>
            <h3>{{ block.settings.capability_title }}</h3>
            <p>{{ block.settings.capability_description }}</p>
            <ul>
              {% assign capability_items = block.settings.capability_features | newline_to_br | split: '<br />' %}
              {% for item in capability_items %}
                {% if item != blank %}
                  <li>{{ item | strip }}</li>
                {% endif %}
              {% endfor %}
            </ul>
            {% if block.settings.capability_note != blank %}
              <p><em>{{ block.settings.capability_note }}</em></p>
            {% endif %}
          </div>
        
        {% when 'block_three' %}
          <div class="manufacturing-highlight" {{ block.shopify_attributes }}>
            <h3>{{ block.settings.highlight_title }}</h3>
            <p>{{ block.settings.highlight_description }}</p>
            <div class="manufacturing-stats">
              {% assign stats = block.settings.stats_list | newline_to_br | split: '<br />' %}
              {% for stat in stats %}
                {% if stat != blank %}
                  <div class="stat-item">
                    <strong>{{ stat | strip }}</strong>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        
        {% when 'block_four' %}
          <div class="manufacturing-card" {{ block.shopify_attributes }}>
            <h3>{{ block.settings.quality_title }}</h3>
            <p>{{ block.settings.quality_description }}</p>
            <ul>
              {% assign quality_items = block.settings.quality_checks | newline_to_br | split: '<br />' %}
              {% for item in quality_items %}
                {% if item != blank %}
                  <li>{{ item | strip }}</li>
                {% endif %}
              {% endfor %}
            </ul>
          </div>
        
        {% when 'block_five' %}
          <div class="manufacturing-card" {{ block.shopify_attributes }}>
            <h3>{{ block.settings.advantage_title }}</h3>
            <div class="advantage-grid">
              {% assign advantages = block.settings.advantages_list | newline_to_br | split: '<br />' %}
              {% for advantage in advantages %}
                {% if advantage != blank %}
                  <div class="advantage-item">
                    <span>✓</span>
                    <strong>{{ advantage | strip }}</strong>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        
        {% when 'block_six' %}
          <div class="cta-section" {{ block.shopify_attributes }}>
            <h3>{{ block.settings.cta_title }}</h3>
            <p>{{ block.settings.cta_description }}</p>
            {% if block.settings.cta_button_text != blank and block.settings.cta_button_link != blank %}
              <a href="{{ block.settings.cta_button_link }}" class="cta-button">
                {{ block.settings.cta_button_text }}
              </a>
            {% endif %}
          </div>
        
      {% endcase %}
    {% endfor %}
    
  </div>
</section>

{% schema %}
{
  "name": "Manufacturing Section",
  "settings": [
    {
      "type": "color",
      "id": "main_color",
      "label": "Main Color",
      "default": "#033770"
    }
  ],
  "blocks": [
    {
      "type": "block_one",
      "name": "Hero Block",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Main Heading",
          "default": "Why In-House Manufacturing Matters"
        },
        {
          "type": "text",
          "id": "problem_title",
          "label": "Problem Section Title",
          "default": "Most packaging suppliers outsource production. That leads to:"
        },
        {
          "type": "textarea",
          "id": "problem_list",
          "label": "Problem List (one per line)",
          "default": "Delayed timelines\nInconsistent quality\nHigher pricing\nCommunication gaps\nLimited customization"
        },
        {
          "type": "text",
          "id": "solution_title",
          "label": "Solution Section Title",
          "default": "We eliminate all of that. Because we manufacture in-house, we guarantee:"
        },
        {
          "type": "textarea",
          "id": "solution_list",
          "label": "Solution List (one per line)",
          "default": "Up to 25% cost efficiency\nFaster production cycles\nConsistent product quality\nReal-time production monitoring\nCustom builds without delays\nReliable inventory supply"
        }
      ]
    },
    {
      "type": "block_two",
      "name": "Capability Block",
      "settings": [
        {
          "type": "text",
          "id": "capability_title",
          "label": "Capability Title",
          "default": "Mylar Bag Lamination & Production"
        },
        {
          "type": "textarea",
          "id": "capability_description",
          "label": "Capability Description",
          "default": "We operate advanced machinery across multiple production lines."
        },
        {
          "type": "textarea",
          "id": "capability_features",
          "label": "Features List (one per line)",
          "default": "Multi-layer barrier lamination\nSmell-proof & moisture-resistant builds\nCustom thickness & finishes\nMatte, gloss, soft-touch options\nCustom sizing & structure control"
        },
        {
          "type": "text",
          "id": "capability_note",
          "label": "Additional Note",
          "default": "Perfect for cannabis flower, edibles, concentrates, and retail packaging."
        }
      ]
    },
    {
      "type": "block_three",
      "name": "Highlight Block",
      "settings": [
        {
          "type": "text",
          "id": "highlight_title",
          "label": "Highlight Title",
          "default": "High Monthly Production Capacity"
        },
        {
          "type": "textarea",
          "id": "highlight_description",
          "label": "Highlight Description",
          "default": "Our facility is engineered for scale."
        },
        {
          "type": "textarea",
          "id": "stats_list",
          "label": "Stats List (one per line)",
          "default": "50+ Million Mylar Bags per month\nHigh-volume injection molding lines\nDedicated printing & labeling units\nStreamlined lamination processes"
        }
      ]
    },
    {
      "type": "block_four",
      "name": "Quality Control Block",
      "settings": [
        {
          "type": "text",
          "id": "quality_title",
          "label": "Quality Title",
          "default": "Quality Control at Every Stage"
        },
        {
          "type": "textarea",
          "id": "quality_description",
          "label": "Quality Description",
          "default": "Because we control the process internally, quality isn't an afterthought — it's built into production."
        },
        {
          "type": "textarea",
          "id": "quality_checks",
          "label": "Quality Checks (one per line)",
          "default": "Material testing\nSeal integrity testing\nStructural durability checks\nCompliance verification\nRandomized production audits"
        }
      ]
    },
    {
      "type": "block_five",
      "name": "Advantages Block",
      "settings": [
        {
          "type": "text",
          "id": "advantage_title",
          "label": "Advantages Title",
          "default": "The Advantage of Working Directly with the Manufacturer"
        },
        {
          "type": "textarea",
          "id": "advantages_list",
          "label": "Advantages List (one per line)",
          "default": "Better pricing\nFaster restocks\nDirect communication\nCustom production flexibility\nLong-term supply stability"
        }
      ]
    },
    {
      "type": "block_six",
      "name": "CTA Block",
      "settings": [
        {
          "type": "text",
          "id": "cta_title",
          "label": "CTA Title",
          "default": "Ready to Build Your Packaging with the Source?"
        },
        {
          "type": "textarea",
          "id": "cta_description",
          "label": "CTA Description",
          "default": "Work directly with the manufacturer. Request a custom quote today and experience full in-house production power."
        },
        {
          "type": "text",
          "id": "cta_button_text",
          "label": "Button Text",
          "default": "Request a Quote"
        },
        {
          "type": "url",
          "id": "cta_button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Manufacturing Section",
      "blocks": [
        {
          "type": "block_one"
        },
        {
          "type": "block_two"
        },
        {
          "type": "block_three"
        },
        {
          "type": "block_four"
        },
        {
          "type": "block_five"
        },
        {
          "type": "block_six"
        }
      ]
    }
  ]
}
{% endschema %}