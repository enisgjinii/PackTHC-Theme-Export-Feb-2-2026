{%- liquid
	assign section_id   = '#shopify-section-' | append: section.id
	assign animation    = settings.section_animation
	assign heading      = section.settings.heading_text
	assign heading_size = section.settings.heading_size
-%}

<style>
	{{ section_id }} .section-wrapper {
		padding-top: {{ section.settings.padding_top_mobile }}px;
		padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
	}

	{{ section_id }} .marquee-content{
		margin: 0.8rem 0;
	}

	@media (min-width: 991px) {
		{{ section_id }} .newsletter-form {
			height: {% if section.settings.height == 0 %}auto{% else %}{{ section.settings.height }}px{% endif %};
		}

		{{ section_id }} .section-wrapper {
			padding-top: {{ section.settings.padding_top }}px;
			padding-bottom: {{ section.settings.padding_bottom }}px;
		}

		{{ section_id }} .marquee-content{
			margin: 1.4rem 0;
		}
	}
</style>

<div class="section-wrapper color-{{ section.settings.color_scheme }}">
	<div class="container flex{% if section.blocks.size == 0 %} no-image{% endif %}">
		<div class="image-with-text-overlay">
			<div class="newsletter-form vertical-{{ section.settings.vertical }} text-{{ section.settings.alignment }}">
				{%- form 'customer', id: nil -%}
					<input type="hidden" name="contact[tags]" value="newsletter">

					<div class="newsletter-inner">
						{%- if heading != blank -%}
							<h2 class="heading rte {{ heading_size }}">{{- heading -}}</h2>
						{%- endif -%}

						{%- if section.settings.description != blank -%}
							<div class="description rte">{{- section.settings.description -}}</div>
						{%- endif -%}

						<div class="field-wrapper">
							<label for="{{ section.id }}-field" class="sr-only">{{ 'templates.form.email' | t }}</label>
							<style>
								{%- for scheme in settings.color_schemes -%}
									{%- assign svg_color = scheme.settings.text_color | replace: '#', '%23' -%}

									{% if forloop.index == 1 %}{{ section_id }} .field-input, {% endif %}{{ section_id }} .color-{{ scheme.id }} .field-input {
										background-image: url('data:image/svg+xml,{%- render 'icon', code: 'email', color: svg_color -%}');
									}
								{%- endfor -%}
							</style>
							<input class="field-input"
								id="{{ section.id }}-field"
								type="email"
								name="contact[email]"
								value="{{ form.email }}"
								aria-required="true"
								autocorrect="off"
								autocapitalize="off"
								autocomplete="email"
								{% if form.errors %}
									autofocus
									aria-invalid="true"
									aria-describedby="{{ section.id }}-contact-error"
								{% elsif form.posted_successfully? %}
									aria-describedby="{{ section.id }}-contact-success"
								{% endif %}
								placeholder="{{ section.settings.placeholder | default: 'Email' }}"
								pattern="^([a-zA-Z0-9_\-\.]+)@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.)|(([a-zA-Z0-9\-]+\.)+))([a-zA-Z]{2,4}|[0-9]{1,3})(\]?)$"
								required >

							<button type="submit" class="button primary-button">
								{{- 'newsletter.button_label' | t -}}
								{% if settings.select_button == 'direction' %}
									{%- render 'icon', code: 'direction-button' -%}
								{% elsif settings.select_button == 'arrow' %}
									{%- render 'icon', code: 'arrow-button' -%}
								{% endif %}
							</button>
						</div>

						{%- if form.errors -%}
							<small class="message error-message" id="{{ section.id }}-contact-error">
								{%- liquid
									render 'icon', code: 'error'

									echo form.errors.translated_fields['email'] | capitalize
									echo form.errors.messages['email']
								-%}
							</small>
						{%- endif -%}
					</div>

					{%- if form.posted_successfully? -%}
						<h3 class="message success-message" id="{{ section.id }}-contact-success" tabindex="-1" autofocus>
							{%- liquid
								render 'icon', code: 'success'
								echo 'newsletter.success' | t
							-%}
						</h3>
					{%- endif -%}
				{%- endform -%}
			</div>

			{% if section.blocks.size > 0 %}
				<div class="two-columns">
					<marquee-vertical class="two-marquee marquee rte">
						<div class="marquee-wrapper marquee-animation even-blocks">
							{%- for block in section.blocks -%}
								{%- assign image = block.settings.image -%}
								<div class="marquee-content" data-{{ block.id }}>
									<div class="image-wrap small-media">
										<div class="collage-image-wrapper{% if settings.image_lazy and image %} lazy-image{% endif %}">
											{% if image != blank %}
												{% render 'lazy-image', image: image, width: 480 %}
											{% else %}
												{% render 'icon', code: 'placeholder', width: 480 %}
											{% endif %}
										</div>
									</div>
								</div>
							{%- endfor -%}
						</div>
					</marquee-vertical>
					<marquee-vertical class="two-marquee marquee rte">
						<div class="marquee-wrapper marquee-animation odd-blocks">
							{%- for block in section.blocks -%}
								{%- assign image = block.settings.image -%}
								<div class="marquee-content" data-{{ block.id }}>
									<div class="image-wrap small-media">
										<div class="collage-image-wrapper{% if settings.image_lazy and image %} lazy-image{% endif %}">
											{% if image != blank %}
												{% render 'lazy-image', image: image, width: 480 %}
											{% else %}
												{% render 'icon', code: 'placeholder', width: 480 %}
											{% endif %}
										</div>
									</div>
								</div>
							{%- endfor -%}
						</div>
					</marquee-vertical>
				</div>
			{% endif %}
		</div>
	</div>
</div>

{% schema %}
{
	"name": "t:sections.newsletter.name",
	"tag": "section",
	"class": "newsletter-section two-animated",
	"limit": 1,
	"disabled_on": {
		"groups": ["header"]
	},
	"settings": [
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"label": "t:settings_schema.colors.label",
			"default": "scheme-1"
		},
		{
			"type": "range",
			"id": "height",
			"min": 300,
			"max": 1300,
			"step": 10,
			"default": 700,
			"unit": "px",
			"label": "t:general.dimensions.height.label"
		},
		{
			"type": "header",
			"content": "t:sections.animated-image-collage.settings.header_content.content"
		},
		{
			"type": "select",
			"id": "vertical",
			"default": "middle",
			"label": "t:general.layout.vertical.label",
			"info": "t:general.layout.vertical.mobile_middle.label",
			"options": [
				{
					"value": "top",
					"label": "t:general.layout.vertical.option_1.label"
				},
				{
					"value": "middle",
					"label": "t:general.layout.vertical.option_2.label"
				},
				{
					"value": "bottom",
					"label": "t:general.layout.vertical.option_3.label"
				}
			]
		},
		{
			"type": "select",
			"id": "alignment",
			"default": "center",
			"label": "t:general.layout.alignment.label",
			"info": "t:general.layout.alignment.mobile_center.label",
			"options": [
				{
					"value": "left",
					"label": "t:general.layout.alignment.option_1.label"
				},
				{
					"value": "center",
					"label": "t:general.layout.alignment.option_2.label"
				},
				{
					"value": "right",
					"label": "t:general.layout.alignment.option_3.label"
				}
			]
		},
		{
			"type": "header",
			"content": "t:general.typography.heading.label"
		},
		{
			"type": "richtext",
			"id": "heading_text",
			"default": "<h4>Join our newsletter<h4>",
			"label": "t:general.typography.heading.label"
		},
		{
			"type": "select",
			"id": "heading_size",
			"options": [
				{
					"value": "h4",
					"label": "t:general.typography.heading_size.option_1.label"
				},
				{
					"value": "h3",
					"label": "t:general.typography.heading_size.option_2.label"
				},
				{
					"value": "h2",
					"label": "t:general.typography.heading_size.option_3.label"
				}
			],
			"default": "h2",
			"label": "t:general.typography.heading_size.label"
		},
		{
			"type": "richtext",
			"id": "description",
			"default": "<p>Sign up for our newsletter and receive 10% off your first order!</p>",
			"label": "t:general.typography.description.label"
		},
		{
			"type": "text",
			"id": "placeholder",
			"default": "Enter your email address",
			"label": "t:sections.newsletter.settings.placeholder.label"
		},
		{
			"type": "header",
			"content": "t:general.padding.header_padding.content"
		},
		{
			"type": "range",
			"id": "padding_top",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 60,
			"unit": "px",
			"label": "t:general.padding.top.label"
		},
		{
			"type": "range",
			"id": "padding_bottom",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 60,
			"unit": "px",
			"label": "t:general.padding.bottom.label"
		},
		{
			"type": "paragraph",
			"content": "t:general.padding.paragraph_mobile.content"
		},
		{
			"type": "range",
			"id": "padding_top_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 30,
			"unit": "px",
			"label": "t:general.padding.top.label"
		},
		{
			"type": "range",
			"id": "padding_bottom_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 30,
			"unit": "px",
			"label": "t:general.padding.bottom.label"
		}
	],
	"blocks": [
		{
			"type": "image",
			"name": "t:general.image.label",
			"settings": [
				{
					"type": "image_picker",
					"id": "image",
					"label": "t:general.image.label"
				}
			]
		}
	],
	"presets": [
		{
			"name": "t:sections.newsletter.presets.name",
			"blocks": [
				{
					"type": "image"
				},
				{
					"type": "image"
				},
				{
					"type": "image"
				},
				{
					"type": "image"
				}
			]
		}
	]
}
{% endschema %}
