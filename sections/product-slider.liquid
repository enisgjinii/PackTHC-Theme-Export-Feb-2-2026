{%- liquid
	assign section_id    = '#shopify-section-' | append: section.id
	assign show_arrows   = section.settings.arrows
	assign show_dots     = section.settings.dots
	assign image_desktop = section.settings.image
	assign image_mobile  = section.settings.mobile_image
	assign total         = section.settings.total
	assign bg_color      = section.settings.bg_color
	assign text_color    = section.settings.text_color
	assign overlay       = section.settings.overlay

	if section.settings.collection != blank and section.settings.collection.all_products_count > 0
		assign product_list = section.settings.collection.products
	endif
-%}

<style>
	{{ section_id }} .container.product-slider-content {
		padding-top: {{ section.settings.padding_top }}px;
		padding-bottom: {{ section.settings.padding_bottom }}px;
	}

	{%- if bg_color != blank -%}
		{{ section_id }} .product-card {
			background-color: {{ bg_color }};
		}
	{%- endif -%}

	{%- if text_color != blank -%}
		{{ section_id }} .product-card-content {
			--heading-color: {{ text_color.red }}, {{ text_color.green }}, {{ text_color.blue }};
			--text-color: {{ text_color.red }}, {{ text_color.green }}, {{ text_color.blue }};
		}
	{%- endif -%}

	@media (min-width: 992px) {
		{{ section_id }} .product-wrapper >.product-slider-content:before {
			content: '';
			left: 0;
			right: 0;
			top: 0;
			bottom: 0;
			position: absolute;
			z-index: 2;
			background: linear-gradient(to bottom,rgba(0,0,0,0),{%- if overlay == 100 -%}rgb(0,0,0){%- else -%}rgba(0,0,0,0.{{ overlay }}){%- endif -%});
		}
	}

	@media (max-width: 991px) {
		{{ section_id }} .container.product-slider-content {
			padding-top: {{ section.settings.padding_top_mobile }}px;
			padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
		}

		{{ section_id }} .product-wrapper .container.product-slider-content .image-wrapper:before {
			content: '';
			left: 0;
			right: 0;
			top: 0;
			bottom: 0;
			position: absolute;
			z-index: 2;
			background: linear-gradient(to bottom,rgba(0,0,0,0),{%- if overlay == 100 -%}rgb(0,0,0){%- else -%}rgba(0,0,0,0.{{ overlay }}){%- endif -%});
		}
	}

	{%- for scheme in settings.color_schemes -%}
		{%- assign input_bg_color = scheme.settings.background_color | color_lighten: 8 -%}

		{{ section_id }} .color-{{ scheme.id }} {
			--input-bg-color: {{ input_bg_color.red }}, {{ input_bg_color.green }}, {{ input_bg_color.blue }};
		}
	{%- endfor -%}
</style>

{%- capture image_wrapper -%}
	<div class="image{% if image_mobile != blank %} hidden-tablet hidden-mobile{% endif %}{% if settings.image_lazy and image_desktop != blank %} lazy-image{% endif %}">
		{%- liquid
			if image_desktop != blank
				render 'lazy-image', image: image_desktop, width: 1920
			else
				render 'icon', code: 'placeholder'
			endif
		-%}
	</div>

	{%- if image_mobile != blank -%}
		<div class="image hidden-desktop{% if settings.image_lazy %} lazy-image{% endif %}">
			{%- render 'lazy-image', image: image_mobile, width: 991 -%}
		</div>
	{%- endif -%}
{%- endcapture -%}

<div class="section-wrapper color-{{ section.settings.color_scheme }}">
	<div class="stretch-section">
		<div class="product-wrapper">
			<div class="product-slider-content flex-align-{{ section.settings.position_y }}">
				<div class="hidden-tablet hidden-mobile">{{- image_wrapper -}}</div>

				<div class="container product-slider-content flex-align-{{ section.settings.position_y }}">
					<div class="product-slider-left">
						<div class="hidden-desktop image-wrapper">{{- image_wrapper -}}</div>
						<div class="content-wrap">
							{%- if section.settings.heading != blank -%}
								<div class="heading {{ section.settings.heading_size }}">{{- section.settings.heading -}}</div>
							{%- endif -%}

							{%- if section.settings.sub_heading != blank -%}
								<h4 class="sub-heading rte text-body">{{- section.settings.sub_heading -}}</h4>
							{%- endif -%}

							{%- if section.settings.description != blank -%}
								<div class="description rte">{{- section.settings.description -}}</div>
							{%- endif -%}

							{%- if section.settings.button_label != blank -%}
								<a class="button secondary-button" href="{{ section.settings.button_link | default: '#' }}">
									{{- section.settings.button_label -}}

									{% if settings.select_button == 'direction' %}
										{%- render 'icon', code: 'direction-button' -%}
									{% elsif settings.select_button == 'arrow' %}
										{%- render 'icon', code: 'arrow-button' -%}
									{% endif %}
								</a>
							{%- endif -%}

							{%- if show_arrows or show_dots -%}
								<div class="swiper-controls">
									{%- if show_arrows -%}
										<button class="swiper-button-prev" title ="{{ 'general.swipper.prev' | t }}" aria-label="{{ 'general.swipper.prev' | t }}" id="{{ 'general.swipper.prev' | t }}" aria-labelledby="{{ 'general.swipper.prev' | t }}">{%- render 'icon', code: 'arrow-left-slider' -%}</button>
									{%- endif -%}

									{%- if show_dots -%}
										<div class="swiper-pagination" tabindex="-1"></div>
									{%- endif -%}

									{%- if show_arrows -%}
										<button class="swiper-button-next" title ="{{ 'general.swipper.next' | t }}" aria-label="{{ 'general.swipper.next' | t }}" id="{{ 'general.swipper.next' | t }}" aria-labelledby="{{ 'general.swipper.next' | t }}">{%- render 'icon', code: 'arrow-right-slider' -%}</button>
									{%- endif -%}
								</div>
							{%- endif -%}
						</div>
					</div>

					<div class="product-slider-right">
						<div class="product-carousel carousel-swiper">
							<template data-options>
								{
									{%- if section.settings.loop -%}
										"loop": true,
									{%- endif -%}

									{%- if section.settings.autoplay and section.settings.delay > 0 -%}
										"autoplay": {
											"delay": {{ section.settings.delay | times: 1000 }},
											"pauseOnMouseEnter": true
										},
									{%- endif -%}

									{%- if show_arrows -%}
										"navigation": {
											"nextEl": "{{ section_id }} .swiper-button-next",
											"prevEl": "{{ section_id }} .swiper-button-prev"
										},
									{%- endif -%}

									{%- if show_dots -%}
										"pagination": {
											"el": "{{ section_id }} .swiper-pagination",
											"clickable": true
										},
									{%- endif -%}

									"autoHeight": true,
									"spaceBetween": 20,
									"speed": {{ section.settings.speed | times: 1000 }}

								}
							</template>

							<div class="swiper">
								<div class="swiper-wrapper">
									{%- for product in product_list limit: total -%}
										<div class="swiper-slide" data-{{ forloop.index0 }} {% if request.design_mode %} data-index="{{ forloop.index0 }}"{% endif %}>
											{%- render 'product-card', product: product, index: forloop.index -%}
										</div>
									{%- else -%}
										{%- for i in (1..total) -%}
											{%- liquid
												capture index
													cycle 1, 2, 3, 4, 5, 6
												endcapture
											-%}

											<div class="swiper-slide" data-{{ index }}>
												{%- render 'product-card-placeholder', index: index -%}
											</div>
										{%- endfor -%}
									{%- endfor -%}
								</div>
							</div>


						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

{% schema %}
{
	"name": "t:sections.product-slider.name",
	"tag": "section",
	"class": "product-slider-section",
	"disabled_on": {
		"groups": ["header", "footer"]
	},
	"settings": [
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"label": "t:settings_schema.colors.label",
			"default": "scheme-1"
		},
		{
			"type": "collection",
			"id": "collection",
			"label": "t:sections.product-slider.settings.collection.label"
		},
		{
			"type": "image_picker",
			"id": "image",
			"label": "t:general.background.label"
		},
		{
			"type": "image_picker",
			"id": "mobile_image",
			"label": "t:general.background_mobile.label"
		},
		{
			"type": "range",
			"id": "overlay",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 60,
			"unit": "%",
			"label": "t:sections.video-background.settings.overlay.label",
			"info": "t:sections.video-background.settings.overlay.info"
		},
		{
			"type": "header",
			"content": "t:settings_schema.product-card.name"
		},
		{
			"type": "color",
			"id": "bg_color",
			"label": "t:general.background.color.label"
		},
		{
			"type": "color",
			"id": "text_color",
			"label": "t:general.colors.text.label"
		},
		{
			"type": "richtext",
			"id": "heading",
			"default": "<p>Heading<p>",
			"label": "t:general.typography.heading.label"
		},
		{
			"type": "select",
			"id": "heading_size",
			"options": [
				{
					"value": "h3",
					"label": "t:general.typography.heading_size.option_1.label"
				},
				{
					"value": "h2",
					"label": "t:general.typography.heading_size.option_2.label"
				},
				{
					"value": "h1",
					"label": "t:general.typography.heading_size.option_3.label"
				}
			],
			"default": "h2",
			"label": "t:general.typography.font_size.label"
		},
		{
			"type": "inline_richtext",
			"id": "sub_heading",
			"label": "t:general.typography.sub_heading.label"
		},
		{
			"type": "richtext",
			"id": "description",
			"default": "<p>Pair text with an image to focus on your<br> chosen product, collection, or blog post.<br> Add details on availability, style, or even provide a review.</p>",
			"label": "t:general.typography.description.label"
		},
		{
			"type": "header",
			"content": "t:general.typography.button.label"
		},
		{
			"type": "text",
			"id": "button_label",
			"default": "Button label",
			"label": "t:general.typography.button.label"
		},
		{
			"type": "url",
			"id": "button_link",
			"label": "t:general.typography.link.label"
		},
		{
			"type": "select",
			"id": "position_y",
			"options": [
				{
					"value": "start",
					"label": "t:sections.product-slider.blocks.slide.settings.position_y.options__1.label"
				},
				{
					"value": "center",
					"label": "t:sections.product-slider.blocks.slide.settings.position_y.options__2.label"
				},
				{
					"value": "end",
					"label": "t:sections.product-slider.blocks.slide.settings.position_y.options__3.label"
				}
			],
			"default": "center",
			"label": "t:sections.product-slider.blocks.slide.settings.position_y.options__2.label"
		},
		{
			"type": "header",
			"content": "t:general.slider.options.label"
		},
		{
			"type": "checkbox",
			"id": "loop",
			"default": false,
			"label": "t:general.slider.loop.label"
		},
		{
			"type": "checkbox",
			"id": "autoplay",
			"default": false,
			"label": "t:general.slider.autoplay.label"
		},
		{
			"type": "checkbox",
			"id": "arrows",
			"default": true,
			"label": "t:general.slider.show_arrows.label"
		},
		{
			"type": "checkbox",
			"id": "dots",
			"default": true,
			"label": "t:general.slider.show_dots.label"
		},
		{
			"type": "range",
			"id": "total",
			"min": 1,
			"max": 20,
			"step": 1,
			"default": 10,
			"label": "t:general.slider.total.label"
		},
		{
			"type": "range",
			"id": "delay",
			"default": 5,
			"min": 0,
			"max": 10,
			"step": 0.1,
			"label": "t:general.slider.delay.label"
		},
		{
			"type": "range",
			"id": "speed",
			"default": 0.5,
			"min": 0,
			"max": 10,
			"step": 0.1,
			"label": "t:general.slider.speed.label"
		},
		{
			"type": "header",
			"content": "t:general.padding.header_padding.content"
		},
		{
			"type": "range",
			"id": "padding_top",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 50,
			"unit": "px",
			"label": "t:general.padding.top.label"
		},
		{
			"type": "range",
			"id": "padding_bottom",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 50,
			"unit": "px",
			"label": "t:general.padding.bottom.label"
		},
		{
			"type": "paragraph",
			"content": "t:general.padding.paragraph_mobile.content"
		},
		{
			"type": "range",
			"id": "padding_top_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 0,
			"unit": "px",
			"label": "t:general.padding.top.label"
		},
		{
			"type": "range",
			"id": "padding_bottom_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 0,
			"unit": "px",
			"label": "t:general.padding.bottom.label"
		}
	],
	"presets": [
		{
			"name": "t:sections.product-slider.name"
		}
	]
}
{% endschema %}