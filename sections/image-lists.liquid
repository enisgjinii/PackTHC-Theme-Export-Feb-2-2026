{%- liquid
	assign section_id    = '#shopify-section-' | append: section.id
	assign animation     = settings.section_animation
	assign full          = section.settings.full
	assign heading       = section.settings.heading_text
	assign heading_size  = section.settings.heading_size
	assign subheading    = section.settings.sub_heading_text
	assign button        = section.settings.button_text
	assign header_layout = section.settings.header_layout
	assign alignment     = section.settings.text_align
	assign total        = section.settings.rows | times: section.settings.columns
-%}

<style>
	{{ section_id }} .section-wrapper {
		padding-top: {{ section.settings.padding_top_mobile }}px;
		padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
	}

	@media (min-width: 992px) {
		{{ section_id }} .section-wrapper {
			padding-top: {{ section.settings.padding_top }}px;
			padding-bottom: {{ section.settings.padding_bottom }}px;
		}
	}
</style>

<div class="section-wrapper color-{{ section.settings.color_scheme }}">
	<div class="{% if full %}stretch-section stretch-padding{% else %}container{% if header_layout == 'column' %} grid-right{% endif %}{% endif %}">
		<div class="image-lists {{ header_layout }} text-{{ alignment }}">
			{%- if heading != blank or subheading != blank -%}
				<div class="title-wrapper{% if animation %} scroll-trigger{% endif %}">
					{%- if heading != blank -%}
						<h2 class="heading rte {{ heading_size }}">{{- heading -}}</h2>
					{%- endif -%}

					{%- if subheading != blank -%}
						<div class="sub-heading rte">{{- subheading -}}</div>
					{%- endif -%}

					{%- if button != blank and header_layout == 'column' -%}
						<div class="button-wrap">
							<a class="button{% if header_layout == 'column' %} primary-button{% else%} link-underline{% endif %}" href="{{ section.settings.button_link | default: '#' }}">
								{{- button -}}

								{% if settings.select_button == 'direction' %}
									{%- render 'icon', code: 'direction-button' -%}
								{% elsif settings.select_button == 'arrow' %}
									{%- render 'icon', code: 'arrow-button' -%}
								{% endif %}
							</a>
						</div>
					{%- endif -%}
				</div>
			{%- endif -%}

			<ul class="image-lists-content grid grid-{{ section.settings.columns }}{% unless section.settings.swipe_mobile %} grid-tablet-{{ section.settings.columns_mobile }} grid-mobile-{{ section.settings.columns_mobile }}{% endunless %}" role="list">
				{%- for block in section.blocks limit: total -%}
					<li class="grid-item">
						<div class="image-item{% if animation %} scroll-trigger{% endif %}" {{ block.shopify_attributes }}>
							{%- case block.type -%}
								{%- when '@app' -%}
									{%- render block -%}

								{%- when 'image' -%}
									{%- assign image = block.settings.image -%}

									<div class="image-wrap square-media">
										<div class="collage-image-wrapper{% if settings.image_lazy and image %} lazy-image{% endif %}">
											{%- liquid
												if image != blank
													render 'lazy-image', image: image, width: 575
												else
													render 'icon', code: 'placeholder'
												endif
											-%}
										</div>
									</div>
							{%- endcase -%}
						</div>
					</li>
				{%- endfor -%}
			</ul>

			{%- if button != blank and header_layout == 'row' -%}
				<div class="button-wrap">
					<a class="button primary-button" href="{{ section.settings.button_link | default: '#' }}">
						{{- button -}}

						{% if settings.select_button == 'direction' %}
							{%- render 'icon', code: 'direction-button' -%}
						{% elsif settings.select_button == 'arrow' %}
							{%- render 'icon', code: 'arrow-button' -%}
						{% endif %}
					</a>
				</div>
			{%- endif -%}
		</div>
	</div>
</div>

{% schema %}
{
	"name": "t:sections.image-lists.name",
	"tag": "section",
	"class": "image-lists-section",
	"disabled_on": {
		"groups": ["header", "footer"]
	},
	"settings": [
		{
			"type": "checkbox",
			"id": "full",
			"default": false,
			"label": "t:general.layout.full.label"
		},
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"label": "t:settings_schema.colors.label",
			"default": "scheme-1"
		},
		{
			"type": "header",
			"content": "t:general.typography.content.label"
		},
		{
			"type": "select",
			"id": "header_layout",
			"options": [
				{
					"value": "column",
					"label": "t:sections.image-lists.settings.header_layout.options_1.label"
				},
				{
					"value": "row",
					"label": "t:sections.image-lists.settings.header_layout.options_2.label"
				}
			],
			"default": "column",
			"label": "t:sections.image-lists.settings.header_layout.label"
		},
		{
			"type": "select",
			"id": "text_align",
			"options": [
				{
					"value": "left",
					"label": "t:general.layout.alignment.option_1.label"
				},
				{
					"value": "center",
					"label": "t:general.layout.alignment.option_2.label"
				},
				{
					"value": "right",
					"label": "t:general.layout.alignment.option_3.label"
				}
			],
			"default": "left",
			"label": "t:general.layout.alignment.label"
		},
		{
			"type": "range",
			"id": "rows",
			"min": 1,
			"max": 10,
			"step": 1,
			"default": 1,
			"label": "t:general.grid.rows.label"
		},
		{
			"type": "range",
			"id": "columns",
			"min": 1,
			"max": 12,
			"step": 1,
			"default": 4,
			"label": "t:general.grid.columns.label"
		},
		{
			"type": "select",
			"id": "columns_mobile",
			"default": "2",
			"label": "t:general.slider.items_per_row_mobile.label",
			"options": [
				{
					"value": "1",
					"label": "1"
				},
				{
					"value": "2",
					"label": "2"
				}
			]
		},
		{
			"type": "checkbox",
			"id": "swipe_mobile",
			"default": true,
			"label": "t:general.slider.swipe_mobile.label"
		},
		{
			"type": "header",
			"content": "t:general.typography.heading.label"
		},
		{
			"type": "inline_richtext",
			"id": "heading_text",
			"default": "Heading",
			"label": "t:general.typography.text.label"
		},
		{
			"type": "select",
			"id": "heading_size",
			"options": [
				{
					"value": "h4",
					"label": "t:general.typography.heading_size.option_1.label"
				},
				{
					"value": "h3",
					"label": "t:general.typography.heading_size.option_2.label"
				},
				{
					"value": "h2",
					"label": "t:general.typography.heading_size.option_3.label"
				}
			],
			"default": "h3",
			"label": "t:general.typography.font_size.label"
		},
		{
			"type": "header",
			"content": "t:general.typography.description.label"
		},
		{
			"type": "richtext",
			"id": "sub_heading_text",
			"default": "<p>Pair text with an image to focus on your chosen product, collection, or blog post.</p>",
			"label": "t:general.typography.text.label"
		},
		{
			"type": "header",
			"content": "t:general.typography.button.label"
		},
		{
			"type": "text",
			"id": "button_text",
			"default": "Button label",
			"label": "t:general.typography.text.label"
		},
		{
			"type": "url",
			"id": "button_link",
			"label": "t:general.typography.link.label"
		},
		{
			"type": "header",
			"content": "t:general.padding.header_padding.content"
		},
		{
			"type": "range",
			"id": "padding_top",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 50,
			"unit": "px",
			"label": "t:general.padding.top.label"
		},
		{
			"type": "range",
			"id": "padding_bottom",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 50,
			"unit": "px",
			"label": "t:general.padding.bottom.label"
		},
		{
			"type": "paragraph",
			"content": "t:general.padding.paragraph_mobile.content"
		},
		{
			"type": "range",
			"id": "padding_top_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 20,
			"unit": "px",
			"label": "t:general.padding.top.label"
		},
		{
			"type": "range",
			"id": "padding_bottom_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 20,
			"unit": "px",
			"label": "t:general.padding.bottom.label"
		}
	],
	"blocks": [
		{
			"type": "@app"
		},
		{
			"type": "image",
			"name": "t:general.image.label",
			"settings": [
				{
					"type": "image_picker",
					"id": "image",
					"label": "t:general.image.label"
				}
			]
		}
	],
	"presets": [
		{
			"name": "t:sections.image-lists.presets.name",
			"blocks": [
				{
					"type": "image"
				},
				{
					"type": "image"
				},
				{
					"type": "image"
				},
				{
					"type": "image"
				},
				{
					"type": "image"
				}
			]
		}
	]
}
{% endschema %}
