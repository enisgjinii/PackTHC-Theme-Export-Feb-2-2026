{% comment %}
  Hero Grid Section for Shopify
  Save this as: sections/hero-grid.liquid
{% endcomment %}

<style>
  .hero-grid-section-{{ section.id }} {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    background: #000;
    margin: 0;
    padding: 0;
  }

  .hero-section-{{ section.id }} {
    display: grid;
    grid-template-columns: 1fr 1fr 2fr;
    grid-template-rows: 1fr 1fr;
    height: 70vh;
    gap: 2px;
    background: #000;
    padding: 2px;
  }

  .grid-item-{{ section.id }} {
    position: relative;
    overflow: hidden;
    cursor: pointer;
    background: #f5f5f5;
  }

  .grid-item-{{ section.id }}::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(to bottom, transparent 0%, rgba(0,0,0,0.1) 100%);
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  .grid-item-{{ section.id }}:hover::after {
    opacity: 1;
  }

  .grid-item-{{ section.id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    display: block;
  }

  .grid-item-{{ section.id }}:hover img {
    transform: scale(1.05);
  }

  .grid-overlay-{{ section.id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 24px;
    background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, transparent 100%);
    transform: translateY(100%);
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 2;
  }

  .grid-item-{{ section.id }}:hover .grid-overlay-{{ section.id }} {
    transform: translateY(0);
  }

  .overlay-title-{{ section.id }} {
    color: #fff;
    font-size: 20px;
    font-weight: 600;
    margin-bottom: 4px;
    letter-spacing: -0.02em;
  }

  .overlay-subtitle-{{ section.id }} {
    color: rgba(255,255,255,0.8);
    font-size: 14px;
    font-weight: 400;
  }

  /* Grid positions */
  .position-1-{{ section.id }} {
    grid-column: 1;
    grid-row: 1;
  }

  .position-2-{{ section.id }} {
    grid-column: 2;
    grid-row: 1;
  }

  .position-3-{{ section.id }} {
    grid-column: 3;
    grid-row: 1 / 3;
  }

  .position-4-{{ section.id }} {
    grid-column: 1;
    grid-row: 2;
  }

  .position-5-{{ section.id }} {
    grid-column: 2;
    grid-row: 2;
  }

  /* Loading state */
  .grid-item-{{ section.id }}.loading::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);
    animation: shimmer-{{ section.id }} 1.5s infinite;
    z-index: 1;
  }

  .grid-item-{{ section.id }}.loaded::before {
    display: none;
  }

  @keyframes shimmer-{{ section.id }} {
    0% {
      left: -100%;
    }
    100% {
      left: 100%;
    }
  }

  /* Responsive design */
  @media (max-width: 1024px) {
    .hero-section-{{ section.id }} {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 1fr 1fr 1fr;
      height: 80vh;
    }

    .position-3-{{ section.id }} {
      grid-column: 1 / 3;
      grid-row: 3;
    }

    .position-1-{{ section.id }} {
      grid-column: 1;
      grid-row: 1;
    }

    .position-2-{{ section.id }} {
      grid-column: 2;
      grid-row: 1;
    }

    .position-4-{{ section.id }} {
      grid-column: 1;
      grid-row: 2;
    }

    .position-5-{{ section.id }} {
      grid-column: 2;
      grid-row: 2;
    }
  }

  @media (max-width: 768px) {
    .hero-section-{{ section.id }} {
      grid-template-columns: 1fr;
      grid-template-rows: repeat(5, 1fr);
      height: auto;
      min-height: 100vh;
    }

    .position-1-{{ section.id }},
    .position-2-{{ section.id }},
    .position-3-{{ section.id }},
    .position-4-{{ section.id }},
    .position-5-{{ section.id }} {
      grid-column: 1;
      grid-row: auto;
    }
  }

  /* Page load animation */
  .hero-section-{{ section.id }} {
    animation: fadeIn-{{ section.id }} 0.6s ease-in;
  }

  @keyframes fadeIn-{{ section.id }} {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>

<div class="hero-grid-section-{{ section.id }}">
  <div class="hero-section-{{ section.id }}">
    {% for block in section.blocks %}
      <div class="grid-item-{{ section.id }} position-{{ forloop.index }}-{{ section.id }} loading" 
           data-category="{{ block.settings.category }}"
           {{ block.shopify_attributes }}>
        
        {% if block.settings.image %}
          <img 
            src="{{ block.settings.image | image_url: width: 1200 }}"
            srcset="{{ block.settings.image | image_url: width: 600 }} 600w,
                    {{ block.settings.image | image_url: width: 1200 }} 1200w,
                    {{ block.settings.image | image_url: width: 1800 }} 1800w"
            sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
            alt="{{ block.settings.image.alt | default: block.settings.title }}"
            loading="lazy">
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
        
        {% if block.settings.show_overlay %}
          <div class="grid-overlay-{{ section.id }}">
            {% if block.settings.title != blank %}
              <h3 class="overlay-title-{{ section.id }}">{{ block.settings.title }}</h3>
            {% endif %}
            {% if block.settings.subtitle != blank %}
              <p class="overlay-subtitle-{{ section.id }}">{{ block.settings.subtitle }}</p>
            {% endif %}
          </div>
        {% endif %}
        
        {% if block.settings.link != blank %}
          <a href="{{ block.settings.link }}" class="grid-item-link" style="position: absolute; inset: 0; z-index: 3;"></a>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const sectionId = '{{ section.id }}';
    const gridItems = document.querySelectorAll('.grid-item-' + sectionId);
    
    // Image loading handler
    gridItems.forEach(item => {
      const img = item.querySelector('img');
      if (img) {
        img.addEventListener('load', function() {
          item.classList.remove('loading');
          item.classList.add('loaded');
        });
        
        if (img.complete) {
          item.classList.remove('loading');
          item.classList.add('loaded');
        }
        
        img.addEventListener('error', function() {
          item.classList.remove('loading');
          item.classList.add('loaded');
        });
      }
    });
    
    // Click handler
    gridItems.forEach(item => {
      item.addEventListener('click', function(e) {
        if (!e.target.closest('.grid-item-link')) {
          const category = this.dataset.category;
          this.style.transform = 'scale(0.98)';
          setTimeout(() => {
            this.style.transform = '';
          }, 150);
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "New Hero Grid Section",
  "tag": "section",
  "class": "hero-grid-section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "paragraph",
      "content": "Create a modern grid layout with 5 blocks. The 3rd block will span full height on the right side."
    }
  ],
  "blocks": [
    {
      "type": "grid_item",
      "name": "Grid Item",
      "limit": 5,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Recommended: 1200x800px for small boxes, 1200x1600px for large box (position 3)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Collection Title"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Explore Collection"
        },
        {
          "type": "checkbox",
          "id": "show_overlay",
          "label": "Show text overlay on hover",
          "default": true
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "category",
          "label": "Category (for tracking)",
          "default": "collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Grid",
      "blocks": [
        {
          "type": "grid_item",
          "settings": {
            "title": "Living Room",
            "subtitle": "Explore Collection",
            "category": "living-room"
          }
        },
        {
          "type": "grid_item",
          "settings": {
            "title": "Kitchen & Dining",
            "subtitle": "Explore Collection",
            "category": "kitchen"
          }
        },
        {
          "type": "grid_item",
          "settings": {
            "title": "Lighting",
            "subtitle": "Explore Collection",
            "category": "lighting"
          }
        },
        {
          "type": "grid_item",
          "settings": {
            "title": "Audio Decor",
            "subtitle": "Explore Collection",
            "category": "audio"
          }
        },
        {
          "type": "grid_item",
          "settings": {
            "title": "Bottles",
            "subtitle": "Explore Collection",
            "category": "bottles"
          }
        }
      ]
    }
  ]
}
{% endschema %}