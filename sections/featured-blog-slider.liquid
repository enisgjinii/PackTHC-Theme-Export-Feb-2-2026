{%- liquid
	assign section_id        = '#shopify-section-' | append: section.id
	assign animation         = settings.section_animation
	assign full              = section.settings.full
	assign blog              = section.settings.blog
	assign heading           = section.settings.heading_text
	assign heading_size      = section.settings.heading_size
	assign heading_upper     = section.settings.heading_upper
	assign post_meta_upper   = section.settings.post_meta_upper
	assign total             = section.settings.total
	assign show_arrows       = section.settings.show_arrows
	assign show_dots         = section.settings.show_dots
	assign column            = section.settings.column
	assign column_gap        = section.settings.column_gap
	assign layout            = section.settings.layout
	assign heading_post_size = section.settings.heading_post_size
-%}

<style>
	{{ section_id }} .section-wrapper {
		padding-top: {{ section.settings.padding_top_mobile }}px;
		padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
	}

	{%- if section.settings.post_padding -%}
		{{ section_id }} .card-column .article-card {
			padding: 1.6rem;
		}
	{%- endif -%}

	@media (min-width: 992px) {
		{{ section_id }} .section-wrapper {
			padding-top: {{ section.settings.padding_top }}px;
			padding-bottom: {{ section.settings.padding_bottom }}px;
		}

		{%- if section.settings.post_padding -%}
			{{ section_id }} .card-column .article-card {
				padding: 2.4rem;
			}
		{%- endif -%}
	}
</style>

<div class="section-wrapper color-{{ section.settings.color_scheme }}">
	<div class="{% if full %}stretch-section stretch-padding{% else %}container{% endif %}">
		<div class="featured-blog-slider-top{% if animation %} scroll-trigger{% endif %}">
			{%- if heading != blank -%}
				<div class="title-wrapper text-left">
					{%- if heading != blank -%}
						<h2 class="heading rte {{ heading_size }}">{{- heading -}}</h2>
					{%- endif -%}
				</div>
			{%- endif -%}

			{%- if section.settings.button_text != blank -%}
				<a class="show-more link-underline" href="{{ section.settings.blog.url | default: '#' }}">
					{{- section.settings.button_text -}}
				</a>
			{%- endif -%}
		</div>

		<div class="featured-blog-slider-content {{ layout }} carousel-swiper{% if animation %} scroll-trigger{% endif %}">
			<template data-options data-css-mode="off">
				{
					{%- if section.settings.loop -%}
						"loop": true,
					{%- endif -%}

					{%- if section.settings.autoplay -%}
						"autoplay": {
							"delay": {{ section.settings.delay | times: 1000 }},
							"disableOnInteraction": false,
							"pauseOnMouseEnter": true
						},
					{%- endif -%}

					{%- if show_arrows -%}
						"navigation": {
							"nextEl": "{{ section_id }} .swiper-button-next",
							"prevEl": "{{ section_id }} .swiper-button-prev"
						},
					{%- endif -%}

					{%- if show_dots -%}
						"pagination": {
							"el": "{{ section_id }} .swiper-pagination",
							"clickable": true
						},
					{%- endif -%}

					"slidesPerView": {{ column }},
					"breakpoints": {
						"240": {
							"slidesPerView": 1.3,
							"spaceBetween": 24
						},
						"992": {
							"slidesPerView": {{ column }},
							"spaceBetween": {{ column_gap }}
						}
					}
				}
			</template>

			<div class="swiper">
				<div class="swiper-wrapper">
					{%- for article in blog.articles limit: total -%}
						<div class="swiper-slide" data-{{ forloop.index0 }} {% if request.design_mode %} data-index="{{ forloop.index0 }}"{% endif %}>
							<article class="article-card color-{{ section.settings.post_color_scheme }}">
								{%- liquid
									assign article_image = article.image
								-%}

								<div class="article-media-wrap {{ section.settings.image_ratio }}-media{% unless article_image %} no-media{% endunless %}">
									{%- if article_image -%}
										<a href="{{ article.url }}" class="article-image{% if settings.image_lazy and article_image %} lazy-image{% endif %}">
											{%- liquid
												assign image_load = 'eager'

												if forloop.index > 1
													assign image_load = 'lazy'
												endif

												if section.settings.image_ratio == 'adapt'
													assign show_aspect_ratio = true
												endif

												render 'lazy-image', image: article_image, width: 740, lazy: image_load, show_aspect_ratio: show_aspect_ratio
											-%}
										</a>
									{%- else -%}
										<h2 class="article-title {{ heading_post_size }}{% if heading_upper %} text-uppercase{% endif %}">
											<a href="{{ article.url }}" class="article-link">
												{{- article.title | escape -}}
											</a>
										</h2>
									{%- endif -%}
								</div>

								<div class="article-info">
									{%- if section.settings.show_date and layout == 'card-overlay' -%}
										<span class="article-date mitem">
											{{- article.published_at | time_tag: format: 'short_month_day_year' -}}
										</span>
									{%- endif -%}

									<div class= "card-bottom">
										<h2 class="article-title {{ heading_post_size }}{% if heading_upper %} text-uppercase{% endif %}">
											<a href="{{ article.url }}">
												{{- article.title | escape -}}
											</a>
										</h2>

										<div class="article-meta{% if post_meta_upper %} text-uppercase{% endif %}">
											{%- if section.settings.show_author -%}
												<span class="mitem">
													{%- if layout == 'card-column' -%}<span class="article-author">{{ 'blogs.article.by' | t }} </span>{%- endif -%}{{- article.author -}}
												</span>

												{%- render 'icon', code: 'spikes' -%}
											{%- endif -%}

											{%- if section.settings.show_date and layout == 'card-column' -%}
												<span class="article-date mitem">
													{{- article.published_at | time_tag: format: 'short_month_day_year' -}}
												</span>

												{%- render 'icon', code: 'spikes' -%}
											{%- endif -%}

											{%- if section.settings.show_blog -%}
												<span class="mitem">
													<a href="{{ blog.url }}" class="article-blog">
														{{- blog.title | escape -}}
													</a>
												</span>

												{%- render 'icon', code: 'spikes' -%}
											{%- endif -%}

											{%- if section.settings.show_comment and blog.comments_enabled? -%}
												<a class="aritcle-comment" href="{{ article.comment_post_url }}">{{ 'blogs.article.comments' | t: count: article.comments_count }}</a>
											{%- endif -%}
										</div>

										{%- if section.settings.read_more != blank and layout == 'card-column' -%}
											<a class="link-underline read-more" href="{{ article.url }}">{{- section.settings.read_more -}}</a>
										{%- endif -%}
									</div>
								</div>
							</article>
						</div>
					{%- else -%}
						{%- for i in (1..total) -%}
							<div class="swiper-slide" data-{{ forloop.index0 }}>
								<article class="article-card">
									<div class="article-media-wrap">
										<div class="article-image {{ section.settings.image_ratio }}-media">
											{%- render 'icon', code: 'placeholder' -%}
										</div>
									</div>

									<div class="article-info">
										{%- if layout == 'card-overlay' -%}
											<span class="article-date mitem">{{- 'onboarding.blogs.date' | t -}}</span>
										{%- endif -%}

										<div class= "card-bottom">
											<h2 class="date article-title h6{% if heading_upper %} text-uppercase{% endif %}">
												{{- 'onboarding.blogs.title' | t -}}
											</h2>
											<span class="article-meta{% if post_meta_upper %} text-uppercase{% endif %}">
												<span class="mitem">{{- 'onboarding.blogs.cate' | t -}}</span>
												{%- render 'icon', code: 'spikes' -%}
												{%- if layout == 'card-column' -%}
													<span class="mitem">{{- 'onboarding.blogs.date' | t -}}</span>
													{%- render 'icon', code: 'spikes' -%}
												{%- endif -%}
												<span class="mitem">{{- 'blogs.article.comments' | t: count: 0 -}}</span>
											</span>
										</div>
									</div>
								</article>
							</div>
						{%- endfor -%}
					{%- endfor -%}
				</div>
			</div>

			{%- if show_arrows or show_dots -%}
				<div class="swiper-controls">
					{%- if show_arrows -%}
						<button class="swiper-button-prev" title ="{{ 'general.swipper.prev' | t }}" aria-label="{{ 'general.swipper.prev' | t }}" id="{{ 'general.swipper.prev' | t }}" aria-labelledby="{{ 'general.swipper.prev' | t }}">{%- render 'icon', code: 'arrow-left-slider' -%}</button>
					{%- endif -%}

					{%- if show_dots -%}
						<div class="swiper-pagination" tabindex="-1"></div>
					{%- endif -%}

					{%- if show_arrows -%}
						<button class="swiper-button-next" title ="{{ 'general.swipper.next' | t }}" aria-label="{{ 'general.swipper.next' | t }}" id="{{ 'general.swipper.next' | t }}" aria-labelledby="{{ 'general.swipper.next' | t }}">{%- render 'icon', code: 'arrow-right-slider' -%}</button>
					{%- endif -%}
				</div>
			{%- endif -%}
		</div>
	</div>
</div>

{% schema %}
{
	"name": "t:sections.featured-blog-slider.name",
	"tag": "section",
	"class": "featured-blog-slider-section",
	"disabled_on": {
		"groups": ["header", "footer"]
	},
	"settings": [
		{
			"type": "checkbox",
			"id": "full",
			"default": false,
			"label": "t:general.layout.full.label"
		},
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"label": "t:settings_schema.colors.label",
			"default": "scheme-1"
		},
		{
			"type": "blog",
			"id": "blog",
			"label": "t:sections.featured-blog.settings.blog.label"
		},
		{
			"type": "select",
			"id": "layout",
			"options": [
				{
					"value": "card-column",
					"label": "t:sections.featured-blog-slider.settings.layout.option_1.label"
				},
				{
					"value": "card-overlay",
					"label": "t:sections.featured-blog-slider.settings.layout.option_2.label"
				}
			],
			"default": "card-column",
			"label": "t:sections.featured-blog-slider.settings.layout.label"
		},
		{
			"type": "header",
			"content": "t:general.typography.heading.label"
		},
		{
			"type": "inline_richtext",
			"id": "heading_text",
			"default": "Heading",
			"label": "t:general.typography.heading.label"
		},
		{
			"type": "select",
			"id": "heading_size",
			"options": [
				{
					"value": "h4",
					"label": "t:general.typography.heading_size.option_1.label"
				},
				{
					"value": "h3",
					"label": "t:general.typography.heading_size.option_2.label"
				},
				{
					"value": "h2",
					"label": "t:general.typography.heading_size.option_3.label"
				}
			],
			"default": "h3",
			"label": "t:general.typography.heading_size.label"
		},
		{
			"type": "text",
			"id": "button_text",
			"default": "Button label",
			"label": "t:general.typography.button_text.label"
		},
		{
			"type": "header",
			"content": "t:sections.featured-blog.settings.card.content"
		},
		{
			"type": "color_scheme",
			"id": "post_color_scheme",
			"label": "t:settings_schema.colors.label",
			"default": "scheme-1"
		},
		{
			"type": "select",
			"id": "image_ratio",
			"options": [
				{
					"value": "adapt",
					"label": "t:general.image.ratio.option_1.label"
				},
				{
					"value": "portrait",
					"label": "t:general.image.ratio.option_2.label"
				},
				{
					"value": "square",
					"label": "t:general.image.ratio.option_3.label"
				}
			],
			"default": "adapt",
			"label": "t:general.image.ratio.label"
		},
		{
			"type": "select",
			"id": "heading_post_size",
			"options": [
				{
					"value": "h5",
					"label": "t:general.typography.heading_size.option_1.label"
				},
				{
					"value": "h4",
					"label": "t:general.typography.heading_size.option_2.label"
				},
				{
					"value": "h3",
					"label": "t:general.typography.heading_size.option_3.label"
				}
			],
			"default": "h4",
			"label": "t:general.typography.heading_size.label"
		},
		{
			"type": "checkbox",
			"id": "heading_upper",
			"default": false,
			"label": "t:sections.featured-blog.settings.heading_upper.label"
		},
		{
			"type": "checkbox",
			"id": "post_meta_upper",
			"default": false,
			"label": "t:sections.featured-blog.settings.post_meta_upper.label"
		},
		{
			"type": "checkbox",
			"id": "post_padding",
			"default": false,
			"label": "t:sections.main-blog.settings.post_padding.label"
		},
		{
			"type": "text",
			"id": "read_more",
			"default": "Continue Reading",
			"label": "t:sections.featured-blog.settings.read_more.label"
		},
		{
			"type": "header",
			"content": "t:sections.featured-blog-slider.settings.header_content.content"
		},
		{
			"type": "checkbox",
			"id": "show_author",
			"default": true,
			"label": "t:sections.featured-blog-slider.settings.show_author.label"
		},
		{
			"type": "checkbox",
			"id": "show_date",
			"default": true,
			"label": "t:sections.featured-blog-slider.settings.show_date.label"
		},
		{
			"type": "checkbox",
			"id": "show_blog",
			"default": false,
			"label": "t:sections.featured-blog-slider.settings.show_blog.label"
		},
		{
			"type": "checkbox",
			"id": "show_comment",
			"default": true,
			"label": "t:sections.featured-blog-slider.settings.show_comment.label"
		},
		{
			"type": "header",
			"content": "t:general.slider.options.label"
		},
		{
			"type": "checkbox",
			"id": "show_arrows",
			"default": true,
			"label": "t:general.slider.show_arrows.label"
		},
		{
			"type": "checkbox",
			"id": "show_dots",
			"default": true,
			"label": "t:general.slider.show_dots.label"
		},
		{
			"type": "checkbox",
			"id": "loop",
			"default": false,
			"label": "t:general.slider.loop.label"
		},
		{
			"type": "checkbox",
			"id": "autoplay",
			"default": false,
			"label": "t:general.slider.autoplay.label"
		},
		{
			"type": "range",
			"id": "delay",
			"min": 3,
			"max": 20,
			"step": 1,
			"default": 5,
			"label": "t:general.slider.delay.label"
		},
		{
			"type": "range",
			"id": "column",
			"min": 1,
			"max": 6,
			"step": 1,
			"default": 3,
			"label": "t:general.slider.column.label"
		},
		{
			"type": "range",
			"id": "column_gap",
			"min": 0,
			"max": 50,
			"step": 1,
			"default": 30,
			"unit": "px",
			"label": "t:general.slider.column_gap.label"
		},
		{
			"type": "range",
			"id": "total",
			"min": 1,
			"max": 20,
			"step": 1,
			"default": 10,
			"label": "t:general.slider.total.label"
		},
		{
			"type": "header",
			"content": "t:general.padding.header_padding.content"
		},
		{
			"type": "range",
			"id": "padding_top",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 50,
			"unit": "px",
			"label": "t:general.padding.top.label"
		},
		{
			"type": "range",
			"id": "padding_bottom",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 50,
			"unit": "px",
			"label": "t:general.padding.bottom.label"
		},
		{
			"type": "paragraph",
			"content": "t:general.padding.paragraph_mobile.content"
		},
		{
			"type": "range",
			"id": "padding_top_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 20,
			"unit": "px",
			"label": "t:general.padding.top.label"
		},
		{
			"type": "range",
			"id": "padding_bottom_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 20,
			"unit": "px",
			"label": "t:general.padding.bottom.label"
		}
	],
	"presets": [
		{
			"name": "t:sections.featured-blog-slider.name"
		}
	]
}
{% endschema %}
