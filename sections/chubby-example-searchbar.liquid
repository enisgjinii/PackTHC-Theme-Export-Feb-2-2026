  /* Layout changes for mobile */
  .layout-sidebar {
    flex-direction: column;
    gap: 0;
  }
  
  /* Mobile sidebar */
  .collections-sidebar {
    position: fixed;
    top: 0;
    left: -300px;
    width: 300px;
    height: 100vh;
    z-index: 999;
    border-radius: 0;
    overflow-y: auto;
    padding: 60px 24px 24px;
    box-shadow: 2px 0 10px rgba(0,0,0,0.15);
