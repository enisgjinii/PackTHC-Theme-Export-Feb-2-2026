  }
}

  @media (max-width: 320px) {
    .collections-sidebar {
      width: 280px;
      left: -280px;
    }
    
    .products-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 6px;
    }
    
    .product-image {
      height: 120px;
    }
    
    .product-info {
      padding: 8px;
    }
    
    .product-title {
      font-size: 0.85rem;
      line-height: 1.2;
      margin-bottom: 4px;
    }
    
    .product-price {
      font-size: 0.9rem;
    }
    
    .section-title {
      font-size: 1.8rem;
    }
    
    .collection-navigator {
      padding: 20px 10px;
    }
  }
</style>

<section class="collection-navigator">
  <div class="section-header">
    <h2 class="section-title">{{ section.settings.title }}</h2>
  </div>



  <!-- Add this search bar -->
  <div class="search-container">
    <input type="text" class="search-bar" id="collectionSearch" placeholder="{{ section.settings.search_placeholder }}">
    <div class="search-icon" id="searchIcon">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
    </div>
  </div>

  <div class="layout-{{ section.settings.layout_style }}">
    {% if section.settings.layout_style == 'sidebar' %}
      <!-- Mobile Menu Button -->
      <button class="mobile-menu-btn" id="mobileMenuBtn">
        <div class="hamburger-icon">
          <span></span>
          <span></span>
          <span></span>
        </div>
        <span>Collections</span>
      </button>
      
      <!-- Mobile Overlay -->
      <div class="mobile-overlay" id="mobileOverlay"></div>
      
      <div class="collections-sidebar" id="collectionsSidebar">
        <h3>Collections</h3>
        <div class="collection-list">
          {% for block in section.blocks %}
            {% assign collection = collections[block.settings.collection] %}
            {% if collection %}
              <div class="collection-item" data-collection-handle="{{ collection.handle }}">
                {{ collection.title }}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    {% else %}
      <div class="collections-tabs">
        {% for block in section.blocks %}
          {% assign collection = collections[block.settings.collection] %}
          {% if collection %}
            <div class="collection-item" data-collection-handle="{{ collection.handle }}">
              {{ collection.title }}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
    
    <div class="products-container">
      <div class="products-grid" id="productsGrid">
        {% if section.blocks.size > 0 %}
          <div class="no-products">
            <h3>Select a collection to explore products</h3>
            <p>Choose from our carefully curated collections above</p>
          </div>
        {% else %}
          <div class="no-products">
            <h3>No collections added yet</h3>
            <p>Please add collections in the section settings</p>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<script>
(function() {
  'use strict';
  
  let isMenuOpen = false;
  let currentProducts = []; // Store current products for search functionality
  
  // Wait for DOM to be ready
  document.addEventListener('DOMContentLoaded', function() {
    initializeCollectionNavigator();
  });
  
  function initializeCollectionNavigator() {
    // Initialize mobile menu
    setupMobileMenu();
    
    // Initialize collection items
    setupCollectionItems();
    
    // Initialize search functionality
    setupSearch();
    
    // Load first collection automatically
    loadFirstCollection();
  }
  
  function setupMobileMenu() {
    const menuBtn = document.getElementById('mobileMenuBtn');
    const overlay = document.getElementById('mobileOverlay');
    
    if (menuBtn) {
      menuBtn.addEventListener('click', toggleMobileMenu);
    }
    
    if (overlay) {
      overlay.addEventListener('click', closeMobileMenu);
    }
    
    // Handle window resize
    window.addEventListener('resize', function() {
      if (window.innerWidth > 768 && isMenuOpen) {
        closeMobileMenu();
      }
    });
  }
  
  function setupCollectionItems() {
    const collectionItems = document.querySelectorAll('.collection-item');
    
    collectionItems.forEach(function(item) {
      item.addEventListener('click', function() {
        const handle = this.getAttribute('data-collection-handle');
        if (handle) {
          showCollectionProducts(handle, this);
        }
      });
    });
  }
  
  function setupSearch() {
    const searchInput = document.getElementById('collectionSearch');
    const searchIcon = document.getElementById('searchIcon');
    
    if (searchInput) {
      // Search on input change with debounce
      let searchTimeout;
      searchInput.addEventListener('input', function() {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(() => {
          filterProducts(this.value.trim().toLowerCase());
        }, 300);
      });
      
      // Also search when clicking the search icon
      if (searchIcon) {
        searchIcon.addEventListener('click', function() {
          filterProducts(searchInput.value.trim().toLowerCase());
        });
      }
      
      // Search on enter key
      searchInput.addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
          filterProducts(this.value.trim().toLowerCase());
        }
      });
    }
  }
  
  function loadFirstCollection() {
    const firstCollection = document.querySelector('.collection-item');
    if (firstCollection) {
      const handle = firstCollection.getAttribute('data-collection-handle');
      if (handle) {
        showCollectionProducts(handle, firstCollection);
      }
    }
  }
  
  function toggleMobileMenu() {
    if (isMenuOpen) {
      closeMobileMenu();
    } else {
      openMobileMenu();
    }
  }
  
  function openMobileMenu() {
    const sidebar = document.getElementById('collectionsSidebar');
    const overlay = document.getElementById('mobileOverlay');
    const menuBtn = document.getElementById('mobileMenuBtn');
    
    if (sidebar && overlay && menuBtn) {
      sidebar.classList.add('mobile-open');
      overlay.classList.add('active');
      menuBtn.classList.add('active');
      document.body.style.overflow = 'hidden';
      isMenuOpen = true;
    }
  }
  
  function closeMobileMenu() {
    const sidebar = document.getElementById('collectionsSidebar');
    const overlay = document.getElementById('mobileOverlay');
    const menuBtn = document.getElementById('mobileMenuBtn');
    
    if (sidebar && overlay && menuBtn) {
      sidebar.classList.remove('mobile-open');
      overlay.classList.remove('active');
      menuBtn.classList.remove('active');
      document.body.style.overflow = '';
      isMenuOpen = false;
    }
  }

  function showCollectionProducts(collectionHandle, clickedElement) {
    // Update active collection
    document.querySelectorAll('.collection-item').forEach(function(item) {
      item.classList.remove('active');
    });
    clickedElement.classList.add('active');
    
    // Close mobile menu if open
    if (isMenuOpen && window.innerWidth <= 768) {
      setTimeout(function() {
        closeMobileMenu();
      }, 200);
    }
    
    // Clear search input when changing collections
    const searchInput = document.getElementById('collectionSearch');
    if (searchInput) {
      searchInput.value = '';
    }
    
    // Show loading state
    const productsGrid = document.getElementById('productsGrid');
    if (productsGrid) {
      productsGrid.innerHTML = '\
        <div class="loading-state">\
          <div class="loading-spinner"></div>\
          <p>Loading products...</p>\
        </div>';
    }
    
    // Fetch collection products
    fetch('/collections/' + collectionHandle + '/products.json')
      .then(function(response) {
        return response.json();
      })
      .then(function(data) {
        if (data.products && data.products.length > 0) {
          currentProducts = data.products; // Store products for search
          renderProducts(data.products);
        } else {
          showNoProducts('No products found', 'This collection doesn\'t contain any products yet');
        }
      })
      .catch(function(error) {
        console.error('Error loading products:', error);
        showNoProducts('Error loading products', 'Please try again later');
      });
  }

  function renderProducts(products) {
    const productsGrid = document.getElementById('productsGrid');
    const showPrice = {{ section.settings.show_product_price | json }};
    
    if (!productsGrid) return;
    
    let html = '';
    
    products.forEach(function(product) {
      const featuredImage = product.images && product.images[0] ? product.images[0] : {
        src: 'https://via.placeholder.com/400x400/f8f9fa/666?text=No+Image',
        alt: 'No image available'
      };
      
      // Format price
      const price = formatPrice(product.price);
      const compareAtPrice = product.compare_at_price ? formatPrice(product.compare_at_price) : null;
      
      html += '\
        <a href="/products/' + product.handle + '" class="product-card">\
          <div class="product-image">\
            <img src="' + featuredImage.src + '" alt="' + (product.title || '') + '" loading="lazy">\
          </div>\
          <div class="product-info">\
            <h4 class="product-title">' + (product.title || '') + '</h4>';
      
      if (showPrice) {
        html += '<div class="product-price">';
        if (compareAtPrice) {
          html += '<span class="compare-price">' + compareAtPrice + '</span>';
        }
        html += price + '</div>';
      }
      
      html += '\
          </div>\
        </a>';
    });
    
    productsGrid.innerHTML = html || showNoProducts('No products found', 'This collection is currently empty');
  }
  
  function filterProducts(searchTerm) {
    const productsGrid = document.getElementById('productsGrid');
    const productCards = productsGrid.querySelectorAll('.product-card');
    let hasMatches = false;
    
    if (!searchTerm) {
      // Show all products if search is empty
      productCards.forEach(card => card.style.display = '');
      
      // Remove no results message if exists
      const noResults = productsGrid.querySelector('.no-results');
      if (noResults) {
        noResults.remove();
      }
      return;
    }
    
    // Filter through current products
    const filteredProducts = currentProducts.filter(product => {
      return product.title.toLowerCase().includes(searchTerm);
    });
    
    if (filteredProducts.length > 0) {
      // Re-render only matching products
      renderProducts(filteredProducts);
      hasMatches = true;
    } else {
      // Show no results message
      showNoProducts('No products found', 'Try a different search term');
    }
  }
  
  function formatPrice(priceInCents) {
    if (!priceInCents) return '';
    
    const price = priceInCents / 100;
    return '₹' + price.toLocaleString('en-IN', {
      minimumFractionDigits: 0,
      maximumFractionDigits: 2
    });
  }
  
  function showNoProducts(title, message) {
    const productsGrid = document.getElementById('productsGrid');
    if (productsGrid) {
      // First remove any existing no-products message
      const existingMessage = productsGrid.querySelector('.no-products');
      if (existingMessage) {
        existingMessage.remove();
      }
      
      // Add new message
      const noProductsDiv = document.createElement('div');
      noProductsDiv.className = 'no-products';
      if (document.getElementById('collectionSearch').value) {
        noProductsDiv.classList.add('no-results');
      }
      noProductsDiv.innerHTML = '\
        <h3>' + title + '</h3>\
        <p>' + message + '</p>';
      productsGrid.appendChild(noProductsDiv);
    }
  }
  
})();
</script>