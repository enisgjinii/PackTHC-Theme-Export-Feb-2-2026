{% comment %}
  Section: Top USA Marijuana Seeds Collection
  Usage: Add this file to sections folder as 'top-usa-collection.liquid'
{% endcomment %}

<style>
  #shopify-section-{{ section.id }} {
    padding: 60px 0;
    background-color: {{ section.settings.background_color }};
  }

  #shopify-section-{{ section.id }} .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  #shopify-section-{{ section.id }} .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
  }

  #shopify-section-{{ section.id }} .section-title {
    font-size: 32px;
    font-weight: 700;
    color: {{ section.settings.title_color }};
    margin: 0;
  }

  #shopify-section-{{ section.id }} .view-all-link {
    font-size: 14px;
    font-weight: 500;
    color: {{ section.settings.link_color }};
    text-decoration: underline;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    transition: opacity 0.3s ease;
  }

  #shopify-section-{{ section.id }} .view-all-link:hover {
    opacity: 0.7;
  }

  #shopify-section-{{ section.id }} .view-all-link:after {
    content: "›";
    font-size: 18px;
  }

  #shopify-section-{{ section.id }} .collection-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  #shopify-section-{{ section.id }} .collection-card {
    position: relative;
    height: 200px;
    border-radius: 8px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    display: block;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  #shopify-section-{{ section.id }} .collection-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 16px rgba(0,0,0,0.2);
  }

  #shopify-section-{{ section.id }} .collection-card-image {
    width: 100%;
    height: 100%;
    position: relative;
  }

  #shopify-section-{{ section.id }} .collection-card-image:before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(to bottom, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0.7) 100%);
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .collection-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  #shopify-section-{{ section.id }} .collection-card:hover .collection-card-image img {
    transform: scale(1.05);
  }

  #shopify-section-{{ section.id }} .collection-card-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 20px;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .collection-info {
    flex: 1;
  }

  #shopify-section-{{ section.id }} .collection-title {
    font-size: 18px;
    font-weight: 600;
    color: {{ section.settings.card_title_color }};
    margin: 0 0 2px 0;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .collection-count {
    font-size: 14px;
    color: {{ section.settings.card_count_color }};
    opacity: 0.9;
  }

  #shopify-section-{{ section.id }} .collection-arrow {
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ section.settings.card_arrow_color }};
    font-size: 24px;
    line-height: 1;
    transition: transform 0.3s ease;
  }

  #shopify-section-{{ section.id }} .collection-card:hover .collection-arrow {
    transform: translateX(3px);
  }

  @media (max-width: 1024px) {
    #shopify-section-{{ section.id }} .collection-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding: 40px 0;
    }

    #shopify-section-{{ section.id }} .section-title {
      font-size: 24px;
    }

    #shopify-section-{{ section.id }} .collection-grid {
      grid-template-columns: 1fr;
      gap: 15px;
    }

    #shopify-section-{{ section.id }} .collection-card {
      height: 180px;
    }
  }
</style>

<div class="container">
  <div class="section-header">
    {% if section.settings.title != blank %}
      <h2 class="section-title">{{ section.settings.title }}</h2>
    {% endif %}
    {% if section.settings.view_all_text != blank and section.settings.view_all_link != blank %}
      <a href="{{ section.settings.view_all_link }}" class="view-all-link">
        {{ section.settings.view_all_text }}
      </a>
    {% endif %}
  </div>

  <div class="collection-grid">
    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        <a href="{{ block.settings.link }}" class="collection-card" {{ block.shopify_attributes }}>
          <div class="collection-card-image">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 600 | image_tag: alt: block.settings.title, loading: 'lazy' }}
            {% else %}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
          </div>
          <div class="collection-card-content">
            <div class="collection-info">
              {% if block.settings.title != blank %}
                <div class="collection-title">{{ block.settings.title }}</div>
              {% endif %}
              {% if block.settings.count != blank %}
                <div class="collection-count">{{ block.settings.count }}</div>
              {% endif %}
            </div>
            <div class="collection-arrow">›</div>
          </div>
        </a>
      {% endfor %}
    {% else %}
      {% comment %} Default placeholder cards {% endcomment %}
      {% assign default_collections = "USA Premium|69,High THC|29,Fast Flowering|24,Sativa Seeds|41" | split: ',' %}
      {% for collection in default_collections %}
        {% assign col_parts = collection | split: '|' %}
        <div class="collection-card">
          <div class="collection-card-image">
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
          <div class="collection-card-content">
            <div class="collection-info">
              <div class="collection-title">{{ col_parts[0] }}</div>
              <div class="collection-count">{{ col_parts[1] }}</div>
            </div>
            <div class="collection-arrow">›</div>
          </div>
        </div>
      {% endfor %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Top USA Collection",
  "tag": "section",
  "class": "top-usa-collection-section",
  "settings": [
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Top USA Marijuana Seeds Collection"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All Text",
      "default": "All weed seed collection"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#f5f0e8"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "View All Link Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "card_title_color",
      "label": "Card Title Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_count_color",
      "label": "Card Count Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_arrow_color",
      "label": "Card Arrow Color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Collection Image",
          "info": "Recommended: 600x400px"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Collection Title",
          "default": "USA Premium"
        },
        {
          "type": "text",
          "id": "count",
          "label": "Product Count",
          "default": "69",
          "info": "Number of products in collection"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Collection Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Top USA Collection",
      "blocks": [
        {
          "type": "collection",
          "settings": {
            "title": "USA Premium",
            "count": "69"
          }
        },
        {
          "type": "collection",
          "settings": {
            "title": "High THC",
            "count": "29"
          }
        },
        {
          "type": "collection",
          "settings": {
            "title": "Fast Flowering",
            "count": "24"
          }
        },
        {
          "type": "collection",
          "settings": {
            "title": "Sativa Seeds",
            "count": "41"
          }
        }
      ]
    }
  ]
}
{% endschema %}