<style>
      .cannabis-page { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
      .hero-slider { position: relative; overflow: hidden; }
      .hero-track { display: flex; transition: transform 0.5s ease; }
      .hero-slide { min-width: 100%; position: relative; min-height: 500px; }
      .hero-content { position: absolute; top: 50%; left: 5%; transform: translateY(-50%); z-index: 2; max-width: 600px; }
      .hero-slide h1 { font-size: 4rem; font-weight: 900; color: white; margin: 0; line-height: 1.1; text-transform: uppercase; }
      .hero-slide p { color: white; font-size: 1.1rem; margin: 20px 0; }
      .hero-badge { color: #ff8c42; font-size: 1.5rem; font-weight: 600; text-transform: uppercase; margin-bottom: 15px }
      .btn { display: inline-flex; align-items: center; gap: 10px; padding: 15px 30px; background: #ff8c42; color: white; text-decoration: none; border-radius: 50px; font-weight: 600; transition: 0.3s; }
      .btn:hover { transform: translateX(5px); }
      .slider-dots { position: absolute; bottom: 100px; left: 50%; transform: translateX(-50%); display: flex; gap: 10px; z-index: 3; }
      .dot { width: 12px; height: 12px; border-radius: 50%; background: rgba(255,255,255,0.5); cursor: pointer; transition: 0.3s; }
      .dot.active { background: #ff8c42; width: 30px; border-radius: 6px; }

      .services { padding: 80px 5%; background: white; }
      .section-title { text-align: center; margin-bottom: 60px; }
      .section-badge { color: #ff8c42; font-size: 1.3rem; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; }
      .section-title h2 { font-size: 2.5rem; font-weight: 900; margin: 0px 0; }
      .services-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 30px; max-width: 1200px; margin: 0 auto; }
      .service-card { border: 2px solid black; border-radius: 20px; padding: 20px; text-align: center; text-decoration: none; color: inherit; display: block; transition: 0.3s; }
      .service-card:hover { transform: translateY(-5px); }
      .service-card img { width: 100%; height: 200px; object-fit: cover; border-radius: 15px; margin-bottom: 20px; }
      .service-card h3 { font-size: 1.3rem; font-weight: 800; text-transform: uppercase; }


      .about { padding: 80px 5%; background: #fff9f5; }
      .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; max-width: 1200px; margin: 0 auto; align-items: center; }
      .about h2 { font-size: 2.5rem; font-weight: 900; margin: 10px 0 20px; }
      .about p { color: #666; line-height: 1.8; margin-bottom: 30px; }
      .features { background: white; border: 2px solid black; border-radius: 20px; padding: 30px; margin-bottom: 30px; }
      .features-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
      .feature-item { display: flex; align-items: center; gap: 10px; }
      .feature-item::before { content: '✓'; color: #ff8c42; font-weight: bold; font-size: 1.2rem; }
      .experience-badge { background: white; border: 2px solid black; border-radius: 50px; padding: 15px 30px; display: inline-block; font-weight: 700; }
      .experience-badge span { color: #ff8c42; font-size: 2rem; }

      .process { padding: 80px 5%; background: white; }
      .process-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; max-width: 1200px; margin: 0 auto; }
      .process h2 { font-size: 2.5rem; font-weight: 900; margin: 10px 0 20px; }
      .process-steps { display: flex; flex-direction: column; gap: 20px; }
      .process-step { background: white; border: 2px solid black; border-radius: 20px; padding: 30px; cursor: pointer; transition: 0.3s; position: relative; overflow: hidden; }
      .process-step:hover { transform: translateY(-5px); box-shadow: 0 10px 30px rgba(0,0,0,0.1); }
      .process-step h3 { font-size: 1.5rem; font-weight: 800; margin-bottom: 15px; display: flex; align-items: center; gap: 10px; }
      .process-step h3::before { content: attr(data-number) ' '; color: #ff8c42; }
      .step-toggle { margin-left: auto; font-size: 1.2rem; transition: 0.3s; }
      .process-step.active .step-toggle { transform: rotate(180deg); }
      .step-preview { color: #666; line-height: 1.6; }
      .step-image { max-height: 0; overflow: hidden; transition: max-height 0.4s ease; border-radius: 15px; margin-top: 0; }
      .step-image img { width: 100%; border-radius: 15px; display: block; }
      .process-step.active .step-image { max-height: 400px; margin-top: 20px; }

      .process-cards { padding: 80px 5%; background: #1a1a1a; }
    .process-cards h2 { text-align: center; color: white; font-size: 2.5rem; font-weight: 900; margin-bottom: 60px; }
    .process-cards .section-badge { text-align: center; margin-bottom: 20px; }
    .cards-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px; max-width: 1200px; margin: 0 auto; }
    .process-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 20px; padding: 40px 30px; transition: 0.3s; }
    .process-card:hover { background: rgba(255,255,255,0.08); transform: translateY(-5px); }
    .card-number { width: 50px; height: 50px; border: 2px solid #ff8c42; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #ff8c42; font-size: 1.5rem; font-weight: 700; margin-bottom: 25px; }
    .process-card h3 { color: #ff8c42; font-size: 1.3rem; font-weight: 800; margin-bottom: 15px; }
    .process-card p { color: #ccc; line-height: 1.7; }

    @media (max-width: 768px) {
      .cards-grid { grid-template-columns: 1fr; }
    }

      .testimonials { padding: 80px 5%; background: #fff9f5; }
      .testimonial-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; max-width: 1200px; margin: 0 auto; align-items: center; }
      .testimonial-image-container { position: relative; min-height: 600px; }
      .testimonial-image { position: absolute; inset: 0; opacity: 0; transition: opacity 0.5s ease; border-radius: 20px; overflow: hidden; }
      .testimonial-image.active { opacity: 1; }
      .testimonial-image img { width: 100%; height: 100%; object-fit: cover; }
      .testimonial-placeholder { width: 100%; height: 100%; background: #ddd; border-radius: 20px; display: flex; align-items: center; justify-content: center; font-size: 3rem; color: #999; }
      .testimonial-content { background: white; border: 2px solid black; border-radius: 20px; padding: 40px; position: relative; }
      .testimonial-header { margin-bottom: 0px; }
      .stars { color: #ff8c42; font-size: 1.5rem; margin-bottom: 20px; }
      .testimonial-text { font-size: 2rem; line-height: 1.8; margin-bottom: 30px; min-height: 120px; }
      .author { display: flex; align-items: center; gap: 15px; margin-bottom: 30px; }
      .author-info h4 { margin: 0; font-weight: 700; }
      .author-info p { margin: 5px 0 0; color: #666; }
      .testimonial-nav { display: flex; gap: 15px; justify-content: flex-end; }
      .testimonial-btn { background: white; border: 2px solid black; width: 50px; height: 50px; border-radius: 50%; cursor: pointer; font-size: 1.2rem; transition: 0.3s; display: flex; align-items: center; justify-content: center; }
      .testimonial-btn:hover { background: #ff8c42; color: white; border-color: #ff8c42; }

      .cta { padding: 80px 5%; background: url('{{ section.settings.cta_bg_image | img_url: 'master' }}') center/cover; text-align: center; position: relative; }
      .cta::before { content: ''; position: absolute; inset: 0; background: rgba(51,51,51,0.85); }
      .cta h2 { color: white; font-size: 3rem; font-weight: 900; margin-bottom: 30px; position: relative; z-index: 1; }
      .cta .btn { position: relative; z-index: 1; }

      @media (max-width: 768px) {
        .hero-slide h1 { font-size: 2.5rem; }
        .about-grid, .process-grid, .testimonial-grid { grid-template-columns: 1fr; }
        .services-grid { grid-template-columns: 1fr; }
        .cta h2 { font-size: 2rem; }
      }

      /* ========== SERVICES TABS SYSTEM ========== */
      .services-tabs-container {
        display: flex;
        justify-content: center;
        margin-bottom: 50px;
        max-width: 1200px;
        margin-left: auto;
        margin-right: auto;
      }

      /* Desktop Tabs */
      .services-tabs-desktop {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        justify-content: center;
      }

      .tab-btn {
        background: white;
        border: 2px solid black;
        padding: 15px 30px;
        border-radius: 50px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        white-space: nowrap;
      }

      .tab-btn:hover {
        background: #ff8c42;
        color: white;
        border-color: #ff8c42;
      }

      .tab-btn.active {
        background: #ff8c42;
        color: white;
        border-color: #ff8c42;
      }

      /* Mobile Dropdown */
      .services-tabs-mobile {
        display: none;
        width: 100%;
        max-width: 300px;
      }

      .mobile-dropdown {
        position: relative;
        width: 100%;
      }

      .mobile-dropdown-btn {
        width: 100%;
        background: white;
        border: 2px solid black;
        padding: 15px 30px;
        border-radius: 50px;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .mobile-dropdown-menu {
        position: absolute;
        top: 100%;
        left: 0;
        width: 100%;
        background: white;
        border: 2px solid black;
        border-radius: 20px;
        margin-top: 10px;
        opacity: 0;
        visibility: hidden;
        transform: translateY(-10px);
        transition: all 0.3s ease;
        z-index: 100;
        max-height: 300px;
        overflow-y: auto;
      }

      .mobile-dropdown.open .mobile-dropdown-menu {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
      }

      .mobile-tab-item {
        padding: 15px 20px;
        cursor: pointer;
        transition: all 0.2s ease;
        border-bottom: 1px solid #eee;
      }

      .mobile-tab-item:last-child {
        border-bottom: none;
      }

      .mobile-tab-item:hover {
        background: #fff9f5;
      }

      .mobile-tab-item.active {
        background: #ff8c42;
        color: white;
      }

      /* Service Popup */
  /* ========== UPDATED SERVICE POPUP ========== */
  .service-popup {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.85);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    opacity: 0;
    visibility: hidden;
    transition: 0.3s;
    padding: 20px;
  }
  .service-popup.active {
    opacity: 1;
    visibility: visible;
  }
  .popup-content {
    background: white;
    border-radius: 30px;
    max-width: 1000px;
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    position: relative;
    transform: translateY(50px);
    transition: 0.4s;
  }
  .service-popup.active .popup-content {
    transform: translateY(0);
  }
  .popup-close {
    position: absolute;
    top: 20px;
    right: 20px;
    background: #ff8c42;
    border: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    color: white;
    font-size: 1.5rem;
    cursor: pointer;
    z-index: 10;
    transition: 0.3s;
  }
  .popup-close:hover {
    transform: rotate(90deg);
    background: #e67a2e;
  }

  /* Popup Image (850x400px) */
  .popup-image-container {
    width: 100%;
    height: 400px;
    position: relative;
    overflow: hidden;
    border-radius: 30px 30px 0 0;
  }
  .popup-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Popup Body */
  .popup-body {
    padding: 40px;
  }
  .popup-header {
    margin-bottom: 30px;
  }
  .popup-category {
    color: #ff8c42;
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
    margin-bottom: 10px;
    letter-spacing: 1px;
  }
  .popup-title {
    font-size: 2.5rem;
    font-weight: 900;
    margin-bottom: 20px;
    line-height: 1.2;
  }
  .popup-description {
    color: #666;
    line-height: 1.8;
    margin-bottom: 40px;
  }

  /* FAQs Section */
  .popup-faqs {
    margin: 40px 0;
  }
  .faqs-title {
    font-size: 1.5rem;
    font-weight: 800;
    margin-bottom: 20px;
    color: #333;
  }
  .faq-item {
    border-bottom: 1px solid #eee;
    margin-bottom: 15px;
    padding-bottom: 15px;
  }
  .faq-question {
    font-weight: 600;
    color: #333;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 0;
  }
  .faq-question::after {
    content: '+';
    font-size: 1.5rem;
    color: #ff8c42;
    transition: transform 0.3s;
  }
  .faq-item.active .faq-question::after {
    content: '−';
    transform: rotate(180deg);
  }
  .faq-answer {
    color: #666;
    line-height: 1.6;
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }
  .faq-item.active .faq-answer {
    max-height: 300px;
    padding-top: 10px;
  }

  /* Numbered Tabs Section */
  .popup-tabs-section {
    margin: 40px 0;
  }
  .tabs-title {
    font-size: 1.5rem;
    font-weight: 800;
    margin-bottom: 25px;
    color: #333;
  }
  .popup-tabs-container {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    margin-bottom: 30px;
  }
  .popup-tab-btn {
    background: white;
    border: 2px solid black;
    padding: 12px 25px;
    border-radius: 50px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    position: relative;
    padding-left: 45px;
  }
  .popup-tab-btn::before {
    content: attr(data-number);
    position: absolute;
    left: 15px;
    top: 50%;
    transform: translateY(-50%);
    width: 25px;
    height: 25px;
    background: #ff8c42;
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.9rem;
    font-weight: 700;
  }
  .popup-tab-btn:hover {
    background: #fff9f5;
  }
  .popup-tab-btn.active {
    background: #ff8c42;
    color: white;
    border-color: #ff8c42;
  }
  .popup-tab-btn.active::before {
    background: white;
    color: #ff8c42;
  }
  .tab-content {
    display: none;
    padding: 25px;
    background: #fff9f5;
    border-radius: 20px;
    border: 2px solid #eee;
  }
  .tab-content.active {
    display: block;
  }
  .tab-content h4 {
    font-size: 1.3rem;
    font-weight: 700;
    margin-bottom: 15px;
    color: #333;
  }
  .tab-content p {
    color: #666;
    line-height: 1.7;
  }

  /* Popup CTA Button */
  .popup-cta-container {
    text-align: center;
    margin-top: 40px;
    padding-top: 40px;
    border-top: 2px solid #eee;
  }
  .popup-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 18px 45px;
    background: #ff8c42;
    color: white;
    text-decoration: none;
    border-radius: 50px;
    font-weight: 600;
    transition: 0.3s;
    border: none;
    cursor: pointer;
  }
  .popup-cta:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 20px rgba(255, 140, 66, 0.3);
    background: #e67a2e;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .popup-content {
      max-width: 95%;
    }
    .popup-image-container {
      height: 300px;
    }
    .popup-body {
      padding: 25px;
    }
    .popup-title {
      font-size: 2rem;
    }
    .popup-tabs-container {
      justify-content: center;
    }
    .popup-tab-btn {
      padding: 10px 20px;
      padding-left: 40px;
    }
  }

      /* Service Item */
      .service-item { cursor: pointer; }
      .service-item.hidden { display: none; }

      /* ========== H2 FIXES ========== */
      .cannabis-page h2,
      .cannabis-page .section-title h2,
      .cannabis-page .about h2,
      .cannabis-page .process h2,
      .cannabis-page .process-cards h2,
      .cannabis-page .testimonials .testimonial-header h2,
      .cannabis-page .cta h2 {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif !important;
        font-weight: 900 !important;
        margin: 10px 0 20px !important;
        line-height: 1.2 !important;
      }

      /* Specific section fixes to prevent theme interference */
      .cannabis-page .section-title h2 {
        font-size: 2.5rem !important;
        text-align: center !important;
      }

      .cannabis-page .about h2 {
        font-size: 2.5rem !important;
      }

      .cannabis-page .process h2 {
        font-size: 2.5rem !important;
      }

      .cannabis-page .process-cards h2 {
        font-size: 2.5rem !important;
        color: white !important;
        text-align: center !important;
      }

      .cannabis-page .testimonials .testimonial-header h2 {
        font-size: 2.5rem !important;
      }

      .cannabis-page .cta h2 {
        font-size: 3rem !important;
        color: white !important;
        text-align: center !important;
      }

      /* Process Steps Number Fix */
      .cannabis-page .process-step h3::before {
        content: attr(data-number) ' ' !important;
        color: #ff8c42 !important;
      }

      .cannabis-page .process-card .card-number {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif !important;
        counter-increment: process-card !important;
      }

      /* Reset counter for process cards */
      .cannabis-page .process-cards .cards-grid {
        counter-reset: process-card 0 !important;
      }

      .cannabis-page .process-cards .card-number::before {
        content: counter(process-card) !important;
      }

      /* Responsive */
      @media (max-width: 992px) {
        .services-tabs-desktop {
          display: none;
        }

        .services-tabs-mobile {
          display: block;
        }
      }

      @media (max-width: 768px) {
        .services-tabs-container {
          padding: 0 20px;
        }
      }
</style>

<div class="cannabis-page">
  <!-- Hero Slider -->
  <section class="hero-slider">
    <div class="hero-track" id="heroTrack">
      {% for block in section.blocks %}
        {% if block.type == 'hero_slide' %}
          <div
            class="hero-slide"
            style="background: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), url('{{ block.settings.image | img_url: 'master' }}') center/cover;"
          >
            <div class="hero-content">
              <div class="hero-badge">{{ block.settings.badge }}</div>
              <h1>{{ block.settings.title }}</h1>
              <p>{{ block.settings.text }}</p>
              <a href="{{ block.settings.button_link }}" class="btn">
                {{ block.settings.button_text }}
                <span>→</span>
              </a>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
    <div class="slider-dots" id="sliderDots"></div>
  </section>

  <!-- Services Section -->
  <section class="services">
    <div class="section-title">
      <div class="section-badge">{{ section.settings.services_badge }}</div>
      <h2>{{ section.settings.services_title }}</h2>
    </div>

    <!-- Tabs for Desktop, Dropdown for Mobile -->
    <div class="services-tabs-container">
      <!-- Desktop Tabs -->
      <div class="services-tabs-desktop" id="desktopTabs">
        <button class="tab-btn active" onclick="filterServices('all', this, 'desktop')">All Services</button>
        {% for block in section.blocks %}
          {% if block.type == 'service_category' %}
            <button class="tab-btn" onclick="filterServices('{{ block.settings.category_id }}', this, 'desktop')">
              {{ block.settings.category_name }}
            </button>
          {% endif %}
        {% endfor %}
      </div>

      <!-- Mobile Dropdown -->
      <div class="services-tabs-mobile">
        <div class="mobile-dropdown" id="mobileDropdown">
          <button class="mobile-dropdown-btn" onclick="toggleMobileDropdown()">
            <span id="mobileTabText">All Services</span>
            <span class="filter-arrow">▼</span>
          </button>
          <div class="mobile-dropdown-menu">
            <div class="mobile-tab-item active" onclick="selectMobileTab('all', 'All Services')">All Services</div>
            {% for block in section.blocks %}
              {% if block.type == 'service_category' %}
                <div
                  class="mobile-tab-item"
                  onclick="selectMobileTab('{{ block.settings.category_id }}', '{{ block.settings.category_name }}')"
                >
                  {{ block.settings.category_name }}
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>
    </div>

    <!-- Services Grid -->
    <div class="services-grid services-dynamic-grid">
      {% for block in section.blocks %}
        {% if block.type == 'service' %}
          <a
            href="javascript:void(0)"
            class="service-card service-item"
            data-category="{{ block.settings.category }}"
            onclick="openServicePopup(this)"
            data-title="{{ block.settings.title }}"
            data-description="{{ block.settings.full_description }}"
            data-features="{{ block.settings.features }}"
            data-faqs="{{ block.settings.faqs }}"
            data-tabs="{{ block.settings.tabs }}"
            data-link="{{ block.settings.link }}"
            data-grid-image="{{ block.settings.image | img_url: '400x' }}"
            data-popup-image="{% if block.settings.popup_image %}{{ block.settings.popup_image | img_url: '850x400', crop: 'center' }}{% else %}{{ block.settings.image | img_url: '850x400', crop: 'center' }}{% endif %}"
          >
            <img
              src="{{ block.settings.image | img_url: '400x' }}"
              alt="{{ block.settings.title }}"
              class="service-image"
            >
            <div class="service-content">
              <h3 class="service-title">{{ block.settings.title }}</h3>
              <p class="service-preview">{{ block.settings.short_description }}</p>
            </div>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </section>

  <!-- Service Popup -->
  <!-- Service Popup -->
  <div class="service-popup" id="servicePopup" onclick="closePopupOnOutside(event)">
    <div class="popup-content" onclick="event.stopPropagation()">
      <button class="popup-close" onclick="closeServicePopup()">×</button>

      <!-- 850x400px Image -->
      <div class="popup-image-container">
        <img id="popupImage" class="popup-image" src="" alt="">
      </div>

      <div class="popup-body">
        <!-- Category and Title -->
        <div class="popup-header">
          <div class="popup-category" id="popupCategory"></div>
          <h2 class="popup-title" id="popupTitle"></h2>
          <p class="popup-description" id="popupDescription"></p>
        </div>

        <!-- Features/Highlights -->
        <div class="popup-features-section">
          <h3 class="faqs-title">Key Highlights</h3>
          <ul class="popup-features" id="popupFeatures"></ul>
        </div>

        <!-- FAQs Section -->
        <div class="popup-faqs" id="popupFaqs">
          <h3 class="faqs-title">Frequently Asked Questions</h3>
          <!-- FAQs will be populated by JavaScript -->
        </div>

        <!-- Numbered Tabs Section -->
        <div class="popup-tabs-section">
          <h3 class="tabs-title">Our Process</h3>
          <div class="popup-tabs-container" id="popupTabs">
            <!-- Tabs will be populated by JavaScript -->
          </div>
          <div class="tabs-content-container" id="tabsContent">
            <!-- Tab content will be populated by JavaScript -->
          </div>
        </div>

        <!-- CTA Button -->
        <div class="popup-cta-container">
          <button class="popup-cta" id="popupCtaBtn">
            Get Started Now
            <span>→</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- About Section -->
  <section class="about">
    <div class="about-grid">
      <div>
        <div class="section-badge">{{ section.settings.about_badge }}</div>
        <h2>{{ section.settings.about_title }}</h2>
        <p>{{ section.settings.about_text }}</p>
        <div class="features">
          <h3>{{ section.settings.features_title }}</h3>
          <div class="features-grid">
            <div class="feature-item">{{ section.settings.feature_1 }}</div>
            <div class="feature-item">{{ section.settings.feature_2 }}</div>
            <div class="feature-item">{{ section.settings.feature_3 }}</div>
            <div class="feature-item">{{ section.settings.feature_4 }}</div>
          </div>
        </div>
        <div class="experience-badge">
          <span>{{ section.settings.years }}+</span> Years Of Experience
        </div>
      </div>
      <div>
        <img
          src="{{ section.settings.about_image | img_url: 'master' }}"
          alt="Packaging"
          style="width: 100%; border-radius: 20px;"
        >
      </div>
    </div>
  </section>

  <!-- Process Cards Section -->
  <section class="process-cards">
    <div class="section-badge">{{ section.settings.cards_badge }}</div>
    <h2>{{ section.settings.cards_title }}</h2>
    <div class="cards-grid">
      {% for block in section.blocks %}
        {% if block.type == 'process_card' %}
          <div class="process-card">
            <div class="card-number"></div>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.description }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </section>

  <!-- Process Section -->
  <section class="process">
    <div class="process-grid">
      <div>
        <div class="section-badge">{{ section.settings.process_badge }}</div>
        <h2>{{ section.settings.process_title }}</h2>
        <p>{{ section.settings.process_text }}</p>
      </div>
      <div class="process-steps">
        {% comment %} Process steps counter reset {% endcomment %}
        {% assign step_counter = 1 %}

        {% for block in section.blocks %}
          {% if block.type == 'process_step' %}
            <div class="process-step" onclick="toggleStep(this)">
              <h3 data-number="{{ step_counter }}">
                {{ block.settings.title }}
                <span class="step-toggle">▼</span>
              </h3>
              <p class="step-preview">{{ block.settings.description }}</p>
              <div class="step-image">
                <img src="{{ block.settings.image | img_url: '600x' }}" alt="{{ block.settings.title }}">
              </div>
            </div>
            {% assign step_counter = step_counter | plus: 1 %}
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section class="testimonials">
    <div class="testimonial-grid">
      <div class="testimonial-image-container">
        {% for block in section.blocks %}
          {% if block.type == 'testimonial' %}
            <div
              class="testimonial-image {% if forloop.first %}active{% endif %}"
              data-testimonial="{{ forloop.index0 }}"
            >
              {% if block.settings.image %}
                <img src="{{ block.settings.image | img_url: '600x' }}" alt="{{ block.settings.name }}">
              {% else %}
                <div class="testimonial-placeholder">590x590</div>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
      <div>
        <div class="testimonial-header">
          <div class="section-badge">{{ section.settings.testimonial_badge }}</div>
          <h2>{{ section.settings.testimonial_title }}</h2>
        </div>
        <div class="testimonial-content">
          <div class="stars" id="testimonialStars">★★★★★</div>
          <p class="testimonial-text" id="testimonialText"></p>
          <div class="author">
            <div class="author-info">
              <h4 id="testimonialName"></h4>
              <p id="testimonialRole"></p>
            </div>
          </div>
          <div class="testimonial-nav">
            <button class="testimonial-btn" onclick="prevTestimonial()">←</button>
            <button class="testimonial-btn" onclick="nextTestimonial()">→</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta">
    <h2>{{ section.settings.cta_text }}</h2>
    <a href="{{ section.settings.cta_link }}" class="btn">
      {{- section.settings.cta_button }}
      <span>→</span></a
    >
  </section>
</div>

<script>
  // ========== HERO SLIDER ==========
  let currentSlide = 0;
  const track = document.getElementById('heroTrack');
  const slides = track.children.length;
  const dotsContainer = document.getElementById('sliderDots');

  for (let i = 0; i < slides; i++) {
    const dot = document.createElement('div');
    dot.className = 'dot' + (i === 0 ? ' active' : '');
    dot.onclick = () => goToSlide(i);
    dotsContainer.appendChild(dot);
  }

  function updateSlider() {
    track.style.transform = `translateX(-${currentSlide * 100}%)`;
    document.querySelectorAll('.dot').forEach((d, i) => {
      d.classList.toggle('active', i === currentSlide);
    });
  }

  function goToSlide(n) {
    currentSlide = n;
    updateSlider();
  }

  function autoSlide() {
    currentSlide = (currentSlide + 1) % slides;
    updateSlider();
  }

  setInterval(autoSlide, 4000);

  // ========== PROCESS STEPS TOGGLE ==========
  function toggleStep(element) {
    const allSteps = document.querySelectorAll('.process-step');
    const isActive = element.classList.contains('active');

    allSteps.forEach((step) => step.classList.remove('active'));

    if (!isActive) {
      element.classList.add('active');
    }
  }

  // ========== TESTIMONIALS ==========
  const testimonials = [
    {% for block in section.blocks %}
      {% if block.type == 'testimonial' %}
        {
          text: {{ block.settings.text | json }},
          name: {{ block.settings.name | json }},
          role: {{ block.settings.role | json }},
          rating: {{ block.settings.rating | default: 5 }}
        }{% unless forloop.last %},{% endunless %}
      {% endif %}
    {% endfor %}
  ];
  
  let currentTestimonial = 0;
  
  function updateTestimonial() {
    if (testimonials.length === 0) return;
    
    const t = testimonials[currentTestimonial];
    document.getElementById('testimonialText').textContent = `"${t.text}"`;
    document.getElementById('testimonialName').textContent = t.name;
    document.getElementById('testimonialRole').textContent = t.role;
    document.getElementById('testimonialStars').textContent = '★'.repeat(t.rating);
    
    document.querySelectorAll('.testimonial-image').forEach((img, i) => {
      img.classList.toggle('active', i === currentTestimonial);
    });
  }
  
  function nextTestimonial() {
    currentTestimonial = (currentTestimonial + 1) % testimonials.length;
    updateTestimonial();
  }
  
  function prevTestimonial() {
    currentTestimonial = (currentTestimonial - 1 + testimonials.length) % testimonials.length;
    updateTestimonial();
  }
  
  if(testimonials.length > 0) updateTestimonial();

  // ========== SERVICES TABS & FILTERING ==========
  function toggleMobileDropdown() {
    const dropdown = document.getElementById('mobileDropdown');
    dropdown.classList.toggle('open');
  }

  function selectMobileTab(category, text) {
    document.getElementById('mobileTabText').textContent = text;
    
    // Update mobile dropdown items
    document.querySelectorAll('.mobile-tab-item').forEach(item => {
      item.classList.remove('active');
    });
    event.target.classList.add('active');
    
    // Filter services
    filterServices(category, event.target, 'mobile');
    
    // Close dropdown
    document.getElementById('mobileDropdown').classList.remove('open');
  }

  function filterServices(category, element, type) {
    // Update active state
    if (type === 'desktop') {
      document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.classList.remove('active');
      });
      element.classList.add('active');
    }
    
    // Filter services
    const items = document.querySelectorAll('.service-item');
    items.forEach(item => {
      if(category === 'all' || item.dataset.category === category) {
        item.classList.remove('hidden');
      } else {
        item.classList.add('hidden');
      }
    });
  }

  // Close mobile dropdown on outside click
  document.addEventListener('click', (e) => {
    const mobileDropdown = document.getElementById('mobileDropdown');
    if (mobileDropdown && !mobileDropdown.contains(e.target)) {
      mobileDropdown.classList.remove('open');
    }
  });

  // ========== SERVICE POPUP ==========
// ========== SERVICE POPUP ==========
// ========== SERVICE POPUP ==========
function openServicePopup(element) {
  const popup = document.getElementById('servicePopup');
  
  // Get data from element
  const popupImage = element.dataset.popupImage || element.dataset.gridImage;
  const gridImage = element.dataset.gridImage;
  const category = element.dataset.category;
  const title = element.dataset.title;
  const description = element.dataset.description;
  const features = element.dataset.features;
  const faqsData = element.dataset.faqs;
  const tabsData = element.dataset.tabs;
  const link = element.dataset.link;
  
  // Set popup image (priority: popup_image > grid_image)
  document.getElementById('popupImage').src = popupImage;
  
  // Set basic info
  document.getElementById('popupCategory').textContent = category;
  document.getElementById('popupTitle').textContent = title;
  document.getElementById('popupDescription').textContent = description;
  
  // Set features
  const featuresList = document.getElementById('popupFeatures');
  featuresList.innerHTML = '';
  if(features) {
    features.split('|').forEach(feature => {
      if (feature.trim()) {
        const li = document.createElement('li');
        li.textContent = feature.trim();
        li.style.listStyle = 'none';
        li.style.padding = '10px 0';
        li.style.paddingLeft = '30px';
        li.style.position = 'relative';
        li.style.color = '#333';
        li.innerHTML = '<span style="position:absolute; left:0; color:#ff8c42; font-weight:bold;">✓</span> ' + feature.trim();
        featuresList.appendChild(li);
      }
    });
  }
  
  // Set FAQs from data or use default
  const faqsContainer = document.getElementById('popupFaqs');
  faqsContainer.innerHTML = '<h3 class="faqs-title">Frequently Asked Questions</h3>';
  
  if (faqsData) {
    // Parse custom FAQs from data
    const faqPairs = faqsData.split('||');
    faqPairs.forEach(pair => {
      const [question, answer] = pair.split('|');
      if (question && answer) {
        const faqItem = document.createElement('div');
        faqItem.className = 'faq-item';
        faqItem.innerHTML = `
          <div class="faq-question" onclick="toggleFaq(this)">
            ${question.trim()}
          </div>
          <div class="faq-answer">
            ${answer.trim()}
          </div>
        `;
        faqsContainer.appendChild(faqItem);
      }
    });
  } else {
    // Default FAQs
    const defaultFaqs = [
      { q: "What is included in this service?", a: "Complete package including design, development, and deployment." },
      { q: "How long does it take to complete?", a: "Typically 2-4 weeks depending on complexity." },
      { q: "What are the pricing options?", a: "We offer flexible pricing packages to suit your needs." },
      { q: "Do you provide ongoing support?", a: "Yes, we provide 6 months of free support and maintenance." }
    ];
    
    defaultFaqs.forEach(faq => {
      const faqItem = document.createElement('div');
      faqItem.className = 'faq-item';
      faqItem.innerHTML = `
        <div class="faq-question" onclick="toggleFaq(this)">
          ${faq.q}
        </div>
        <div class="faq-answer">
          ${faq.a}
        </div>
      `;
      faqsContainer.appendChild(faqItem);
    });
  }
  
  // Set Numbered Tabs from data or use default
  const tabsContainer = document.getElementById('popupTabs');
  const tabsContentContainer = document.getElementById('tabsContent');
  
  tabsContainer.innerHTML = '';
  tabsContentContainer.innerHTML = '';
  
  let tabData = [];
  
  if (tabsData) {
    // Parse custom tabs from data
    const tabPairs = tabsData.split('||');
    tabPairs.forEach((pair, index) => {
      const [title, content] = pair.split('|');
      if (title && content) {
        tabData.push({
          number: index + 1,
          title: title.trim(),
          content: content.trim()
        });
      }
    });
  }
  
  // If no custom tabs, use defaults
  if (tabData.length === 0) {
    tabData = [
      { number: 1, title: "Consultation", content: "We start with a detailed consultation to understand your needs and goals." },
      { number: 2, title: "Planning", content: "Our team creates a comprehensive plan and strategy for your project." },
      { number: 3, title: "Execution", content: "We implement the plan with precision and attention to detail." },
      { number: 4, title: "Delivery", content: "Final delivery and launch with thorough testing and optimization." }
    ];
  }
  
  // Create tabs and content
  tabData.forEach((tab, index) => {
    // Create tab button
    const tabBtn = document.createElement('button');
    tabBtn.className = 'popup-tab-btn' + (index === 0 ? ' active' : '');
    tabBtn.setAttribute('data-number', tab.number);
    tabBtn.textContent = tab.title;
    tabBtn.onclick = () => switchPopupTab(index);
    tabsContainer.appendChild(tabBtn);
    
    // Create tab content
    const tabContent = document.createElement('div');
    tabContent.className = 'tab-content' + (index === 0 ? ' active' : '');
    tabContent.innerHTML = `
      <h4>Step ${tab.number}: ${tab.title}</h4>
      <p>${tab.content}</p>
    `;
    tabsContentContainer.appendChild(tabContent);
  });
  
  // Set CTA button
  const ctaBtn = document.getElementById('popupCtaBtn');
  if (link) {
    ctaBtn.onclick = function() {
      window.location.href = link;
    };
    ctaBtn.style.cursor = 'pointer';
  } else {
    ctaBtn.onclick = function() {
      window.location.href = '/contact';
    };
  }
  
  // Open popup
  popup.classList.add('active');
  document.body.style.overflow = 'hidden';
}

// FAQ toggle function
function toggleFaq(element) {
  const faqItem = element.parentElement;
  const isActive = faqItem.classList.contains('active');
  
  // Close all FAQs
  document.querySelectorAll('.faq-item').forEach(item => {
    item.classList.remove('active');
  });
  
  // Open clicked FAQ if it wasn't active
  if (!isActive) {
    faqItem.classList.add('active');
  }
}

// Switch between tabs
function switchPopupTab(index) {
  // Update tab buttons
  document.querySelectorAll('.popup-tab-btn').forEach((btn, i) => {
    btn.classList.toggle('active', i === index);
  });
  
  // Update tab content
  document.querySelectorAll('.tab-content').forEach((content, i) => {
    content.classList.toggle('active', i === index);
  });
}

function closeServicePopup() {
  document.getElementById('servicePopup').classList.remove('active');
  document.body.style.overflow = '';
}

  function closePopupOnOutside(event) {
    if(event.target.id === 'servicePopup') {
      closeServicePopup();
    }
  }

  // ESC key to close popup
  document.addEventListener('keydown', (e) => {
    if(e.key === 'Escape') closeServicePopup();
  });
</script>

