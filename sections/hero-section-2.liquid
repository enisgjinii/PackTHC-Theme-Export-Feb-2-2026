<div class="image-grid" style="padding: {{ section.settings.section_padding_top | default: 36 }}px 0 {{ section.settings.section_padding_bottom | default: 36 }}px; position: relative;">
  
  {%- comment -%} Christmas Lights - Sirf home page par {%- endcomment -%}
  {% if template == 'index' %}
  <ul class="lightrope">
    {% for i in (1..80) %}
      <li></li>
    {% endfor %}
  </ul>
  {% endif %}
  
  {% assign images = 'left_image,middle_top_image,middle_bottom_image,right_image' | split: ',' %}
  {% assign collection_fields = 'left_collection,middle_top_collection,middle_bottom_collection,right_collection' | split: ',' %}
  {% assign url_fields = 'left_url,middle_top_url,middle_bottom_url,right_url' | split: ',' %}
  
  {% for image in images %}
    {% assign i = forloop.index0 %}
    {% assign collection_field = collection_fields[i] %}
    {% assign url_field = url_fields[i] %}
    
    {% if section.settings[image] %}
      <div class="grid-item grid-item-{{ forloop.index }}">
        {%- comment -%} Left Image - Carousel Feature {%- endcomment -%}
        {% if forloop.index == 1 %}
          <div class="carousel-container">
            <div class="carousel-slides">
              {% if section.settings.left_image %}
                <div class="carousel-slide active">
                  <img 
                    src="{{ section.settings.left_image | image_url: width: 600 }}" 
                    srcset="
                      {{ section.settings.left_image | image_url: width: 400 }} 400w,
                      {{ section.settings.left_image | image_url: width: 600 }} 600w,
                      {{ section.settings.left_image | image_url: width: 800 }} 800w,
                      {{ section.settings.left_image | image_url: width: 1200 }} 1200w
                    "
                    sizes="
                      (max-width: 768px) 100vw,
                      (max-width: 1024px) 50vw,
                      33vw
                    "
                    alt="{{ section.settings.left_image.alt | default: 'Image 1' }}"
                    width="{{ section.settings.left_image.width }}"
                    height="{{ section.settings.left_image.height }}"
                    loading="lazy">
                </div>
              {% endif %}
              {% if section.settings.left_image_2 %}
                <div class="carousel-slide">
                  <img 
                    src="{{ section.settings.left_image_2 | image_url: width: 600 }}" 
                    srcset="
                      {{ section.settings.left_image_2 | image_url: width: 400 }} 400w,
                      {{ section.settings.left_image_2 | image_url: width: 600 }} 600w,
                      {{ section.settings.left_image_2 | image_url: width: 800 }} 800w,
                      {{ section.settings.left_image_2 | image_url: width: 1200 }} 1200w
                    "
                    sizes="
                      (max-width: 768px) 100vw,
                      (max-width: 1024px) 50vw,
                      33vw
                    "
                    alt="{{ section.settings.left_image_2.alt | default: 'Image 2' }}"
                    width="{{ section.settings.left_image_2.width }}"
                    height="{{ section.settings.left_image_2.height }}"
                    loading="lazy">
                </div>
              {% endif %}
              {% if section.settings.left_image_3 %}
                <div class="carousel-slide">
                  <img 
                    src="{{ section.settings.left_image_3 | image_url: width: 600 }}" 
                    srcset="
                      {{ section.settings.left_image_3 | image_url: width: 400 }} 400w,
                      {{ section.settings.left_image_3 | image_url: width: 600 }} 600w,
                      {{ section.settings.left_image_3 | image_url: width: 800 }} 800w,
                      {{ section.settings.left_image_3 | image_url: width: 1200 }} 1200w
                    "
                    sizes="
                      (max-width: 768px) 100vw,
                      (max-width: 1024px) 50vw,
                      33vw
                    "
                    alt="{{ section.settings.left_image_3.alt | default: 'Image 3' }}"
                    width="{{ section.settings.left_image_3.width }}"
                    height="{{ section.settings.left_image_3.height }}"
                    loading="lazy">
                </div>
              {% endif %}
            </div>
            <div class="carousel-nav">
              {% if section.settings.left_image %}
                <button class="carousel-btn active" data-slide="0"></button>
              {% endif %}
              {% if section.settings.left_image_2 %}
                <button class="carousel-btn" data-slide="1"></button>
              {% endif %}
              {% if section.settings.left_image_3 %}
                <button class="carousel-btn" data-slide="2"></button>
              {% endif %}
            </div>
          </div>
        {% else %}
          {%- comment -%} Regular images for other positions {%- endcomment -%}
          {% assign href = '' %}

          {%- comment -%} 1) Custom URL takes priority {%- endcomment -%}
          {% if section.settings[url_field] != blank %}
            {% assign href = section.settings[url_field] %}
          {% else %}
            {%- comment -%} 2) Fallback to collection if provided {%- endcomment -%}
            {% if section.settings[collection_field] %}
              {% assign col_value = section.settings[collection_field] %}
              {% if collections[col_value] %}
                {% assign href = collections[col_value].url %}
              {% else %}
                {% assign href = section.settings[collection_field].url | default: section.settings[collection_field] %}
              {% endif %}
            {% endif %}
          {% endif %}

          {% assign is_large = false %}
          {% if forloop.index == 4 %}
            {% assign is_large = true %}
          {% endif %}

          {% if href != '' %}
            <a href="{{ href }}">
          {% endif %}
              <img 
                src="{{ section.settings[image] | image_url: width: 600 }}" 
                srcset="
                  {{ section.settings[image] | image_url: width: 400 }} 400w,
                  {{ section.settings[image] | image_url: width: 600 }} 600w,
                  {{ section.settings[image] | image_url: width: 800 }} 800w,
                  {{ section.settings[image] | image_url: width: 1200 }} 1200w
                "
                sizes="
                  (max-width: 768px) 100vw,
                  {% if is_large %}
                    (max-width: 1024px) 50vw,
                    33vw
                  {% else %}
                    (max-width: 1024px) 50vw,
                    33vw
                  {% endif %}
                "
                alt="{{ section.settings[image].alt | default: 'Image' }}"
                width="{{ section.settings[image].width }}"
                height="{{ section.settings[image].height }}"
                loading="lazy"
                decoding="async">
          {% if href != '' %}
            </a>
          {% endif %}
        {% endif %}
      </div>
    {% endif %}
  {% endfor %}
</div>

<style>
/* Christmas Festoon Lights - Pure CSS */
.lightrope {
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  position: absolute;
  z-index: 10;
  margin: -8px 0 0 0; 
  padding: 0;
  pointer-events: none;
  width: 100%;
  list-style: none;
  top: 0;
}

.lightrope li {
  position: relative;
  animation-fill-mode: both;
  animation-iteration-count: infinite;
  list-style: none;
  margin: 0;
  padding: 0;
  display: inline-block;
  width: 8px;
  height: 18px;
  border-radius: 50%;
  margin: 12px;
  background: rgba(178, 34, 34, 1);
  box-shadow: 0px 3px 16px 2px rgba(178, 34, 34, 1);
  animation-name: flash-1;
  animation-duration: 2s;
}

.lightrope li:nth-child(2n+1) {
  background: rgba(34, 139, 34, 1);
  box-shadow: 0px 3px 16px 2px rgba(34, 139, 34, 1);
  animation-name: flash-2;
  animation-duration: 0.4s;
}

.lightrope li:nth-child(4n+2) {
  background: rgba(218, 165, 32, 1);
  box-shadow: 0px 3px 16px 2px rgba(218, 165, 32, 1);
  animation-name: flash-3;
  animation-duration: 1.1s;
}

.lightrope li:nth-child(odd) {
  animation-duration: 1.8s;
}

.lightrope li:nth-child(3n+1) {
  animation-duration: 1.4s;
}

.lightrope li:before {
  content: "";
  position: absolute;
  background: #222;
  width: 7px;
  height: 6px;
  border-radius: 3px;
  top: -3px;
  left: 0.5px;
}

.lightrope li:after {
  content: "";
  top: -10px;
  left: 6px;
  position: absolute;
  width: 38px;
  height: 12px;
  border-bottom: solid #222 2px;
  border-radius: 50%;
}

.lightrope li:last-child:after {
  content: none;
}

.lightrope li:first-child {
  margin-left: -40px;
}

@keyframes flash-1 {
  0%, 100% {
    background: rgba(178, 34, 34, 1);
    box-shadow: 0px 3px 16px 2px rgba(178, 34, 34, 1);
  }
  50% {
    background: rgba(178, 34, 34, 0.4);
    box-shadow: 0px 3px 16px 2px rgba(178, 34, 34, 0.2);
  }
}

@keyframes flash-2 {
  0%, 100% {
    background: rgba(34, 139, 34, 1);
    box-shadow: 0px 3px 16px 2px rgba(34, 139, 34, 1);
  }
  50% {
    background: rgba(34, 139, 34, 0.4);
    box-shadow: 0px 3px 16px 2px rgba(34, 139, 34, 0.2);
  }
}

@keyframes flash-3 {
  0%, 100% {
    background: rgba(218, 165, 32, 1);
    box-shadow: 0px 3px 16px 2px rgba(218, 165, 32, 1);
  }
  50% {
    background: rgba(218, 165, 32, 0.4);
    box-shadow: 0px 3px 16px 2px rgba(218, 165, 32, 0.2);
  }
}

/* Image Grid */
.image-grid {
  display: grid;
  grid-template: auto auto / 1fr 1fr 1fr;
  gap: 2px;
  width: 100%;
}

.grid-item {
  min-height: 200px;
  background: #f8f8f8;
  overflow: hidden;
  position: relative;
  display: flex; 
}

.grid-item-1 { grid-area: 1 / 1 / 3 / 2; min-height: 400px; }
.grid-item-2 { grid-area: 1 / 2 / 2 / 3; }
.grid-item-3 { grid-area: 2 / 2 / 3 / 3; }
.grid-item-4 { grid-area: 1 / 3 / 3 / 4; min-height: 400px; }

.grid-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s ease;
  display: block;
}

.grid-item:hover {
  box-shadow: 0 0 10px rgba(0, 74, 38, 0.5);
}

.grid-item a {
  display: block;
  width: 100%;
  height: 100%;
  text-decoration: none;
  color: inherit;
}

/* Carousel Styles */
.carousel-container {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.carousel-slides {
  position: relative;
  width: 100%;
  height: 100%;
}

.carousel-slide {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  transition: opacity 0.5s ease-in-out;
}

.carousel-slide.active {
  opacity: 1;
  z-index: 1;
}

.carousel-slide img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.carousel-nav {
  position: absolute;
  bottom: 12px;
  right: 12px;
  display: flex;
  gap: 8px;
  z-index: 2;
}

.carousel-btn {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  border: 2px solid white;
  background: rgba(255, 255, 255, 0.5);
  cursor: pointer;
  transition: all 0.3s ease;
  padding: 0;
}

.carousel-btn:hover {
  background: rgba(255, 255, 255, 0.8);
  transform: scale(1.2);
}

.carousel-btn.active {
  background: white;
  box-shadow: 0 0 8px rgba(255, 255, 255, 0.8);
}

@media (max-width: 768px) {
  .image-grid {
    grid-template: repeat(4, auto) / 1fr;
    gap: 2px;
  }
  
  .grid-item-1, .grid-item-2, .grid-item-3, .grid-item-4 {
    grid-area: unset;
    min-height: 250px;
  }
  
  .grid-item-1, .grid-item-4 { 
    min-height: 400px;
  }
  
  .carousel-container {
    min-height: 400px;
    height: 400px;
  }
  
  .carousel-nav {
    bottom: 8px;
    right: 8px;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const slides = document.querySelectorAll('.carousel-slide');
  const btns = document.querySelectorAll('.carousel-btn');
  let currentSlide = 0;
  let autoplayInterval;

  if (slides.length === 0) return;

  function showSlide(index) {
    slides.forEach(slide => slide.classList.remove('active'));
    btns.forEach(btn => btn.classList.remove('active'));
    
    slides[index].classList.add('active');
    btns[index].classList.add('active');
    currentSlide = index;
  }

  function nextSlide() {
    currentSlide = (currentSlide + 1) % slides.length;
    showSlide(currentSlide);
  }

  function startAutoplay() {
    autoplayInterval = setInterval(nextSlide, 3000);
  }

  function stopAutoplay() {
    clearInterval(autoplayInterval);
  }

  btns.forEach((btn, index) => {
    btn.addEventListener('click', () => {
      showSlide(index);
      stopAutoplay();
      startAutoplay();
    });
  });

  startAutoplay();

  const carouselContainer = document.querySelector('.carousel-container');
  if (carouselContainer) {
    carouselContainer.addEventListener('mouseenter', stopAutoplay);
    carouselContainer.addEventListener('mouseleave', startAutoplay);
  }
});
</script>

{% schema %}
{
  "name": "Image Grid Layout home 2",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Left Carousel Images" },
    { "type": "image_picker", "id": "left_image", "label": "Left Image 1" },
    { "type": "image_picker", "id": "left_image_2", "label": "Left Image 2" },
    { "type": "image_picker", "id": "left_image_3", "label": "Left Image 3" },
    { "type": "collection", "id": "left_collection", "label": "Left Collection (optional)" },
    { "type": "url", "id": "left_url", "label": "Left Custom URL (optional)" },

    { "type": "header", "content": "Other Images" },
    { "type": "image_picker", "id": "middle_top_image", "label": "Middle Top Image" },
    { "type": "collection", "id": "middle_top_collection", "label": "Middle Top Collection (optional)" },
    { "type": "url", "id": "middle_top_url", "label": "Middle Top Custom URL (optional)" },

    { "type": "image_picker", "id": "middle_bottom_image", "label": "Middle Bottom Image" },
    { "type": "collection", "id": "middle_bottom_collection", "label": "Middle Bottom Collection (optional)" },
    { "type": "url", "id": "middle_bottom_url", "label": "Middle Bottom Custom URL (optional)" },

    { "type": "image_picker", "id": "right_image", "label": "Right Image" },
    { "type": "collection", "id": "right_collection", "label": "Right Collection (optional)" },
    { "type": "url", "id": "right_url", "label": "Right Custom URL (optional)" },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "section_padding_top", "min": 0, "max": 100, "step": 4, "unit":"px", "label":"Top Padding", "default":36 },
    { "type": "range", "id": "section_padding_bottom", "min": 0, "max": 100, "step": 4, "unit":"px", "label":"Bottom Padding", "default":36 }
  ],
  "presets": [ { "name": "Image Grid Layout home 2" } ]
}
{% endschema %}