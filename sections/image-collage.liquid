{%- liquid
	assign section_id   = '#shopify-section-' | append: section.id
	assign animation    = settings.section_animation
	assign full         = section.settings.full
	assign heading      = section.settings.heading_text
	assign heading_size = section.settings.heading_size
	assign image_ratio  = section.settings.image_ratio
	assign item_width   = 410

	if section.settings.width > 0
		assign item_width = section.settings.width
	endif
-%}

<style>
	{{ section_id }} .section-wrapper {
		padding-top: {{ section.settings.padding_top_mobile }}px;
		padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
	}

	{{ section_id }} .swiper-slide {
		width: 20rem;
		padding-right: 16px;
	}

	@media (min-width: 992px) {
		{{ section_id }} .section-wrapper {
			padding-top: {{ section.settings.padding_top }}px;
			padding-bottom: {{ section.settings.padding_bottom }}px;
		}

		{{ section_id }} .swiper-slide {
			width: {{ item_width }}px;
			padding-right: {{ section.settings.column_gap }}px;
		}
	}
</style>

<div class="section-wrapper color-{{ section.settings.color_scheme }}">
	<div class="{% if full %}stretch-section stretch-padding{% else %}container{% endif %}">
		<div class="image-slider">
			{%- if heading != blank -%}
				<div class="title-wrapper">
					<h2 class="heading rte {{ heading_size }}">{{- heading -}}</h2>

					{%- if section.settings.button_text != blank -%}
						<a class="show-more-button link-underline" href="{{ section.settings.button_link | default: '#' }}">{{- section.settings.button_text -}}</a>
					{%- endif -%}
				</div>
			{%- endif -%}

			<div class="image-slider-content carousel-swiper{% if animation %} scroll-trigger{% endif %}">
				<template data-options data-pagination-mobile data-css-mode="off">
					{
						{%- if section.settings.autoplay -%}
							"autoplay": {
								"delay": {{ section.settings.delay | times: 1000 }},
								"disableOnInteraction": false,
								"pauseOnMouseEnter": true
							},
						{%- endif -%}

						{%- if section.settings.loop -%}
							"loop": true,
						{%- endif -%}

						"slidesPerView": "auto"
					}
				</template>

				<div class="swiper">
					<div class="swiper-wrapper">
						{%- for block in section.blocks -%}
							<div class="swiper-slide{% if animation and forloop.index == 1 %} scroll-trigger{% endif %}" data-{{ block.id }} {{ block.shopify_attributes }} {% if request.design_mode %} data-index="{{ forloop.index0 }}"{% endif %}>
								{%- case block.type -%}
									{%- when '@app' -%}
										{%- render block -%}

									{%- when 'image' -%}
										{%- liquid
											assign image = block.settings.image
											assign link  = block.settings.link
										-%}

										{%- if link != blank -%}
											<a class="image-link" href="{{ link }}" aria-label="{{- 'general.text.link' | t -}}"></a>
										{%- endif -%}

										<div class="image {{ image_ratio }}-media">
											<div class="{% if image == blank %}adapt-svg-placeholder{% endif %}{% if settings.image_lazy and image %} lazy-image{% endif %}">
												{%- liquid
													if image != blank
														render 'lazy-image', image: image, width: 1200
													else
														render 'icon', code: 'placeholder'
													endif
												-%}
											</div>
										</div>
								{%- endcase -%}
							</div>
						{%- endfor -%}
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

{% schema %}
{
	"name": "t:sections.image-slider.name",
	"tag": "section",
	"class": "image-slider-section",
	"disabled_on": {
		"groups": ["header", "footer"]
	},
	"settings": [
		{
			"type": "checkbox",
			"id": "full",
			"default": false,
			"label": "t:general.layout.full.label"
		},
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"label": "t:settings_schema.colors.label",
			"default": "scheme-1"
		},
		{
			"type": "select",
			"id": "image_ratio",
			"options": [
				{
					"value": "adapt",
					"label": "t:sections.image-slider.settings.image_ratio.options_1.label"
				},
				{
					"value": "portrait",
					"label": "t:sections.image-slider.settings.image_ratio.options_2.label"
				},
				{
					"value": "square",
					"label": "t:sections.image-slider.settings.image_ratio.options_3.label"
				}
			],
			"default": "adapt",
			"label": "t:sections.image-slider.settings.image_ratio.label"
		},
		{
			"type": "header",
			"content": "t:general.typography.heading.label"
		},
		{
			"type": "inline_richtext",
			"id": "heading_text",
			"default": "Heading",
			"label": "t:general.typography.text.label"
		},
		{
			"type": "select",
			"id": "heading_size",
			"options": [
				{
					"value": "h4",
					"label": "t:general.typography.heading_size.option_1.label"
				},
				{
					"value": "h3",
					"label": "t:general.typography.heading_size.option_2.label"
				},
				{
					"value": "h2",
					"label": "t:general.typography.heading_size.option_3.label"
				}
			],
			"default": "h2",
			"label": "t:general.typography.font_size.label"
		},
		{
			"type": "header",
			"content": "t:general.typography.button.label"
		},
		{
			"type": "text",
			"id": "button_text",
			"default": "Button label",
			"label": "t:general.typography.text.label"
		},
		{
			"type": "url",
			"id": "button_link",
			"label": "t:general.typography.link.label"
		},
		{
			"type": "header",
			"content": "t:general.slider.options.label"
		},
		{
			"type": "checkbox",
			"id": "loop",
			"default": false,
			"label": "t:general.slider.loop.label"
		},
		{
			"type": "checkbox",
			"id": "autoplay",
			"default": false,
			"label": "t:general.slider.autoplay.label"
		},
		{
			"type": "range",
			"id": "delay",
			"min": 3,
			"max": 20,
			"step": 1,
			"default": 5,
			"label": "t:general.slider.delay.label"
		},
		{
			"type": "number",
			"id": "width",
			"default": 409,
			"label": "t:general.dimensions.width.label"
		},
		{
			"type": "range",
			"id": "column_gap",
			"min": 0,
			"max": 200,
			"step": 2,
			"default": 32,
			"unit": "px",
			"label": "t:general.slider.column_gap.label"
		},
		{
			"type": "header",
			"content": "t:general.padding.header_padding.content"
		},
		{
			"type": "range",
			"id": "padding_top",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 50,
			"unit": "px",
			"label": "t:general.padding.top.label"
		},
		{
			"type": "range",
			"id": "padding_bottom",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 50,
			"unit": "px",
			"label": "t:general.padding.bottom.label"
		},
		{
			"type": "paragraph",
			"content": "t:general.padding.paragraph_mobile.content"
		},
		{
			"type": "range",
			"id": "padding_top_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 20,
			"unit": "px",
			"label": "t:general.padding.top.label"
		},
		{
			"type": "range",
			"id": "padding_bottom_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 20,
			"unit": "px",
			"label": "t:general.padding.bottom.label"
		}
	],
		"blocks": [
		{
			"type": "@app"
		},
		{
			"type": "image",
			"name": "t:general.image.label",
			"limit": 6,
			"settings": [
				{
					"type": "image_picker",
					"id": "image",
					"label": "t:general.image.label"
				},
				{
					"type": "url",
					"id": "link",
					"label": "t:general.typography.link.label"
				}
			]
		}
	],
	"presets": [
		{
			"name": "t:sections.image-slider.name",
			"blocks": [
				{
					"type": "image"
				},
				{
					"type": "image"
				},
				{
					"type": "image"
				},
				{
					"type": "image"
				},
				{
					"type": "image"
				}
			]
		}
	]
}
{% endschema %}
