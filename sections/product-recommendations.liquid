{%- liquid
	assign section_id    = '#shopify-section-' | append: section.id
	assign full          = section.settings.full
	assign layout        = section.settings.layout
	assign columns       = section.settings.columns
	assign total         = section.settings.rows | times: columns
	assign show_arrows   = section.settings.show_arrows
	assign show_dots     = section.settings.show_dots
	assign column_gap    = 30
	assign heading       = section.settings.heading
	assign heading_size  = section.settings.heading_size
	assign view_all_text = section.settings.view_all_text
-%}

<style>
	{{ section_id }} .section-inner {
		padding-top: {{ section.settings.padding_top_mobile }}px;
		padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
	}

	@media (min-width: 992px) {
		{{ section_id }} .section-inner {
			padding-top: {{ section.settings.padding_top }}px;
			padding-bottom: {{ section.settings.padding_bottom }}px;
		}

		{{ section_id }} .slider-layout .swiper:not(.swiper-initialized) .swiper-slide {
			width: calc( ( 100% - {{ columns | minus: 1 | times: column_gap }}px ) / {{ columns }} );
			margin-right: {{ column_gap }}px;
		}
	}

	@media (max-width: 991px) {
		{{ section_id }} .swiper:not(.swiper-initialized) .swiper-slide {
			margin-right: {{ column_gap }}px;
		}
	}
</style>

<div class="section-inner product-performed slider-layout color-{{ section.settings.color_scheme }}">
	<div class="{% if full %}stretch-section stretch-padding{% else %}container{% endif %}">
		<div class="product-recommendations" data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ total }}" data-source>
			{%- if recommendations.performed and recommendations.products_count > 0 -%}
				{%- if heading != blank or view_all_text != blank -%}
					<div class="wrapper-heading">
						{%- if heading != blank -%}
							<h2 class="title {{ heading_size }} rte">{{- heading | escape -}}</h2>
						{%- endif -%}

						{%- if view_all_text != blank -%}
							<a href="{{ section.settings.view_all_url | default: '#' }}" class="link-underline">{{- view_all_text | escape -}}</a>
						{%- endif -%}
					</div>
				{%- endif -%}

				{%- if layout == 'slider' -%}
					<div class="carousel-swiper">
						<template data-options data-pagination-mobile data-css-mode="off">
							{
								{%- if section.settings.loop -%}
									"loop": true,
								{%- endif -%}
								{%- if section.settings.autoplay -%}
									"autoplay": {
										"delay": {{ section.settings.delay | times: 1000 }},
										"disableOnInteraction": false,
										"pauseOnMouseEnter": true
									},
								{%- endif -%}
								{%- if show_arrows -%}
									"navigation": {
										"nextEl": "{{ section_id }} .swiper-button-next",
										"prevEl": "{{ section_id }} .swiper-button-prev"
									},
								{%- endif -%}
								{%- if show_dots -%}
									"pagination": {
										"el": "{{ section_id }} .swiper-pagination",
										"clickable": true
									},
								{%- endif -%}
								"spaceBetween": 30,
								"slidesPerView": {{ columns }},
								"breakpoints": {
									"240": {
										"slidesPerView": 1.3,
										"spaceBetween": 15
									},
									"992": {
										"slidesPerView": 4
									}
								}
							}
						</template>

						<div class="swiper">
				{%- endif -%}
					<div class="{% if layout == 'grid' %}grid grid-{{ columns }} grid-tablet-3 grid-mobile-2{% else %}swiper-wrapper{% endif %}">
						{%- for product in recommendations.products limit: total -%}
							<div class="{% if layout == 'grid' %}grid-item{% else %}swiper-slide{% endif %}">
								{%- render 'product-card', product: product, index: forloop.index -%}
							</div>
						{%- else -%}
							{%- for i in (1..4) -%}
								<div class="{% if layout == 'grid' %}grid-item{% else %}swiper-slide{% endif %}">
									{%- render 'product-card-placeholder', index: forloop.index -%}
								</div>
							{%- endfor -%}
						{%- endfor -%}
					</div>

				{%- if layout == 'slider' -%}
					</div>{% comment %} .swiper {% endcomment %}

					{%- if layout == 'slider' and show_dots or show_arrows -%}
						<div class="swiper-controls">
							{%- if show_arrows -%}
								<button class="swiper-button-prev" title ="{{ 'general.swipper.prev' | t }}" aria-label="{{ 'general.swipper.prev' | t }}" id="{{ 'general.swipper.prev' | t }}" aria-labelledby="{{ 'general.swipper.prev' | t }}">{%- render 'icon', code: 'arrow-left-slider' -%}</button>
							{%- endif -%}

							{%- if show_dots -%}
								<div class="swiper-pagination" tabindex="-1"></div>
							{%- endif -%}

							{%- if show_arrows -%}
								<button class="swiper-button-next" title ="{{ 'general.swipper.next' | t }}" aria-label="{{ 'general.swipper.next' | t }}" id="{{ 'general.swipper.next' | t }}" aria-labelledby="{{ 'general.swipper.next' | t }}">{%- render 'icon', code: 'arrow-right-slider' -%}</button>
							{%- endif -%}
						</div>
					{%- endif -%}

					</div>{% comment %} .carousel-swiper {% endcomment %}
				{%- endif -%}
			{%- endif -%}
		</div>
	</div>
</div>

{% schema %}
{
	"name": "t:sections.product-recommendations.name",
	"tag": "section",
	"class": "recommendations-section",
	"limit": 1,
	"enabled_on": {
		"templates": ["product"]
	},
	"settings": [
		{
			"type": "paragraph",
			"content": "t:sections.product-recommendations.settings.paragraph_1.content"
		},
		{
			"type": "checkbox",
			"id": "full",
			"default": false,
			"label": "t:general.layout.full.label"
		},
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"label": "t:settings_schema.colors.label",
			"default": "scheme-1"
		},
		{
			"type": "inline_richtext",
			"id": "heading",
			"default": "Related products",
			"label": "t:general.typography.heading.label"
		},
		{
			"type": "select",
			"id": "heading_size",
			"options": [
				{
					"value": "h4",
					"label": "t:general.typography.heading_size.option_1.label"
				},
				{
					"value": "h3",
					"label": "t:general.typography.heading_size.option_2.label"
				},
				{
					"value": "h2",
					"label": "t:general.typography.heading_size.option_3.label"
				}
			],
			"default": "h2",
			"label": "t:general.typography.heading_size.label"
		},
		{
			"type": "text",
			"id": "view_all_text",
			"default": "See All Products",
			"label": "t:sections.product-recommendations.settings.view_all_text.label"
		},
		{
			"type": "url",
			"id": "view_all_url",
			"label": "t:sections.product-recommendations.settings.view_all_url.label"
		},
		{
			"type": "select",
			"id": "layout",
			"options": [
				{
					"value": "grid",
					"label": "t:sections.product-recommendations.settings.layout.options__1.label"
				},
				{
					"value": "slider",
					"label": "t:sections.product-recommendations.settings.layout.options__2.label"
				}
			],
			"default": "grid",
			"label": "t:sections.product-recommendations.settings.layout.label"
		},
		{
			"type": "range",
			"id": "rows",
			"min": 1,
			"max": 10,
			"step": 1,
			"default": 1,
			"label": "t:sections.product-recommendations.settings.rows.label"
		},
		{
			"type": "range",
			"id": "columns",
			"min": 1,
			"max": 12,
			"step": 1,
			"default": 4,
			"label": "t:sections.product-recommendations.settings.columns.label"
		},
		{
			"type": "header",
			"content": "t:general.slider.options.label"
		},
		{
			"type": "checkbox",
			"id": "show_arrows",
			"default": true,
			"label": "t:general.slider.show_arrows.label"
		},
		{
			"type": "checkbox",
			"id": "show_dots",
			"default": true,
			"label": "t:general.slider.show_dots.label"
		},
		{
			"type": "checkbox",
			"id": "loop",
			"default": false,
			"label": "t:general.slider.loop.label"
		},
		{
			"type": "checkbox",
			"id": "autoplay",
			"default": false,
			"label": "t:general.slider.autoplay.label"
		},
		{
			"type": "range",
			"id": "delay",
			"min": 3,
			"max": 20,
			"step": 1,
			"default": 5,
			"label": "t:general.slider.delay.label"
		},
		{
			"type": "header",
			"content": "t:general.padding.header_padding.content"
		},
		{
			"type": "range",
			"id": "padding_top",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 0,
			"unit": "px",
			"label": "t:general.padding.top.label"
		},
		{
			"type": "range",
			"id": "padding_bottom",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 50,
			"unit": "px",
			"label": "t:general.padding.bottom.label"
		},
		{
			"type": "paragraph",
			"content": "t:general.padding.paragraph_mobile.content"
		},
		{
			"type": "range",
			"id": "padding_top_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 20,
			"unit": "px",
			"label": "t:general.padding.top.label"
		},
		{
			"type": "range",
			"id": "padding_bottom_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 20,
			"unit": "px",
			"label": "t:general.padding.bottom.label"
		}
	],
	"presets": [
		{
			"name": "t:sections.product-recommendations.name"
		}
	]
}
{% endschema %}
