{%- liquid
	assign section_id      = '#shopify-section-' | append: section.id
	assign animation       = settings.section_animation
	assign content_width   = section.settings.content_width
	assign align           = section.settings.align
	assign heading         = section.settings.heading
	assign heading_size    = section.settings.heading_size
	assign sub_heading     = section.settings.sub_heading
	assign address_heading = section.settings.address_heading
	assign address         = section.settings.address
	assign hours           = section.settings.hours
-%}

<style>
	{{ section_id }} .section-wrapper {
		padding-top: {{ section.settings.padding_top_mobile }}px;
		padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
	}

	@media (min-width: 992px) {
		{{ section_id }} .section-wrapper {
			padding-top: {{ section.settings.padding_top }}px;
			padding-bottom: {{ section.settings.padding_bottom }}px;
		}
	}

	@media (min-width: 1024px) {
		{{ section_id }} .contact-wrapper {
			max-width: {{ content_width }}%;
			margin: 0 auto;
		}
	}

	{%- for scheme in settings.color_schemes -%}
		{%- assign input_bg_color = scheme.settings.background_color | color_lighten: 8 -%}

		{{ section_id }} .color-{{ scheme.id }} {
			--input-bg-color: {{ input_bg_color.red }}, {{ input_bg_color.green }}, {{ input_bg_color.blue }};
		}
	{%- endfor -%}
</style>

<div class="section-wrapper color-{{ section.settings.color_scheme }}">
	<div class="container">
		<div class="contact-wrapper">
			{%- if heading != blank or sub_heading != blank -%}
				<div class="contact-top text-{{ align }}{% if animation %} scroll-trigger{% endif %}">
					{%- if heading != blank -%}
						<h2 class="contact-heading {{ heading_size }}">
							{{- heading -}}
						</h2>
					{%- endif -%}

					{%- if sub_heading != blank -%}
						<div class="contact-subheading">
							{{- sub_heading -}}
						</div>
					{%- endif -%}
				</div>
			{%- endif -%}

			<div class="contact-inner{% if animation %} scroll-trigger{% endif %}{%- if address_heading != blank or address != blank or hours != blank or section.settings.button_label != blank -%} has-address{% endif %}">
				{%- if address_heading != blank or address != blank or hours != blank or section.settings.button_label != blank -%}
					<div class="contact-inner-content">
						{%- if address_heading != blank -%}
							<h4 class="contact-inner-heading">
								{{- address_heading -}}
							</h4>
						{%- endif -%}
						{%- if address != blank -%}
							<div class="address">
								{{- address -}}
							</div>
						{%- endif -%}
						{%- if hours != blank -%}
							<div class="hours">
								{{- hours -}}
							</div>
						{%- endif -%}
						{%- if section.settings.button_label != blank -%}
							<a class="button primary-button{% if animation %} scroll-trigger{% endif %}" href="{{ section.settings.button_link | default: '#' }}">
								{{- section.settings.button_label -}}

								{% if settings.select_button == 'direction' %}
									{%- render 'icon', code: 'direction-button' -%}
								{% elsif settings.select_button == 'arrow' %}
									{%- render 'icon', code: 'arrow-button' -%}
								{% endif %}
							</a>
						{%- endif -%}
					</div>
				{%- endif -%}

				{%- form 'contact', id: nil, class: 'contact-form' -%}
					{%- if form.posted_successfully? -%}
						<p class="message success-message" tabindex="-1" autofocus>
							{%- liquid
								render 'icon', code: 'success'
								echo 'templates.form.contact_success' | t
							-%}
						</p>
					{%- elsif form.errors -%}
						<p class="message error-message">
							{%- liquid
								render 'icon', code: 'error'
								echo 'templates.form.error_heading' | t
							-%}
						</p>

						<ul class="error-list" role="list">
							<li>
								<a href="#form-field-email-error{{ section_id }}" class="link">
									{{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
								</a>
							</li>
						</ul>
					{%- endif -%}

					<div class="form-fields">
						<div class="group-form-fields">
							{% comment %} Name {% endcomment %}
							<div class="field-form">
								<label for="form-field-name-{{ section.id }}">{{- 'templates.form.name' | t -}}</label>

								<input autocomplete="name" type="text" id="form-field-name-{{ section.id }}" name="contact[name]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" placeholder="{{- 'templates.form.name_placeholder' | t -}}" required>
							</div>

							{% comment %} Email {% endcomment %}
							<div class="field-form">
								<label for="form-field-email-{{ section.id }}">{{- 'templates.form.email' | t -}}</label>
								<input autocomplete="email"
									type="email"
									id="form-field-email-{{ section.id }}"
									name="contact[email]"
									spellcheck="false"
									autocapitalize="off"
									value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
									aria-required="true"
									{% if form.errors contains 'email' %}
										aria-invalid="true"
										aria-describedby="form-field-email-error{{ section_id }}"
									{% endif %}
									pattern="^([a-zA-Z0-9_\-\.]+)@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.)|(([a-zA-Z0-9\-]+\.)+))([a-zA-Z]{2,4}|[0-9]{1,3})(\]?)$"
									placeholder="{{- 'templates.form.email_placeholder' | t -}}"
									required>
							</div>

							{%- if form.errors contains 'email' -%}
								<small class="form-field-email-error" id="form-field-email-error{{ section_id }}">
									<span class="sr-only">{{- 'accessibility.error' | t -}}</span>

									<span class="message error-message">
										{%- liquid
											render 'icon', code: 'error'
											echo form.errors.translated_fields['email'] | capitalize | append: ' ' | append: form.errors.messages['email']
										 -%}
									</span>
								</small>
							{%- endif -%}
						</div>

						{%- for block in section.blocks -%}
							{%- liquid
								assign heading = block.settings.dropdown
								assign values  = block.settings.values | split: ','
							-%}

							<div class="field-form" {{ block.shopify_attributes }}>
								<label for="form-field-select-{{ section.id }}">{{- heading -}}</label>

								<select class="field-select" name="contact[{{ heading | escape }}]" required data-noui>
									{%- for value in values -%}
										<option{% if value.first != blank %} selected{% endif %} value="{{ value | handle }}">{{- value -}}</option>
									{%- endfor -%}
								</select>
							</div>
						{%- endfor -%}

						{% comment %} Textarea {% endcomment %}
						<div class="field-form text-area">
							<label for="form-field-body-{{ section.id }}">{{- 'templates.form.message' | t -}}</label>

							<textarea id="form-field-body-{{ section.id }}" name="contact[body]" placeholder="{{- 'templates.form.message_placeholder' | t -}}" required>
								{{- form.body -}}
							</textarea>
						</div>
					</div>

					{% comment %} Submit {% endcomment %}
					<div class="info-bottom">
						<div class="information">
							{{- 'templates.form.information' | t -}}
						</div>
						<button type="submit" class="button primary-button medium-button">
							{{- 'templates.form.send' | t -}}
							{% if settings.select_button == 'direction' %}
								{%- render 'icon', code: 'direction-button' -%}
							{% elsif settings.select_button == 'arrow' %}
								{%- render 'icon', code: 'arrow-button' -%}
							{% endif %}
						</button>
					</div>
				{%- endform -%}
			</div>
		</div>
	</div>
</div>

{% schema %}
{
	"name": "t:sections.contact.name",
	"tag": "section",
	"class": "contact-section",
	"disabled_on": {
		"groups": ["header", "footer"]
	},
	"settings": [
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"default": "scheme-2",
			"label": "t:settings_schema.colors.label"
		},
		{
			"type": "range",
			"id": "content_width",
			"default": 80,
			"min": 60,
			"max": 100,
			"step": 1,
			"unit": "%",
			"label": "t:general.dimensions.content_width.label"
		},
		{
			"type": "select",
			"id": "align",
			"options": [
				{
					"value": "left",
					"label": "t:general.layout.alignment.option_1.label"
				},
				{
					"value": "center",
					"label": "t:general.layout.alignment.option_2.label"
				},
				{
					"value": "right",
					"label": "t:general.layout.alignment.option_3.label"
				}
			],
			"default": "center",
			"label": "t:general.layout.alignment.label"
		},
		{
			"type": "inline_richtext",
			"id": "heading",
			"default": "Heading",
			"label": "t:general.typography.heading.label"
		},
		{
			"type": "select",
			"id": "heading_size",
			"options": [
				{
					"value": "h3",
					"label": "t:general.typography.heading_size.option_1.label"
				},
				{
					"value": "h2",
					"label": "t:general.typography.heading_size.option_2.label"
				},
				{
					"value": "h1",
					"label": "t:general.typography.heading_size.option_3.label"
				}
			],
			"default": "h2",
			"label": "t:general.typography.heading_size.label"
		},
		{
			"type": "richtext",
			"id": "sub_heading",
			"default": "<p>Use this text to share information about your brand with your customers. <br>Describe a product, share announcements, or welcome customers to your store.</p>",
			"label": "t:general.typography.sub_heading.label"
		},
		{
			"type": "header",
			"content": "t:sections.contact.settings.address_hours.content"
		},
		{
			"type": "text",
			"id": "address_heading",
			"default": "Find Our Store",
			"label": "t:general.typography.heading.label"
		},
		{
			"type": "richtext",
			"id": "address",
			"default": "<p>2306 West Lauren St, Springfield, Illinois 62702 <br>Tel: (808) 555-0111 <br>Email: hi@pure.com <br>Website: https://pure.com</p>",
			"label": "t:sections.contact.settings.address.label"
		},
		{
			"type": "richtext",
			"id": "hours",
			"default": "<p>Mon - Fri: 9:00 am - 10:00 pm <br>Saturday: 9:00 am - 10:00 pm <br>Sunday: 9:00 am - 10:00 pm</p>",
			"label": "t:sections.contact.settings.hours.label"
		},
		{
			"type": "text",
			"id": "button_label",
			"default": "Button label",
			"label": "t:general.typography.button_label.label"
		},
		{
			"type": "url",
			"id": "button_link",
			"label": "t:general.typography.link.label"
		},
		{
			"type": "header",
			"content": "t:general.padding.header_padding.content"
		},
		{
			"type": "range",
			"id": "padding_top",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 50,
			"unit": "px",
			"label": "t:general.padding.top.label"
		},
		{
			"type": "range",
			"id": "padding_bottom",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 50,
			"unit": "px",
			"label": "t:general.padding.bottom.label"
		},
		{
			"type": "paragraph",
			"content": "t:general.padding.paragraph_mobile.content"
		},
		{
			"type": "range",
			"id": "padding_top_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 50,
			"unit": "px",
			"label": "t:general.padding.top.label"
		},
		{
			"type": "range",
			"id": "padding_bottom_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 50,
			"unit": "px",
			"label": "t:general.padding.bottom.label"
		}
	],
	"blocks": [
		{
			"type": "dropdown",
			"name": "t:sections.contact.blocks.dropdown.name",
			"settings": [
				{
					"type": "text",
					"id": "dropdown",
					"default": "I'd like to ask about",
					"label": "t:general.typography.heading.label"
				},
				{
					"type": "text",
					"id": "values",
					"default": "Refund Policy, Shipping Costs, Delivery Times",
					"label": "t:sections.contact.blocks.dropdown.value.label",
					"info": "t:sections.contact.blocks.dropdown.value.info"
				}
			]
		}
	],
	"presets": [
		{
			"name": "t:sections.contact.name",
			"blocks": [
				{
					"type": "dropdown"
				}
			]
		}
	]
}
{% endschema %}
