{% comment %}
  Video Hero — Modern Cinematic Overlay Layout
  Full-width video, text overlaid on top, glassmorphism UI
{% endcomment %}

<style>
  .vhm-section {
    --vhm-accent: {{ section.settings.accent_color | default: '#00f5a0' }};
    --vhm-text:   {{ section.settings.text_color   | default: '#ffffff' }};
    --vhm-sub:    {{ section.settings.subtext_color | default: 'rgba(255,255,255,0.55)' }};
    --vhm-radius: {{ section.settings.video_radius  | default: 24 }}px;

    position: relative;
    width: 100%;
    overflow: hidden;
    background: #000;
  }

  /* ══════════════════════════════
     VIDEO CONTAINER
  ══════════════════════════════ */
  .vhm-video-wrap {
    position: relative;
    width: 100%;
    border-radius: var(--vhm-radius);
    overflow: hidden;
  }

  .vhm-video-wrap video,
  .vhm-video-wrap iframe {
    display: block;
    width: 100%;
    height: auto;
    position: relative;
    object-fit: contain;
  }

  /* dark cinematic gradient overlays */
  .vhm-overlay-top {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 50%;
    background: linear-gradient(to bottom, rgba(0,0,0,0.80) 0%, transparent 100%);
    z-index: 1;
    pointer-events: none;
  }

  .vhm-overlay-bottom {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 65%;
    background: linear-gradient(to top, rgba(0,0,0,0.92) 0%, rgba(0,0,0,0.4) 60%, transparent 100%);
    z-index: 1;
    pointer-events: none;
  }

  /* ══════════════════════════════
     CONTENT LAYER (over video)
  ══════════════════════════════ */
  .vhm-content {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 36px 52px 48px;
  }

  /* ── TOP BAR ── */
  .vhm-topbar {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    opacity: 0;
    transform: translateY(-16px);
    transition: opacity 0.8s ease 0.1s, transform 0.8s cubic-bezier(0.16,1,0.3,1) 0.1s;
  }
  .vhm-topbar.vhm-in { opacity: 1; transform: translateY(0); }

  .vhm-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--vhm-accent);
    padding: 7px 16px;
    border: 1px solid var(--vhm-accent);
    border-radius: 100px;
    backdrop-filter: blur(8px);
    background: rgba(0,0,0,0.25);
  }
  .vhm-badge::before {
    content: '';
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--vhm-accent);
    animation: vhmBlink 1.8s ease-in-out infinite;
  }
  @keyframes vhmBlink {
    0%,100% { opacity: 1; } 50% { opacity: 0.15; }
  }

  /* top right — stats row */
  .vhm-stats-row {
    display: flex;
    align-items: center;
    gap: 0;
  }

  .vhm-stat-pill {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 10px 24px;
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 100px;
    backdrop-filter: blur(10px);
    background: rgba(0,0,0,0.25);
    gap: 2px;
  }

  .vhm-stat-pill__num {
    font-size: 22px;
    font-weight: 900;
    color: var(--vhm-text);
    line-height: 1;
    letter-spacing: -0.5px;
  }
  .vhm-stat-pill__label {
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--vhm-sub);
  }

  .vhm-stats-divider {
    width: 1px;
    height: 28px;
    background: rgba(255,255,255,0.15);
    margin: 0 4px;
  }

  /* ── BOTTOM SECTION ── */
  .vhm-bottom {
    display: flex;
    flex-direction: column;
    gap: 28px;
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.9s ease 0.25s, transform 0.9s cubic-bezier(0.16,1,0.3,1) 0.25s;
  }
  .vhm-bottom.vhm-in { opacity: 1; transform: translateY(0); }

  /* title + right col side by side */
  .vhm-bottom-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
  }

  /* ── TITLE ── */
  .vhm-title-block { flex: 1; }

  .vhm-eyebrow {
    display: block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--vhm-accent);
    margin-bottom: 12px;
  }

  .vhm-title {
    font-size: clamp(52px, 8.5vw, 128px);
    font-weight: 900;
    line-height: 0.88;
    letter-spacing: -3px;
    text-transform: uppercase;
    color: var(--vhm-text);
    margin: 0;
  }

  .vhm-title em {
    font-style: normal;
    -webkit-text-stroke: 2px var(--vhm-text);
    color: transparent;
  }

  /* ── RIGHT BLOCK ── */
  .vhm-right-block {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 20px;
    flex-shrink: 0;
    max-width: 300px;
    text-align: right;
  }

  .vhm-desc {
    font-size: 14px;
    line-height: 1.75;
    color: var(--vhm-sub);
    margin: 0;
  }

  /* ── CTA ROW ── */
  .vhm-cta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-top: 4px;
    border-top: 1px solid rgba(255,255,255,0.1);
  }

  /* play wrap left */
  .vhm-play-wrap {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .vhm-play-btn {
    width: 72px; height: 72px;
    border-radius: 50%;
    background: rgba(255,255,255,0.1);
    backdrop-filter: blur(16px);
    border: 1.5px solid rgba(255,255,255,0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.3s ease, transform 0.3s ease, border-color 0.3s ease;
    pointer-events: all;
    flex-shrink: 0;
  }
  .vhm-play-btn:hover {
    background: var(--vhm-accent);
    border-color: var(--vhm-accent);
    transform: scale(1.08);
  }
  .vhm-play-btn:hover svg polygon,
  .vhm-play-btn:hover svg rect { fill: #000; }

  .vhm-play-info {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .vhm-play-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--vhm-text);
  }
  .vhm-play-sub {
    font-size: 11px;
    color: var(--vhm-sub);
    letter-spacing: 0.05em;
  }

  /* cta buttons right */
  .vhm-cta-buttons {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .vhm-cta-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: #000;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 14px 26px;
    border-radius: 100px;
    background: var(--vhm-accent);
    border: 1px solid var(--vhm-accent);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }
  .vhm-cta-primary:hover { opacity: 0.88; transform: translateY(-1px); }

  .vhm-cta-secondary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--vhm-text);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 13px 24px;
    border-radius: 100px;
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.2);
    backdrop-filter: blur(10px);
    transition: background 0.25s ease, border-color 0.25s ease;
  }
  .vhm-cta-secondary:hover {
    background: rgba(255,255,255,0.14);
    border-color: rgba(255,255,255,0.35);
  }

  /* ── SIDE TAGS ── */
  .vhm-side-tags {
    position: absolute;
    left: 20px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
    display: flex;
    flex-direction: column;
    gap: 12px;
    opacity: 0;
    transition: opacity 0.9s ease 0.5s;
  }
  .vhm-side-tags.vhm-in { opacity: 1; }

  .vhm-tag {
    writing-mode: vertical-rl;
    text-orientation: mixed;
    transform: rotate(180deg);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--vhm-sub);
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .vhm-tag::before {
    content: '';
    width: 1px;
    height: 32px;
    background: rgba(255,255,255,0.18);
    flex-shrink: 0;
  }

  /* ── SCROLL INDICATOR ── */
  .vhm-scroll-hint {
    position: absolute;
    bottom: 52px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    opacity: 0;
    transition: opacity 0.9s ease 0.7s;
    pointer-events: none;
  }
  .vhm-scroll-hint.vhm-in { opacity: 0.38; }

  .vhm-scroll-mouse {
    width: 22px; height: 34px;
    border: 1.5px solid rgba(255,255,255,0.5);
    border-radius: 11px;
    display: flex;
    justify-content: center;
    padding-top: 6px;
  }
  .vhm-scroll-mouse::before {
    content: '';
    width: 3px; height: 7px;
    background: rgba(255,255,255,0.7);
    border-radius: 2px;
    animation: vhmScroll 1.8s ease-in-out infinite;
  }
  @keyframes vhmScroll {
    0%   { transform: translateY(0);    opacity: 1; }
    100% { transform: translateY(10px); opacity: 0; }
  }
  .vhm-scroll-hint span {
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.5);
  }

  /* ── GRAIN ── */
  .vhm-grain {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    opacity: 0.03;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 900px) {
    .vhm-content      { padding: 28px 28px 36px; }
    .vhm-side-tags    { display: none; }
    .vhm-stats-row    { display: none; }
    .vhm-bottom-row   { flex-direction: column; align-items: flex-start; gap: 20px; }
    .vhm-right-block  { align-items: flex-start; text-align: left; max-width: 100%; }
    .vhm-cta-row      { flex-direction: column; align-items: flex-start; gap: 16px; }
    .vhm-title        { font-size: clamp(44px, 12vw, 70px); letter-spacing: -1.5px; }
  }

  @media (max-width: 480px) {
    .vhm-content      { padding: 20px 20px 28px; }
    .vhm-title        { font-size: clamp(38px, 13vw, 56px); letter-spacing: -1px; }
    .vhm-play-btn     { width: 58px; height: 58px; }
    .vhm-cta-buttons  { flex-direction: column; width: 100%; }
    .vhm-cta-primary,
    .vhm-cta-secondary { width: 100%; justify-content: center; }
    .vhm-scroll-hint  { display: none; }
  }
  @media (max-width: 900px) {
  .vhm-play-wrap {
    display: none;
  }
}
</style>

<section id="vhm-{{ section.id }}" class="vhm-section">
  <div class="vhm-video-wrap">

    {% if section.settings.video_type == 'mp4' %}
      <video
        id="vhm-vid-{{ section.id }}"
        src="{{ section.settings.video_url }}"
        {% if section.settings.autoplay %}autoplay muted playsinline{% endif %}
        {% if section.settings.loop %}loop{% endif %}
        poster="{% if section.settings.video_poster != blank %}{{ section.settings.video_poster | image_url: width: 1600 }}{% endif %}"
        preload="auto"
      ></video>

    {% elsif section.settings.video_type == 'youtube' %}
      <iframe
        src="https://www.youtube.com/embed/{{ section.settings.youtube_id }}?autoplay={% if section.settings.autoplay %}1{% else %}0{% endif %}&mute=1&loop={% if section.settings.loop %}1{% else %}0{% endif %}&playlist={{ section.settings.youtube_id }}&rel=0&modestbranding=1&controls=0&showinfo=0"
        allow="autoplay; encrypted-media"
        allowfullscreen
      ></iframe>

    {% elsif section.settings.video_type == 'vimeo' %}
      <iframe
        src="https://player.vimeo.com/video/{{ section.settings.vimeo_id }}?autoplay={% if section.settings.autoplay %}1{% else %}0{% endif %}&muted=1&loop={% if section.settings.loop %}1{% else %}0{% endif %}&title=0&byline=0&portrait=0&background=1"
        allow="autoplay; fullscreen"
        allowfullscreen
      ></iframe>
    {% endif %}

    <div class="vhm-overlay-top"></div>
    <div class="vhm-overlay-bottom"></div>
    <div class="vhm-grain"></div>

    <!-- CONTENT -->
    <div class="vhm-content">

      <!-- TOP BAR -->
      <div class="vhm-topbar" id="vhm-topbar-{{ section.id }}">
        {% if section.settings.badge_text != blank %}
          <span class="vhm-badge">{{ section.settings.badge_text }}</span>
        {% endif %}

        <div class="vhm-stats-row">
          {% if section.settings.stat1_num != blank %}
            <div class="vhm-stat-pill">
              <span class="vhm-stat-pill__num">{{ section.settings.stat1_num }}</span>
              <span class="vhm-stat-pill__label">{{ section.settings.stat1_label }}</span>
            </div>
          {% endif %}
          {% if section.settings.stat2_num != blank %}
            <div class="vhm-stats-divider"></div>
            <div class="vhm-stat-pill">
              <span class="vhm-stat-pill__num">{{ section.settings.stat2_num }}</span>
              <span class="vhm-stat-pill__label">{{ section.settings.stat2_label }}</span>
            </div>
          {% endif %}
          {% if section.settings.stat3_num != blank %}
            <div class="vhm-stats-divider"></div>
            <div class="vhm-stat-pill">
              <span class="vhm-stat-pill__num">{{ section.settings.stat3_num }}</span>
              <span class="vhm-stat-pill__label">{{ section.settings.stat3_label }}</span>
            </div>
          {% endif %}
        </div>
      </div>

      <!-- BOTTOM -->
      <div class="vhm-bottom" id="vhm-bottom-{{ section.id }}">

        <!-- title + desc row -->
        <div class="vhm-bottom-row">
          <div class="vhm-title-block">
            {% if section.settings.eyebrow != blank %}
              <span class="vhm-eyebrow">{{ section.settings.eyebrow }}</span>
            {% endif %}
            <h1 class="vhm-title">
              {{ section.settings.title_line1 | default: 'CREATIVES' }}<br>
              <em>{{ section.settings.title_line2 | default: 'CREATE' }}</em>
            </h1>
          </div>

          <div class="vhm-right-block">
            {% if section.settings.description != blank %}
              <p class="vhm-desc">{{ section.settings.description }}</p>
            {% endif %}
          </div>
        </div>

        <!-- play + cta row -->
        <div class="vhm-cta-row">
          <div class="vhm-play-wrap">
            <button class="vhm-play-btn" id="vhm-play-{{ section.id }}" aria-label="Play video">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                <polygon points="6,3 20,12 6,21" fill="white"/>
              </svg>
            </button>
            <div class="vhm-play-info">
              <span class="vhm-play-label">{{ section.settings.play_label | default: 'Watch Reel' }}</span>
              {% if section.settings.play_sub != blank %}
                <span class="vhm-play-sub">{{ section.settings.play_sub }}</span>
              {% endif %}
            </div>
          </div>

          <div class="vhm-cta-buttons">
            {% if section.settings.button_label != blank %}
              <a href="{{ section.settings.button_link | default: '#' }}" class="vhm-cta-primary">
                {{ section.settings.button_label }}
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
                  <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            {% endif %}
            {% if section.settings.button2_label != blank %}
              <a href="{{ section.settings.button2_link | default: '#' }}" class="vhm-cta-secondary">
                {{ section.settings.button2_label }}
              </a>
            {% endif %}
          </div>
        </div>

      </div>
    </div>

    <!-- SIDE TAGS -->
    <div class="vhm-side-tags" id="vhm-tags-{{ section.id }}">
      {% if section.settings.tag1 != blank %}<span class="vhm-tag">{{ section.settings.tag1 }}</span>{% endif %}
      {% if section.settings.tag2 != blank %}<span class="vhm-tag">{{ section.settings.tag2 }}</span>{% endif %}
    </div>

    <!-- SCROLL HINT -->
    <div class="vhm-scroll-hint" id="vhm-scroll-{{ section.id }}">
      <div class="vhm-scroll-mouse"></div>
      <span>{{ section.settings.scroll_text | default: 'Scroll' }}</span>
    </div>

  </div>
</section>

<script>
(function () {
  var sid     = '{{ section.id }}';
  var topbar  = document.getElementById('vhm-topbar-' + sid);
  var bottom  = document.getElementById('vhm-bottom-' + sid);
  var tags    = document.getElementById('vhm-tags-'   + sid);
  var scroll  = document.getElementById('vhm-scroll-' + sid);
  var playBtn = document.getElementById('vhm-play-'   + sid);
  var vid     = document.getElementById('vhm-vid-'    + sid);

  function animateIn() {
    [topbar, bottom, tags, scroll].forEach(function(el) {
      if (el) el.classList.add('vhm-in');
    });
  }

  if (document.readyState === 'complete') {
    setTimeout(animateIn, 120);
  } else {
    window.addEventListener('load', function() { setTimeout(animateIn, 120); });
  }

  if (playBtn && vid) {
    var playing = {{ section.settings.autoplay | default: true }};
    var pauseIcon = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><rect x="5" y="4" width="4" height="16" fill="white"/><rect x="15" y="4" width="4" height="16" fill="white"/></svg>';
    var playIcon  = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><polygon points="6,3 20,12 6,21" fill="white"/></svg>';

    if (playing) playBtn.innerHTML = pauseIcon;

    playBtn.addEventListener('click', function () {
      if (playing) {
        vid.pause();
        playBtn.innerHTML = playIcon;
      } else {
        vid.play();
        playBtn.innerHTML = pauseIcon;
      }
      playing = !playing;
    });
  }
})();
</script>

{% schema %}
{
  "name": "Video Hero Modern",
  "tag": "section",
  "class": "vhm-section-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "🎨 Colors"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#00f5a0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "subtext_color",
      "label": "Subtext Color",
      "default": "#ffffff99"
    },
    {
      "type": "header",
      "content": "🎬 Video"
    },
    {
      "type": "select",
      "id": "video_type",
      "label": "Video Source",
      "options": [
        { "value": "mp4",     "label": "Hosted MP4" },
        { "value": "youtube", "label": "YouTube" },
        { "value": "vimeo",   "label": "Vimeo" }
      ],
      "default": "mp4"
    },
    {
      "type": "url",
      "id": "video_url",
      "label": "MP4 Video URL"
    },
    {
      "type": "image_picker",
      "id": "video_poster",
      "label": "Poster / Thumbnail"
    },
    {
      "type": "text",
      "id": "youtube_id",
      "label": "YouTube Video ID"
    },
    {
      "type": "text",
      "id": "vimeo_id",
      "label": "Vimeo Video ID"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay (muted)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop",
      "default": true
    },
    {
      "type": "range",
      "id": "video_radius",
      "label": "Corner Radius (px)",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 0
    },
    {
      "type": "header",
      "content": "✏️ Content"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Top Badge",
      "default": "Accounting for Creatives"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text (above title)",
      "default": "Est. 2019"
    },
    {
      "type": "text",
      "id": "title_line1",
      "label": "Title Line 1 (solid)",
      "default": "CREATIVES"
    },
    {
      "type": "text",
      "id": "title_line2",
      "label": "Title Line 2 (outlined)",
      "default": "CREATE"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Bespoke accounting for the creative industry. We handle the numbers so you can stay in your zone."
    },
    {
      "type": "text",
      "id": "play_label",
      "label": "Play Button Label",
      "default": "Watch Reel"
    },
    {
      "type": "text",
      "id": "play_sub",
