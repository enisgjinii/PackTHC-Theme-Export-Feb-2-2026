{%- liquid
  assign section_id = '#shopify-section-' | append: section.id
  assign configurator_url = section.settings.configurator_base_url | default: 'https://dram-product-customizer.vercel.app'
  assign iframe_height = section.settings.iframe_height | default: 800
  assign show_header = section.settings.show_header
  assign show_product_bar = section.settings.show_product_bar
-%}

{{ 'product-configurator.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {{ section_id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  {{ section_id }} .configurator-wrapper {
    padding-top: var(--section-padding-top);
    padding-bottom: var(--section-padding-bottom);
  }
  {{ section_id }} .configurator-iframe {
    height: {{ iframe_height }}px;
  }
  @media (max-width: 768px) {
    {{ section_id }} .configurator-iframe {
      height: {{ section.settings.iframe_height_mobile | default: 550 }}px;
    }
  }
{%- endstyle -%}

<div class="configurator-wrapper">
  {%- if show_header -%}
    <div class="configurator-header">
      <h1 class="configurator-title">{{ section.settings.heading | default: '3D Product Configurator' }}</h1>
      <p class="configurator-subtitle">{{ section.settings.subheading | default: 'Design your custom packaging in real-time 3D' }}</p>
    </div>
  {%- endif -%}

  {%- comment -%} Product Info Bar — populated via Liquid or JS {%- endcomment -%}
  {%- if show_product_bar and product != blank -%}
    <div class="product-info-bar" id="product-info-bar-{{ section.id }}">
      {%- if product.featured_image -%}
        <img
          class="product-info-bar__image"
          src="{{ product.featured_image | image_url: width: 128 }}"
          alt="{{ product.title | escape }}"
          width="64"
          height="64"
          loading="lazy"
        >
      {%- endif -%}
      <div class="product-info-bar__details">
        <h2 class="product-info-bar__title">{{ product.title }}</h2>
        <p class="product-info-bar__meta">
          {%- if product.selected_or_first_available_variant.sku != blank -%}
            SKU: {{ product.selected_or_first_available_variant.sku }}
          {%- endif -%}
          {%- if product.vendor != blank -%}
            &nbsp;&middot;&nbsp; {{ product.vendor }}
          {%- endif -%}
        </p>
      </div>
      <div class="product-info-bar__price">
        {{ product.selected_or_first_available_variant.price | money }}
      </div>
      <div class="product-info-bar__actions">
        <button
          type="button"
          class="btn-configurator btn-configurator--primary btn-add-to-cart"
          data-variant-id="{{ product.selected_or_first_available_variant.id }}"
          id="configurator-add-to-cart-{{ section.id }}"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
          <span class="btn-add-to-cart__text">Add to Cart</span>
          <svg class="btn-add-to-cart__spinner hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>
        </button>
        <a href="{{ product.url }}" class="btn-configurator btn-configurator--secondary">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          Back
        </a>
      </div>
    </div>
  {%- elsif show_product_bar -%}
    <div class="product-info-bar" id="product-info-bar-{{ section.id }}" style="display:none;">
      {%- comment -%} Will be populated by JS when product comes from URL params {%- endcomment -%}
    </div>
  {%- endif -%}

  {%- comment -%} Toolbar {%- endcomment -%}
  <div class="configurator-toolbar">
    <button
      class="btn-configurator btn-configurator--icon btn-configurator--ghost"
      data-action="refresh"
      title="Reload Configurator"
      aria-label="Reload Configurator"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
    </button>
    <button
      class="btn-configurator btn-configurator--icon btn-configurator--ghost"
      data-action="fullscreen"
      title="Fullscreen"
      aria-label="Toggle Fullscreen"
    >
      <svg class="fs-expand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/></svg>
      <svg class="fs-collapse hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="4 14 10 14 10 20"/><polyline points="20 10 14 10 14 4"/><line x1="14" y1="10" x2="21" y2="3"/><line x1="3" y1="21" x2="10" y2="14"/></svg>
    </button>
  </div>

  {%- comment -%} Iframe Container {%- endcomment -%}
  <div id="configurator-container-{{ section.id }}" class="configurator-iframe-container" style="display: none;">
    <div class="configurator-loading" id="configurator-loading-{{ section.id }}">
      <div class="configurator-loading__spinner"></div>
      <p class="configurator-loading__text">Loading 3D Configurator&hellip;</p>
    </div>
    <iframe
      id="configurator-iframe-{{ section.id }}"
      class="configurator-iframe"
      title="PackTHC 3D Product Configurator"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; fullscreen; camera; microphone"
      sandbox="allow-scripts allow-same-origin allow-popups allow-forms allow-modals allow-top-navigation-by-user-activation allow-downloads"
      allowfullscreen
      loading="lazy"
    ></iframe>
  </div>

  {%- comment -%} Error / No Product State {%- endcomment -%}
  <div class="configurator-error" id="configurator-error-{{ section.id }}" style="display: none;">
    <svg class="configurator-error__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
      <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
    </svg>
    <h3 class="configurator-error__title">No Product Selected</h3>
    <p class="configurator-error__text">Please select a product to customize from our catalog.</p>
    <a href="/collections/all" class="btn-configurator btn-configurator--primary">Browse Products</a>
  </div>

  {%- comment -%} Configuration payload for JS {%- endcomment -%}
  <script type="application/json" data-configurator-config>
    {
      "baseUrl": {{ configurator_url | json }},
      "shop": {
        "domain": {{ shop.permanent_domain | json }},
        "name": {{ shop.name | json }}
      },
      "product": {
        {%- if product != blank -%}
          "handle": {{ product.handle | json }},
          "productId": {{ product.id | json }},
          "variantId": {{ product.selected_or_first_available_variant.id | json }},
          "title": {{ product.title | json }},
          "sku": {{ product.selected_or_first_available_variant.sku | default: '' | json }},
          "vendor": {{ product.vendor | json }},
          "image": {{ product.featured_image | image_url: width: 400 | json }},
          "price": {{ product.selected_or_first_available_variant.price | money_without_currency | json }}
        {%- else -%}
          "handle": null,
          "productId": null,
          "variantId": null,
          "title": null,
          "sku": null,
          "vendor": null,
          "image": null,
          "price": null
        {%- endif -%}
      }
    }
  </script>
</div>

{%- comment -%}
  Inline fallback script for when product comes from URL params (standalone page usage).
  The external JS file handles the main logic; this covers URL-param-based product loading.
{%- endcomment -%}
<script>
  (function() {
    var sectionId = {{ section.id | json }};
    var baseUrl   = {{ configurator_url | json }};
    var shopDomain = {{ shop.permanent_domain | json }};
    var shopName   = {{ shop.name | json }};

    {% if product != blank %}
      // Product set via Liquid — external JS handles it
      return;
    {% endif %}

    document.addEventListener('DOMContentLoaded', function() {
      var params = new URLSearchParams(window.location.search);
      var handle = params.get('product');
      var productId = params.get('product_id');

      if (!handle && !productId) {
        var err = document.getElementById('configurator-error-' + sectionId);
        if (err) err.style.display = 'block';
        return;
      }

      var productData = {
        handle:    handle,
        productId: productId,
        variantId: params.get('variant_id'),
        title:     params.get('title') ? decodeURIComponent(params.get('title')) : null,
        sku:       params.get('sku'),
        vendor:    params.get('vendor') ? decodeURIComponent(params.get('vendor')) : null,
        image:     params.get('image') ? decodeURIComponent(params.get('image')) : null,
        price:     params.get('price')
      };

      // Populate product info bar
      var infoBar = document.getElementById('product-info-bar-' + sectionId);
      if (infoBar && (productData.title || productData.handle)) {
        infoBar.style.display = 'flex';
        infoBar.innerHTML = ''
          + (productData.image ? '<img class="product-info-bar__image" src="' + productData.image + '" alt="' + (productData.title || 'Product') + '" width="64" height="64">' : '')
          + '<div class="product-info-bar__details">'
          +   '<h2 class="product-info-bar__title">' + (productData.title || productData.handle || 'Custom Product') + '</h2>'
          +   '<p class="product-info-bar__meta">'
          +     (productData.sku ? 'SKU: ' + productData.sku : '')
          +     (productData.vendor ? ' &middot; ' + productData.vendor : '')
          +   '</p>'
          + '</div>'
          + (productData.price ? '<div class="product-info-bar__price">$' + productData.price + '</div>' : '')
          + '<div class="product-info-bar__actions">'
          +   '<button type="button" class="btn-configurator btn-configurator--primary btn-add-to-cart" data-variant-id="' + (productData.variantId || '') + '" id="configurator-add-to-cart-' + sectionId + '">'
          +     '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>'
          +     '<span class="btn-add-to-cart__text">Add to Cart</span>'
          +     '<svg class="btn-add-to-cart__spinner hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>'
          +   '</button>'
          +   '<a href="/products/' + (productData.handle || '') + '" class="btn-configurator btn-configurator--secondary">'
          +     '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>'
          +     ' Back'
          +   '</a>'
          + '</div>';
      }

      // Build iframe URL
      var iframeParams = new URLSearchParams();
      if (productData.handle)    iframeParams.set('product', productData.handle);
      if (productData.productId) iframeParams.set('product_id', productData.productId);
      if (productData.variantId) iframeParams.set('variant_id', productData.variantId);
      if (productData.title)     iframeParams.set('title', productData.title);
      if (productData.sku)       iframeParams.set('sku', productData.sku);
      if (productData.vendor)    iframeParams.set('vendor', productData.vendor);
      if (productData.image)     iframeParams.set('image', productData.image);
      if (productData.price)     iframeParams.set('price', productData.price);
      iframeParams.set('shop', shopDomain);
      iframeParams.set('shop_name', shopName);

      var sep = baseUrl.indexOf('?') > -1 ? '&' : '?';
      var iframeUrl = baseUrl + sep + iframeParams.toString();

      var container = document.getElementById('configurator-container-' + sectionId);
      var iframe    = document.getElementById('configurator-iframe-' + sectionId);
      var loading   = document.getElementById('configurator-loading-' + sectionId);

      if (container && iframe) {
        container.style.display = 'block';
        iframe.src = iframeUrl;
        iframe.addEventListener('load', function() {
          if (loading) loading.style.display = 'none';
        });
        setTimeout(function() { if (loading) loading.style.display = 'none'; }, 15000);
      }
    });
  })();
</script>

<script src="{{ 'product-configurator.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "3D Configurator",
  "tag": "section",
  "class": "product-configurator-section",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "checkbox",
      "id": "show_header",
      "label": "Show section header",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "3D Product Configurator"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Design your custom packaging in real-time 3D"
    },
    {
      "type": "header",
      "content": "Configurator"
    },
    {
      "type": "url",
      "id": "configurator_base_url",
      "label": "Configurator URL",
      "info": "The deployed URL of your Next.js 3D configurator app. Leave empty to use default."
    },
    {
      "type": "range",
      "id": "iframe_height",
      "label": "Desktop Height (px)",
      "min": 500,
      "max": 1200,
      "step": 25,
      "default": 800,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "iframe_height_mobile",
      "label": "Mobile Height (px)",
      "min": 400,
      "max": 900,
      "step": 25,
      "default": 550,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Product Info"
    },
    {
      "type": "checkbox",
      "id": "show_product_bar",
      "label": "Show product info bar",
      "default": true,
      "info": "Displays product name, image, price, and back button above the configurator."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "3D Product Configurator",
      "settings": {
        "show_header": true,
        "heading": "3D Product Configurator",
        "subheading": "Design your custom packaging in real-time 3D",
        "iframe_height": 800,
        "iframe_height_mobile": 550,
        "show_product_bar": true,
        "padding_top": 20,
        "padding_bottom": 40
      }
    }
  ],
  "templates": ["page", "product"]
}
{% endschema %}
