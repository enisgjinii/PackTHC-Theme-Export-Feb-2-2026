{%- liquid
	assign section_id        = '#shopify-section-' | append: section.id
	assign animation         = settings.section_animation
-%}

<style>
	{{ section_id }} .section-wrapper {
		padding-top: {{ section.settings.padding_top }}px;
		padding-bottom: {{ section.settings.padding_bottom }}px;
	}

	@media (min-width: 992px) {
		{{ section_id }} .split-screen-slideshow-slider {
			width: {{- 100 | minus: section.settings.width -}}%;
		}

		{{ section_id }} .split-screen-slideshow-content {
			width: {{- section.settings.width -}}%;
		}
	}

	@media (max-width: 991px) {
		{{ section_id }} .section-wrapper {
			padding-top: {{ section.settings.padding_top_mobile }}px;
			padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
		}
	}

	{%- for block in section.blocks -%}
		{%- liquid
			assign card_bg           = block.settings.card_bg
			assign card_color        = block.settings.card_color
			assign card_sale_color   = card_color | color_lighten: 5
			assign sub_heading_color = block.settings.sub_heading_color
		-%}

		{{ section_id }} .swiper-slide[data-{{ block.id }}] {
			{%- if card_bg != blank -%}
				--product-card-bg: {{ card_bg.red }}, {{ card_bg.green }}, {{ card_bg.blue }};
			{%- endif -%}

			{%- if card_color != blank -%}
				--text-color: {{ card_color.red }}, {{ card_color.green }}, {{ card_color.blue }};
				--sale-price-color: {{ card_sale_color.red }}, {{ card_sale_color.green }}, {{ card_sale_color.blue }};
			{%- endif -%}
		}

		{%- if sub_heading_color != blank -%}
		{{ section_id }} .sub-heading {
			color: {{ sub_heading_color }};
		}
	{%- endif -%}
	{%- endfor -%}
</style>

<div class="section-wrapper color-{{ section.settings.color_scheme }}">
	<div class="container">
		<div class="section-inner">
			<div class="split-screen-slideshow-content carousel-swiper{% if animation %} scroll-trigger{% endif %}">
				<template data-options data-css-mode="off">
					{
						{%- if section.settings.loop -%}
							"loop": true,
						{%- endif -%}

						"navigation": {
							"nextEl": "{{ section_id }} .swiper-button-next",
							"prevEl": "{{ section_id }} .swiper-button-prev"
						},

						"pagination": {
							"el": "{{ section_id }} .swiper-pagination",
							"clickable": true
						},

						"allowTouchMove": false,
						"autoHeight": true,
						"spaceBetween": 20,
						"speed": {{ section.settings.speed | times: 1000 }},
						"slidesPerView": 1,
						"breakpoints": {
							"240": {
								"slidesPerView": 1,
								"spaceBetween": 15
							},
							"992": {
								"slidesPerView": 1
							}
						}
					}
				</template>
				<div class="swiper">
					<div class="swiper-wrapper">
						{%- for block in section.blocks -%}
							<div class="swiper-slide content">
								{%- liquid
									assign heading          = block.settings.heading
									assign sub_heading      = block.settings.sub_heading
									assign description      = block.settings.description
									assign rating           = block.settings.rating
									assign footer_text      = block.settings.footer_text
								-%}

								{%- if heading != blank -%}
									<h2 class="heading rte h4">{{- heading -}}</h2>
								{%- endif -%}

								{%- unless rating == '0' -%}
									<div class="ratings-stars">
										{%- for i in (1..rating) -%}
											<span class="star">
												{%- render 'icon', code: 'star' -%}
											</span>
										{%- endfor -%}
									</div>
								{%- endunless -%}

								{%- if sub_heading != blank -%}
									<h4 class="sub-heading rte text-body">{{- sub_heading -}}</h4>
								{%- endif -%}

								{%- if description != blank -%}
									<div class="description rte h3">{{- description -}}</div>
								{%- endif -%}

								{%- if footer_text != blank -%}
									<div class="author-info">
										{{- footer_text -}}
									</div>
								{%- endif -%}
							</div>
						{%- endfor -%}
					</div>
				</div>
				<div class="swiper-controls">
					<button class="swiper-button-prev" title ="{{ 'general.swipper.prev' | t }}" aria-label="{{ 'general.swipper.prev' | t }}" id="{{ 'general.swipper.prev' | t }}" aria-labelledby="{{ 'general.swipper.prev' | t }}">{%- render 'icon', code: 'arrow-left-slider' -%}</button>
					<div class="swiper-pagination" tabindex="-1"></div>
					<button class="swiper-button-next" title ="{{ 'general.swipper.next' | t }}" aria-label="{{ 'general.swipper.next' | t }}" id="{{ 'general.swipper.next' | t }}" aria-labelledby="{{ 'general.swipper.next' | t }}">{%- render 'icon', code: 'arrow-right-slider' -%}</button>
				</div>
			</div>

			<div class="split-screen-slideshow-slider carousel-swiper{% if animation %} scroll-trigger{% endif %}">
				<template data-options data-css-mode="off">
					{
						{%- if section.settings.loop -%}
							"loop": true,
						{%- endif -%}

						{%- if section.settings.autoplay -%}
							"autoplay": {
								"delay": {{ section.settings.delay | times: 1000 }},
								"disableOnInteraction": false,
								"pauseOnMouseEnter": true
							},
						{%- endif -%}

						"navigation": {
							"nextEl": "{{ section_id }} .swiper-button-next",
							"prevEl": "{{ section_id }} .swiper-button-prev"
						},

						"pagination": {
							"el": "{{ section_id }} .swiper-pagination",
							"clickable": true
						},
						"allowTouchMove": false,
						"autoHeight": true,
						"spaceBetween": 32,
						"speed": {{ section.settings.speed | times: 1000 }},
						"slidesPerView": 1,
						"breakpoints": {
							"240": {
								"slidesPerView": 1,
								"spaceBetween": 0
							},
							"992": {
								"slidesPerView": 1.3
							}
						}
					}
				</template>

				<div class="swiper">
					<div class="swiper-wrapper">
						{%- for block in section.blocks -%}
							{%- liquid
								assign image   = block.settings.image
								assign product = block.settings.product
							-%}

							<div class="swiper-slide" {{ block.shopify_attributes }} data-{{ block.id }} {% if request.design_mode %} data-index="{{ forloop.index0 }}"{% endif %}>
								<div class="list-item{% if animation %} scroll-trigger{% endif %}">
									<a class="card-media" href="{{ product.url }}">
										<span class="card-media-wrapper{% if settings.image_lazy and product.featured_image != blank %} lazy-image{% endif %}">
											{%- liquid
												if product.featured_image != blank
													render 'lazy-image', image: product.featured_image, width: 768
												else
													render 'icon', code: 'placeholder'
												endif
											-%}
										</span>
									</a>
									<div class="infor-card">
										{%- if product.title != blank -%}
											<h6 class="card-title">
												{{- product.title -}}
											</h6>
										{%- else -%}
											<h6 class="card-title">
												<span>{{- 'onboarding.products.title' | t -}}</span>
											</h6>
										{%- endif -%}

										{%- if product != blank -%}
											{% render 'price', product: product, price_class: 'card-item' %}
										{%- else -%}
											{% render 'price', product: false, price_class: 'card-item' %}
										{%- endif -%}

										<a href="{{ product.url }}" class="card-url link-underline">
											{{- 'onboarding.products.shop_all' | t -}}
										</a>
									</div>
								</div>

								<div class="adapt-media">
									<div class="media{% if settings.image_lazy and image != blank %} lazy-image{% endif %}">
										{%- liquid
											if image != blank
												render 'lazy-image', image: image, width: 755
											else
												render 'icon', code: 'placeholder'
											endif
										-%}
									</div>
								</div>
							</div>
						{%- endfor -%}
					</div>


				</div>
			</div>
		</div>
	</div>
</div>

{% schema %}
{
	"name": "t:sections.testimonial-with-product-slideshow.name",
	"tag": "section",
	"class": "testimonial-with-product-slideshow-section",
	"disabled_on": {
		"groups": ["header", "footer"]
	},
	"settings": [
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"label": "t:settings_schema.colors.label",
			"default": "scheme-1"
		},
		{
			"type": "range",
			"id": "width",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 50,
			"unit": "%",
			"label": "t:general.dimensions.width.label"
		},
		{
			"type": "header",
			"content": "t:general.slider.options.label"
		},
		{
			"type": "checkbox",
			"id": "loop",
			"default": false,
			"label": "t:general.slider.loop.label"
		},
		{
			"type": "checkbox",
			"id": "autoplay",
			"default": false,
			"label": "t:general.slider.autoplay.label"
		},
		{
			"type": "range",
			"id": "delay",
			"default": 9,
			"min": 3,
			"max": 10,
			"step": 0.1,
			"label": "t:general.slider.delay.label"
		},
		{
			"type": "range",
			"id": "speed",
			"default": 0.5,
			"min": 0,
			"max": 2,
			"step": 0.1,
			"label": "t:general.slider.speed.label"
		},
		{
			"type": "header",
			"content": "t:general.padding.header_padding.content"
		},
		{
			"type": "range",
			"id": "padding_top",
			"min": 50,
			"max": 150,
			"step": 1,
			"default": 50,
			"unit": "px",
			"label": "t:general.padding.top.label"
		},
		{
			"type": "range",
			"id": "padding_bottom",
			"min": 50,
			"max": 150,
			"step": 1,
			"default": 50,
			"unit": "px",
			"label": "t:general.padding.bottom.label"
		},
		{
			"type": "paragraph",
			"content": "t:general.padding.paragraph_mobile.content"
		},
		{
			"type": "range",
			"id": "padding_top_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 60,
			"unit": "px",
			"label": "t:general.padding.top.label"
		},
		{
			"type": "range",
			"id": "padding_bottom_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 60,
			"unit": "px",
			"label": "t:general.padding.bottom.label"
		}
	],
	"blocks": [
		{
			"type": "slide",
			"name": "t:general.slider.slide.label",
			"settings": [
		{
			"type": "inline_richtext",
			"id": "heading",
			"default": "Heading",
			"label": "t:general.typography.heading.label"
		},
		{
			"type": "select",
			"id": "rating",
			"default": "5",
			"label": "t:sections.testimonial.settings.rating.label",
			"options": [
				{
					"value": "5",
					"label": "t:sections.testimonial.settings.rating.star_5.label"
				},
				{
					"value": "4",
					"label": "t:sections.testimonial.settings.rating.star_4.label"
				},
				{
					"value": "3",
					"label": "t:sections.testimonial.settings.rating.star_3.label"
				},
				{
					"value": "2",
					"label": "t:sections.testimonial.settings.rating.star_2.label"
				},
				{
					"value": "1",
					"label": "t:sections.testimonial.settings.rating.star_1.label"
				},
				{
					"value": "0",
					"label": "t:sections.testimonial.settings.rating.none.label"
				}
			]
		},
		{
			"type": "inline_richtext",
			"id": "sub_heading",
			"label": "t:general.typography.sub_heading.label"
		},
		{
			"type": "richtext",
			"id": "description",
			"default": "<p>Pair text with an image to focus on your chosen product, collection, or blog post. Add details on availability, style, or even provide a review.</p>",
			"label": "t:general.typography.description.label"
		},
		{
			"type": "inline_richtext",
			"id": "footer_text",
			"default": "— Buyer's name",
			"label": "t:sections.testimonial.settings.author_info.label"
		},
		{
			"type": "product",
			"id": "product",
			"label": "t:settings_schema.product.name"
		},
		{
			"type": "image_picker",
			"id": "image",
			"label": "t:general.image.label"
		}
		]
		}
	],
	"presets": [
		{
			"name": "t:sections.testimonial-with-product-slideshow.name",
			"blocks": [
				{
					"type": "slide"
				},
				{
					"type": "slide"
				},
				{
					"type": "slide"
				}
			]
		}
	]
}
{% endschema %}
