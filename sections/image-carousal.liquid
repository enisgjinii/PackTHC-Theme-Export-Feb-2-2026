{% schema %}
{
  "name": "Infinite Image Carousel",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Carousel Title",
      "default": "Featured Products"
    },
    {
      "type": "range",
      "id": "height",
      "min": 200,
      "max": 800,
      "step": 50,
      "unit": "px",
      "label": "Carousel Height",
      "default": 400
    },
    {
      "type": "range",
      "id": "slide_width",
      "min": 200,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Slide Width",
      "default": 300
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Gap Between Slides",
      "default": 30
    },
    {
      "type": "range",
      "id": "speed",
      "min": 1,
      "max": 10,
      "step": 1,
      "label": "Scroll Speed",
      "default": 3
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt Text",
          "info": "Description for accessibility"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Infinite Image Carousel",
      "category": "Image"
    }
  ]
}
{% endschema %}

<style>
  .infinite-carousel-container {
    width: 100%;
    height: {{ section.settings.height }}px;
    overflow: hidden;
    position: relative;
    margin: 20px 0;
  }

  .infinite-carousel-track {
    display: flex;
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;
  }

  .infinite-carousel-slide {
    min-width: {{ section.settings.slide_width }}px;
    height: 100%;
    position: relative;
    overflow: hidden;
    margin-right: {{ section.settings.gap }}px;
  }

  .infinite-carousel-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 10px;
    transition: transform 0.3s ease;
  }

  .infinite-carousel-slide:hover img {
    transform: scale(1.05);
  }

  .infinite-carousel-title {
    position: absolute;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    color: white;
    font-size: 24px;
    font-weight: bold;
    text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
    z-index: 10;
  }
</style>

<div class="infinite-carousel-container">
  {% if section.settings.title != blank %}
    <h2 class="infinite-carousel-title">{{ section.settings.title }}</h2>
  {% endif %}
  
  <div class="infinite-carousel-track" id="infiniteCarouselTrack-{{ section.id }}">
    {% for block in section.blocks %}
      <div class="infinite-carousel-slide" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          <img src="{{ block.settings.image | img_url: '800x' }}" 
               alt="{{ block.settings.alt_text | escape }}"
               loading="lazy">
        {% else %}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const sectionId = '{{ section.id }}';
  const track = document.getElementById(`infiniteCarouselTrack-${sectionId}`);
  
  if (!track) return;
  
  const slides = Array.from(track.children);
  
  // Only proceed if there are slides
  if (slides.length === 0) return;
  
  const slideWidth = slides[0].getBoundingClientRect().width;
  const gap = {{ section.settings.gap }};
  const speed = {{ section.settings.speed }};
  
  // Clone all slides and append them to create seamless loop
  const clonedSlides = slides.map(slide => slide.cloneNode(true));
  clonedSlides.forEach(clone => {
    track.appendChild(clone);
  });
  
  const totalSlides = slides.length;
  const totalWidth = (slideWidth + gap) * totalSlides;
  
  let currentPosition = 0;
  
  function animate() {
    currentPosition -= speed;
    
    // When we've scrolled one full set of slides, reset position
    if (Math.abs(currentPosition) >= totalWidth) {
      currentPosition = 0;
    }
    
    track.style.transform = `translateX(${currentPosition}px)`;
    requestAnimationFrame(animate);
  }
  
  // Start animation
  animate();
  
  // Pause on hover
  track.addEventListener('mouseenter', function() {
    speed = 0;
  });
  
  track.addEventListener('mouseleave', function() {
    speed = {{ section.settings.speed }};
  });
});
</script>