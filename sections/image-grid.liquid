{% schema %}
{
  "name": "Image Grid",
  "settings": [
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "Images per row (Desktop)"
    }
  ],
  "blocks": [
    {
      "type": "image_block",
      "name": "Image Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Upload Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image Grid",
      "category": "Custom"
    }
  ]
}
{% endschema %}

{% style %}
.collection-grid-wrapper {
  display: flex;
  flex-wrap: wrap;
  margin: 0;
  padding: 0;
}
.collection-item {
  text-align: center;
  width: calc(100% / {{ section.settings.columns }});
  margin: 0;
  padding: 4px;
}
.collection-image {
  overflow: hidden;
  position: relative;
}
.collection-image img {
  width: 100%;
  height: auto;
  object-fit: contain;
  background: #fff;
  transition: transform 0.15s ease-in-out;
  display: block;
}
.collection-info h3 {
  margin: 10px 0 4px;
  font-size: 16px;
  font-weight: 600;
}
.collection-image:hover img {
  transform: scale(1.1);
}
@media (max-width: 767px) {
  .collection-item {
    width: 50%;
  }
  .collection-info h3 {
    font-size: 14px;
  }
}
{% endstyle %}

<div class="container">
  <div class="collection-grid-wrapper">
    {% for block in section.blocks %}
      {% assign image = block.settings.image %}
      {% assign title = block.settings.title %}
      {% assign link = block.settings.link %}
      
      {% if image != blank %}
        <div class="collection-item" {{ block.shopify_attributes }}>
          <div class="collection-image">
            {% if link != blank %}
              <a href="{{ link }}">
                {% render 'responsive-image', image: image, title: title %}
              </a>
            {% else %}
              {% render 'responsive-image', image: image, title: title %}
            {% endif %}
          </div>
          {% if title != blank %}
            <div class="collection-info">
              <h3>{{ title }}</h3>
            </div>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>