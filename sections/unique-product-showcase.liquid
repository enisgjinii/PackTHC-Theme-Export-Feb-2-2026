{% schema %}
{
  "name": "Hero Product Showcase",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "Featured Hero Product"
    },
    {
      "type": "text",
      "id": "section_subtitle",
      "label": "Section Subtitle",
      "default": "Discover our most popular product"
    },
    {
      "type": "product",
      "id": "hero_product",
      "label": "Select Hero Product"
    },
    {
      "type": "text",
      "id": "hero_badge",
      "label": "Hero Badge Text",
      "default": "BESTSELLER"
    },
    {
      "type": "text",
      "id": "discount_text",
      "label": "Discount Text",
      "default": "50% OFF"
    },
    {
      "type": "text",
      "id": "price_below_text",  // NEW FIELD ADDED
      "label": "Bold Text Below Price",
      "default": "Limited Time Offer!"
    },
    {
      "type": "textarea",
      "id": "hero_description",
      "label": "Hero Product Description",
      "default": "Experience the ultimate quality and performance with our hero product."
    },
    {
      "type": "text",
      "id": "cta_primary",
      "label": "Primary Button Text",
      "default": "Buy Now"
    },
    {
      "type": "text",
      "id": "cta_secondary",
      "label": "Secondary Button Text",
      "default": "Add to Cart"
    },
    {
      "type": "checkbox",
      "id": "show_reviews",
      "label": "Show Customer Reviews",
      "default": true
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "Review Count",
      "default": "2,847"
    },
    {
      "type": "range",
      "id": "star_rating",
      "label": "Star Rating",
      "min": 1,
      "max": 5,
      "step": 0.5,
      "default": 4.5
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Product Feature",
      "settings": [
        {
          "type": "text",
          "id": "feature_icon",
          "label": "Feature Icon (SVG or Unicode)",
          "default": "✨"
        },
        {
          "type": "text",
          "id": "feature_title",
          "label": "Feature Title",
          "default": "Premium Quality"
        },
        {
          "type": "text",
          "id": "feature_description",
          "label": "Feature Description",
          "default": "Made with finest materials"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Product Showcase",
      "category": "Product"
    }
  ]
}
{% endschema %}

<style>
  .hero-product-showcase {
    font-family: "ITC Avant Garde Gothic", sans-serif;
    background: linear-gradient(135deg, #fff 0%, #f8f9fa 100%);
    padding: 80px 0;
    position: relative;
    overflow: hidden;
  }

  .hero-product-showcase::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grain" width="100" height="100" patternUnits="userSpaceOnUse"><circle cx="20" cy="20" r="0.5" fill="%23E0131A" opacity="0.05"/><circle cx="80" cy="80" r="0.3" fill="%23202425" opacity="0.03"/><circle cx="40" cy="60" r="0.4" fill="%23E0131A" opacity="0.04"/></pattern></defs><rect width="100" height="100" fill="url(%23grain)"/></svg>');
    pointer-events: none;
  }

  .hero-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
    position: relative;
    z-index: 2;
  }

  .hero-section-header {
    text-align: center;
    margin-bottom: 60px;
    position: relative;
  }

  .hero-section-title {
    font-size: 50px;
    font-weight: 700;
    color: #202425;
    margin-bottom: 15px;
    text-transform: uppercase;
    letter-spacing: 2px;
    position: relative;
    display: inline-block;
  }

  .hero-section-title::after {
    content: '';
    position: absolute;
    bottom: -10px;
    left: 50%;
    transform: translateX(-50%);
    width: 80px;
    height: 4px;
    background: linear-gradient(90deg, #E0131A 0%, #8B0000 100%);
    border-radius: 2px;
  }

  .hero-section-subtitle {
    font-size: 1.3rem;
    color: #666;
    margin-top: 25px;
    font-weight: 400;
  }

  .hero-product-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
    margin-bottom: 60px;
  }

  .hero-product-images {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero-main-image {
    position: relative;
    width: 100%;
    max-width: 500px;
    height: 500px;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0,0,0,0.15);
    background: linear-gradient(135deg, #fff 0%, #f8f9fa 100%);
    transition: all 0.4s ease;
  }

  .hero-main-image:hover {
    transform: translateY(-10px) scale(1.02);
    box-shadow: 0 30px 80px rgba(224, 19, 26, 0.2);
  }

  .hero-main-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .hero-main-image:hover img {
    transform: scale(1.1);
  }

  .hero-badge {
    position: absolute;
    top: 20px;
    left: 20px;
    background: linear-gradient(135deg, #E0131A 0%, #8B0000 100%);
    color: white;
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    z-index: 3;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0% { transform: scale(1); }
    50% { transform: scale(1.05); }
    100% { transform: scale(1); }
  }

  .hero-discount {
    display: none;
    position: absolute;
    top: 20px;
    right: 20px;
    background: #202425;
    color: white;
    padding: 12px 18px;
    border-radius: 50%;
    font-size: 1rem;
    font-weight: 700;
    z-index: 3;
    animation: bounce 2s infinite;
  }

  @keyframes bounce {
    0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
    40% { transform: translateY(-10px); }
    60% { transform: translateY(-5px); }
  }

  .hero-product-info {
    padding: 20px 0;
  }

  .hero-product-title {
    font-size: 3rem;
    font-weight: 700;
    color: #202425;
    margin-bottom: 20px;
    line-height: 1.2;
  }

  .hero-product-price {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 20px;
  }

  .hero-current-price {
    font-size: 2.5rem;
    font-weight: 800;
    color: #E0131A;
  }

  .hero-original-price {
    font-size: 1.5rem;
    color: #999;
    text-decoration: line-through;
  }

  .hero-savings {
    background: #28a745;
    color: white;
    padding: 4px 12px;
    border-radius: 15px;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .hero-reviews {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 25px;
  }

  .hero-stars {
    display: flex;
    gap: 2px;
  }

  .hero-star {
    width: 20px;
    height: 20px;
    background: #ddd;
    border-radius: 50%;
    position: relative;
    overflow: hidden;
  }

  .hero-star.filled {
    background: linear-gradient(135deg, #E0131A 0%, #8B0000 100%);
  }

  .hero-star.half::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 50%;
    height: 100%;
    background: linear-gradient(135deg, #E0131A 0%, #8B0000 100%);
  }

  .hero-review-text {
    font-size: 1rem;
    color: #666;
    font-weight: 500;
  }

  .hero-description {
    font-size: 1.2rem;
    color: #555;
    line-height: 1.6;
    margin-bottom: 30px;
  }

  .hero-features {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 40px;
  }

  .hero-feature {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 20px;
    background: white;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    transition: all 0.3s ease;
  }

  .hero-feature:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 30px rgba(224, 19, 26, 0.15);
  }

  .hero-feature-icon {
    font-size: 1.5rem;
    color: #E0131A;
    min-width: 40px;
    text-align: center;
  }

  .hero-feature-content h4 {
    font-size: 1rem;
    font-weight: 600;
    color: #202425;
    margin-bottom: 5px;
  }

  .hero-feature-content p {
    font-size: 0.9rem;
    color: #666;
    margin: 0;
  }

  .hero-cta-buttons {
    display: flex;
    gap: 20px;
    margin-bottom: 30px;
  }

  .hero-btn {
    padding: 18px 40px;
    border: none;
    border-radius: 50px;
    font-size: 15px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }

  .hero-btn-primary {
    background: linear-gradient(135deg, #E0131A 0%, #8B0000 100%);
    color: white;
    box-shadow: 0 8px 25px rgba(224, 19, 26, 0.3);
  }

  .hero-btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 35px rgba(224, 19, 26, 0.4);
  }

  .hero-btn-secondary {
    display: none;
    background: white;
    color: #202425;
    border: 2px solid #202425;
  }

  .hero-btn-secondary:hover {
    background: #202425;
    color: white;
    transform: translateY(-3px);
  }

  .hero-trust-indicators {
    display: none;
    justify-content: center;
    gap: 40px;
    margin-top: 40px;
    padding: 30px;
    background: white;
    border-radius: 15px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
  }

  .trust-item {
    text-align: center;
    flex: 1;
  }

  .trust-icon {
    font-size: 2rem;
    color: #E0131A;
    margin-bottom: 10px;
  }

  .trust-title {
    font-size: 1rem;
    font-weight: 600;
    color: #202425;
    margin-bottom: 5px;
  }

  .trust-subtitle {
    font-size: 0.9rem;
    color: #666;
  }

  /* Previous CSS remains the same, just adding the new style */
  .hero-price-below-text {
    font-size: 13px;
    font-weight: 700;
    color: #E0131A;
    margin-bottom: 15px;
    text-transform: uppercase;
    letter-spacing: 1px;
    display: inline-block;
    padding: 5px 15px;
    background-color: rgba(224, 19, 26, 0.1);
    border-radius: 5px;
  }
  
  /* Rest of your existing CSS remains unchanged */
  .hero-product-showcase {
    font-family: "ITC Avant Garde Gothic", sans-serif;
    background: linear-gradient(135deg, #fff 0%, #f8f9fa 100%);
    padding: 80px 0;
    position: relative;
    overflow: hidden;
  }

  /* Responsive Design */
  @media (max-width: 1024px) {
    .hero-product-grid {
      gap: 50px;
    }
    
    .hero-section-title {
      font-size: 2.8rem;
    }
    
    .hero-product-title {
      font-size: 2.5rem;
    }
  }

  @media (max-width: 768px) {
    .hero-product-showcase {
      padding: 50px 0;
    }
    
    .hero-product-grid {
      grid-template-columns: 1fr;
      gap: 40px;
      text-align: start;
    }
    
    .hero-section-title {
      font-size: 2.2rem;
    }
    
    .hero-product-title {
      font-size: 2rem;
    }
    
    .hero-main-image {
      height: 400px;
      max-width: 400px;
    }
    
    .hero-features {
      grid-template-columns: 1fr;
      gap: 15px;
    }
    
    .hero-cta-buttons {
      flex-direction: column;
      align-items: start;
    }
    
    .hero-btn {
      width: 100%;
      max-width: 300px;
    }
    
    .hero-trust-indicators {
      flex-direction: column;
      gap: 20px;
    }
  }

  @media (max-width: 480px) {
    .hero-container {
      padding: 0 15px;
    }
    
    .hero-section-title {
      font-size: 1.8rem;
    }
    
    .hero-product-title {
      font-size: 1.6rem;
    }
    
    .hero-main-image {
      height: 300px;
      max-width: 300px;
    }
    
    .hero-current-price {
      font-size: 2rem;
    }
  }
</style>

<section class="hero-product-showcase" data-section-id="{{ section.id }}">
  <div class="hero-container">
    <!-- Section Header -->
    <div class="hero-section-header">
      <h1 class="hero-section-title">{{ section.settings.section_title }}</h1>
      <p class="hero-section-subtitle">{{ section.settings.section_subtitle }}</p>
    </div>

    {% if section.settings.hero_product %}
      {% assign hero_product = all_products[section.settings.hero_product] %}
      
      <!-- Main Product Grid -->
      <div class="hero-product-grid">
        <!-- Product Images -->
        <div class="hero-product-images">
          <div class="hero-main-image">
            {% if section.settings.hero_badge != blank %}
              <div class="hero-badge">{{ section.settings.hero_badge }}</div>
            {% endif %}
            {% if section.settings.discount_text != blank %}
              <div class="hero-discount">{{ section.settings.discount_text }}</div>
            {% endif %}
            <img src="{{ hero_product.featured_image | img_url: '600x600' }}" alt="{{ hero_product.title | escape }}">
          </div>
        </div>

        <!-- Product Info -->
        <div class="hero-product-info">
          <h2 class="hero-product-title">{{ hero_product.title }}</h2>
          
          <!-- Price -->
          <div class="hero-product-price">
            <span class="hero-current-price">{{ hero_product.price | money }}</span>
            {% if hero_product.compare_at_price > hero_product.price %}
              <span class="hero-original-price">{{ hero_product.compare_at_price | money }}</span>
              {% assign savings = hero_product.compare_at_price | minus: hero_product.price %}
              <span class="hero-savings">Save {{ savings | money }}</span>
            {% endif %}
          </div>
          <!-- NEW BOLD TEXT BELOW PRICE -->
          {% if section.settings.price_below_text != blank %}
            <div class="hero-price-below-text">{{ section.settings.price_below_text }}</div>
          {% endif %}

          <!-- Reviews -->
          {% if section.settings.show_reviews %}
            <div class="hero-reviews">
              <div class="hero-stars">
                {% assign rating = section.settings.star_rating %}
                {% assign rating_floor = rating | floor %}
                {% assign rating_remainder = rating | minus: rating_floor %}
                {% assign half_star_position = rating_floor | plus: 1 %}
                {% for i in (1..5) %}
                  {% if i <= rating_floor %}
                    <span class="hero-star filled"></span>
                  {% elsif rating_remainder > 0 and i == half_star_position %}
                    <span class="hero-star half"></span>
                  {% else %}
                    <span class="hero-star"></span>
                  {% endif %}
                {% endfor %}
              </div>
              <span class="hero-review-text">{{ rating }} stars ({{ section.settings.review_count }} reviews)</span>
            </div>
          {% endif %}

          <!-- Description -->
          {% if section.settings.hero_description != blank %}
            <p class="hero-description">{{ section.settings.hero_description }}</p>
          {% endif %}

          <!-- Features -->
          {% if section.blocks.size > 0 %}
            <div class="hero-features">
              {% for block in section.blocks %}
                <div class="hero-feature" {{ block.shopify_attributes }}>
                  <div class="hero-feature-icon">{{ block.settings.feature_icon }}</div>
                  <div class="hero-feature-content">
                    <h4>{{ block.settings.feature_title }}</h4>
                    <p>{{ block.settings.feature_description }}</p>
                  </div>
                </div>
              {% endfor %}
            </div>
          {% endif %}

          <!-- CTA Buttons -->
          <div class="hero-cta-buttons">
            <form method="post" action="/cart/add" class="hero-buy-now-form">
              <input type="hidden" name="id" value="{{ hero_product.variants.first.id }}">
              <input type="hidden" name="return_to" value="/checkout">
              <button type="submit" class="hero-btn hero-btn-primary">{{ section.settings.cta_primary }}</button>
            </form>
            
            <form method="post" action="/cart/add" class="hero-add-to-cart-form">
              <input type="hidden" name="id" value="{{ hero_product.variants.first.id }}">
              <button type="submit" class="hero-btn hero-btn-secondary">{{ section.settings.cta_secondary }}</button>
            </form>
          </div>
        </div>
      </div>

      <!-- Trust Indicators -->
      <div class="hero-trust-indicators">
        <div class="trust-item">
          <div class="trust-icon">🚚</div>
          <div class="trust-title">Free Shipping</div>
          <div class="trust-subtitle">On orders over ₹999</div>
        </div>
        <div class="trust-item">
          <div class="trust-icon">🔒</div>
          <div class="trust-title">Secure Payment</div>
          <div class="trust-subtitle">100% Protected</div>
        </div>
        <div class="trust-item">
          <div class="trust-icon">↩️</div>
          <div class="trust-title">Easy Returns</div>
          <div class="trust-subtitle">30-day policy</div>
        </div>
        <div class="trust-item">
          <div class="trust-icon">⭐</div>
          <div class="trust-title">Top Rated</div>
          <div class="trust-subtitle">5-star reviews</div>
        </div>
      </div>

    {% else %}
      <div style="text-align: center; padding: 60px 20px; background: #f8f9fa; border-radius: 10px;">
        <h3>Please select a hero product in the section settings</h3>
      </div>
    {% endif %}
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Add to cart functionality
  document.querySelectorAll('.hero-add-to-cart-form').forEach(form => {
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      const button = this.querySelector('.hero-btn-secondary');
      
      button.style.transform = 'scale(0.95)';
      button.textContent = 'Adding...';
      
      fetch('/cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({
          items: [{
            id: this.querySelector('[name="id"]').value,
            quantity: 1
          }]
        })
      })
      .then(response => response.json())
      .then(data => {
        button.textContent = 'Added to Cart!';
        button.style.background = '#28a745';
        button.style.borderColor = '#28a745';
        button.style.color = 'white';
        
        setTimeout(() => {
          button.style.transform = 'scale(1)';
          button.textContent = '{{ section.settings.cta_secondary }}';
          button.style.background = 'white';
          button.style.borderColor = '#202425';
          button.style.color = '#202425';
        }, 2000);
      })
      .catch(error => {
        console.error('Error:', error);
        button.textContent = 'Error - Try Again';
        button.style.background = '#dc3545';
        button.style.borderColor = '#dc3545';
        button.style.color = 'white';
        
        setTimeout(() => {
          button.style.transform = 'scale(1)';
          button.textContent = '{{ section.settings.cta_secondary }}';
          button.style.background = 'white';
          button.style.borderColor = '#202425';
          button.style.color = '#202425';
        }, 2000);
      });
    });
  });
  
  // Buy now functionality
  document.querySelectorAll('.hero-buy-now-form').forEach(form => {
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      const button = this.querySelector('.hero-btn-primary');
      
      button.style.transform = 'scale(0.95)';
      button.textContent = 'Redirecting...';
      
      fetch('/cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({
          items: [{
            id: this.querySelector('[name="id"]').value,
            quantity: 1
          }]
        })
      })
      .then(response => response.json())
      .then(data => {
        window.location.href = '/checkout';
      })
      .catch(error => {
        console.error('Error:', error);
        button.textContent = 'Error - Try Again';
        button.style.background = '#dc3545';
        
        setTimeout(() => {
          button.style.transform = 'scale(1)';
          button.textContent = '{{ section.settings.cta_primary }}';
          button.style.background = 'linear-gradient(135deg, #E0131A 0%, #8B0000 100%)';
        }, 2000);
      });
    });
  });
});
</script>