{% stylesheet %}
  .track-record-section {
    background: #033770;
    padding: 60px 40px;
    margin: 0 auto;
  }

  .track-record-container {
    max-width: 1400px;
    margin: 0 auto;
  }

  .track-record-title {
    font-size: 28px;
    font-weight: 700;
    color: white;
    margin-bottom: 48px;
    text-align: left;
  }

  .track-record-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
  }

  .track-record-item {
    display: grid;
    gap: 24px;
    align-items: center;
    padding: 32px 24px;
    border-bottom: 1px solid #334155;
  }

  .track-record-item:nth-child(1),
  .track-record-item:nth-child(2),
  .track-record-item:nth-child(3) {
    border-top: 1px solid #334155;
  }

  .track-record-item:nth-child(3n+1),
  .track-record-item:nth-child(3n+2) {
    border-right: 1px solid #334155;
  }

  .track-record-stat {
    font-size: 72px;
    font-weight: 800;
    color: #a78bfa;
    line-height: 1;
    white-space: nowrap;
  }

  .track-record-divider {
    width: 2px;
    height: 80px;
    background-color: #a78bfa;
    flex-shrink: 0;
  }

  .track-record-description {
    font-size: 15px;
    font-weight: 400;
    color: white;
    line-height: 1.5;
  }

  /* Tablet Responsive (1024px and below) */
  @media (max-width: 1024px) {
    .track-record-section {
      padding: 40px 32px;
    }

    .track-record-title {
      font-size: 24px;
      margin-bottom: 40px;
    }

    .track-record-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .track-record-item:nth-child(3n+1),
    .track-record-item:nth-child(3n+2) {
      border-right: none;
    }

    .track-record-item:nth-child(2n+1) {
      border-right: 1px solid #334155;
    }

    .track-record-item:nth-child(1),
    .track-record-item:nth-child(2) {
      border-top: 1px solid #334155;
    }

    .track-record-item:nth-child(3) {
      border-top: none;
    }

    .track-record-stat {
      font-size: 64px;
    }

    .track-record-divider {
      height: 70px;
    }

    .track-record-description {
      font-size: 14px;
    }
  }

  /* Mobile Large (768px and below) */
  @media (max-width: 768px) {
    .track-record-section {
      padding: 32px 20px;
    }

    .track-record-title {
      font-size: 20px;
      margin-bottom: 32px;
    }

    .track-record-grid {
      grid-template-columns: 1fr;
    }

    .track-record-item {
      padding: 24px 16px;
      border-right: none !important;
    }

    .track-record-item:nth-child(1) {
      border-top: 1px solid #334155;
    }

    .track-record-stat {
      font-size: 56px;
    }

    .track-record-divider {
      height: 60px;
    }

    .track-record-description {
      font-size: 13px;
    }
  }

  /* Mobile Small (480px and below) */
  @media (max-width: 480px) {
    .track-record-section {
      padding: 24px 16px;
    }

    .track-record-title {
      font-size: 18px;
      margin-bottom: 24px;
    }

    .track-record-item {
      grid-template-columns: auto 2px 1fr;
      gap: 16px;
      padding: 20px 12px;
    }

    .track-record-stat {
      font-size: 48px;
    }

    .track-record-divider {
      height: 50px;
    }

    .track-record-description {
      font-size: 12px;
    }
  }
{% endstylesheet %}

<div class="track-record-section">
  <div class="track-record-container">
    <h2 class="track-record-title">{{ section.settings.section_title }}</h2>

    <div class="track-record-grid">
      {% for block in section.blocks %}
        <div class="track-record-item">
          <div class="track-record-stat">{{ block.settings.stat_number }}</div>
          <div class="track-record-divider"></div>
          <div class="track-record-description">{{ block.settings.stat_description }}</div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Track Record Stats",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "Proven Track Record, Measurable Results"
    }
  ],
  "blocks": [
    {
      "type": "stat_item",
      "name": "Stat Item",
      "settings": [
        {
          "type": "text",
          "id": "stat_number",
          "label": "Stat Number",
          "default": "1M"
        },
        {
          "type": "textarea",
          "id": "stat_description",
          "label": "Stat Description",
          "default": "units manufactured since inception with consistent, brand-true quality control"
        }
      ]
    }
  ],
  "presets": [
