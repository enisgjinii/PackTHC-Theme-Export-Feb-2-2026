
{% comment %}
  Flash Sale Banner Section
  Left: Heading | Center: CTA Button | Right: Infinite Scroll Products (Desktop + Mobile)
{% endcomment %}
<div class="flash-banner-wrapper">
<div class="flash-banner" id="flash-banner-{{ section.id }}">

  {% comment %} LEFT: Heading {% endcomment %}
  <div class="flash-banner__left">
    <p class="flash-banner__label">{{ section.settings.label_text }}</p>
    <h2 class="flash-banner__heading">{{ section.settings.heading }}</h2>
    {% if section.settings.subheading != blank %}
      <p class="flash-banner__sub">{{ section.settings.subheading }}</p>
    {% endif %}
  </div>

  {% comment %} CENTER: CTA Button {% endcomment %}
  <div class="flash-banner__center">
    <a
      href="{{ section.settings.button_url }}"
      class="flash-banner__btn"
      {% if section.settings.button_new_tab %}target="_blank" rel="noopener"{% endif %}
    >
      {{ section.settings.button_label }}
    </a>
    {% if section.settings.promo_code != blank %}
      <div class="flash-banner__code">
        Use Code: <strong>{{ section.settings.promo_code }}</strong>
      </div>
    {% endif %}
  </div>

  {% comment %} RIGHT: Animated Product Images {% endcomment %}
  <div class="flash-banner__right">
    <div class="flash-banner__products">
      <div class="flash-banner__products-track">
        {% comment %} First Set {% endcomment %}
        {% for block in section.blocks %}
          {% if block.type == 'product_image' %}
            {% assign product = all_products[block.settings.product] %}
            <a
              href="{{ product.url | default: block.settings.product_url }}"
              class="flash-banner__product-item"
              aria-label="{{ product.title | default: block.settings.product_title }}"
              {{ block.shopify_attributes }}
            >
              {% if product != blank and product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 120 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  width="80"
                  height="80"
                  loading="lazy"
                >
              {% elsif block.settings.custom_image != blank %}
                <img
                  src="{{ block.settings.custom_image | image_url: width: 120 }}"
                  alt="{{ block.settings.product_title | escape }}"
                  width="80"
                  height="80"
                  loading="lazy"
                >
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-img' }}
              {% endif %}
              <span class="flash-banner__product-title">
                {{ product.title | default: block.settings.product_title | truncate: 18 }}
              </span>
            </a>
          {% endif %}
        {% endfor %}
        
        {% comment %} Duplicate Set for Infinite Loop {% endcomment %}
        {% for block in section.blocks %}
          {% if block.type == 'product_image' %}
            {% assign product = all_products[block.settings.product] %}
            <a
              href="{{ product.url | default: block.settings.product_url }}"
              class="flash-banner__product-item"
              aria-label="{{ product.title | default: block.settings.product_title }}"
            >
              {% if product != blank and product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 120 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  width="80"
                  height="80"
                  loading="lazy"
                >
              {% elsif block.settings.custom_image != blank %}
                <img
                  src="{{ block.settings.custom_image | image_url: width: 120 }}"
                  alt="{{ block.settings.product_title | escape }}"
                  width="80"
                  height="80"
                  loading="lazy"
                >
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-img' }}
              {% endif %}
              <span class="flash-banner__product-title">
                {{ product.title | default: block.settings.product_title | truncate: 18 }}
              </span>
            </a>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

</div>
</div>

<style>
  #flash-banner-{{ section.id }} {
    --banner-bg: {{ section.settings.background_color }};
    --banner-text: {{ section.settings.text_color }};
    --btn-bg: {{ section.settings.button_bg_color }};
    --btn-text: {{ section.settings.button_text_color }};
    --banner-radius: {{ section.settings.border_radius }}px;
  }

.flash-banner-wrapper {
  width: 100%;
  padding: 20px 0;
  background: {{ section.settings.background_color }};
}

.flash-banner {
  max-width: 1550px;
  margin: 0 auto;
  padding: 0 36px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  color: var(--banner-text);
  border-radius: var(--banner-radius);
  overflow: hidden;
  position: relative;
}

  /* LEFT */
  .flash-banner__left {
    flex: 0 0 auto;
    min-width: 180px;
  }
  .flash-banner__label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.65;
    margin: 0 0 4px;
  }
  .flash-banner__heading {
    font-size: 30px;
    font-weight: 800;
    line-height: 1.2;
    margin: 0 0 4px;
    color: var(--banner-text);
  }
  .flash-banner__sub {
    font-size: 13px;
    opacity: 0.7;
    margin: 0;
  }

  /* CENTER */
  .flash-banner__center {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  .flash-banner__btn {
    display: inline-block;
    background: var(--btn-bg);
    color: var(--btn-text);
    font-size: 16px;
    font-weight: 700;
    padding: 13px 28px;
    border-radius: 50px;
    text-decoration: none;
    letter-spacing: 0.03em;
    white-space: nowrap;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .flash-banner__btn:hover {
    transform: scale(1.04);
    box-shadow: 0 4px 18px rgba(0,0,0,0.18);
  }
  .flash-banner__code {
    font-size: 12px;
    opacity: 0.75;
    letter-spacing: 0.04em;
  }
  .flash-banner__code strong {
    font-weight: 800;
    opacity: 1;
  }

  /* RIGHT - Products Container (Fixed width on desktop) */
  .flash-banner__right {
    flex: 0 0 auto;
    max-width: 420px;
    overflow: hidden;
    /* Smooth edges mask - applied to desktop too */
    mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%);
  }
  .flash-banner__products {
    width: 100%;
    overflow: hidden;
    position: relative;
  }
  .flash-banner__products-track {
    display: flex;
    align-items: center;
    gap: 12px;
    width: max-content;
    /* Infinite horizontal scroll for ALL devices */
    animation: scroll-left 18s linear infinite;
  }
  
  /* Pause on hover (desktop) */
  @media (hover: hover) {
    .flash-banner__products-track:hover {
      animation-play-state: paused;
    }
  }

  /* Product Item */
  .flash-banner__product-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    color: var(--banner-text);
    background: rgba(255,255,255,0.18);
    border: 1.5px solid rgba(255,255,255,0.3);
    border-radius: 14px;
    padding: 10px;
    width: 95px;
    cursor: pointer;
    transition: transform 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
    position: relative;
    flex-shrink: 0;
    /* No float animation - only scroll */
  }
  
  .flash-banner__product-item:hover {
    background: rgba(255,255,255,0.38);
    box-shadow: 0 6px 20px rgba(0,0,0,0.15);
    transform: translateY(-4px) scale(1.05);
    z-index: 2;
  }
  
  .flash-banner__product-item img,
  .flash-banner__product-item .placeholder-img {
    width: 70px;
    height: 70px;
    object-fit: contain;
    border-radius: 8px;
    display: block;
    pointer-events: none; /* Prevent drag issues during scroll */
  }
  .flash-banner__product-title {
    font-size: 11px;
    font-weight: 600;
    text-align: center;
    line-height: 1.3;
    opacity: 0.9;
    max-width: 80px;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  /* Infinite Scroll Animation */
  @keyframes scroll-left {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .flash-banner {
      flex-wrap: wrap;
      padding: 18px 22px;
      gap: 16px;
    }
    .flash-banner__right {
      max-width: 380px;
    }
    .flash-banner__products-track {
      animation-duration: 15s;
      gap: 10px;
    }
    .flash-banner__product-item {
      width: 85px;
    }
  }

  @media (max-width: 640px) {
    .flash-banner {
      flex-direction: column;
      text-align: center;
      padding: 24px 16px;
      gap: 20px;
    }
    .flash-banner__right {
      max-width: 100%;
      width: 100%;
    }
    .flash-banner__products-track {
      animation-duration: 12s; /* Faster on mobile */
      gap: 12px;
    }
    .flash-banner__product-item {
      width: 90px;
      padding: 10px;
    }
    .flash-banner__product-item img {
      width: 65px;
      height: 65px;
    }
    .flash-banner__heading {
      font-size: 26px;
    }
  }
</style>

{% schema %}
{
  "name": "Flash Sale Banner",
  "tag": "section",
  "class": "flash-sale-section",
  "settings": [
    {
      "type": "header",
      "content": "Left: Heading"
    },
    {
      "type": "text",
      "id": "label_text",
      "label": "Label (small text above heading)",
      "default": "Flash Sale now on!"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Upto 50% OFF"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading (optional)",
      "default": "Best sellers + More"
    },
    {
      "type": "header",
      "content": "Center: Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button Link"
    },
    {
      "type": "checkbox",
      "id": "button_new_tab",
      "label": "Open in new tab?",
      "default": false
    },
    {
      "type": "text",
      "id": "promo_code",
      "label": "Promo Code (optional)",
      "default": "GORILLA10"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Banner Background",
      "default": "#E8F5A3"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Banner Border Radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "product_image",
      "name": "Product",
      "limit": 4,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Or use Custom Image (if no product selected)"
        },
        {
          "type": "text",
          "id": "product_title",
          "label": "Product Title (for custom image)",
          "default": "Product"
        },
        {
          "type": "url",
          "id": "product_url",
          "label": "Product URL (for custom image)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Flash Sale Banner",
      "blocks": [
        { "type": "product_image" },
        { "type": "product_image" },
        { "type": "product_image" },
        { "type": "product_image" }
      ]
    }
  ]
}
{% endschema %}
