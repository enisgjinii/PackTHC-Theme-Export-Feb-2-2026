{%- liquid
	assign section_id       = '#shopify-section-' | append: section.id
	assign full             = section.settings.full
	assign heading_size     = section.settings.heading_size
	assign column_gap       = section.settings.column_gap
	assign column           = section.settings.column | times: 1
	assign columns_mobile   = section.settings.columns_mobile | times: 1
	assign total            = section.settings.total
	assign heading          = section.settings.heading_text
	assign description      = section.settings.description
	assign collection       = section.settings.collection
	assign show_description = section.settings.show_description
-%}

<style>
	{{ section_id }} .section-wrapper{
		--item-gap: 2.4rem 2.4rem;
		--template-columns: repeat({{ columns_mobile }}, minmax(0, 1fr));
		padding-top: {{ section.settings.padding_top_mobile }}px;
		padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
	}

	@media (min-width: 992px) {
		{{ section_id }} .section-wrapper{
			--item-gap: 6rem 3rem;
			--template-columns: repeat({{ column }}, minmax(0, 1fr));
			padding-top: {{ section.settings.padding_top }}px;
			padding-bottom: {{ section.settings.padding_bottom }}px;
		}
	}
</style>

<div class="section-wrapper color-{{ section.settings.color_scheme }}">
	<div class="{% if full %}stretch-section stretch-padding{% else %}container{% endif %}">
		{%- if heading != blank or description != blank -%}
			<div class="header-section text-left">
				{%- if heading != blank -%}
					<h2 class="heading rte {{ heading_size }}">{{ heading }}</h2>
				{%- endif -%}

				{%- if description != blank or show_description and collection.description != empty-%}
					<div class="description">
						{%- if show_description -%}
							{{ collection.description }}
						{%- else -%}
							{{ description -}}
						{%- endif %}
					</div>
				{%- endif -%}
			</div>
		{%- endif -%}

		<div class="featured-collection-tabs tabs">
			<div class="list-product nt animation-fade">
				{%- for product in collection.products limit: total -%}
					<div class="item-{{ column }}">
						{%- render 'product-card', product: product -%}
					</div>
				{%- else -%}
					{%- for i in (1..total) -%}
						<div class="item-{{ column }}">
							{%- render 'product-card-placeholder', index: forloop.index -%}
						</div>
					{%- endfor -%}
				{%- endfor -%}
			</div>
		</div>

		{%- if section.settings.button_label != blank and collection.products.size > total-%}
			<div class="view-all text-center">
				<a class="button primary-button collection-button" href="{{ first_collection.url | default: '#' }}">
					{{ section.settings.button_label }}

					{% if settings.select_button == 'direction' %}
						{%- render 'icon', code: 'direction-button' -%}
					{% elsif settings.select_button == 'arrow' %}
						{%- render 'icon', code: 'arrow-button' -%}
					{% endif %}
				</a>
			</div>
		{%- endif -%}
	</div>
</div>


{% schema %}
{
	"name": "t:sections.featured-collection.name",
	"tag": "section",
	"class": "featured-collection-section",
	"disabled_on": {
		"groups": ["header", "footer"]
	},
	"settings": [
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"label": "t:settings_schema.colors.label",
			"default": "scheme-1"
		},
		{
			"type": "collection",
			"id": "collection",
			"label": "t:sections.featured-collection-tabs.blocks.tab.settings.collection.label"
		},
		{
			"type": "inline_richtext",
			"id": "heading_text",
			"label": "t:general.typography.heading.label",
			"default": "Heading"
		},
		{
			"type": "select",
			"id": "heading_size",
			"options": [
				{
					"value": "h4",
					"label": "t:general.typography.heading_size.option_1.label"
				},
				{
					"value": "h3",
					"label": "t:general.typography.heading_size.option_2.label"
				},
				{
					"value": "h2",
					"label": "t:general.typography.heading_size.option_3.label"
				}
			],
			"default": "h3",
			"label": "t:general.typography.heading_size.label"
		},
		{
			"type": "inline_richtext",
			"id": "description",
			"label": "t:general.typography.description.label"
		},
		{
			"type": "checkbox",
			"id": "show_description",
			"label": "t:sections.featured-collection.settings.show_description.label",
			"default": false
		},
		{
			"type": "text",
			"id": "button_label",
			"label": "t:general.typography.button_label.label",
			"default": "View all",
		},
		{
			"type": "range",
			"id": "column",
			"min": 1,
			"max": 5,
			"step": 1,
			"default": 4,
			"label": "t:general.slider.column.label"
		},
		{
			"type": "select",
			"id": "columns_mobile",
			"default": "2",
			"options": [
				{
					"value": "1",
					"label": "1"
				},
				{
					"value": "2",
					"label": "2"
				}
			],
			"label": "t:general.layout.columns_mobile.label"
		},
		{
			"type": "range",
			"id": "total",
			"min": 1,
			"max": 20,
			"step": 1,
			"default": 8,
			"label": "t:general.slider.total.label"
		},
		{
			"type": "header",
			"content": "t:general.padding.header_padding.content"
		},
		{
			"type": "range",
			"id": "padding_top",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 50,
			"unit": "px",
			"label": "t:general.padding.top.label"
		},
		{
			"type": "range",
			"id": "padding_bottom",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 50,
			"unit": "px",
			"label": "t:general.padding.bottom.label"
		},
		{
			"type": "paragraph",
			"content": "t:general.padding.paragraph_mobile.content"
		},
		{
			"type": "range",
			"id": "padding_top_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 50,
			"unit": "px",
			"label": "t:general.padding.top.label"
		},
		{
			"type": "range",
			"id": "padding_bottom_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 50,
			"unit": "px",
			"label": "t:general.padding.bottom.label"
		}
	],
	"presets": [
		{
			"name": "t:sections.featured-collection.name"
		}
	]
}
{% endschema %}
