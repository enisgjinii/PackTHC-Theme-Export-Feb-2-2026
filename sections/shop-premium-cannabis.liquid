{% comment %}
  Section: Shop Premium Cannabis Seeds
  Usage: Add this file to sections folder as 'shop-premium-cannabis.liquid'
{% endcomment %}

<style>
  #shopify-section-{{ section.id }} {
    padding: 60px 0;
    background-color: {{ section.settings.background_color }};
  }

  #shopify-section-{{ section.id }} .container {
    max-width: 1500px;
    margin: 0 auto;
    padding: 0 20px;
  }

  #shopify-section-{{ section.id }} .header {
    margin-bottom: 40px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  #shopify-section-{{ section.id }} .header-content {
    flex: 1;
  }

  #shopify-section-{{ section.id }} .subtitle {
    font-size: 14px;
    color: {{ section.settings.subtitle_color }};
    margin-bottom: 10px;
    font-weight: 400;
    line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .title {
    font-size: 48px;
    font-weight: 700;
    color: {{ section.settings.title_color }};
    margin: 0;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .header-nav {
    display: flex;
    gap: 12px;
  }

  #shopify-section-{{ section.id }} .header-nav-btn {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: {{ section.settings.button_color }};
    border: none;
    color: white;
    font-size: 24px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    box-shadow: 0 2px 8px rgba(0,0,0,0.2);
  }

  #shopify-section-{{ section.id }} .header-nav-btn:hover {
    background: {{ section.settings.button_hover_color }};
    transform: scale(1.1);
  }

  #shopify-section-{{ section.id }} .header-nav-btn:active {
    transform: scale(0.95);
  }

  #shopify-section-{{ section.id }} .header-nav-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  #shopify-section-{{ section.id }} .carousel-wrapper {
    position: relative;
  }

  #shopify-section-{{ section.id }} .carousel-container {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
  }

  #shopify-section-{{ section.id }} .carousel-container::-webkit-scrollbar {
    display: none;
  }

  #shopify-section-{{ section.id }} .category-card {
    flex: 0 0 calc(25% - 15px);
    min-width: 280px;
    background: {{ section.settings.card_background }};
    border-radius: 16px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    display: block;
    position: relative;
    height: 420px;
    scroll-snap-align: start;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  #shopify-section-{{ section.id }} .category-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 20px rgba(0,0,0,0.2);
  }

  #shopify-section-{{ section.id }} .category-card-image {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .category-card-image:before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(to bottom, rgba(0,0,0,0.3) 0%, rgba(0,0,0,0.6) 100%);
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .category-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  #shopify-section-{{ section.id }} .category-card:hover .category-card-image img {
    transform: scale(1.05);
  }

  #shopify-section-{{ section.id }} .category-card-content {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    padding: 30px;
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .category-label {
    font-size: 12px;
    font-weight: 600;
    color: {{ section.settings.label_color }};
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: 10px;
    opacity: 0.9;
  }

  #shopify-section-{{ section.id }} .category-title {
    font-size: 28px;
    font-weight: 700;
    color: {{ section.settings.category_title_color }};
    line-height: 1.2;
    margin: 0;
  }

  @media (max-width: 1200px) {
    #shopify-section-{{ section.id }} .category-card {
      flex: 0 0 calc(33.333% - 14px);
    }
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding: 40px 0;
    }

    #shopify-section-{{ section.id }} .container {
      padding: 0 15px;
    }

    #shopify-section-{{ section.id }} .header {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
      margin-bottom: 30px;
    }

    #shopify-section-{{ section.id }} .title {
      font-size: 32px;
    }

    #shopify-section-{{ section.id }} .carousel-container {
      gap: 15px;
      padding: 0 5px;
    }

    #shopify-section-{{ section.id }} .category-card {
      flex: 0 0 calc(100vw - 50px);
      max-width: 380px;
    }

    #shopify-section-{{ section.id }} .header-nav-btn {
      width: 40px;
      height: 40px;
      font-size: 20px;
    }

    #shopify-section-{{ section.id }} .category-title {
      font-size: 24px;
    }
  }
</style>

<div class="container">
  <div class="header">
    <div class="header-content">
      {% if section.settings.subtitle != blank %}
        <div class="subtitle">{{ section.settings.subtitle }}</div>
      {% endif %}
      {% if section.settings.title != blank %}
        <h2 class="title">{{ section.settings.title }}</h2>
      {% endif %}
    </div>
    <div class="header-nav">
      <button class="header-nav-btn carousel-prev-{{ section.id }}" aria-label="Previous">‹</button>
      <button class="header-nav-btn carousel-next-{{ section.id }}" aria-label="Next">›</button>
    </div>
  </div>

  <div class="carousel-wrapper">
    <div class="carousel-container carousel-{{ section.id }}">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <a href="{{ block.settings.link }}" class="category-card" {{ block.shopify_attributes }}>
            <div class="category-card-image">
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 800 | image_tag: alt: block.settings.title, loading: 'lazy' }}
              {% else %}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}
            </div>
            <div class="category-card-content">
              {% if block.settings.label != blank %}
                <div class="category-label">{{ block.settings.label }}</div>
              {% endif %}
              {% if block.settings.title != blank %}
                <h3 class="category-title">{{ block.settings.title }}</h3>
              {% endif %}
            </div>
          </a>
        {% endfor %}
      {% else %}
        {% comment %} Default placeholder cards {% endcomment %}
        {% assign default_categories = "DAY NEUTRAL|Autoflower Cannabis Seeds,PHOTOPERIOD|Full Term Cannabis Seeds,PHOTOPERIOD|Semi-Full Term Cannabis Seeds,0% THC|Hemp & CBD Seeds" | split: ',' %}
        {% for category in default_categories %}
          {% assign cat_parts = category | split: '|' %}
          <div class="category-card">
            <div class="category-card-image">
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
            <div class="category-card-content">
              <div class="category-label">{{ cat_parts[0] }}</div>
              <h3 class="category-title">{{ cat_parts[1] }}</h3>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>

<script>
  (function() {
    const carousel = document.querySelector('.carousel-{{ section.id }}');
    const prevBtn = document.querySelector('.carousel-prev-{{ section.id }}');
    const nextBtn = document.querySelector('.carousel-next-{{ section.id }}');
    
    function getScrollAmount() {
      const card = carousel.querySelector('.category-card');
      if (!card) return 300;
      const cardWidth = card.offsetWidth;
      const gap = 20;
      return cardWidth + gap;
    }

    prevBtn.addEventListener('click', () => {
      carousel.scrollBy({
        left: -getScrollAmount(),
        behavior: 'smooth'
      });
    });

    nextBtn.addEventListener('click', () => {
      carousel.scrollBy({
        left: getScrollAmount(),
        behavior: 'smooth'
      });
    });

    function updateButtons() {
      const maxScroll = carousel.scrollWidth - carousel.clientWidth;
      prevBtn.disabled = carousel.scrollLeft <= 0;
      nextBtn.disabled = carousel.scrollLeft >= maxScroll - 1;
    }

    carousel.addEventListener('scroll', updateButtons);
    window.addEventListener('resize', updateButtons);
    updateButtons();
  })();
</script>

{% schema %}
{
  "name": "Shop Premium Cannabis",
  "tag": "section",
  "class": "shop-premium-section",
  "settings": [
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "High yielding, high potency, mold resistant seeds"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Shop Premium Cannabis Seeds"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle Color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button Color",
      "default": "#2d7a5e"
    },
    {
      "type": "color",
      "id": "button_hover_color",
      "label": "Button Hover Color",
      "default": "#246952"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card Background",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Category Label Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "category_title_color",
      "label": "Category Title Color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category Image",
          "info": "Recommended: 800x1000px"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Category Label",
          "default": "DAY NEUTRAL",
          "info": "Small text above title"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category Title",
          "default": "Autoflower Cannabis Seeds"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop Premium Cannabis",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "label": "DAY NEUTRAL",
            "title": "Autoflower Cannabis Seeds"
          }
        },
        {
          "type": "category",
          "settings": {
            "label": "PHOTOPERIOD",
            "title": "Full Term Cannabis Seeds"
          }
        },
        {
          "type": "category",
          "settings": {
            "label": "PHOTOPERIOD",
            "title": "Semi-Full Term Cannabis Seeds"
          }
        },
        {
          "type": "category",
          "settings": {
            "label": "0% THC",
            "title": "Hemp & CBD Seeds"
          }
        }
      ]
    }
  ]
}
{% endschema %}