<style>
      .utility-bar {
       background: #033770;
        border-bottom: 1px solid rgba(0, 0, 0, 0);
        position: relative;
        z-index: var(--index-utility-bar);
      }

      .utility-bar .utility-bar__content {
        padding: 15px 0px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
      }

      .utility-bar-wrap {
        display: flex;
        flex: 1;
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        gap: 20px;
        max-width: 100%;
      }

      .utility-bar-wrap > div {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        min-width: 0;

      }
      .utility-bar a {
    display: flex;
    align-items: center;
    gap: 2px;
    line-height: 1;
  }


      .utility-bar a, .text-white {
        color: #FFFFFF !important;
        font-size: 14px;
        font-weight: 600;
        font-family: "Instrument Sans", sans-serif;
        text-indent: 0px;
      }

      .utility-bar-phone, .utility-bar-email {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
      }

      .utility-bar-phone svg, .utility-bar-email svg {
        min-width: 20px;
        height: 20px;
      }



      .utility-bar a:hover, .text-white:hover    {
      text-decoration-line : underline;
      }

      .whatsapp-icons{
        height:20px;
        width:20px;
      }

      @media (max-width: 767px) {
        .utility-bar {
          display: block !important;
        }
        .utility-bar a, .text-white{
          font-size: 10px;
        }
        .mobile{
          display: none !important;
        }
      }
      @media (max-width: 1334px) {
        .utility-bar {
          display: block !important;
        }
        .mobile{
          display: none !important;
        }
      }
      .utility-bar-phone-whatsapp a {
      display: flex;
      align-items: center;
      gap: 3px;
    }

    .utility-bar-phone-whatsapp img {
      display: block;
    }
</style>

