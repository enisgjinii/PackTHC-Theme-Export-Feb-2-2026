{%- liquid
	assign section_id   = '#shopify-section-' | append: section.id
	assign animation    = settings.section_animation
	assign heading      = section.settings.heading_text
	assign heading_size = section.settings.heading_size
	assign total        = 10
-%}

<style>
	{{ section_id }} .section-wrapper {
		padding-top: {{ section.settings.padding_top_mobile }}px;
		padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
	}

	{%- if section.settings.post_padding -%}
		{{ section_id }} .article-card {
			padding: 1.6rem;
		}
	{%- endif -%}

	@media (min-width: 992px) {
		{{ section_id }} .section-wrapper {
			padding-top: {{ section.settings.padding_top }}px;
			padding-bottom: {{ section.settings.padding_bottom }}px;
		}

		{%- if section.settings.post_padding -%}
			{{ section_id }} .article-card {
				padding: 2.4rem;
			}
		{%- endif -%}
	}
</style>

<div class="section-wrapper color-{{ section.settings.color_scheme }}">
	<div class="container">
		<div class="recent-posts{% if animation %} scroll-trigger{% endif %}">
			<div class="recent-posts-top">
				{%- if heading != blank -%}
					<div class="title-wrapper">
						<h3 class="heading {{ heading_size }} rte">{{- heading -}}</h3>
					</div>
				{%- endif -%}

				{%- if section.settings.button_text != blank -%}
					<a class="show-more link-underline" href="{{ section.settings.button_link | default: '#' }}">{{- section.settings.button_text -}}</a>
				{%- endif -%}
			</div>

			<div class="recent-posts-content">
				{%- render 'recent-posts', limit: total -%}
			</div>
		</div>
	</div>
</div>

{% schema %}
{
	"name": "t:sections.recent-posts.name",
	"tag": "section",
	"class": "recent-posts-section",
	"enabled_on": {
		"templates": ["article"]
	},
	"settings": [
		{
			"type": "checkbox",
			"id": "full",
			"default": false,
			"label": "t:general.layout.full.label"
		},
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"label": "t:settings_schema.colors.label",
			"default": "scheme-3"
		},
		{
			"type": "header",
			"content": "t:general.typography.heading.label"
		},
		{
			"type": "inline_richtext",
			"id": "heading_text",
			"default": "Heading",
			"label": "t:general.typography.heading.label"
		},
		{
			"type": "select",
			"id": "heading_size",
			"options": [
				{
					"value": "h4",
					"label": "t:general.typography.heading_size.option_1.label"
				},
				{
					"value": "h3",
					"label": "t:general.typography.heading_size.option_2.label"
				},
				{
					"value": "h2",
					"label": "t:general.typography.heading_size.option_3.label"
				}
			],
			"default": "h4",
			"label": "t:general.typography.heading_size.label"
		},
		{
			"type": "text",
			"id": "button_text",
			"default": "Button label",
			"label": "t:general.typography.button_text.label"
		},
		{
			"type": "url",
			"id": "button_link",
			"label": "t:general.typography.button_link.label"
		},
		{
			"type": "header",
			"content": "t:sections.featured-blog.settings.card.content"
		},
		{
			"type": "color_scheme",
			"id": "post_color_scheme",
			"label": "t:settings_schema.colors.label",
			"default": "scheme-1"
		},
		{
			"type": "checkbox",
			"id": "post_padding",
			"default": false,
			"label": "t:sections.main-blog.settings.post_padding.label"
		},
		{
			"type": "header",
			"content": "t:general.padding.header_padding.content"
		},
		{
			"type": "range",
			"id": "padding_top",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 50,
			"unit": "px",
			"label": "t:general.padding.top.label"
		},
		{
			"type": "range",
			"id": "padding_bottom",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 50,
			"unit": "px",
			"label": "t:general.padding.bottom.label"
		},
		{
			"type": "paragraph",
			"content": "t:general.padding.paragraph_mobile.content"
		},
		{
			"type": "range",
			"id": "padding_top_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 20,
			"unit": "px",
			"label": "t:general.padding.top.label"
		},
		{
			"type": "range",
			"id": "padding_bottom_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 20,
			"unit": "px",
			"label": "t:general.padding.bottom.label"
		}
	],
	"presets": [
		{
			"name": "t:sections.recent-posts.name"
		}
	]
}
{% endschema %}