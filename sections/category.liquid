{% comment %}
  Filename: shop-by-category.liquid - Optimized Version
{% endcomment %}

<!-- Preload critical images -->
{% for block in section.blocks limit: 4 %}
  <link rel="preload" as="image" href="{{ block.settings.image | image_url: width: 400 }}">
{% endfor %}

<section class="shop-section">
  <h2 class="section-title">{{ section.settings.title }}</h2>

  <div class="categories-grid" id="categoriesGrid">
  {% for block in section.blocks %}
    {% assign img = block.settings.image %}
    {% assign title_text = block.settings.title | default: section.settings.heading | default: page_title | default: 'wholesale child resistant packaging' | escape %}
    {% assign load = 'lazy' %}
    {% assign fp = 'auto' %}
    {% if forloop.index == 1 %}
      {% assign load = 'eager' %}
      {% assign fp = 'high' %}
    {% endif %}

    <article class="category-item" data-category="{{ title_text }}">
      <div class="category-image">
        <a href="{{ block.settings.link }}" aria-label="Shop {{ title_text }}">
          {% if img %}
            <img
              src="{{ img | image_url: width: 600, height: 600, crop: 'center' }}"
              srcset="
                {{ img | image_url: width: 300,  height: 300,  crop: 'center' }} 300w,
                {{ img | image_url: width: 600,  height: 600,  crop: 'center' }} 600w,
                {{ img | image_url: width: 800,  height: 800,  crop: 'center' }} 800w"
              sizes="(min-width: 1200px) 200px, (min-width: 992px) 180px, (min-width: 768px) 140px, (min-width: 576px) 120px, (min-width: 375px) 90px, 100px"
              alt="{{ img.alt | default: title_text | escape }}"
              loading="{{ load }}"
              fetchpriority="{{ fp }}"
              decoding="async"
              width="600"
              height="600">
          {% else %}
            {% render 'icon', code: 'placeholder', width: 400, height: 400 %}
          {% endif %}
        </a>
      </div>
      <h3 class="category-name">{{ block.settings.title }}</h3>
    </article>
  {% endfor %}
</div>

</section>

<style>
  /* Critical CSS - Inline for better performance */
  .shop-section {
    max-width: 100%;
    margin: 0 auto;
    text-align: center;
    padding: 20px 15px;
    overflow-x: hidden;
  }

  .section-title {
    font-size: clamp(1.5rem, 4vw, 3.5rem);
    font-weight: 600;
    color: #202425;
    margin-bottom: 30px;
  }

  .categories-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 15px;
    padding: 0 5px;
    justify-items: center;
    max-width: 100%;
  }

  .category-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 180px;
    text-decoration: none;
    color: inherit;
  }

  .category-image {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    overflow: hidden;
    margin-bottom: 12px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    flex-shrink: 0;
  }

  .category-image a {
    display: block;
    width: 100%;
    height: 100%;
  }

  .category-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease-in-out;
  }

  .category-name {
    font-size: 13px;
    font-weight: 500;
    color: #202425;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    text-align: center;
    margin: 0;
    line-height: 1.3;
    word-wrap: break-word;
    max-width: 100%;
  }

 /* Smooth zoom effect - Image zooms inside circle */
  @media (hover: hover) {
    .category-item:hover .category-image img {
      transform: scale(1.15);
    }
    
    .category-item:hover .category-name {
      color: #000;
    }
  }

  /* Mobile - Small (375px+) */
  @media (min-width: 375px) {
    .categories-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }
    .category-image {
      width: 90px;
      height: 90px;
    }
    .category-name {
      font-size: 12px;
    }
  }

  /* Mobile - Large / Small Tablets (576px+) */
  @media (min-width: 576px) {
    .categories-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
      padding: 0 10px;
    }
    .category-image {
      width: 120px;
      height: 120px;
    }
    .category-name {
      font-size: 13px;
    }
    .category-item {
      max-width: 200px;
    }
  }

  /* Tablets / Laptop Small (768px+) */
  @media (min-width: 768px) {
    .categories-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }
    .category-image {
      width: 140px;
      height: 140px;
      margin-bottom: 15px;
    }
    .category-name {
      font-size: 14px;
    }
    .section-title {
      margin-bottom: 40px;
    }
  }

  /* Laptop / Desktop Small (992px+) */
  @media (min-width: 992px) {
    .categories-grid {
      grid-template-columns: repeat(5, 1fr);
      gap: 25px;
    }
    .category-image {
      width: 160px;
      height: 160px;
    }
    .category-name {
      font-size: 15px;
    }
  }

  /* Desktop Large (1200px+) */
  @media (min-width: 1200px) {
    .categories-grid {
      grid-template-columns: repeat(6, 1fr);
      gap: 30px;
      max-width: 2000px;
      margin: 0 auto;
    }
    .category-image {
      width: 180px;
      height: 180px;
      margin-bottom: 18px;
    }
    .category-name {
      font-size: 16px;
    }
  }

  /* Extra Large Desktop (1400px+) */
  @media (min-width: 1400px) {
    .category-image {
      width: 225px;
      height: 225px;
    }
  }
  /* Extra Large Desktop (1400px+) */
  @media (min-width: 1600px) {
    .category-image {
      width: 250px;
      height: 250px;
    }
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const grid = document.getElementById('categoriesGrid');
  
  if (!grid) return;

  // Click tracking with event delegation
  grid.addEventListener('click', function(e) {
    const categoryItem = e.target.closest('.category-item');
    if (categoryItem) {
      const categoryName = categoryItem.dataset.category;
      
      // Analytics tracking
      if (typeof gtag !== 'undefined') {
        gtag('event', 'category_click', {
          'category_name': categoryName,
          'event_category': 'shop_by_category'
        });
      }
    }
  });
});
</script>

{% schema %}
{
  "name": "Shop by Category",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Shop by Category"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category Image",
          "info": "Recommended size: 600x600px"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category Name",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Category Link"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Shop by Category",
      "category": "Custom",
      "blocks": [
        {
          "type": "category"
        },
        {
          "type": "category"
        },
        {
          "type": "category"
        }
      ]
    }
  ]
}
{% endschema %}