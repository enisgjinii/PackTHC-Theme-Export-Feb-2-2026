<div class="clook-section">
  {% if product.metafields.custom.closer_look_images %}
    <div class="clook-container">
      <h2 class="clook-main-title">Product Closer Look</h2>
      
      <div class="clook-grid-wrapper">
        <div class="clook-grid">
          {% assign features_data = product.metafields.custom.closer_look_heading_desc.value %}
          {% assign images = product.metafields.custom.closer_look_images.value %}
          
          {% for image in images limit: 4 %}
            {% assign index = forloop.index0 %}
            {% assign feature = features_data[index] %}
            
            <div class="clook-card">
              <div class="clook-img-box">
                <img 
                  src="{{ image | image_url: width: 800 }}" 
                  srcset="{{ image | image_url: width: 400 }} 400w,
                          {{ image | image_url: width: 600 }} 600w,
                          {{ image | image_url: width: 800 }} 800w"
                  sizes="(min-width: 1200px) 25vw, (min-width: 768px) 33vw, 100vw"
                  alt="{{ feature.title }}" 
                  loading="lazy"
                  class="clook-img">
              </div>
              <div class="clook-text-area">
                <div class="clook-number-line">
                  <span class="clook-num">{{ forloop.index }}</span>
                  <span class="clook-dots"></span>
                </div>
                <h3 class="clook-title">{{ feature.title }}</h3>
                <p class="clook-desc">{{ feature.description }}</p>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  {% endif %}
</div>

<style>
/* Main Container */
.clook-section {
  padding: 60px 0;
  background: #fff;
}

.clook-container {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 20px;
}

.clook-main-title {
  text-align: center;
  font-size: 36px;
  font-weight: 700;
  margin: 0 0 60px 0;
  color: #000;
  font-family: inherit;
}

/* Grid Wrapper for Mobile Scroll */
.clook-grid-wrapper {
  overflow: visible;
}

.clook-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
}

/* Card */
.clook-card {
  display: flex;
  flex-direction: column;
}

/* Image Box */
.clook-img-box {
  background: #f5f5f5;
  border-radius: 8px;
  margin-bottom: 24px;
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.clook-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}

/* Text Area */
.clook-text-area {
  text-align: left;
}

/* Number with Dots */
.clook-number-line {
  display: flex;
  align-items: center;
  margin-bottom: 8px;
  gap: 8px;
}

.clook-num {
  font-size: 14px;
  color: #666;
  font-weight: 400;
  flex-shrink: 0;
}

.clook-dots {
  flex: 1;
  height: 1px;
  background-image: linear-gradient(to right, #ddd 50%, transparent 50%);
  background-size: 6px 1px;
  background-repeat: repeat-x;
}

.clook-title {
  font-size: 20px;
  font-weight: 700;
  margin: 0 0 12px 0;
  color: #000;
  line-height: 1.3;
}

.clook-desc {
  font-size: 14px;
  line-height: 1.6;
  color: #666;
  margin: 0;
}

/* Tablet */
@media (max-width: 990px) {
  .clook-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 30px;
  }
  
  .clook-main-title {
    font-size: 32px;
    margin-bottom: 40px;
  }
}

/* Mobile with Horizontal Scroll */
@media (max-width: 749px) {
  .clook-section {
    padding: 40px 0;
  }
  
  .clook-container {
    padding: 0;
  }
  
  .clook-main-title {
    font-size: 26px;
    margin-bottom: 30px;
    padding: 0 20px;
  }
  
  .clook-grid-wrapper {
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 0 20px;
  }
  
  .clook-grid-wrapper::-webkit-scrollbar {
    display: none;
  }
  
  .clook-grid {
    display: flex;
    gap: 16px;
    padding-bottom: 10px;
  }
  
  .clook-card {
    min-width: 240px;
    max-width: 240px;
    flex-shrink: 0;
  }
  
  .clook-img-box {
    aspect-ratio: 1;
    margin-bottom: 16px;
  }
  
  .clook-img {
    width: auto;
    height: auto;
    object-fit: contain;
  }
  
  .clook-title {
    font-size: 16px;
    margin-bottom: 8px;
  }
  
  .clook-desc {
    font-size: 13px;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  
  .clook-number-line {
    margin-bottom: 6px;
  }
  
  .clook-num {
    font-size: 13px;
  }
}


</style>

{% schema %}
{
  "name": "Closer Look Section",
  "settings": [],
  "presets": [
    {
      "name": "Closer Look"
    }
  ]
}
{% endschema %}