{% stylesheet %}
  .comparison-section {
    background: #223D2C;
    padding: 60px 40px;
    margin: 0 auto;
  }

  .comparison-container {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 60px;
    align-items: center;
  }

  .comparison-left {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .comparison-title {
    font-size: 48px;
    font-weight: 800;
    line-height: 1.1;
    color: #ffffff;
  }

  .comparison-subtitle {
    font-size: 16px;
    color: #d1d5db;
    line-height: 1.6;
  }

  .comparison-cta {
    background-color: #ffffff;
    color: #1f2937;
    padding: 16px 32px;
    border: none;
    border-radius: 50px;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 0.3s ease;
    text-decoration: none;
    display: inline-block;
    text-align: center;
    align-self: flex-start;
  }

  .comparison-cta:hover {
    background-color: #223D2C;
    color: #ffffff;
  }

  .comparison-features {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    margin-top: 16px;
  }

  .comparison-feature {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-align: center;
  }

  .comparison-feature-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .comparison-feature-icon svg {
    width: 100%;
    height: 100%;
    fill: #ffffff;
  }

  .comparison-feature-text {
    font-size: 13px;
    color: white;
    font-weight: 600;
    line-height: 1.3;
  }

  .comparison-right {
    /*
    background: #1e293b;*/
    border: 2px solid #334155;
    border-radius: 20px;
    overflow: hidden;
  }

  .comparison-table {
    width: 100%;
    border-collapse: collapse;
  }
/*
  .comparison-table thead {
    background: #0f172a;
  }
    */

  .comparison-table th {
    padding: 20px 16px;
    text-align: center;
    font-size: 14px;
    font-weight: 700;
    color: white;
    border-bottom: 2px solid #334155;
  }

  .comparison-table th:first-child {
    text-align: left;
    background: transparent;
  }

  .comparison-table th.highlight {
    background: #ffffff;
    position: relative;
    color: #000000;
  }

  .comparison-table tbody tr {
    border-bottom: 1px solid #334155;
  }

  .comparison-table tbody tr:last-child {
    border-bottom: none;
  }

  .comparison-table td {
    padding: 20px 16px;
    text-align: center;
    font-size: 15px;
    font-weight: 600;
    color: white;
  }

  .comparison-table td:first-child {
    text-align: left;
    color: #e5e7eb;
  }

  .comparison-check {
    color: #ffffff;
    font-size: 28px;
    line-height: 1;
  }

  .comparison-cross {
    color: #ffffff;
    font-size: 28px;
    line-height: 1;
  }

  /* Tablet Responsive (1024px and below) */
  @media (max-width: 1024px) {
    .comparison-section {
      padding: 40px 32px;
    }

    .comparison-container {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .comparison-title {
      font-size: 36px;
    }

    .comparison-features {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }

    .comparison-table th,
    .comparison-table td {
      padding: 16px 12px;
      font-size: 13px;
    }
  }

  /* Mobile Large (768px and below) */
  @media (max-width: 768px) {
    .comparison-section {
      padding: 32px 20px;
    }

    .comparison-container {
      gap: 32px;
    }

    .comparison-title {
      font-size: 28px;
    }

    .comparison-subtitle {
      font-size: 14px;
    }

    .comparison-cta {
      width: 100%;
      align-self: stretch;
    }

    .comparison-features {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }

    .comparison-feature-icon {
      width: 40px;
      height: 40px;
    }

    .comparison-feature-text {
      font-size: 12px;
    }

    .comparison-right {
      overflow-x: auto;
    }

    .comparison-table {
      min-width: 600px;
    }

    .comparison-table th,
    .comparison-table td {
      padding: 14px 10px;
      font-size: 12px;
    }

    .comparison-check,
    .comparison-cross {
      font-size: 24px;
    }
  }

  /* Mobile Small (480px and below) */
  @media (max-width: 480px) {
    .comparison-section {
      padding: 24px 16px;
    }

    .comparison-container {
      gap: 28px;
    }

    .comparison-title {
      font-size: 24px;
    }

    .comparison-subtitle {
      font-size: 13px;
    }

    .comparison-cta {
      padding: 14px 28px;
      font-size: 13px;
    }

    .comparison-features {
      gap: 16px;
    }

    .comparison-feature-icon {
      width: 36px;
      height: 36px;
    }

    .comparison-feature-text {
      font-size: 11px;
    }

    .comparison-table th,
    .comparison-table td {
      padding: 12px 8px;
      font-size: 11px;
    }

    .comparison-check,
    .comparison-cross {
      font-size: 20px;
    }
  }
{% endstylesheet %}

<div class="comparison-section">
  <div class="comparison-container">
    <div class="comparison-left">
      <h2 class="comparison-title">{{ section.settings.main_title }}</h2>
      <p class="comparison-subtitle">{{ section.settings.subtitle }}</p>
      
      <a href="{{ section.settings.cta_link }}" class="comparison-cta">
        {{ section.settings.cta_text }}
      </a>

      <div class="comparison-features">
        {% for block in section.blocks %}
          {% if block.type == 'feature_item' %}
            <div class="comparison-feature">
              <div class="comparison-feature-icon">
                {% if block.settings.icon_svg %}
                  {{ block.settings.icon_svg }}
                {% else %}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="M12 2L2 7v10c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-10-5z"/>
                  </svg>
                {% endif %}
              </div>
              <div class="comparison-feature-text">{{ block.settings.feature_text }}</div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="comparison-right">
      <table class="comparison-table">
        <thead>
          <tr>
            <th></th>
            <th class="highlight">{{ section.settings.col1_header }}</th>
            <th>{{ section.settings.col2_header }}</th>
            <th>{{ section.settings.col3_header }}</th>
            <th>{{ section.settings.col4_header }}</th>
          </tr>
        </thead>
        <tbody>
          {% for block in section.blocks %}
            {% if block.type == 'comparison_row' %}
              <tr>
                <td>{{ block.settings.row_label }}</td>
                <td>
                  {% if block.settings.col1_value == 'check' %}
                    <span class="comparison-check">✓</span>
                  {% else %}
                    <span class="comparison-cross">✕</span>
                  {% endif %}
                </td>
                <td>
                  {% if block.settings.col2_value == 'check' %}
                    <span class="comparison-check">✓</span>
                  {% else %}
                    <span class="comparison-cross">✕</span>
                  {% endif %}
                </td>
                <td>
                  {% if block.settings.col3_value == 'check' %}
                    <span class="comparison-check">✓</span>
                  {% else %}
                    <span class="comparison-cross">✕</span>
                  {% endif %}
                </td>
                <td>
                  {% if block.settings.col4_value == 'check' %}
                    <span class="comparison-check">✓</span>
                  {% else %}
                    <span class="comparison-cross">✕</span>
                  {% endif %}
                </td>
              </tr>
            {% endif %}
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>

