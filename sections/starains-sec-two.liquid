{% comment %}
  Section: Tabbed Content Section
  Usage: Add this file to sections folder as 'tabbed-content.liquid'
{% endcomment %}

<style>
  #shopify-section-{{ section.id }} {
    padding: 80px 0;
    background-color: {{ section.settings.background_color }};
  }

  #shopify-section-{{ section.id }} .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  #shopify-section-{{ section.id }} .section-title {
    font-size: 48px;
    font-weight: 800;
    color: {{ section.settings.title_color }};
    text-align: center;
    margin: 0 0 60px 0;
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  /* Tabs Navigation */
  #shopify-section-{{ section.id }} .tabs-nav {
    display: flex;
    gap: 0;
    border-bottom: 2px solid {{ section.settings.border_color }};
    margin-bottom: 50px;
    overflow-x: auto;
    scrollbar-width: thin;
  }

  #shopify-section-{{ section.id }} .tabs-nav::-webkit-scrollbar {
    height: 4px;
  }

  #shopify-section-{{ section.id }} .tabs-nav::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.1);
  }

  #shopify-section-{{ section.id }} .tabs-nav::-webkit-scrollbar-thumb {
    background: {{ section.settings.tab_active_color }};
  }

  #shopify-section-{{ section.id }} .tab-button {
    padding: 20px 40px;
    background: transparent;
    border: none;
    color: {{ section.settings.tab_color }};
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
    position: relative;
    transition: all 0.3s ease;
    white-space: nowrap;
    border-bottom: 3px solid transparent;
  }

  #shopify-section-{{ section.id }} .tab-button:hover {
    color: {{ section.settings.tab_hover_color }};
    background: rgba(255, 255, 255, 0.05);
  }

  #shopify-section-{{ section.id }} .tab-button.active {
    color: {{ section.settings.tab_active_color }};
    border-bottom-color: {{ section.settings.tab_active_color }};
  }

  /* Tab Content */
  #shopify-section-{{ section.id }} .tabs-content {
    position: relative;
    min-height: 300px;
  }

  #shopify-section-{{ section.id }} .tab-panel {
    display: none;
    animation: fadeIn 0.4s ease;
  }

  #shopify-section-{{ section.id }} .tab-panel.active {
    display: block;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  #shopify-section-{{ section.id }} .tab-content-wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  /* Text Content */
  #shopify-section-{{ section.id }} .tab-text-content {
    color: {{ section.settings.content_color }};
  }

  #shopify-section-{{ section.id }} .tab-content-title {
    font-size: 36px;
    font-weight: 700;
    color: {{ section.settings.content_title_color }};
    margin: 0 0 20px 0;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  #shopify-section-{{ section.id }} .tab-content-description {
    font-size: 16px;
    line-height: 1.8;
    margin: 0 0 30px 0;
  }

  #shopify-section-{{ section.id }} .tab-content-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .tab-content-list li {
    font-size: 16px;
    line-height: 2;
    padding-left: 25px;
    position: relative;
    margin-bottom: 10px;
  }

  #shopify-section-{{ section.id }} .tab-content-list li:before {
    content: "→";
    position: absolute;
    left: 0;
    color: {{ section.settings.tab_active_color }};
    font-weight: bold;
  }

  #shopify-section-{{ section.id }} .tab-cta-button {
    display: inline-block;
    background: {{ section.settings.button_background }};
    color: {{ section.settings.button_text_color }};
    padding: 15px 40px;
    border-radius: 4px;
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.3s ease;
    margin-top: 20px;
    letter-spacing: 1px;
  }

  #shopify-section-{{ section.id }} .tab-cta-button:hover {
    background: {{ section.settings.button_hover_background }};
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(255, 255, 255, 0.2);
  }

  /* Image Content */
  #shopify-section-{{ section.id }} .tab-image-content {
    position: relative;
  }

  #shopify-section-{{ section.id }} .tab-image-wrapper {
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.5);
  }

  #shopify-section-{{ section.id }} .tab-image-wrapper img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.5s ease;
  }

  #shopify-section-{{ section.id }} .tab-image-wrapper:hover img {
    transform: scale(1.05);
  }

  /* Single Column Layout */
  #shopify-section-{{ section.id }} .tab-content-single {
    max-width: 1000px;
    margin: 0 auto;
  }

  @media (max-width: 1024px) {
    #shopify-section-{{ section.id }} .tab-content-wrapper {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    #shopify-section-{{ section.id }} .section-title {
      font-size: 36px;
    }

    #shopify-section-{{ section.id }} .tab-content-title {
      font-size: 28px;
    }
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding: 50px 0;
    }

    #shopify-section-{{ section.id }} .container {
      padding: 0 20px;
    }

    #shopify-section-{{ section.id }} .section-title {
      font-size: 28px;
      margin-bottom: 40px;
    }

    #shopify-section-{{ section.id }} .tab-button {
      padding: 15px 25px;
      font-size: 14px;
    }

    #shopify-section-{{ section.id }} .tabs-content {
      min-height: 200px;
    }
  }
</style>

<div class="container">
  {% if section.settings.title != blank %}
    <h2 class="section-title">{{ section.settings.title }}</h2>
  {% endif %}

  <div class="tabs-nav" role="tablist">
    {% for block in section.blocks %}
      <button 
        class="tab-button {% if forloop.first %}active{% endif %}"
        data-tab="tab-{{ section.id }}-{{ forloop.index }}"
        role="tab"
        aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
        {{ block.shopify_attributes }}
      >
        {{ block.settings.tab_title }}
      </button>
    {% endfor %}
  </div>

  <div class="tabs-content">
    {% for block in section.blocks %}
      <div 
        class="tab-panel {% if forloop.first %}active{% endif %}"
        id="tab-{{ section.id }}-{{ forloop.index }}"
        role="tabpanel"
        {{ block.shopify_attributes }}
      >
        {% if block.settings.layout == 'two-column' %}
          <div class="tab-content-wrapper">
            <div class="tab-text-content">
              {% if block.settings.content_title != blank %}
                <h3 class="tab-content-title">{{ block.settings.content_title }}</h3>
              {% endif %}
              
              {% if block.settings.content_description != blank %}
                <div class="tab-content-description">{{ block.settings.content_description }}</div>
              {% endif %}

              {% if block.settings.content_list != blank %}
                <ul class="tab-content-list">
                  {% assign list_items = block.settings.content_list | split: '|' %}
                  {% for item in list_items %}
                    <li>{{ item | strip }}</li>
                  {% endfor %}
                </ul>
              {% endif %}

              {% if block.settings.button_text != blank and block.settings.button_link != blank %}
                <a href="{{ block.settings.button_link }}" class="tab-cta-button">
                  {{ block.settings.button_text }}
                </a>
              {% endif %}
            </div>

            <div class="tab-image-content">
              {% if block.settings.image != blank %}
                <div class="tab-image-wrapper">
                  {{ block.settings.image | image_url: width: 1000 | image_tag: alt: block.settings.content_title }}
                </div>
              {% endif %}
            </div>
          </div>
        {% else %}
          <div class="tab-content-single">
            {% if block.settings.content_title != blank %}
              <h3 class="tab-content-title">{{ block.settings.content_title }}</h3>
            {% endif %}
            
            {% if block.settings.content_description != blank %}
              <div class="tab-content-description">{{ block.settings.content_description }}</div>
            {% endif %}

            {% if block.settings.content_list != blank %}
              <ul class="tab-content-list">
                {% assign list_items = block.settings.content_list | split: '|' %}
                {% for item in list_items %}
                  <li>{{ item | strip }}</li>
                {% endfor %}
              </ul>
            {% endif %}

            {% if block.settings.button_text != blank and block.settings.button_link != blank %}
              <a href="{{ block.settings.button_link }}" class="tab-cta-button">
                {{ block.settings.button_text }}
              </a>
            {% endif %}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

<script>
  (function() {
    const tabButtons = document.querySelectorAll('#shopify-section-{{ section.id }} .tab-button');
    const tabPanels = document.querySelectorAll('#shopify-section-{{ section.id }} .tab-panel');

    tabButtons.forEach(button => {
      button.addEventListener('click', () => {
        const targetTab = button.getAttribute('data-tab');

        // Remove active class from all buttons and panels
        tabButtons.forEach(btn => {
          btn.classList.remove('active');
          btn.setAttribute('aria-selected', 'false');
        });
        tabPanels.forEach(panel => panel.classList.remove('active'));

        // Add active class to clicked button and corresponding panel
        button.classList.add('active');
        button.setAttribute('aria-selected', 'true');
        document.getElementById(targetTab).classList.add('active');
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Tabbed Content",
  "tag": "section",
  "class": "tabbed-content-section",
  "settings": [
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Product Features"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "tab_color",
      "label": "Tab Color",
      "default": "#999999"
    },
    {
      "type": "color",
      "id": "tab_hover_color",
      "label": "Tab Hover Color",
      "default": "#cccccc"
    },
    {
      "type": "color",
      "id": "tab_active_color",
      "label": "Tab Active Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "content_title_color",
      "label": "Content Title Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "content_color",
      "label": "Content Text Color",
      "default": "#cccccc"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_hover_background",
      "label": "Button Hover Background",
      "default": "#cccccc"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "tab_title",
          "label": "Tab Title",
          "default": "Features"
        },
        {
          "type": "select",
          "id": "layout",
          "label": "Content Layout",
          "options": [
            {
              "value": "two-column",
              "label": "Two Column (Text + Image)"
            },
            {
              "value": "single-column",
              "label": "Single Column (Text Only)"
            }
          ],
          "default": "two-column"
        },
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "text",
          "id": "content_title",
          "label": "Content Title",
          "default": "Amazing Features"
        },
        {
          "type": "textarea",
          "id": "content_description",
          "label": "Description",
          "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua."
        },
        {
          "type": "textarea",
          "id": "content_list",
          "label": "List Items",
          "info": "Separate items with | symbol. Example: Item 1 | Item 2 | Item 3"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Only shown in Two Column layout"
        },
        {
          "type": "header",
          "content": "Call to Action"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tabbed Content",
      "blocks": [
        {
          "type": "tab",
          "settings": {
            "tab_title": "Features",
            "content_title": "Amazing Features",
            "content_description": "Discover what makes our product unique and exceptional."
          }
        },
        {
          "type": "tab",
          "settings": {
            "tab_title": "Specifications",
            "content_title": "Technical Specs",
            "content_description": "All the technical details you need to know."
          }
        },
        {
          "type": "tab",
          "settings": {
            "tab_title": "Reviews",
            "content_title": "Customer Reviews",
            "content_description": "See what our customers are saying about this product."
          }
        }
      ]
    }
  ]
}
{% endschema %}