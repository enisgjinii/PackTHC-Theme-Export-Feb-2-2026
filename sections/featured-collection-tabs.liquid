{%- liquid
	assign section_id   = '#shopify-section-' | append: section.id
	assign full         = section.settings.full
	assign heading_size = section.settings.heading_size
	assign button_size  = section.settings.button_size
	assign column_gap   = section.settings.column_gap
	assign column       = section.settings.column
	assign show_dots    = section.settings.show_dots
	assign show_arrows  = section.settings.show_arrows
	assign total        = section.settings.total
	assign sub_heading  = section.settings.sub_heading_text
	assign heading      = section.settings.heading_text
-%}

<style>
	{{ section_id }} .section-wrapper{
		padding-top: {{ section.settings.padding_top_mobile }}px;
		padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
	}

	@media (min-width: 992px) {
		{{ section_id }} .section-wrapper{
			padding-top: {{ section.settings.padding_top }}px;
			padding-bottom: {{ section.settings.padding_bottom }}px;
		}

		{{ section_id }} .swiper:not(.swiper-initialized) .swiper-slide {
			width: calc( ( 100% - {{ column | minus: 1 | times: column_gap }}px ) / {{ column }} );
			margin-right: {{ column_gap }}px;
		}
	}
</style>

<div class="section-wrapper color-{{ section.settings.color_scheme }}">
	<div class="{% if full %}stretch-section stretch-padding{% else %}container{% endif %}">
		{%- if sub_heading != blank or heading != blank -%}
			<div class="header-section text-center">
				{%- if sub_heading != blank -%}
					<div class="sub-heading badge-heading rte">{{- sub_heading -}}</div>
				{%- endif -%}
				{%- if heading != blank -%}
					<h2 class="heading rte {{ heading_size }}">{{- heading -}}</h2>
				{%- endif -%}
			</div>
		{%- endif -%}

		{%- if section.blocks.size > 0 -%}
			<div class="featured-collection-tabs tabs">
				<div class="tabs-head{% if section.settings.button_label == blank %} center-content{% endif %}">
					<div class="tabs-head-desktop">
						{%- for block in section.blocks -%}
							<span class="tab-head {{ section.settings.heading_size_tab }}{% if forloop.index == 1 %} active{% endif %}" data-index="{{ forloop.index }}" data-collection-url="{% if block.settings.collection != blank %}{{ block.settings.collection.url }}{% endif %}" {{ block.shopify_attributes }}{% if request.design_mode %} data-id="{{ block.id }}"{% endif %}>
								{%- liquid
									assign collection = block.settings.collection

									if block.settings.name != blank
										echo block.settings.name | escape
									elsif collection != blank
										echo collection.title
									else
										echo 'general.text.tab' | t | append: ' ' | append: forloop.index
									endif
								-%}
							</span>
						{%- endfor -%}
					</div>

					<div class="toggle-dropdown tabs-head-mobile">
						<div class="dropdown-summary">
							<span class="summary-info {{ section.settings.heading_size_tab }}">
								{%- liquid
									for block in section.blocks limit: 1
										assign collection = block.settings.collection

										if block.settings.name != blank
											echo block.settings.name | escape
										elsif collection != blank
											echo collection.title
										else
											echo 'general.text.tab' | t | append: ' ' | append: forloop.index
										endif
									endfor
								-%}
							</span>

							{%- render 'icon', code: 'arrow-button' -%}
						</div>

						<div class="dropdown-content" role="list">
							<div class="dropdown-content-inner">
								<header class="dropdown-content-header">
									<span class="dropdown-content-title">
										{%- liquid
											for block in section.blocks limit: 1
												assign collection = block.settings.collection

												if block.settings.name != blank
													echo block.settings.name | escape
												elsif collection != blank
													echo collection.title
												else
													echo 'general.text.tab' | t | append: ' ' | append: forloop.index
												endif
											endfor
										-%}
									</span>

									{%- render 'icon', code: 'arrow-button' -%}
								</header>

								<ul class="content" role="list">
									{%- for block in section.blocks -%}
										{%- liquid
											assign collection = block.settings.collection

											if block.settings.name != blank
												assign name = block.settings.name | escape
											elsif collection != blank
												assign name = collection.title
											else
												assign name = 'general.text.tab' | t | append: ' ' | append: forloop.index
											endif
										-%}

										<li class="dropdown-item" data-value="{{ name }}" data-index="{{ forloop.index }}" data-collection-url="{% if collection != blank %}{{ collection.url }}{% endif %}">{{- name -}}</li>
									{%- endfor -%}
								</ul>
							</div>
						</div>
					</div>

					{%- if section.settings.button_label != blank -%}
						{%- liquid
							assign first_collection = section.blocks.first.settings.collection
						-%}

						<a class="button collection-button link-underline {{ button_size }}" href="{{ first_collection.url | default: '#' }}">
							{{- section.settings.button_label | escape -}}
						</a>
					{%- endif -%}
				</div>

				<div class="tabs-content animation-fade carousel-swiper">
					{%- for block in section.blocks -%}
						{%- liquid
							assign collection = block.settings.collection
						-%}

						<div class="tab-content{% if forloop.index == 1 %} active{% endif %}" data-id="{{ block.id }}" data-index="{{ forloop.index }}">
							<template data-options data-pagination-mobile data-css-mode="off">
								{
									{%- if section.settings.loop -%}
										"loop": true,
									{%- endif -%}
									{%- if section.settings.autoplay -%}
										"autoplay": {
											"delay": {{ section.settings.delay | times: 1000 }},
											"disableOnInteraction": false,
											"pauseOnMouseEnter": true
										},
									{%- endif -%}
									{%- if show_arrows -%}
										"navigation": {
											"nextEl": "{{ section_id }} .swiper-button-next",
											"prevEl": "{{ section_id }} .swiper-button-prev"
										},
									{%- endif -%}
									{%- if show_dots -%}
										"pagination": {
											"el": "{{ section_id }} .tab-content[data-id='{{ block.id }}'] .swiper-pagination",
											"clickable": true
										},
									{%- endif -%}
									"spaceBetween": {{ column_gap }},
									"slidesPerView": {{ column }},
									"breakpoints": {
										"240": {
											"slidesPerView": 1.3,
											"spaceBetween": 15
										},
										"992": {
											"slidesPerView": {{ column }}
										}
									}
								}
							</template>

							<div class="swiper">
								<div class="swiper-wrapper">
									{%- for product in collection.products limit: total -%}
										<div class="swiper-slide">
											{%- render 'product-card', product: product -%}
										</div>
									{%- else -%}
										{%- for i in (1..total) -%}
											<div class="swiper-slide">
												{%- render 'product-card-placeholder', index: forloop.index -%}
											</div>
										{%- endfor -%}
									{%- endfor -%}
								</div>
							</div>

							<div class="swiper-controls">
								{%- if show_arrows -%}
									<button class="swiper-button-prev" title ="{{ 'general.swipper.prev' | t }}" aria-label="{{ 'general.swipper.prev' | t }}" id="{{ 'general.swipper.prev' | t }}" aria-labelledby="{{ 'general.swipper.prev' | t }}">{%- render 'icon', code: 'arrow-left-slider' -%}</button>
								{%- endif -%}

								{%- if show_dots -%}
									<div class="swiper-pagination" tabindex="-1"></div>
								{%- endif -%}

								{%- if show_arrows -%}
									<button class="swiper-button-next" title ="{{ 'general.swipper.next' | t }}" aria-label="{{ 'general.swipper.next' | t }}" id="{{ 'general.swipper.next' | t }}" aria-labelledby="{{ 'general.swipper.next' | t }}">{%- render 'icon', code: 'arrow-right-slider' -%}</button>
								{%- endif -%}
							</div>
						</div>
					{%- endfor -%}
				</div>
			</div>
		{%- endif -%}
	</div>
</div>

{% schema %}
{
	"name": "t:sections.featured-collection-tabs.name",
	"tag": "section",
	"class": "featured-collection-tabs-section",
	"disabled_on": {
		"groups": ["header", "footer"]
	},
	"settings": [
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"label": "t:settings_schema.colors.label",
			"default": "scheme-1"
		},
		{
			"type": "text",
			"id": "sub_heading_text",
			"label": "t:general.typography.sub_heading.label"
		},
		{
			"type": "inline_richtext",
			"id": "heading_text",
			"label": "t:general.typography.heading.label"
		},
		{
			"type": "select",
			"id": "heading_size",
			"options": [
				{
					"value": "h4",
					"label": "t:general.typography.heading_size.option_1.label"
				},
				{
					"value": "h3",
					"label": "t:general.typography.heading_size.option_2.label"
				},
				{
					"value": "h2",
					"label": "t:general.typography.heading_size.option_3.label"
				}
			],
			"default": "h3",
			"label": "t:general.typography.heading_size.label"
		},
		{
			"type": "header",
			"content": "t:sections.featured-collection-tabs.settings.header_head.content"
		},

		{
			"type": "select",
			"id": "heading_size_tab",
			"options": [
				{
					"value": "h5",
					"label": "t:general.typography.heading_size.option_1.label"
				},
				{
					"value": "h4",
					"label": "t:general.typography.heading_size.option_2.label"
				},
				{
					"value": "h3",
					"label": "t:general.typography.heading_size.option_3.label"
				}
			],
			"default": "h4",
			"label": "t:general.typography.heading_size.label"
		},
		{
			"type": "text",
			"id": "button_label",
			"label": "t:general.typography.button_label.label"
		},
		{
			"type": "select",
			"id": "button_size",
			"options": [
				{
					"value": "h6",
					"label": "t:general.typography.button_size.option_1.label"
				},
				{
					"value": "h5",
					"label": "t:general.typography.button_size.option_2.label"
				},
				{
					"value": "h4",
					"label": "t:general.typography.button_size.option_3.label"
				}
			],
			"default": "h5",
			"label": "t:general.typography.button_size.label"
		},
		{
			"type": "header",
			"content": "t:sections.featured-collection.settings.header_carousel.content"
		},
		{
			"type": "checkbox",
			"id": "show_arrows",
			"default": true,
			"label": "t:general.slider.show_arrows.label"
		},
		{
			"type": "checkbox",
			"id": "show_dots",
			"default": true,
			"label": "t:general.slider.show_dots.label"
		},
		{
			"type": "checkbox",
			"id": "loop",
			"default": false,
			"label": "t:general.slider.loop.label"
		},
		{
			"type": "checkbox",
			"id": "autoplay",
			"default": false,
			"label": "t:general.slider.autoplay.label"
		},
		{
			"type": "range",
			"id": "delay",
			"min": 3,
			"max": 20,
			"step": 1,
			"default": 5,
			"label": "t:general.slider.delay.label"
		},
		{
			"type": "range",
			"id": "column",
			"min": 1,
			"max": 6,
			"step": 1,
			"default": 4,
			"label": "t:general.slider.column.label"
		},
		{
			"type": "range",
			"id": "column_gap",
			"min": 0,
			"max": 50,
			"step": 1,
			"default": 30,
			"unit": "px",
			"label": "t:general.slider.column_gap.label"
		},
		{
			"type": "range",
			"id": "total",
			"min": 1,
			"max": 20,
			"step": 1,
			"default": 10,
			"label": "t:general.slider.total.label"
		},
		{
			"type": "header",
			"content": "t:general.padding.header_padding.content"
		},
		{
			"type": "range",
			"id": "padding_top",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 50,
			"unit": "px",
			"label": "t:general.padding.top.label"
		},
		{
			"type": "range",
			"id": "padding_bottom",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 50,
			"unit": "px",
			"label": "t:general.padding.bottom.label"
		},
		{
			"type": "paragraph",
			"content": "t:general.padding.paragraph_mobile.content"
		},
		{
			"type": "range",
			"id": "padding_top_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 50,
			"unit": "px",
			"label": "t:general.padding.top.label"
		},
		{
			"type": "range",
			"id": "padding_bottom_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 50,
			"unit": "px",
			"label": "t:general.padding.bottom.label"
		}
	],
	"blocks": [
		{
			"type": "tab",
			"name": "t:sections.featured-collection-tabs.blocks.tab.name",
			"settings": [
				{
					"type": "text",
					"id": "name",
					"label": "t:general.typography.heading.label"
				},
				{
					"type": "collection",
					"id": "collection",
					"label": "t:sections.featured-collection-tabs.blocks.tab.settings.collection.label"
				}
			]
		}
	],
	"presets": [
		{
			"name": "t:sections.featured-collection-tabs.name",
			"blocks": [
				{
					"type": "tab",
					"settings": {
						"name": "Tab 1"
					}
				},
				{
					"type": "tab",
					"settings": {
						"name": "Tab 2"
					}
				}
			]
		}
	]
}
{% endschema %}
