{% comment %} Self-contained Multi Banner Slider (Purely Theme Compatible) {% endcomment %}
<style>
  .multi-banner-slider {
    max-width: 1762px;
    margin: auto;
    position: relative;
    overflow: hidden;
  }
  .multi-banner-slider .slides {
    display: flex;
    transition: transform 0.5s ease-in-out;
  }
  .multi-banner-slider .slide {
    flex: 0 0 100%;
    text-align: center;
  }
  .multi-banner-slider img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .multi-banner-slider .dots {
    text-align: center;
    margin-top: 10px;
  }
  .multi-banner-slider .dot {
    display: inline-block;
    width: 10px;
    height: 10px;
    margin: 0 5px;
    background-color: #999;
    border-radius: 50%;
    cursor: pointer;
  }
  .multi-banner-slider .dot.active {
    background-color: #333;
  }
</style>

<div class="multi-banner-slider" id="bannerSlider-{{ section.id }}" style="padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px 0;">
  <div class="slides">
    {% for block in section.blocks %}
      <div class="slide">
        <a href="{{ block.settings.banner_link }}" target="_blank">
          <img src="{{ block.settings.banner_image | image_url: width: 1762 }}" alt="Slide {{ forloop.index }}">
        </a>
      </div>
    {% endfor %}
  </div>
  <div class="dots">
    {% for block in section.blocks %}
      <span class="dot{% if forloop.first %} active{% endif %}" data-index="{{ forloop.index0 }}"></span>
    {% endfor %}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var sliderId = "bannerSlider-{{ section.id }}";
    var slider = document.getElementById(sliderId);
    var slidesContainer = slider.querySelector('.slides');
    var dots = slider.querySelectorAll('.dot');
    var totalSlides = dots.length;
    var currentIndex = 0;
    var delay = {{ section.settings.slider_speed | default: 3 }} * 1000;

    function goToSlide(index) {
      slidesContainer.style.transform = 'translateX(' + (-index * 100) + '%)';
      dots.forEach(function (dot) { dot.classList.remove('active'); });
      if (dots[index]) dots[index].classList.add('active');
      currentIndex = index;
    }

    function nextSlide() {
      var nextIndex = (currentIndex + 1) % totalSlides;
      goToSlide(nextIndex);
    }

    var interval = setInterval(nextSlide, delay);

    dots.forEach(function (dot) {
      dot.addEventListener('click', function () {
        clearInterval(interval);
        goToSlide(parseInt(this.getAttribute('data-index')));
        interval = setInterval(nextSlide, delay);
      });
    });
  });
</script>

{% schema %}
{
  "name": "Multi Banner Slider",
  "settings": [
    {
      "type": "range",
      "id": "slider_speed",
      "label": "Slider Speed (seconds)",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 3
    },
{
  "type": "number",
  "id": "padding_top",
  "label": "Padding Top (px)",
  "default": 16
},
{
  "type": "number",
  "id": "padding_bottom",
  "label": "Padding Bottom (px)",
  "default": 16
}
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "banner_image",
          "label": "Banner Image"
        },
        {
          "type": "url",
          "id": "banner_link",
          "label": "Custom URL"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Multi Banner Slider",
      "category": "Custom"
    }
  ]
}
{% endschema %}
