        "custom_liquid_fFbkxD": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<style>\nth, td {\n  font-size:13px;\n  text-align:center;\n  padding:8px;\n}\n.email, .mob, th {\n  color:#004A26;\n  font-size:15px;\n}\n@media (max-width: 767px) {\n  th, td {\n    font-size: 10px;\n    padding: 6px;\n  }\n  .email, .mob {\n    font-size: 12px;\n  }\n}\n</style>\n\n{% assign current_variant = product.selected_or_first_available_variant %}\n\n<!-- Default Product Pricing Table -->\n<div id=\"default-pricing-table\">\n  {% assign qty_list = product.metafields.custom.quantity_table %}\n  {% assign unit_list = product.metafields.custom.unit_table %}\n  {% assign price_list = product.metafields.custom.price_table %}\n  \n  {% if qty_list and unit_list and price_list %}\n    <table style=\"width: 100%; border-collapse: collapse; margin-top: 20px;\">\n      <thead>\n        <tr>\n          <th style=\"border: 1px solid #ddd;\" colspan=\"2\">Quantity</th>\n          <th style=\"border: 1px solid #ddd;\">Price Per Case</th>\n          <th style=\"border: 1px solid #ddd;\">Price Per Piece</th>\n        </tr>\n      </thead>\n      <tbody>\n        {% assign qty_array = qty_list | split: ',' %}\n        {% assign unit_array = unit_list | split: ',' %}\n        {% assign price_array = price_list | split: ',' %}\n        \n        {% for i in (0..qty_array.size) %}\n          {% if i < qty_array.size %}\n            <tr>\n              <td style=\"border: 1px solid #ddd;\" colspan=\"2\">{{ qty_array[i] }}</td>\n              <td style=\"border: 1px solid #ddd;\">{{ price_array[i] }}</td>\n              <td style=\"border: 1px solid #ddd;\">{{ unit_array[i] }}</td>\n            </tr>\n          {% endif %}\n        {% endfor %}\n      </tbody>\n      <tfoot>\n        <tr>\n          <td style=\"border: 1px solid #ddd; font-weight:bold;\" colspan=\"4\">\n            For Higher Quantity Pricing, Please \n            <a class=\"email\" href=\"mailto:hello@packthc.com\"> Email Us</a> \n            or Call <a href=\"tel:+1816PACKTHC\" class=\"mob\">+1(816)PACKTHC</a>\n          </td>\n        </tr>\n      </tfoot>\n    </table>\n  {% endif %}\n</div>\n\n<!-- Variant Pricing Table -->\n<div id=\"variant-pricing-table\" style=\"display: none;\">\n  <table style=\"width: 100%; border-collapse: collapse; margin-top: 20px;\">\n    <thead>\n      <tr>\n        <th style=\"border: 1px solid #ddd;\" colspan=\"2\">Quantity</th>\n        <th style=\"border: 1px solid #ddd;\">Price Per Case</th>\n        <th style=\"border: 1px solid #ddd;\">Price Per Piece</th>\n      </tr>\n    </thead>\n    <tbody id=\"variant-table-body\">\n      <!-- Content will be populated by JavaScript -->\n    </tbody>\n    <tfoot>\n      <tr>\n        <td style=\"border: 1px solid #ddd; font-weight:bold;\" colspan=\"4\">\n          For Higher Quantity Pricing, Please \n          <a class=\"email\" href=\"mailto:hello@packthc.com\"> Email Us</a> \n          or Call <a href=\"tel:+1816PACKTHC\" class=\"mob\">+1(816)PACKTHC</a>\n        </td>\n      </tr>\n    </tfoot>\n  </table>\n</div>\n\n<!-- Hidden data for all variants -->\n{% assign has_variants_with_pricing = false %}\n{% assign first_variant_with_pricing_id = '' %}\n\n{% for variant in product.variants %}\n  {% if variant.metafields.custom.quantity_table and variant.metafields.custom.unit_table and variant.metafields.custom.price_table %}\n    {% assign has_variants_with_pricing = true %}\n    {% if first_variant_with_pricing_id == blank %}\n      {% assign first_variant_with_pricing_id = variant.id %}\n    {% endif %}\n  {% endif %}\n{% endfor %}\n\n{% if has_variants_with_pricing %}\n<script type=\"application/json\" id=\"variant-pricing-data\">\n{\n  {% for variant in product.variants %}\n    \"{{ variant.id }}\": {\n      \"title\": \"{{ variant.title }}\",\n      \"qty\": \"{{ variant.metafields.custom.quantity_table }}\",\n      \"unit\": \"{{ variant.metafields.custom.unit_table }}\",\n      \"price\": \"{{ variant.metafields.custom.price_table }}\"\n    }{% unless forloop.last %},{% endunless %}\n  {% endfor %}\n}\n</script>\n\n<script>\nlet currentSelectedVariant = '{{ current_variant.id }}';\nlet isVariantSelected = false;\n{% if qty_list and unit_list and price_list %}\nlet hasDefaultPricing = true;\n{% else %}\nlet hasDefaultPricing = false;\n{% endif %}\nconst hasVariantPricing = {{ has_variants_with_pricing | json }};\nconst firstVariantWithPricing = '{{ first_variant_with_pricing_id }}';\n\nfunction showDefaultTable() {\n  document.getElementById('default-pricing-table').style.display = 'block';\n  document.getElementById('variant-pricing-table').style.display = 'none';\n}\n\nfunction showVariantTable(variantId) {\n  if (!hasVariantPricing) {\n    showDefaultTable();\n    return;\n  }\n\n  const data = JSON.parse(document.getElementById('variant-pricing-data').textContent);\n  const variant = data[variantId];\n  \n  if (!variant || !variant.qty || !variant.unit || !variant.price) {\n    showDefaultTable();\n    return;\n  }\n  \n  // Hide default table and show variant table\n  document.getElementById('default-pricing-table').style.display = 'none';\n  document.getElementById('variant-pricing-table').style.display = 'block';\n  \n  // Update table body\n  const qtyArray = variant.qty.split(',');\n  const unitArray = variant.unit.split(',');\n  const priceArray = variant.price.split(',');\n  \n  let tableHTML = '';\n  for (let i = 0; i < qtyArray.length; i++) {\n    const qty = qtyArray[i] ? qtyArray[i].trim() : '';\n    const unit = unitArray[i] ? unitArray[i].trim() : '';\n    const price = priceArray[i] ? priceArray[i].trim() : '';\n    \n    if (qty && unit && price) {\n      tableHTML += `\n        <tr>\n          <td style=\"border: 1px solid #ddd;\" colspan=\"2\">${qty}</td>\n          <td style=\"border: 1px solid #ddd;\">${price}</td>\n          <td style=\"border: 1px solid #ddd;\">${unit}</td>\n        </tr>\n      `;\n    }\n  }\n  \n  document.getElementById('variant-table-body').innerHTML = tableHTML;\n}\n\nfunction checkVariantSelection() {\n  // If no variant pricing exists, always show default table\n  if (!hasVariantPricing) {\n    showDefaultTable();\n    return;\n  }\n\n  let newVariant = null;\n  let variantWasClicked = false;\n  \n  // Check for radio buttons (like Label Type)\n  const checkedRadio = document.querySelector('input[name=\"Label Type\"]:checked, input[name=\"id\"]:checked');\n  if (checkedRadio) {\n    // If it's a variant selector\n    if (checkedRadio.name === 'id') {\n      newVariant = checkedRadio.value;\n      variantWasClicked = true;\n    } else if (checkedRadio.name === 'Label Type') {\n      // For Label Type, we need to find the corresponding variant\n      const labelValue = checkedRadio.value;\n      const data = JSON.parse(document.getElementById('variant-pricing-data').textContent);\n      \n      // Find variant that matches this label type\n      for (const [variantId, variantData] of Object.entries(data)) {\n        if (variantData.title.includes(labelValue)) {\n          newVariant = variantId;\n          variantWasClicked = true;\n          break;\n        }\n      }\n    }\n  }\n  \n  // Check select dropdown\n  if (!newVariant) {\n    const select = document.querySelector('select[name=\"id\"]');\n    if (select && select.value) {\n      newVariant = select.value;\n      if (select.value !== currentSelectedVariant) {\n        variantWasClicked = true;\n      }\n    }\n  }\n  \n  // Update if variant changed\n  if (newVariant && newVariant !== currentSelectedVariant) {\n    currentSelectedVariant = newVariant;\n    isVariantSelected = variantWasClicked;\n    \n    if (isVariantSelected) {\n      showVariantTable(newVariant);\n    }\n  }\n}\n\nfunction initializePricingTable() {\n  // If product has default pricing, show default table\n  if (hasDefaultPricing) {\n    showDefaultTable();\n  }\n  // If product has no default pricing but has variant pricing, show first variant's table\n  else if (hasVariantPricing && firstVariantWithPricing) {\n    showVariantTable(firstVariantWithPricing);\n  }\n  // If neither exists, hide both tables\n  else {\n    document.getElementById('default-pricing-table').style.display = 'none';\n    document.getElementById('variant-pricing-table').style.display = 'none';\n  }\n}\n\n// Only add event listeners if there are variants with pricing\nif (hasVariantPricing) {\n  // Event listeners\n  document.addEventListener('click', function(e) {\n    // Listen for clicks on variant options\n    if (e.target.matches('input[name=\"Label Type\"], input[name=\"id\"], label[for*=\"option-\"]')) {\n      setTimeout(() => {\n        isVariantSelected = true;\n        checkVariantSelection();\n      }, 100);\n    }\n  });\n\n  document.addEventListener('change', function(e) {\n    if (e.target.matches('select[name=\"id\"], input[name=\"Label Type\"], input[name=\"id\"]')) {\n      isVariantSelected = true;\n      setTimeout(checkVariantSelection, 50);\n    }\n  });\n\n  // Fallback check\n  setInterval(checkVariantSelection, 1000);\n}\n\n// Initialize - show appropriate table on page load\ndocument.addEventListener('DOMContentLoaded', function() {\n  initializePricingTable();\n});\n</script>\n{% endif %}"
          }
        }
