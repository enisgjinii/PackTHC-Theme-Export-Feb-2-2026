{%- liquid
	assign section_id             = '#shopify-section-' | append: section.id
	assign animation              = settings.section_animation
	assign full                   = section.settings.full
	assign layout                 = section.settings.layout
	assign layout_heading         = section.settings.layout_heading
	assign heading_collection     = section.settings.heading_collection
	assign content_width          = section.settings.content_width
	assign rows                   = section.settings.rows
	assign show_arrows            = section.settings.show_arrows
	assign show_dots              = section.settings.show_dots
	assign columns                = section.settings.columns | times: 1
	assign columns_mobile         = section.settings.columns_mobile | times: 1
	assign total                  = rows | times: columns
	assign collections_to_display = section.settings.collection_list
-%}

<style>
	@media (min-width: 1024px) {
		{{ section_id }} .collections {
			max-width: {{ content_width }}%;
			margin: 0 auto;
		}
	}

	{{ section_id }} .section-wrapper {
		--item-gap: 2.4rem 2.4rem;
		--template-columns: repeat({{ columns_mobile }}, minmax(0, 1fr));
		padding-top: {{ section.settings.padding_top_mobile }}px;
		padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
	}

	@media (min-width: 992px) {
		{{ section_id }} .section-wrapper {
			--item-gap: 6rem 3rem;
			--template-columns: repeat({{ columns }}, minmax(0, 1fr));
			padding-top: {{ section.settings.padding_top }}px;
			padding-bottom: {{ section.settings.padding_bottom }}px;
		}
	}
</style>

{{ 'filter.css' | asset_url | stylesheet_tag }}
{{ 'nouislider.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nouislider.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'filter.js' | asset_url }}" defer="defer"></script>

<div class="section-wrapper color-{{ section.settings.color_scheme }}">
	<div class="has-product-filters filters-{{ layout }}{% if layout == 'left' or layout == 'right' %} filters-sidebar{% endif %}" data-id="{{ section.id }}">
		<div class="collections content{% if section.settings.infinite_scroll %} infinite-scroll{% endif %}{% if section.settings.show_collection_list and collections.size > 0 %} has-collection-list{% endif %}" data-type="collection">
			{%- paginate collection.products by total -%}
				{% comment %} Collection info {% endcomment %}
				<div class="collection-info text-{{ section.settings.align }}{% if animation %} scroll-trigger{% endif %} layout-heading-{{ layout_heading }}">
					{%- if section.settings.show_collection_image or section.settings.show_heading or section.settings.show_description-%}
						<div class="collection-inner{% if section.settings.show_collection_image and collection.image %} has-image {% endif %}">
							{%- if section.settings.show_collection_image and collection.image -%}
								<div class="collection-media">
									<img
										srcset="{%- if collection.image.width >= 165 -%}{{ collection.image | image_url: width: 165 }} 165w,{%- endif -%}
											{%- if collection.image.width >= 360 -%}{{ collection.image | image_url: width: 360 }} 360w,{%- endif -%}
											{%- if collection.image.width >= 535 -%}{{ collection.image | image_url: width: 535 }} 535w,{%- endif -%}
											{%- if collection.image.width >= 750 -%}{{ collection.image | image_url: width: 750 }} 750w,{%- endif -%}
											{%- if collection.image.width >= 1070 -%}{{ collection.image | image_url: width: 1070 }} 1070w,{%- endif -%}
											{%- if collection.image.width >= 1500 -%}{{ collection.image | image_url: width: 1500 }} 1500w,{%- endif -%}
											{{ collection.image | image_url }} {{ collection.image.width }}w"
										src="{{ collection.image | image_url: width: 940 }}"
										alt="{{ collection.image.alt }}"
										width="{{ collection.image.width }}"
										height="{{ collection.image.height }}" >
								</div>
							{%- endif -%}

							<div class="info-collection container{% if section.settings.image != blank %} has-background{% endif %}">
								{%- if section.settings.show_heading or section.settings.show_description -%}
									<div class="align-inner color-{{ section.settings.color_scheme_banner }}">
										{%- if section.settings.show_heading -%}
											<h1 class="title h1{% if animation %} scroll-trigger{% endif %}">
												{%- liquid
													if collection.handle == 'all'
														echo 'sections.collection_template.title' | t
													else
														echo collection.title
													endif
												-%}
											</h1>
										{%- endif -%}

										{%- if collection.description != blank and section.settings.show_description -%}
											<div class="description{% if animation %} scroll-trigger{% endif %}"><h4>{{- collection.description | strip_html -}}</h4></div>
										{%- endif -%}
									</div>
								{%- endif -%}
							</div>
						</div>
					{%- endif -%}

					{%- if section.settings.show_collection_list and section.settings.collection_list != blank -%}
						{% if layout_heading == 'carousel'%}<div class="carousel-collection color-{{ section.settings.color_scheme_collection_info }}">{% endif %}
							<div class="collection-list{% if layout_heading == 'carousel'%} layout-one{% else %} layout-two text-left{% endif %} full-image carousel-swiper container">
								{%- if heading_collection != blank -%}
									<div class="title-wrapper text-center">
										<h3 class="heading">{{- heading_collection -}}</h3>
									</div>
								{%- endif -%}
								{%- if collections_to_display != blank -%}
									<template data-options data-pagination-mobile data-css-mode="off">
										{
											"loop": false,
											"navigation": {
												"nextEl": "{{ section_id }} .swiper-button-next",
												"prevEl": "{{ section_id }} .swiper-button-prev"
											},
											"pagination": {
												"el": "{{ section_id }} .swiper-pagination",
												"clickable": true
											},
											"spaceBetween": 32,
											"slidesPerView": 4,
											"breakpoints": {
												"240": {
													"slidesPerView": 1.15,
													"spaceBetween": 24
												},
												"992": {
													"slidesPerView": 3
												},
												"1400": {
													"slidesPerView": 3
												}
											}
										}
									</template>

									<div class="swiper" data-id="{{ section.settings.layout }}">
										<div class="swiper-wrapper">
											{%- for collection in collections_to_display  -%}
												{% if layout_heading == 'carousel'%}
													<div class="swiper-slide text-center list-item {% if layout_heading != 'carousel'%} color-{{ section.settings.color_scheme_collection_info }}{% endif %}">
														<a class="card-media min-media" href="{{ collection.url }}" title="{{ collection.url }}">
															<span class="card-media-wrapper{% if settings.image_lazy and collection.featured_image != blank %} lazy-image{% endif %}">
																{%- liquid
																	if collection.featured_image != blank
																		render 'lazy-image', image: collection.featured_image, width: 768
																	else
																		render 'icon', code: 'placeholder'
																	endif
																-%}
															</span>
														</a>

														<h3 class="card-title">
															<a href="{{ collection.url }}" class="card-url" title="{{ collection.url }}">
																{{- collection.title -}}
															</a>
														</h3>
														<div class="collection-count">
															{%- liquid
																assign counts = collection.all_products_count

																echo 'sections.collection_list.count_collection' | t: count: counts
															-%}
														</div>
													</div>
												{% else %}
													<div class="swiper-slide color-{{ section.settings.color_scheme_collection_info }} list-item">
														<a class="card-media" href="{{ collection.url }}" title="{{ collection.url }}">
															<span class="card-media-wrapper{% if settings.image_lazy and collection.featured_image != blank %} lazy-image{% endif %}">
																{%- liquid
																	if collection.featured_image != blank
																		render 'lazy-image', image: collection.featured_image, width: 768
																	else
																		render 'icon', code: 'placeholder'
																	endif
																-%}
															</span>
														</a>
														<div class="infor-card">
															<h4 class="card-title">
																{{- collection.title -}}
															</h4>
															<div class="collection-count">
																{%- liquid
																	assign counts = collection.all_products_count

																	echo 'sections.collection_list.count_collection' | t: count: counts
																-%}
															</div>
															<a href="{{ collection.url }}" class="card-url" title="{{ collection.url }}">
																{{- 'sections.collection_list.all_product' | t -}}

																{% if settings.select_button == 'direction' %}
																	{%- render 'icon', code: 'direction-button' -%}
																{% elsif settings.select_button == 'arrow' %}
																	{%- render 'icon', code: 'arrow-button' -%}
																{% endif %}
															</a>
														</div>
													</div>
												{% endif %}
											{%- endfor -%}
										</div>
									</div>

									{%- if show_arrows or show_dots -%}
										<div class="swiper-controls">
											{%- if show_arrows -%}
												<button class="swiper-button-prev" title ="{{ 'general.swipper.prev' | t }}" aria-label="{{ 'general.swipper.prev' | t }}" id="{{ 'general.swipper.prev' | t }}" aria-labelledby="{{ 'general.swipper.prev' | t }}">{%- render 'icon', code: 'arrow-left-slider' -%}</button>
											{%- endif -%}

											{%- if show_dots -%}
												<div class="swiper-pagination" tabindex="-1"></div>
											{%- endif -%}

											{%- if show_arrows -%}
												<button class="swiper-button-next" title ="{{ 'general.swipper.next' | t }}" aria-label="{{ 'general.swipper.next' | t }}" id="{{ 'general.swipper.next' | t }}" aria-labelledby="{{ 'general.swipper.next' | t }}">{%- render 'icon', code: 'arrow-right-slider' -%}</button>
											{%- endif -%}
										</div>
									{%- endif -%}
								{%- endif -%}
							</div>
						{% if layout_heading == 'carousel'%}</div>{% endif %}
					{%- endif -%}
				</div>

				{% comment %} Products filter {% endcomment %}
				<div class="product-filter {% if full %}stretch-section stretch-padding{% else %}container{% endif %}">
					{%- render 'filter', results: collection, ssettings: section.settings, paginate: paginate -%}
				</div>
			{%- endpaginate -%}
		</div>
	</div>
</div>

{% schema %}
{
	"name": "t:sections.main-collection.name",
	"class": "collection-page-section",
	"settings": [
		{
			"type": "checkbox",
			"id": "full",
			"default": false,
			"label": "t:general.layout.full.label"
		},
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"label": "t:settings_schema.colors.label",
			"default": "scheme-1"
		},
		{
			"type": "range",
			"id": "content_width",
			"default": 100,
			"min": 60,
			"max": 100,
			"step": 1,
			"unit": "%",
			"label": "t:general.dimensions.content_width.label"
		},
		{
			"type": "header",
			"content": "t:sections.main-collection.settings.header_collection.content"
		},
		{
			"type": "color_scheme",
			"id": "color_scheme_banner",
			"label": "t:settings_schema.colors.label",
			"default": "scheme-1"
		},
		{
			"type": "checkbox",
			"id": "show_collection_image",
			"default": false,
			"label": "t:sections.main-collection.settings.show_collection_image.label"
		},
		{
			"type": "checkbox",
			"id": "show_heading",
			"default": true,
			"label": "t:sections.main-collection.settings.show_heading.label"
		},
		{
			"type": "checkbox",
			"id": "show_description",
			"default": true,
			"label": "t:sections.main-collection.settings.show_description.label"
		},
		{
			"type": "select",
			"id": "align",
			"options": [
				{
					"value": "left",
					"label": "t:general.layout.alignment.option_1.label"
				},
				{
					"value": "center",
					"label": "t:general.layout.alignment.option_2.label"
				},
				{
					"value": "right",
					"label": "t:general.layout.alignment.option_3.label"
				}
			],
			"default": "center",
			"label": "t:general.layout.alignment.label"
		},
		{
			"type": "header",
			"content": "t:sections.main-collection.settings.header_collection_list.content"
		},
		{
			"type": "checkbox",
			"id": "show_collection_list",
			"default": false,
			"label": "t:sections.main-collection.settings.show_collection_list.label"
		},
		{
			"type": "color_scheme",
			"id": "color_scheme_collection_info",
			"label": "t:settings_schema.colors.label",
			"default": "scheme-1"
		},
		{
			"type": "text",
			"id": "heading_collection",
			"label": "t:general.typography.heading.label",
			"default": "Shop By Frame Shape"
		},
		{
			"type": "select",
			"id": "layout_heading",
			"options": [
				{
					"value": "carousel",
					"label": "t:sections.main-collection.settings.layout.option_6.label"
				},
				{
					"value": "list",
					"label": "t:sections.main-collection.settings.layout.option_5.label"
				},
			],
			"default": "list",
			"label": "t:sections.main-collection.settings.layout.label"
		},
		{
			"type": "collection_list",
			"id": "collection_list",
			"label": "t:sections.main-collection.settings.collection_list.label"
		},
		{
			"type": "checkbox",
			"id": "show_arrows",
			"default": false,
			"label": "t:general.slider.show_arrows.label"
		},
		{
			"type": "checkbox",
			"id": "show_dots",
			"default": false,
			"label": "t:general.slider.show_dots.label"
		},
		{
			"type": "header",
			"content": "t:sections.main-collection.settings.header_filters.content"
		},
		{
			"type": "select",
			"id": "layout",
			"options": [
				{
					"value": "top",
					"label": "t:sections.main-collection.settings.layout.option_1.label"
				},
				{
					"value": "left",
					"label": "t:sections.main-collection.settings.layout.option_2.label"
				},
				{
					"value": "right",
					"label": "t:sections.main-collection.settings.layout.option_3.label"
				},
				{
					"value": "none",
					"label": "t:sections.main-collection.settings.layout.option_4.label"
				}
			],
			"default": "top",
			"label": "t:sections.main-collection.settings.layout.label",
			"info": "t:sections.main-collection.settings.layout.info"
		},
		{
			"type": "checkbox",
			"id": "infinite_scroll",
			"default": false,
			"label": "t:sections.main-collection.settings.infinite_scroll.label"
		},
		{
			"type": "range",
			"id": "rows",
			"default": 2,
			"min": 1,
			"max": 20,
			"step": 1,
			"label": "t:sections.main-collection.settings.rows.label"
		},
		{
			"type": "select",
			"id": "columns",
			"default": "4",
			"options": [
				{
					"value": "2",
					"label": "2"
				},
				{
					"value": "3",
					"label": "3"
				},
				{
					"value": "4",
					"label": "4"
				},
				{
					"value": "5",
					"label": "5"
				},
				{
					"value": "6",
					"label": "6"
				}
			],
			"label": "t:general.layout.columns.label"
		},
		{
			"type": "select",
			"id": "columns_mobile",
			"default": "2",
			"options": [
				{
					"value": "1",
					"label": "1"
				},
				{
					"value": "2",
					"label": "2"
				}
			],
			"label": "t:general.layout.columns_mobile.label"
		},
		{
			"type": "checkbox",
			"id": "show_sorting",
			"default": true,
			"label": "t:sections.main-collection.settings.show_sorting.label"
		},
		{
			"type": "checkbox",
			"id": "show_results_count",
			"default": false,
			"label": "t:sections.main-collection.settings.show_results_count.label"
		},
		{
			"type": "checkbox",
			"id": "show_filter_count",
			"default": true,
			"label": "t:sections.main-collection.settings.show_filter_count.label"
		},
		{
			"type": "header",
			"content": "t:general.padding.header_padding.content"
		},
		{
			"type": "range",
			"id": "padding_top",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 40,
			"unit": "px",
			"label": "t:general.padding.top.label"
		},
		{
			"type": "range",
			"id": "padding_bottom",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 60,
			"unit": "px",
			"label": "t:general.padding.bottom.label"
		},
		{
			"type": "paragraph",
			"content": "t:general.padding.paragraph_mobile.content"
		},
		{
			"type": "range",
			"id": "padding_top_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 0,
			"unit": "px",
			"label": "t:general.padding.top.label"
		},
		{
			"type": "range",
			"id": "padding_bottom_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 50,
			"unit": "px",
			"label": "t:general.padding.bottom.label"
		}
	]
}
{% endschema %}
