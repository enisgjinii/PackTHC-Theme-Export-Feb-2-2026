{%- liquid
	assign section_id   = '#shopify-section-' | append: section.id
	assign space        = section.settings.space
	assign scale        = section.settings.scale | divided_by: 100.0
	assign scale_mobile = section.settings.scale_mobile | divided_by: 100.0
-%}

<style>
	{{ section_id }} .section-wrapper {
		padding-top: {{ section.settings.padding_top_mobile }}px;
		padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
	}

	{{ section_id }} .marquee-content {
		margin-right: {{ space }}px;
	}

	{{ section_id }} .collections-list{
		width: {{ section.settings.width }}%;
	}

	{{ section_id }} .content-list{
		width: {{ 100 | minus: section.settings.width }}%;;
	}

	{{ section_id }} .marquee {
		--marquee-time: {{ section.settings.time }}s;
		--marquee-scale: {{ scale_mobile }};
	}

	{{ section_id }} .marquee-content img,
	{{ section_id }} .marquee-content svg {
		margin-right: {{ space }}px;
	}

	{%- if section.settings.direction == 'ltr' -%}
		{{ section_id }} .marquee-wrapper {
			animation-direction: reverse;
		}
	{%- endif -%}

	@media (max-width: 991px) {
		{{ section_id }} .collections-list {
			width: 100%;
			height: auto;
		}

		{{ section_id }} .content-list{
			width: 100%;
		}
	}

	@media (min-width: 992px) {
		{{ section_id }} .section-wrapper {
			padding-top: {{ section.settings.padding_top }}px;
			padding-bottom: {{ section.settings.padding_bottom }}px;
		}

		{{ section_id }} .marquee {
			--marquee-scale: {{ scale }};
		}
	}
</style>

<collections-list>
	<div class="section-wrapper color-{{ section.settings.color_scheme }}">
		<div class="stretch-section container">
			<div class="collections-list">
				<div class="background-section">
					{%- for block in section.blocks -%}
						{%- liquid
							assign collection_image = block.settings.image_background

							unless collection_image
								assign collection_image = block.settings.collection.featured_image
							endunless

							unless collection_image
								for product in block.settings.collection.products
									if product.featured_image
										assign collection_image = product.featured_image
										break
									endif
								endfor
							endunless
						-%}

						<div class="background-item{% if forloop.index == 1 %} active{% endif %}" data-bg="{{ forloop.index }}" {{ block.shopify_attributes }}>
  <div class="card-media {% if settings.image_lazy and collection_image != blank %} lazy-image{% endif %}">
    {%- liquid
      if collection_image != blank
        assign fetch_p = 'auto'
        if forloop.index == 1
        assign fetch_p = 'high'
        endif

        assign auto_alt = collection_image.alt
        if auto_alt == blank and block.settings.heading != blank
          assign auto_alt = block.settings.heading
        endif
        if auto_alt == blank and block.settings.title != blank
          assign auto_alt = block.settings.title
        endif
        if auto_alt == blank and block.settings.collection and block.settings.collection.title != blank
  assign auto_alt = block.settings.collection.title
endif
        if auto_alt == blank and section and section.settings and section.settings.title != blank
          assign auto_alt = section.settings.title
        endif
        if auto_alt == blank
          assign auto_alt = 'wholesale child resistant packaging'
        endif

        render 'lazy-image', image: collection_image, width: 300, lazy: image_load, fetchpriority: fetch_p, alt: auto_alt | escape
      else
        render 'icon', code: 'placeholder', height: 300
      endif
    -%}
  </div>
</div>

					{%- endfor -%}
				</div>

				<div class="marquee-wrapper-item text-{{ section.settings.alignment }}">
					{%- for block in section.blocks -%}
						{%- liquid
							assign collection = block.settings.collection
						-%}
						<div class="marquee-content-item{% if forloop.index == 1 %} active{% endif %}" data-bg="{{ forloop.index }}" {{ block.shopify_attributes }}{% if request.design_mode %} data-block-id="{{ block.id }}"{% endif %}>
							<div class="marquee-text {{ block.settings.heading_size }}">
								<div class="link-collection">
									{%- liquid
										if block.settings.heading != blank
											echo block.settings.heading
										elsif collection.title != blank
											echo collection.title
										else
        									echo 'onboarding.collections.title' | t
										endif
									-%}
								</div>
							</div>
						</div>
					{%- endfor -%}
				</div>
			</div>
			<div class="content-list">
				{%- if section.settings.heading != blank -%}
					<p class="heading rte">{{- section.settings.heading -}}</p>
				{%- endif -%}

				<div class="product-list">
					{%- for block in section.blocks -%}
						{%- liquid
							assign collection = block.settings.collection
						-%}

						<div class="tab-product{% if forloop.index == 1 %} active{% endif %}" data-bg="{{ forloop.index }}">
							{%- for product in collection.products limit: 3 -%}
								{%- liquid
									assign collection = block.settings.collection
								-%}

								<div class="item">
									{%- render 'product-card', product: product -%}
								</div>
							{%- else -%}
								{%- for i in (1..3) -%}
									<div class="item">
										{%- render 'product-card-placeholder', index: forloop.index -%}
									</div>
								{%- endfor -%}
							{%- endfor -%}

							{%- if section.settings.button_label != blank -%}
								<div class="link-collection">
									<a class="button primary-button" href="{{ collection.url | default: '#' }}">
										{{- section.settings.button_label -}}

										{% if settings.select_button == 'direction' %}
											{%- render 'icon', code: 'direction-button' -%}
										{% elsif settings.select_button == 'arrow' %}
											{%- render 'icon', code: 'arrow-button' -%}
										{% endif %}
									</a>
								</div>
							{%- endif -%}
						</div>
					{%- endfor -%}
				</div>
			</div>
		</div>
	</div>
</collections-list>

{% schema %}
{
	"name": "t:sections.featured-collections-image.name",
	"tag": "section",
	"class": "featured-collections-image-section",
	"disabled_on": {
		"groups": ["header", "footer"]
	},
	"settings": [
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"label": "t:settings_schema.colors.label",
			"default": "scheme-1"
		},
		{
			"type": "select",
			"id": "alignment",
			"default": "center",
			"label": "t:general.layout.alignment.label",
			"info": "t:general.layout.alignment.mobile_center.label",
			"options": [
				{
					"value": "left",
					"label": "t:general.layout.alignment.option_1.label"
				},
				{
					"value": "center",
					"label": "t:general.layout.alignment.option_2.label"
				},
				{
					"value": "right",
					"label": "t:general.layout.alignment.option_3.label"
				}
			]
		},
		{
			"type": "range",
			"id": "width",
			"min": 30,
			"max": 80,
			"step": 1,
			"default": 50,
			"unit": "%",
			"label": "t:general.dimensions.width.label"
		},
		{
			"type": "inline_richtext",
			"id": "heading",
			"default": "Heading",
			"label": "t:general.typography.heading.label"
		},
		{
			"type": "text",
			"id": "button_label",
			"default": "Button label",
			"label": "t:general.typography.button_label.label"
		},
		{
			"type": "header",
			"content": "t:general.padding.header_padding.content"
		},

		{
			"type": "range",
			"id": "padding_top",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 50,
			"unit": "px",
			"label": "t:general.padding.top.label"
		},
		{
			"type": "range",
			"id": "padding_bottom",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 50,
			"unit": "px",
			"label": "t:general.padding.bottom.label"
		},
		{
			"type": "paragraph",
			"content": "t:general.padding.paragraph_mobile.content"
		},
		{
			"type": "range",
			"id": "padding_top_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 40,
			"unit": "px",
			"label": "t:general.padding.top.label"
		},
		{
			"type": "range",
			"id": "padding_bottom_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 40,
			"unit": "px",
			"label": "t:general.padding.bottom.label"
		}
	],
	"blocks": [
		{
			"type": "collection",
			"name": "t:sections.collection-list.blocks.collection.name",
			"settings": [
				{
					"type": "collection",
					"id": "collection",
					"label": "t:sections.collection-list.blocks.collection.name"
				},
				{
					"type": "inline_richtext",
					"id": "heading",
					"label": "t:general.typography.heading.label"
				},
				{
					"type": "select",
					"id": "heading_size",
					"options": [
						{
							"value": "h3",
							"label": "t:general.typography.heading_size.option_1.label"
						},
						{
							"value": "h2",
							"label": "t:general.typography.heading_size.option_2.label"
						},
						{
							"value": "h1",
							"label": "t:general.typography.heading_size.option_3.label"
						}
					],
					"default": "h2",
					"label": "t:general.typography.heading_size.label"
				},
				{
					"type": "image_picker",
					"id": "image_background",
					"label": "t:general.background.image.label"
				}
			]
		}
	],
	"presets": [
		{
			"name": "t:sections.featured-collections-image.name",
			"blocks": [
				{
					"type": "collection"
				},
				{
					"type": "collection"
				},
				{
					"type": "collection"
				},
				{
					"type": "collection"
				}
			]
		}
	]
}
{% endschema %}
