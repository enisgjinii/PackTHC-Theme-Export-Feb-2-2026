{%- liquid
	assign section_id   = '#shopify-section-' | append: section.id
	assign animation    = settings.section_animation
	assign full         = section.settings.full
	assign space        = section.settings.space
	assign scale        = section.settings.scale | divided_by: 100.0
	assign scale_mobile = section.settings.scale_mobile | divided_by: 100.0
-%}

<style>
	{{ section_id }} .section-wrapper {
		padding-top: {{ section.settings.padding_top_mobile }}px;
		padding-bottom: {{ section.settings.padding_bottom_mobile }}px;

		{%- if section.settings.background != blank -%}
			background: {{ section.settings.background }};
		{%- endif -%}
	}

	{{ section_id }} .marquee-content {
		margin-right: {{ space }}px;
	}

	{{ section_id }} .marquee {
		--marquee-time: {{ section.settings.time }}s;
		--marquee-scale: {{ scale_mobile }};
	}

	{{ section_id }} .marquee-content img,
	{{ section_id }} .marquee-content svg {
		margin-right: {{ space }}px;
	}

	{%- if section.settings.direction == 'ltr' -%}
		{{ section_id }} .marquee-wrapper {
			animation-direction: reverse;
		}
	{%- endif -%}

	@media (min-width: 992px) {
		{{ section_id }} .section-wrapper {
			padding-top: {{ section.settings.padding_top }}px;
			padding-bottom: {{ section.settings.padding_bottom }}px;
		}

		{{ section_id }} .marquee {
			--marquee-scale: {{ scale }};
		}
	}

	{%- for block in section.blocks -%}
		{%- case block.type -%}
			{%- when 'image' -%}
				{{ section_id }} .marquee-content[data-{{ block.id }}] .image-wrapper {
					width: {{ block.settings.width }}px;
				}

				@media (max-width: 991px) {
					{{ section_id }} .marquee-content[data-{{ block.id }}] .image-wrapper {
						width: {{ block.settings.width_mobile }}px;
					}
				}
			{%- when 'text' -%}
				{{ section_id }} .marquee-content[data-{{ block.id }}] .marquee-text {
					font-family: var({{ block.settings.font_family }});
				}
		{%- endcase -%}
	{%- endfor -%}
</style>

<div class="section-wrapper color-{{ section.settings.color_scheme }}">
	<div class="{% if full %}stretch-section{% else %}container{% endif %}">
		<marquee-section class="marquee rte{% if animation %} scroll-trigger{% endif %}">
			<div class="marquee-wrapper marquee-animation">
				{%- for block in section.blocks -%}
					<div class="marquee-content" data-{{ block.id }}>
						{%- if block.settings.icon_image != blank -%}
							<div class="marquee-icon">
								{{ block.settings.icon_image | image_url: width: block.settings.icon_image.width | image_tag: width: block.settings.icon_image.width, loading: 'lazy' }}
							</div>
						{% endif %}

						{%- case block.type -%}
							{%- when 'text' -%}
								<div class="marquee-text">
									{%- liquid
										if block.settings.text != blank
											echo block.settings.text
										endif
									-%}
								</div>

							{%- when 'image' -%}
								{%- liquid
									assign image = block.settings.image
									assign ratio = image.aspect_ratio

									if ratio < 1
										assign height = 400 | times: scale | times: ratio | ceil
									else
										assign height = 300 | times: scale | times: ratio | ceil
									endif
								-%}

								<div class="marquee-image" style="--aspect-ratio: {% if image != blank %}{{ ratio | round: 2 }}{% else %}1{% endif %};">
									<div class="image{% if settings.image_lazy and image != blank %} lazy-image{% endif %}">
										{%- liquid
											if image != blank
												render 'lazy-image', image: image, height: height
											else
												render 'icon', code: 'placeholder'
											endif
										-%}
									</div>
								</div>
						{%- endcase -%}
					</div>
				{%- endfor -%}
			</div>
		</marquee-section>
	</div>
</div>

{% schema %}
{
	"name": "t:sections.marquee.name",
	"tag": "section",
	"class": "marquee-section",
	"disabled_on": {
		"groups": ["footer"]
	},
	"settings": [
		{
			"type": "checkbox",
			"id": "full",
			"default": true,
			"label": "t:general.layout.full.label"
		},
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"label": "t:settings_schema.colors.label",
			"default": "scheme-1"
		},
		{
			"type": "color_background",
			"id": "background",
			"label": "t:general.background.color.label"
		},
		{
			"type": "range",
			"id": "time",
			"min": 1,
			"max": 50,
			"step": 1,
			"default": 20,
			"unit": "s",
			"label": "t:sections.marquee.settings.time.label"
		},
		{
			"type": "range",
			"id": "scale",
			"min": 50,
			"max": 250,
			"step": 5,
			"default": 100,
			"unit": "%",
			"label": "t:sections.marquee.settings.scale.label"
		},
		{
			"type": "range",
			"id": "scale_mobile",
			"min": 50,
			"max": 250,
			"step": 5,
			"default": 100,
			"unit": "%",
			"label": "t:sections.marquee.settings.scale_mobile.label"
		},
		{
			"type": "select",
			"id": "direction",
			"options": [
				{
					"value": "ltr",
					"label": "t:sections.marquee.settings.direction.option_1.label"
				},
				{
					"value": "rtl",
					"label": "t:sections.marquee.settings.direction.option_2.label"
				}
			],
			"default": "rtl",
			"label": "t:sections.marquee.settings.direction.label"
		},
		{
			"type": "range",
			"id": "space",
			"min": 10,
			"max": 100,
			"step": 1,
			"default": 64,
			"unit": "px",
			"label": "t:general.dimensions.space.label"
		},
		{
			"type": "header",
			"content": "t:general.padding.header_padding.content"
		},
		{
			"type": "range",
			"id": "padding_top",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 40,
			"unit": "px",
			"label": "t:general.padding.top.label"
		},
		{
			"type": "range",
			"id": "padding_bottom",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 40,
			"unit": "px",
			"label": "t:general.padding.bottom.label"
		},
		{
			"type": "paragraph",
			"content": "t:general.padding.paragraph_mobile.content"
		},
		{
			"type": "range",
			"id": "padding_top_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 20,
			"unit": "px",
			"label": "t:general.padding.top.label"
		},
		{
			"type": "range",
			"id": "padding_bottom_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 20,
			"unit": "px",
			"label": "t:general.padding.bottom.label"
		}
	],
	"blocks": [
		{
			"type": "text",
			"name": "t:general.typography.text.label",
			"settings": [
				{
					"type": "inline_richtext",
					"id": "text",
					"default": "Welcome to our store",
					"label": "t:general.typography.text.label"
				},
				{
					"type": "select",
					"id": "font_family",
					"options": [
						{
							"value": "--heading-font-family",
							"label": "t:general.typography.font_family.option_1.label"
						},
						{
							"value": "--body-font-family",
							"label": "t:general.typography.font_family.option_2.label"
						}
					],
					"default": "--body-font-family",
					"label": "t:general.typography.font_family.label"
				},
				{
					"type": "image_picker",
					"id": "icon_image",
					"label": "t:general.image.label"
				}
			]
		},
		{
			"type": "image",
			"name": "t:general.image.label",
			"settings": [
				{
					"type": "image_picker",
					"id": "image",
					"label": "t:general.image.label"
				}
			]
		}
	],
	"presets": [
		{
			"name": "t:sections.marquee.name",
			"blocks": [
				{
					"type": "text"
				},
				{
					"type": "text"
				},
				{
					"type": "text"
				}
			]
		}
	]
}
{% endschema %}
