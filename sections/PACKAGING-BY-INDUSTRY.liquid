{% comment %}
  Section: Packaging by Industry
  Usage: Add this file to sections folder as 'packaging-industry.liquid'
  Supports both regular cards and feature cards with icons
{% endcomment %}

<style>
  #shopify-section-{{ section.id }} {
    padding: 60px 0;
    background-color: {{ section.settings.background_color }};
  }

  #shopify-section-{{ section.id }} .container {
    max-width: 1800px;
    margin: 0 auto;
    padding: 0 40px;
  }

  #shopify-section-{{ section.id }} .section-title {
    font-size: 42px;
    font-weight: 800;
    color: {{ section.settings.title_color }};
    text-align: center;
    margin: 0 0 50px 0;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  #shopify-section-{{ section.id }} .cards-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 30px;
  }

  /* Regular Collection Card */
  #shopify-section-{{ section.id }} .card {
    background: {{ section.settings.card_background }};
    border-radius: 0;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  #shopify-section-{{ section.id }} .card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 20px rgba(0,0,0,0.15);
  }

  #shopify-section-{{ section.id }} .card-header {
    background: {{ section.settings.card_header_background }};
    padding: 10px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .card-title {
    font-size: 14px;
    font-weight: 700;
    color: {{ section.settings.card_title_color }};
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .card-image {
    width: 100%;
   /* background: #ffffff; */
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex: 1;
  }

  /* 4 Column Layout - Width 318px Height 168px */
  #shopify-section-{{ section.id }} .cards-grid[data-columns="4"] .card-image {
    min-height: 168px;
    height: auto;
  }

  #shopify-section-{{ section.id }} .cards-grid[data-columns="4"] .card-image img {
    width: 100%;
    max-width: 318px;
    height: 168px;
    object-fit: contain;
    transition: transform 0.3s ease;
  }

  /* 3 Column Layout - Width 427px Height 168px */
  #shopify-section-{{ section.id }} .cards-grid[data-columns="3"] .card-image {
    min-height: 168px;
    height: auto;
  }

  #shopify-section-{{ section.id }} .cards-grid[data-columns="3"] .card-image img {
    width: 100%;
    max-width: 427px;
    height: 168px;
    object-fit: contain;
    transition: transform 0.3s ease;
  }

  /* 2 Column Layout - Width 640px Height 168px */
  #shopify-section-{{ section.id }} .cards-grid[data-columns="2"] .card-image {
    min-height: 168px;
    height: auto;
  }

  #shopify-section-{{ section.id }} .cards-grid[data-columns="2"] .card-image img {
    width: 100%;
    max-width: 640px;
    height: 168px;
    object-fit: contain;
    transition: transform 0.3s ease;
  }

  #shopify-section-{{ section.id }} .card:hover .card-image img {
    transform: scale(1.05);
  }

  /* Feature Card (custom graphic) */
  #shopify-section-{{ section.id }} .feature-card {
    background: {{ section.settings.card_background }};
    border-radius: 0;
    overflow: hidden;
    display: block;
    text-decoration: none;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  #shopify-section-{{ section.id }} .feature-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 20px rgba(0,0,0,0.15);
  }

  #shopify-section-{{ section.id }} .feature-card-image {
    width: 100%;
    height: 100%;
    min-height: 250px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #ffffff;
    padding: 20px;
  }

  #shopify-section-{{ section.id }} .feature-card-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.3s ease;
  }

  #shopify-section-{{ section.id }} .feature-card:hover .feature-card-image img {
    transform: scale(1.02);
  }

  @media (max-width: 1024px) {
    #shopify-section-{{ section.id }} .cards-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
    }

    #shopify-section-{{ section.id }} .cards-grid .card-image {
      height: 168px;
      padding: 15px;
    }

    #shopify-section-{{ section.id }} .cards-grid .card-image img {
      max-width: 100%;
      height: 168px;
    }
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding: 40px 0;
    }

    #shopify-section-{{ section.id }} .container {
      padding: 0 20px;
    }

    #shopify-section-{{ section.id }} .section-title {
      font-size: 28px;
      margin-bottom: 30px;
    }

    #shopify-section-{{ section.id }} .cards-grid {
      grid-template-columns: repeat(1, 1fr);
      gap: 10px;
    }

    #shopify-section-{{ section.id }} .cards-grid .card-image {
      height: 140px;
      padding: 10px;
    }

    #shopify-section-{{ section.id }} .cards-grid .card-image img {
      max-width: 100%;
      height: 140px;
    }
  }

</style>

<div class="container">
  {% if section.settings.title != blank %}
    <h2 class="section-title">{{ section.settings.title }}</h2>
  {% endif %}

  <div class="cards-grid" data-columns="{{ section.settings.columns_desktop }}">
    {% for block in section.blocks %}
      {% if block.type == 'collection_card' %}
        <a href="{{ block.settings.link }}" class="card" {{ block.shopify_attributes }}>
          <div class="card-header">
            <h3 class="card-title">{{ block.settings.title }}</h3>
          </div>
          <div class="card-image">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 800 | image_tag: alt: block.settings.title, loading: 'lazy' }}
            {% else %}
              <span style="font-size: 14px; color: #999;">image</span>
            {% endif %}
          </div>
        </a>

      {% elsif block.type == 'feature_card' %}
        <a href="{{ block.settings.link }}" class="feature-card" {{ block.shopify_attributes }}>
          <div class="feature-card-image">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 800 | image_tag: alt: 'Feature', loading: 'lazy' }}
            {% else %}
              <span style="font-size: 14px; color: #999;">feature image</span>
            {% endif %}
          </div>
        </a>
      {% endif %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Packaging by Industry",
  "tag": "section",
  "class": "packaging-industry-section",
  "settings": [
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "PACKAGING BY INDUSTRY"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (Desktop)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4,
      "info": "Number of columns on desktop"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card Background",
      "default": "#d9d9d9"
    },
    {
      "type": "color",
      "id": "card_header_background",
      "label": "Card Header Background",
      "default": "#d9d9d9"
    },
    {
      "type": "color",
      "id": "card_title_color",
      "label": "Card Title Color",
      "default": "#1a1a1a"
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Card Title",
          "default": "CBD PACKAGING"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL"
        }
      ]
    },
    {
      "type": "feature_card",
      "name": "Feature Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Feature Image",
          "info": "Upload your custom graphic with icons and button"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Packaging by Industry",
      "blocks": [
        {
          "type": "collection_card",
          "settings": {
            "title": "CBD PACKAGING"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "title": "CANNABIS CONCENTRATE PACKAGING"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "title": "MEDICAL MARIJUANA PACKAGING"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "title": "CANNABIS FOR PETS PACKAGING"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "title": "ONLINE & RETAIL CANNABIS PACKAGING"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "title": "CANNABIS GROWERS PACKAGING"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "title": "VAPE PACKAGING"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "title": "DISPLAY PACKAGING"
          }
        }
      ]
    }
  ]
}
{% endschema %}