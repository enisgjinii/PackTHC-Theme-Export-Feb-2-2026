{%- liquid
	assign section_id   = '#shopify-section-' | append: section.id
	assign space        = section.settings.space
-%}

<style>
	{{ section_id }} .section-wrapper .marquee-wrapper-item{
		padding-top: {{ section.settings.padding_top_mobile }}px;
		padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
		width: {{ section.settings.width }}%;
	}

	{{ section_id }} .marquee-content {
		margin-right: {{ space }}px;
	}

	{{ section_id }} .marquee {
		--marquee-time: {{ section.settings.time }}s;
	}

	{{ section_id }} .marquee-content img,
	{{ section_id }} .marquee-content svg {
		margin-right: {{ space }}px;
	}

	{%- if section.settings.direction == 'ltr' -%}
		{{ section_id }} .marquee-wrapper {
			animation-direction: reverse;
		}
	{%- endif -%}

	{%- if section.settings.hover_text -%}
		{{ section_id }} .marquee.text-stroke .marquee-textx {
			color: transparent;
		}
	{%- endif -%}

	@media (max-width: 991px) {
		{{ section_id }} .marquee-wrapper-item {
			width: 100%;
			align-items: flex-start;
			height: auto;
			top: 0;
		}
	}

	@media (min-width: 992px) {
		{{ section_id }} .section-wrapper .marquee-wrapper-item{
			padding-top: {{ section.settings.padding_top }}px;
			padding-bottom: {{ section.settings.padding_bottom }}px;
		}
	}
</style>

<div class="section-wrapper color-{{ section.settings.color_scheme }}">
	<div class="stretch-section text-stroke">
		<div class="background-section">
  {%- for block in section.blocks -%}
    <div class="background-item{% if forloop.index == 1 %} active{% endif %}" data-bg="{{ forloop.index }}">
      {%- if block.settings.image_background != blank -%}
        {{ block.settings.image_background 
          | image_url: width: block.settings.image_background.width 
          | image_tag: 
            width: block.settings.image_background.width, 
            loading: 'lazy', 
            fetchpriority: 'high', 
            alt: block.settings.image_background.alt 
              | default: section.settings.title 
              | default: page_title 
              | default: article.title 
              | default: 'wholesale child resistant packaging' 
              | escape 
        }}
      {%- else -%}
        {%- render 'icon', code: 'placeholder' -%}
      {% endif %}
    </div>
  {%- endfor -%}
</div>
		<div class="marquee-wrapper-item text-center">
			{%- if section.settings.heading != blank -%}
				<p class="heading rte">{{- section.settings.heading -}}</p>
			{%- endif -%}

			{%- for block in section.blocks -%}
				{% assign collection = block.settings.button_link %}

				{% if block.settings.text != blank or collection != blank%}
					<div class="marquee-content-item" data-bg="{{ forloop.index }}">
						<div class="marquee-textx {{ block.settings.heading_size }}">
							<a class="link-collection" href="{{ collection.url }}" title="{{ collection.title }}">
								{%- liquid
									if block.settings.text != blank
										echo block.settings.text
									else
										echo collection.title
									endif
								-%}
							</a>
						</div>
						<b class="controls-hover first">{% if collection != blank %}<a class="link-collection" href="{{ collection.url }}" title="{{ collection.title }}"></a>{% endif %}</b>
						<b class="controls-hover second">{% if collection != blank %}<a class="link-collection" href="{{ collection.url }}" title="{{ collection.title }}"></a>{% endif %}</b>
						<marquee-section class="marquee img-collections text-stroke">
							{% for i in (1..10) %}
								<div class="marquee-wrapper marquee-animation">
									<div class="marquee-content">
										{%- if block.settings.icon_image != blank -%}
											<div class="marquee-icon">
												{{ block.settings.icon_image | image_url: width: block.settings.icon_image.width | image_tag: width: block.settings.icon_image.width, loading: 'lazy' }}
											</div>
										{% endif %}

										<div class="marquee-textx ccc {{ block.settings.heading_size }}">
											{%- liquid
												if block.settings.text != blank
													echo block.settings.text
												else
													echo collection.title
												endif
											-%}
										</div>
									</div>
								</div>
							{% endfor %}
						</marquee-section>
					</div>
				{% endif %}
			{%- endfor -%}
		</div>
	</div>
</div>

{% schema %}
{
	"name": "t:sections.collection_list_hover_image.name",
	"tag": "section",
	"class": "collection-list-hover-image marquee-section",
	"disabled_on": {
		"groups": ["header", "footer"]
	},
	"settings": [
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"label": "t:settings_schema.colors.label",
			"default": "scheme-1"
		},
		{
			"type": "range",
			"id": "width",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 100,
			"unit": "%",
			"label": "t:general.dimensions.width.label"
		},
		{
			"type": "inline_richtext",
			"id": "heading",
			"default": "Heading",
			"label": "t:general.typography.text.label"
		},
		{
			"type": "range",
			"id": "time",
			"min": 1,
			"max": 50,
			"step": 1,
			"default": 5,
			"unit": "s",
			"label": "t:sections.marquee.settings.time.label"
		},
		{
			"type": "range",
			"id": "space",
			"min": 10,
			"max": 100,
			"step": 1,
			"default": 64,
			"unit": "px",
			"label": "t:general.dimensions.space.label"
		},
		{
			"type": "checkbox",
			"id": "hover_text",
			"default": false,
			"label": "t:sections.collection_list_hover_image.settings.hover_text.label"
		},
		{
			"type": "header",
			"content": "t:general.padding.header_padding.content"
		},
		{
			"type": "range",
			"id": "padding_top",
			"min": 50,
			"max": 150,
			"step": 1,
			"default": 100,
			"unit": "px",
			"label": "t:general.padding.top.label"
		},
		{
			"type": "range",
			"id": "padding_bottom",
			"min": 50,
			"max": 150,
			"step": 1,
			"default": 100,
			"unit": "px",
			"label": "t:general.padding.bottom.label"
		},
		{
			"type": "paragraph",
			"content": "t:general.padding.paragraph_mobile.content"
		},
		{
			"type": "range",
			"id": "padding_top_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 50,
			"unit": "px",
			"label": "t:general.padding.top.label"
		},
		{
			"type": "range",
			"id": "padding_bottom_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 50,
			"unit": "px",
			"label": "t:general.padding.bottom.label"
		}
	],
	"blocks": [
		{
			"type": "text",
			"name": "t:sections.collection_list_hover_image.settings.collection.label",
			"settings": [
				{
					"type": "inline_richtext",
					"id": "text",
					"default": "Collection name",
					"label": "t:general.typography.text.label"
				},
				{
					"type": "select",
					"id": "heading_size",
					"options": [
						{
							"value": "h3",
							"label": "t:general.typography.heading_size.option_1.label"
						},
						{
							"value": "h2",
							"label": "t:general.typography.heading_size.option_2.label"
						},
						{
							"value": "h1",
							"label": "t:general.typography.heading_size.option_3.label"
						}
					],
					"default": "h2",
					"label": "t:general.typography.font_size.label"
				},
				{
					"type": "collection",
					"id": "button_link",
					"label": "t:sections.collection_list_hover_image.settings.collection.label"
				},
				{
					"type": "image_picker",
					"id": "icon_image",
					"label": "t:general.image.label"
				},
				{
					"type": "image_picker",
					"id": "image_background",
					"label": "t:general.background.image.label"
				}
			]
		}
	],
	"presets": [
		{
			"name": "t:sections.collection_list_hover_image.name",
			"blocks": [
				{
					"type": "text"
				},
				{
					"type": "text"
				},
				{
					"type": "text"
				},
				{
					"type": "text"
				}
			]
		}
	]
}
{% endschema %}
