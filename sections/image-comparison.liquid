{%- liquid
	assign section_id   = '#shopify-section-' | append: section.id
	assign animation    = settings.section_animation
	assign full         = section.settings.full
	assign image_before = section.settings.image_before
	assign image_after  = section.settings.image_after
	assign heading      = section.settings.heading_text
	assign heading_size = section.settings.heading_size
	assign description  = section.settings.text
	assign button_label = section.settings.button_label
-%}

<style>
	{{ section_id }} .section-wrapper {
		padding-top: {{ section.settings.padding_top_mobile }}px;
		padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
	}

	@media (min-width: 992px) {
		{{ section_id }} .section-wrapper {
			padding-top: {{ section.settings.padding_top }}px;
			padding-bottom: {{ section.settings.padding_bottom }}px;
		}
	}
</style>

<div class="section-wrapper color-{{ section.settings.color_scheme }}">
	<div class="{% if full %}stretch-section stretch-padding{% else %}container{% endif %}">
		<div class="image-comparison{% if animation %} scroll-trigger{% endif %}">
			{%- if heading != blank or description != blank or button_label != blank -%}
				<div class="comparison-text">
					{%- if heading != blank -%}
						<h2 class="heading rte {{ heading_size }}">{{- heading -}}</h2>
					{%- endif -%}

					{%- if description != blank -%}
						<div class="description rte">{{- description -}}</div>
					{%- endif -%}

					{%- if button_label != blank -%}
						<div class="button-comparison">
							<a class="button primary-button" href="{{ section.settings.button_link | default: '#' }}">
								{{- button_label -}}

								{% if settings.select_button == 'direction' %}
									{%- render 'icon', code: 'direction-button' -%}
								{% elsif settings.select_button == 'arrow' %}
									{%- render 'icon', code: 'arrow-button' -%}
								{% endif %}
							</a>
						</div>
					{%- endif -%}
				</div>
			{%- endif -%}

			<div class="c-compare" style="--value: 50%;">
				<div class="c-compare-left">
					{%- liquid
						if image_before != blank
							echo image_before | image_url: width: 1920 | image_tag
						else
							echo 'lifestyle-1' | placeholder_svg_tag
						endif
					-%}
				</div>

				<div class="c-compare-right">
					{%- liquid
						if image_after != blank
							echo image_after | image_url: width: 1920 | image_tag
						else
							echo 'lifestyle-1' | placeholder_svg_tag
						endif
					-%}
				</div>

				<input type="range" min="0" max="100" value="50" class="c-compare-range" data-noui oninput="this.parentNode.style.setProperty( '--value', `${this.value}%` );" >

				<div class="c-circle">
					{%- render 'icon', code: 'vertical-draw' -%}
				</div>
			</div>
		</div>
	</div>
</div>

{% schema %}
{
	"name": "t:sections.image-comparison.name",
	"tag": "section",
	"class": "image-comparison-section",
	"disabled_on": {
		"groups": ["header", "footer"]
	},
	"settings": [
		{
			"type": "checkbox",
			"id": "full",
			"default": false,
			"label": "t:general.layout.full.label"
		},
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"label": "t:settings_schema.colors.label",
			"default": "scheme-1"
		},
		{
			"type": "header",
			"content": "t:sections.image-comparison.settings.header_content.content"
		},
		{
			"type": "inline_richtext",
			"id": "heading_text",
			"default": "Heading text",
			"label": "t:general.typography.heading.label"
		},
		{
			"type": "select",
			"id": "heading_size",
			"options": [
				{
					"value": "h3",
					"label": "t:general.typography.heading_size.option_1.label"
				},
				{
					"value": "h2",
					"label": "t:general.typography.heading_size.option_2.label"
				},
				{
					"value": "h1",
					"label": "t:general.typography.heading_size.option_3.label"
				}
			],
			"default": "h2",
			"label": "t:general.typography.heading_size.label"
		},
		{
			"type": "richtext",
			"id": "text",
			"default": "<p>Pair text with an image to focus on your chosen product, collection, or blog post.</p>",
			"label": "t:general.typography.description.label"
		},
		{
			"type": "text",
			"id": "button_label",
			"default": "Button label",
			"label": "t:general.typography.button_label.label"
		},
		{
			"type": "url",
			"id": "button_link",
			"label": "t:general.typography.button_link.label"
		},
		{
			"type": "header",
			"content": "t:sections.image-comparison.settings.header_image.content"
		},
		{
			"type": "image_picker",
			"id": "image_before",
			"label": "t:sections.image-comparison.settings.image_before.label"
		},
		{
			"type": "image_picker",
			"id": "image_after",
			"label": "t:sections.image-comparison.settings.image_after.label"
		},
		{
			"type": "header",
			"content": "t:general.padding.header_padding.content"
		},
		{
			"type": "range",
			"id": "padding_top",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 50,
			"unit": "px",
			"label": "t:general.padding.top.label"
		},
		{
			"type": "range",
			"id": "padding_bottom",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 50,
			"unit": "px",
			"label": "t:general.padding.bottom.label"
		},
		{
			"type": "paragraph",
			"content": "t:general.padding.paragraph_mobile.content"
		},
		{
			"type": "range",
			"id": "padding_top_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 20,
			"unit": "px",
			"label": "t:general.padding.top.label"
		},
		{
			"type": "range",
			"id": "padding_bottom_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 20,
			"unit": "px",
			"label": "t:general.padding.bottom.label"
		}
	],
	"presets": [
		{
			"name": "t:sections.image-comparison.name"
		}
	]
}
{% endschema %}