{% schema %}
{
  "name": "Collection new Tabs",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Shop Best Sellers"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "By Category"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#c41e3a"
    },
    {
      "type": "color",
      "id": "active_tab_color",
      "label": "Active Tab Color",
      "default": "#0f6b3e"
    },
    {
      "type": "checkbox",
      "id": "show_regular_price",
      "label": "Show Regular Price",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Tab Title",
          "default": "New Tab"
        },
        {
          "type": "checkbox",
          "id": "show_badge",
          "label": "Show Badge",
          "default": false
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge Text",
          "default": "Sale"
        },
        {
          "type": "color",
          "id": "badge_color",
          "label": "Badge Color",
          "default": "#c41e3a"
        },
        {
          "type": "product",
          "id": "product_1",
          "label": "Product 1"
        },
        {
          "type": "product",
          "id": "product_2",
          "label": "Product 2"
        },
        {
          "type": "product",
          "id": "product_3",
          "label": "Product 3"
        },
        {
          "type": "product",
          "id": "product_4",
          "label": "Product 4"
        },
        {
          "type": "product",
          "id": "product_5",
          "label": "Product 5"
        },
        {
          "type": "product",
          "id": "product_6",
          "label": "Product 6"
        },
        {
          "type": "product",
          "id": "product_7",
          "label": "Product 7"
        },
        {
          "type": "product",
          "id": "product_8",
          "label": "Product 8"
        },
        {
          "type": "product",
          "id": "product_9",
          "label": "Product 9"
        },
        {
          "type": "product",
          "id": "product_10",
          "label": "Product 10"
        },
        {
          "type": "product",
          "id": "product_11",
          "label": "Product 11"
        },
        {
          "type": "product",
          "id": "product_12",
          "label": "Product 12"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection new Tabs",
      "category": "Collection",
      "blocks": [
        {
          "type": "tab",
          "settings": {
            "title": "Jars"
          }
        },
        {
          "type": "tab",
          "settings": {
            "title": "Bags"
          }
        },
        {
          "type": "tab",
          "settings": {
            "title": "Bottles"
          }
        }
      ]
    }
  ]
}
{% endschema %}

<style>
  @keyframes sparkleFloat {
    0%, 100% {
      transform: translateY(0px) scale(1);
      opacity: 0.8;
    }
    50% {
      transform: translateY(-20px) scale(1.3);
      opacity: 1;
    }
  }

  @keyframes goldenShine {
    0% {
      background-position: -200% center;
    }
    100% {
      background-position: 200% center;
    }
  }

  .collection-tabs-container {
    max-width: 1400px;
    margin: 0 auto;
    font-family: Poppins, sans-serif;
    position: relative;
    overflow: hidden;
    background: #FFFFFF;
    border-radius: 0;
    box-shadow: none;
  }

  .sparkle-particle {
    position: absolute;
    width: 6px;
    height: 6px;
    background: radial-gradient(circle, #FFD700 0%, #FFA500 100%);
    border-radius: 50%;
    animation: sparkleFloat 3s ease-in-out infinite;
    box-shadow: 0 0 15px #FFD700, 0 0 30px #FFA500;
    pointer-events: none;
  }

  .sparkle-particle:nth-child(1) { top: 5%; left: 5%; animation-delay: 0s; animation-duration: 4s; }
  .sparkle-particle:nth-child(2) { top: 10%; left: 90%; animation-delay: 0.5s; animation-duration: 3.5s; }
  .sparkle-particle:nth-child(3) { top: 20%; left: 20%; animation-delay: 1s; animation-duration: 4.5s; }
  .sparkle-particle:nth-child(4) { top: 30%; left: 80%; animation-delay: 1.5s; animation-duration: 3s; }
  .sparkle-particle:nth-child(5) { top: 50%; left: 10%; animation-delay: 2s; animation-duration: 4s; }
  .sparkle-particle:nth-child(6) { top: 60%; left: 85%; animation-delay: 0.8s; animation-duration: 3.8s; }
  .sparkle-particle:nth-child(7) { top: 70%; left: 30%; animation-delay: 1.2s; animation-duration: 4.2s; }
  .sparkle-particle:nth-child(8) { top: 80%; left: 70%; animation-delay: 1.8s; animation-duration: 3.3s; }

  .star-decoration {
    position: absolute;
    font-size: 30px;
    opacity: 0.6;
    animation: sparkleFloat 5s ease-in-out infinite;
    filter: drop-shadow(0 0 10px #FFD700);
  }

  .star-decoration:nth-child(9) { top: 8%; left: 15%; animation-delay: 0.3s; }
  .star-decoration:nth-child(10) { top: 15%; left: 75%; animation-delay: 1.5s; }
  .star-decoration:nth-child(11) { top: 85%; left: 20%; animation-delay: 2.5s; }
  .star-decoration:nth-child(12) { top: 88%; left: 80%; animation-delay: 0.8s; }

  .collection-tabs-header {
    text-align: center;
    padding: 20px 20px 30px;
    background: transparent;
    color: white;
    position: relative;
    z-index: 10;
  }

  .collection-tabs-header h2 {
    font-size: 55px;
    font-weight: 900;
    margin-bottom: 10px;
    background: linear-gradient(90deg, #FFD700 0%, #FFA500 25%, #FFD700 50%, #FFA500 75%, #FFD700 100%);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: goldenShine 3s linear infinite;
    text-transform: uppercase;
    letter-spacing: 4px;
    filter: drop-shadow(0 0 20px rgba(255, 215, 0, 0.5));
  }

  .collection-tabs-header p {
    font-size: 22px;
    color: #FFD700;
    font-weight: 500;
    text-shadow: 0 0 10px rgba(255, 215, 0, 0.5);
    letter-spacing: 2px;
  }

  .collection-tabs {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 15px;
    padding: 0 0px 20px;
  }

  .collection-tab {
    background: transparent;
    border: 2px solid #FFD700;
    color: #FFD700;
    padding: 15px 40px;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    border-radius: 0;
    transition: all 0.3s ease;
    position: relative;
    text-transform: uppercase;
    letter-spacing: 2px;
    overflow: hidden;
  }

  .collection-tab::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 215, 0, 0.2), transparent);
    transition: left 0.5s ease;
  }

  .collection-tab:hover::before {
    left: 100%;
  }

  .collection-tab:hover {
    background: rgba(255, 215, 0, 0.1);
    box-shadow: 0 0 20px rgba(255, 215, 0, 0.3);
  }

  .collection-tab.active {
    background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
    color: #000000;
    border-color: #FFD700;
    box-shadow: 0 0 30px rgba(255, 215, 0, 0.6);
    font-weight: 900;
  }

  .collection-products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 30px;
    padding: 40px;
    background: transparent;
    min-height: 200px;
  }

  .collection-product-card {
    background: #FFFFFF;
    border: 1px solid rgba(255, 215, 0, 0.3);
    border-radius: 0;
    padding: 20px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.3);
    position: relative;
    overflow: visible;
    transition: all 0.4s ease;
  }

  .collection-product-card::before {
    content: '';
    position: absolute;
    top: -2px;
    left: -2px;
    right: -2px;
    bottom: -2px;
    background: linear-gradient(45deg, #FFD700, #FFA500, #FFD700);
    background-size: 300% 300%;
    animation: goldenShine 3s linear infinite;
    opacity: 0;
    transition: opacity 0.4s ease;
    z-index: -1;
    border-radius: 0;
  }

  .collection-product-card:hover::before {
    opacity: 1;
  }

  .collection-product-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 40px rgba(255, 215, 0, 0.4);
  }

  .collection-badge {
    position: absolute;
    top: 15px;
    left: 15px;
    color: #FFFFFF;
    background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
    padding: 8px 15px;
    border-radius: 0;
    font-size: 12px;
    font-weight: 900;
    z-index: 2;
    text-transform: uppercase;
    letter-spacing: 1px;
    box-shadow: 0 2px 10px rgba(255, 215, 0, 0.5);
  }

  .collection-product-image {
    width: 100%;
    height: 250px;
    border-radius: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    position: relative;
    overflow: hidden;
    background: #f9f9f9;
  }

  .collection-product-image img {
    max-width: 100%;
    object-fit: contain;
    transition: transform 0.4s ease;
  }

  .collection-product-card:hover .collection-product-image img {
    transform: scale(1.08);
  }

  .collection-product-info {
    text-align: center;
  }

  .collection-product-title {
    font-size: 18px;
    font-weight: 700;
    color: #000000;
    margin-bottom: 12px;
    line-height: 1.4;
    min-height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .collection-price-section {
    margin-bottom: 15px;
  }

  .collection-unit-price {
    font-size: 28px;
    color: #000000;
    margin-top: 5px;
    display: block;
    font-weight: 900;
  }

  .collection-buy-button {
    width: 100%;
    background: #000000;
    color: #FFD700;
    border: 2px solid #FFD700;
    padding: 14px 20px;
    border-radius: 0;
    font-size: 16px;
    font-weight: 900;
    cursor: pointer;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 2px;
    position: relative;
    overflow: hidden;
  }

  .collection-buy-button::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 215, 0, 0.3), transparent);
    transition: left 0.5s ease;
  }

  .collection-buy-button:hover::before {
    left: 100%;
  }

  .collection-buy-button:hover {
    background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
    color: #000000;
    box-shadow: 0 0 20px rgba(255, 215, 0, 0.6);
  }

  .collection-cart-icon {
    position: absolute;
    top: 15px;
    right: 15px;
    width: 45px;
    height: 45px;
    background: #000000;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 3;
    border: 2px solid #FFD700;
    transition: all 0.3s ease;
    font-size: 18px;
    color: #FFD700;
  }

  .collection-cart-icon::before {
    content: '🛒';
  }

  .collection-cart-icon:hover {
    transform: scale(1.15) rotate(-5deg);
    background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
    box-shadow: 0 0 20px rgba(255, 215, 0, 0.6);
  }

  .collection-tab-content {
    display: none;
  }

  .collection-tab-content.active {
    display: block;
  }

  .no-products-message {
    text-align: center;
    padding: 60px 20px;
    color: #FFD700;
    font-size: 18px;
    background: rgba(255, 215, 0, 0.05);
    border-radius: 0;
    margin: 20px;
    border: 2px dashed #FFD700;
  }

  .no-products-message h3 {
    color: #FFD700;
    font-size: 24px;
    margin-bottom: 10px;
    font-weight: 900;
  }

  @media (max-width: 768px) {
    .collection-tabs-header h2 {
      font-size: 35px;
    }

    .collection-tabs-header p {
      font-size: 16px;
    }

    .collection-tab {
      padding: 12px 10px;
      font-size: 13px;
    }

    .collection-products-grid {
      grid-template-columns: repeat(auto-fit, minmin(250px, 1fr));
      gap: 20px;
      padding: 20px;
    }

    .collection-product-title {
      font-size: 15px;
      min-height: 40px;
    }

    .collection-product-image {
      height: 200px;
    }
    
    .collection-badge {
      font-size: 10px;
      padding: 6px 12px;
    }
    
    .collection-cart-icon {
      width: 40px;
      height: 40px;
      font-size: 16px;
    }
  }

  @media (max-width: 600px) {
    .collection-products-grid {
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 5px !important;
      padding: 0px 5px !important;
    }

    .collection-product-card {
      padding: 12px !important;
    }

    .collection-product-image {
      height: 160px !important;
      margin-bottom: 12px !important;
    }

    .collection-product-title {
      font-size: 13px !important;
      min-height: 40px !important;
    }

    .collection-unit-price {
      font-size: 20px !important;
    }

    .collection-buy-button {
      padding: 10px !important;
      font-size: 11px !important;
    }

    .collection-cart-icon {
      width: 35px !important;
      height: 35px !important;
      font-size: 14px !important;
    }

    .star-decoration {
      font-size: 20px;
    }
  }
</style>

<div class="collection-tabs-container">
  <!-- Golden Sparkle Particles -->
  <div class="sparkle-particle"></div>
  <div class="sparkle-particle"></div>
  <div class="sparkle-particle"></div>
  <div class="sparkle-particle"></div>
  <div class="sparkle-particle"></div>
  <div class="sparkle-particle"></div>
  <div class="sparkle-particle"></div>
  <div class="sparkle-particle"></div>
  
  <!-- Star Decorations -->
  <div class="star-decoration">⭐</div>
  <div class="star-decoration">⭐</div>
  <div class="star-decoration">⭐</div>
  <div class="star-decoration">⭐</div>

  <div class="collection-tabs-header">
    <h2>{{ section.settings.title }}</h2>
    {% if section.settings.subtitle != blank %}
      <p>{{ section.settings.subtitle }}</p>
    {% endif %}
  </div>

  {% if section.blocks.size > 0 %}
    <div class="collection-tabs">
      {% for block in section.blocks %}
        <button
          class="collection-tab {% if forloop.first %}active{% endif %}"
          data-tab-id="tab-content-{{ forloop.index }}"
          onclick="showCollectionTab('tab-content-{{ forloop.index }}', this)"
        >
          {{ block.settings.title }}
        </button>
      {% endfor %}
    </div>

    {% for block in section.blocks %}
      <div id="tab-content-{{ forloop.index }}" class="collection-tab-content {% if forloop.first %}active{% endif %}">
        <div class="collection-products-grid">
          {% comment %} Count actual products in THIS tab only {% endcomment %}
          {% assign current_tab_product_count = 0 %}
          
          {% comment %} First pass: count products {% endcomment %}
          {% for i in (1..12) %}
            {% capture product_key %}product_{{ i }}{% endcapture %}
            {% assign current_product = block.settings[product_key] %}
            {% if current_product != blank and current_product.id != blank %}
              {% assign current_tab_product_count = current_tab_product_count | plus: 1 %}
            {% endif %}
          {% endfor %}

          {% comment %} Second pass: display products {% endcomment %}
          {% if current_tab_product_count > 0 %}
            {% for i in (1..12) %}
              {% capture product_key %}product_{{ i }}{% endcapture %}
              {% assign current_product = block.settings[product_key] %}
              
              {% if current_product != blank and current_product.id != blank %}
                <div class="collection-product-card">
                  {% if block.settings.show_badge and block.settings.badge_text != blank %}
                    <div class="collection-badge" style="background: {{ block.settings.badge_color }};">
                      {{ block.settings.badge_text }}
                    </div>
                  {% endif %}

                  <div class="collection-cart-icon" onclick="window.location.href='{{ current_product.url }}'"></div>

                  <div class="collection-product-image">
                    {% if current_product.featured_image %}
                      <img
                        src="{{ current_product.featured_image | img_url: '400x' }}"
                        alt="{{ current_product.title | escape }}"
                        loading="lazy"
                      >
                    {% else %}
                      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    {% endif %}
                  </div>

                  <div class="collection-product-info">
                    <div class="collection-product-title">{{ current_product.title }}</div>

                    <div class="collection-price-section">
                      {% if current_product.metafields.custom.unit_price %}
                        <span class="collection-unit-price">${{ current_product.metafields.custom.unit_price }}/UNIT</span>
                      {% elsif current_product.price %}
                        <span class="collection-unit-price">{{ current_product.price | money }}</span>
                      {% endif %}
                    </div>

                    <button class="collection-buy-button" onclick="window.location.href='{{ current_product.url }}'">
                      View Product
                    </button>
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          {% else %}
            <div class="no-products-message">
              <h3>No products selected for "{{ block.settings.title }}" tab</h3>
              <p>Please select products in the theme customizer to display them here.</p>
            </div>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  {% else %}
    <div class="no-products-message">
      <h3>Configure your product tabs</h3>
      <p>Add tabs and select products in the theme customizer to get started.</p>
    </div>
  {% endif %}
</div>

<script>
  function showCollectionTab(tabId, buttonElement) {
    // Hide all tab contents
    const allContents = document.querySelectorAll('.collection-tab-content');
    allContents.forEach(function(content) {
      content.classList.remove('active');
    });

    // Remove active class from all tab buttons
    const allTabs = document.querySelectorAll('.collection-tab');
    allTabs.forEach(function(tab) {
      tab.classList.remove('active');
    });

    // Show the selected tab content
    const selectedTab = document.getElementById(tabId);
    if (selectedTab) {
      selectedTab.classList.add('active');
    }

    // Add active class to the clicked button
    if (buttonElement) {
      buttonElement.classList.add('active');
    }
  }
</script>