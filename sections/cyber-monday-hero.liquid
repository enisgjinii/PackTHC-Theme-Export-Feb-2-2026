<section class="hero-cybermonday-plain" aria-labelledby="hero-cybermonday-plain-heading" style="background: url('{{ section.settings.bg_image | img_url: 'master' }}') center/cover no-repeat;">
  <div class="hero-wrap">
    <h1 id="hero-cybermonday-plain-heading" class="hero-title">{{ section.settings.heading | default: 'Cyber Monday 2025' }}</h1>
    <p class="hero-sub">{{ section.settings.subtext | default: 'Cyber Monday is the day following Black Friday — a great time to grab top deals and limited-time discounts.' }}</p>

    <div class="countdown-area" aria-hidden="false">
      <p class="countdown-label">{{ section.settings.countdown_label }}</p>
      <div id="hero-countdown" class="countdown-timer" role="timer" aria-live="polite" aria-atomic="true" aria-label="Countdown timer"></div>
      <div id="hero-countdown-sr" class="visually-hidden" aria-live="polite"></div>
    </div>
  </div>
</section>

<style>
.visually-hidden{
  position:absolute!important;
  height:1px;width:1px;
  overflow:hidden;
  clip:rect(1px,1px,1px,1px);
  white-space:nowrap;
  border:0;padding:0;margin:-1px;
}

.hero-cybermonday-plain{
  position:relative;
  color:#fff;
  min-height:360px;
  display:flex;
  align-items:center;
  justify-content:center;
  text-align:center;
  overflow:hidden;
  padding:calc(48px + env(safe-area-inset-top)) 20px calc(48px + env(safe-area-inset-bottom));
  background: url('{{ section.settings.bg_image | img_url: "master" }}') center/cover no-repeat;
}

.hero-cybermonday-plain::after{
  content:'';
  position:absolute;
  inset:0;
  background:linear-gradient(180deg, rgba(6,6,10,0.12), rgba(6,6,10,0.40));
  pointer-events:none;
  z-index:0;
}

.hero-wrap{
  position:relative;
  z-index:1;
  max-width:1000px;
  width:100%;
}

.hero-title{
  font-family: Georgia, 'Times New Roman', serif;
  font-weight:500;
  font-size:clamp(28px,4.2vw,56px);
  margin:0 0 12px;
  color:#fff;
}

.hero-sub{
  font-size:clamp(14px,1.6vw,18px);
  opacity:0.92;
  margin:0 auto 22px;
  max-width:820px;
}

/* Countdown container */
.countdown-area{
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:12px;
}

.countdown-label{
  font-weight:700;
  letter-spacing:0.6px;
}

/* Desktop: 4 columns */
.countdown-timer{
  display:grid;
  grid-template-columns: repeat(4, minmax(64px, 1fr));
  gap:12px;
  width:min(760px,100%);
  justify-items:center;
  align-items:center;
  font-family:'Orbitron', system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial;
  font-weight:800;
}

/* Ensure blocks shrink and fill their grid cell */
.count-block{
  width:100%;
  min-width:0;
  background:rgba(255,255,255,0.04);
  border-radius:10px;
  padding:12px;
  text-align:center;
  box-shadow:0 8px 30px rgba(0,0,0,0.45);
  backdrop-filter:blur(4px);
  transition:transform .28s cubic-bezier(.2,.9,.3,1);
  box-sizing:border-box;
}

.count-value{
  display:block;
  font-size:clamp(18px,2.8vw,34px);
  line-height:1;
}

.count-label{
  display:block;
  font-size:12px;
  margin-top:6px;
  font-weight:700;
  letter-spacing:1px;
  text-transform:uppercase;
  opacity:.9;
}

.count-block.pulse{
  animation:pulse-pop .85s ease forwards;
}

@keyframes pulse-pop{
  0%{transform:translateY(0) scale(1)}
  40%{transform:translateY(-6px) scale(1.04)}
  100%{transform:translateY(0) scale(1)}
}

/* Tablet: keep two columns layout but larger spacing */
@media (max-width: 1024px){
  .hero-title{ font-size: clamp(28px,6vw,48px); }
  .hero-sub{ font-size: clamp(15px,2vw,18px); }
  .countdown-timer{ gap:14px; width:100%; max-width:680px; }
}

/* Responsive: Force 4 boxes in one row on all screens below 720px */
@media (max-width: 720px){
  .countdown-timer{
    grid-template-columns: repeat(4, 1fr); /* always 4 in one row */
    gap: 6px;
    width: 100%;
    max-width: 100%;
    justify-items: stretch;
  }

  .count-block{
    padding: 8px 4px;
    min-width: 0;
    width: 100%;
  }

  .count-value{
    font-size: clamp(14px, 4.5vw, 22px);
  }

  .count-label{
    font-size: 10px;
  }
}

/* Extra small phones (prevent overflow, keep 4 in one row) */
@media (max-width: 360px){
  .countdown-timer{
    gap: 4px;
  }

  .count-value{
    font-size: clamp(12px, 4vw, 18px);
  }

  .count-label{
    font-size: 9px;
  }
}


</style>

<script>
(function(){
  const dateString = {{ section.settings.countdown_end_date | json }};
  const countdownEl = document.getElementById('hero-countdown');
  const srEl = document.getElementById('hero-countdown-sr');
  if(!countdownEl) return;
  if(!dateString){countdownEl.innerHTML='<div class="count-block"><span class="count-value">—</span><span class="count-label">No date set</span></div>';srEl.textContent='Countdown date not configured.';return}
  const target = new Date(dateString).getTime();
  if(isNaN(target)){countdownEl.innerHTML='<div class="count-block"><span class="count-value">—</span><span class="count-label">Invalid date</span></div>';srEl.textContent='Countdown end date invalid.';return}
  function pad(n){return String(n).padStart(2,'0')}
  function render(d,h,m,s){return '<div class="count-block" role="presentation"><span class="count-value">'+d+'</span><span class="count-label">Days</span></div>'+
    '<div class="count-block" role="presentation"><span class="count-value">'+pad(h)+'</span><span class="count-label">Hours</span></div>'+
    '<div class="count-block" role="presentation"><span class="count-value">'+pad(m)+'</span><span class="count-label">Minutes</span></div>'+
    '<div class="count-block" role="presentation"><span class="count-value">'+pad(s)+'</span><span class="count-label">Seconds</span></div>'}
  let lastShown = {};
  function update(){
    const now = Date.now();
    let dist = target - now;
    if(dist<=0){clearInterval(timerId);countdownEl.innerHTML='<div class="count-block"><span class="count-value">00</span><span class="count-label">Ended</span></div>';srEl.textContent='Cyber Monday has ended.';return}
    const days = Math.floor(dist/(1000*60*60*24));
    const hours = Math.floor((dist%(1000*60*60*24))/(1000*60*60));
    const minutes = Math.floor((dist%(1000*60*60))/(1000*60));
    const seconds = Math.floor((dist%(1000*60))/1000);
    countdownEl.innerHTML = render(days,hours,minutes,seconds);
    srEl.textContent = 'Time remaining: '+days+' days, '+pad(hours)+' hours, '+pad(minutes)+' minutes and '+pad(seconds)+' seconds.';
    try{
      const blocks = countdownEl.querySelectorAll('.count-block');
      if(blocks.length===4){
        const values = [days,hours,minutes,seconds];
        blocks.forEach(function(b,i){
          const v = String(values[i]);
          const prev = lastShown[i];
          if(String(prev)!==String(v)){
            b.classList.remove('pulse');
            void b.offsetWidth;
            b.classList.add('pulse');
            lastShown[i]=v;
          }
        });
      }
    }catch(e){}
  }
  update();
  const timerId = setInterval(update,1000);
  window.addEventListener('unload',function(){clearInterval(timerId)});
})();
</script>

{% schema %}
{
  "name": "Cyber Monday Hero",
  "settings": [
    {"type":"image_picker","id":"bg_image","label":"Background Image", "info": "Recommended size: 1200 x 600 px"},
    {"type":"text","id":"heading","label":"Heading","default":"Cyber Monday 2025"},
    {"type":"text","id":"subtext","label":"Subtext","default":"Cyber Monday is the day following Black Friday — a great time to grab top deals and limited-time discounts."},
    {"type":"text","id":"countdown_label","label":"Countdown Label","default":"Hurry — sale ends in"},
    {"type":"text","id":"countdown_end_date","label":"Countdown End Date (ISO)","default":"2025-11-30T23:59:59"},
    {"type":"checkbox","id":"hide_on_end","label":"Hide section when sale ends","default":false}
  ],
  "presets": [{"name":"Cyber Monday Hero"}]
}
{% endschema %}
