{% comment %}
  Section: All Strains Page
  File: sections/all-strains.liquid
  CSS Prefix: strx17 — fully unique, zero theme conflicts
{% endcomment %}

<style>
  /* ============================================================
     PREFIX: strx17 — unique to this section, no conflicts
  ============================================================ */

  .strx17-root {
    background: {{ section.settings.color_page_bg | default: '#f4f1eb' }};
    min-height: 100vh;
  }

  .strx17-root *,
  .strx17-root *::before,
  .strx17-root *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  /* ===== WRAPPER ===== */
  .strx17-wrap {
    max-width: {{ section.settings.max_width | default: 1440 }}px;
    margin: 0 auto;
    padding: {{ section.settings.padding_vertical | default: 60 }}px {{ section.settings.padding_horizontal | default: 40 }}px;
  }

  /* ===== HEADER ===== */
  .strx17-hd { margin-bottom: 52px; }

  .strx17-hd-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: {{ section.settings.color_eyebrow | default: '#7a6e5f' }};
    margin-bottom: 18px;
  }

  .strx17-hd-eyebrow::before {
    content: '';
    display: inline-block;
    width: 28px;
    height: 1.5px;
    background: currentColor;
    border-radius: 2px;
  }

  .strx17-hd-title {
    font-size: clamp(40px, 6vw, 78px);
    font-weight: 800;
    color: {{ section.settings.color_title | default: '#1a1611' }};
    line-height: 0.95;
    letter-spacing: -2px;
    margin-bottom: 22px;
  }

  .strx17-hd-title em {
    font-style: italic;
    color: {{ section.settings.color_accent | default: '#4a7c59' }};
  }

  .strx17-hd-count {
    font-size: 13px;
    color: {{ section.settings.color_meta | default: '#7a6e5f' }};
    font-weight: 400;
  }

  .strx17-hd-count b {
    color: {{ section.settings.color_title | default: '#1a1611' }};
    font-weight: 600;
  }

  /* ===== CONTROLS ROW ===== */
  .strx17-ctrl {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 44px;
    flex-wrap: wrap;
  }

  /* ===== TABS ===== */
  .strx17-tabs {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    flex: 1;
  }

  .strx17-tabx {
    font-size: 13px;
    font-weight: 500;
    padding: 10px 22px;
    border-radius: 100px;
    border: 1.5px solid {{ section.settings.color_tab_border | default: '#ccc5b5' }};
    background: transparent;
    color: {{ section.settings.color_tab_text | default: '#5a5347' }};
    cursor: pointer;
    transition: all 0.22s ease;
    white-space: nowrap;
    letter-spacing: 0.3px;
  }

  .strx17-tabx:hover {
    border-color: {{ section.settings.color_accent | default: '#4a7c59' }};
    color: {{ section.settings.color_accent | default: '#4a7c59' }};
    background: {{ section.settings.color_tab_hover_bg | default: '#edf4ef' }};
  }

  .strx17-tabx.strx17-tabx-on {
    background: {{ section.settings.color_tab_active_bg | default: '#1a1611' }};
    color: {{ section.settings.color_tab_active_text | default: '#f4f1eb' }};
    border-color: {{ section.settings.color_tab_active_bg | default: '#1a1611' }};
  }

  /* ===== SEARCH ===== */
  .strx17-sq-wrap { position: relative; flex-shrink: 0; }

  .strx17-sq-box {
    display: flex;
    align-items: center;
    background: {{ section.settings.color_search_bg | default: '#ffffff' }};
    border: 1.5px solid {{ section.settings.color_tab_border | default: '#ccc5b5' }};
    border-radius: 100px;
    overflow: hidden;
    transition: width 0.35s cubic-bezier(0.4,0,0.2,1), border-color 0.25s, box-shadow 0.25s;
    width: 52px;
  }

  .strx17-sq-box.strx17-sq-on {
    width: 310px;
    border-color: {{ section.settings.color_accent | default: '#4a7c59' }};
    box-shadow: 0 0 0 4px {{ section.settings.color_accent | default: '#4a7c59' }}18;
  }

  .strx17-sq-icobtn {
    flex-shrink: 0;
    width: 50px;
    height: 50px;
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ section.settings.color_search_icon | default: '#5a5347' }};
    transition: color 0.2s;
  }

  .strx17-sq-box.strx17-sq-on .strx17-sq-icobtn {
    color: {{ section.settings.color_accent | default: '#4a7c59' }};
  }

  .strx17-sq-field {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    font-size: 14px;
    color: {{ section.settings.color_title | default: '#1a1611' }};
    padding: 0;
    width: 0;
    opacity: 0;
    transition: opacity 0.3s ease;
    min-width: 0;
  }

  .strx17-sq-box.strx17-sq-on .strx17-sq-field {
    width: auto;
    opacity: 1;
    padding-right: 4px;
  }

  .strx17-sq-field::placeholder {
    color: {{ section.settings.color_meta | default: '#b0a898' }};
  }

  .strx17-sq-xbtn {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    margin-right: 11px;
    background: {{ section.settings.color_clear_bg | default: '#e8e3d9' }};
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: none;
    align-items: center;
    justify-content: center;
    color: {{ section.settings.color_meta | default: '#5a5347' }};
    transition: background 0.2s, color 0.2s, transform 0.15s;
  }

  .strx17-sq-xbtn:hover {
    background: {{ section.settings.color_tab_border | default: '#ccc5b5' }};
    color: {{ section.settings.color_title | default: '#1a1611' }};
    transform: scale(1.1);
  }

  .strx17-sq-xbtn.strx17-xbtn-show { display: flex; }

  /* ===== GRID ===== */
  .strx17-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.grid_columns | default: 4 }}, 1fr);
    gap: {{ section.settings.card_gap | default: 20 }}px;
  }

  /* ===== CARD ===== */
  .strx17-crd {
    background: {{ section.settings.color_card_bg | default: '#ffffff' }};
    border-radius: {{ section.settings.card_radius | default: 16 }}px;
    overflow: hidden;
    transition: transform 0.38s cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.35s ease;
    box-shadow: 0 1px 4px rgba(0,0,0,0.06);
    cursor: pointer;
  }

  .strx17-crd:hover {
    box-shadow: rgba(0, 0, 0, 0.24) 0px 3px 8px;
  }

  .strx17-crd.strx17-crd-hide { display: none; }

  .strx17-crd-img {
    position: relative;
    width: 100%;
    height: {{ section.settings.card_img_height | default: 260 }}px;
    overflow: hidden;
    background: {{ section.settings.color_img_fallback | default: '#e8e3d9' }};
  }

  .strx17-crd-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
    display: block;
  }

  .strx17-crd:hover .strx17-crd-img img { transform: scale(1.07); }

  .strx17-crd-pill {
    position: absolute;
    top: 13px;
    left: 13px;
    background: {{ section.settings.color_pill_bg | default: '#f4f1ebeb' }};
    backdrop-filter: blur(8px);
    color: {{ section.settings.color_accent | default: '#4a7c59' }};
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    padding: 5px 12px;
    border-radius: 100px;
    border: 1px solid {{ section.settings.color_accent | default: '#4a7c59' }}33;
  }

  .strx17-crd-body {
    padding: 20px 20px 22px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .strx17-crd-name {
    font-size: 18px;
    font-weight: 700;
    color: {{ section.settings.color_card_title | default: '#1a1611' }};
    line-height: 1.2;
    letter-spacing: -0.3px;
  }

  .strx17-crd-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 20px;
    background: {{ section.settings.color_btn_bg | default: '#1a1611' }};
    color: {{ section.settings.color_btn_text | default: '#f4f1eb' }};
    text-decoration: none;
    border-radius: {{ section.settings.btn_radius | default: 10 }}px;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.3px;
    transition: background 0.25s ease, gap 0.25s ease, transform 0.2s ease;
    align-self: flex-start;
  }

  .strx17-crd-btn:hover {
    background: {{ section.settings.color_btn_hover | default: '#4a7c59' }};
    color: {{ section.settings.color_btn_hover_text | default: '#ffffff' }};
    gap: 13px;
    transform: translateY(-1px);
  }

  .strx17-crd-btn svg { transition: transform 0.25s ease; flex-shrink: 0; }
  .strx17-crd-btn:hover svg { transform: translateX(3px); }

  /* ===== NO RESULTS ===== */
  .strx17-nores {
    display: none;
    grid-column: 1 / -1;
    text-align: center;
    padding: 80px 20px;
  }

  .strx17-nores.strx17-nores-on { display: block; }

  .strx17-nores-ico {
    width: 64px;
    height: 64px;
    margin: 0 auto 20px;
    background: {{ section.settings.color_clear_bg | default: '#e8e3d9' }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ section.settings.color_meta | default: '#9a9080' }};
  }

  .strx17-nores-ttl {
    font-size: 24px;
    font-weight: 700;
    color: {{ section.settings.color_title | default: '#1a1611' }};
    margin-bottom: 10px;
  }

  .strx17-nores-txt {
    font-size: 14px;
    color: {{ section.settings.color_meta | default: '#7a6e5f' }};
    margin-bottom: 28px;
    line-height: 1.6;
  }

  .strx17-nores-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 32px;
    background: {{ section.settings.color_accent | default: '#4a7c59' }};
    color: white;
    text-decoration: none;
    border-radius: 100px;
    font-size: 14px;
    font-weight: 600;
    transition: background 0.25s, transform 0.25s, box-shadow 0.25s;
  }

  .strx17-nores-link:hover {
    background: {{ section.settings.color_title | default: '#1a1611' }};
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(0,0,0,0.15);
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 1200px) {
    .strx17-grid { grid-template-columns: repeat(3, 1fr); }
  }

  @media (max-width: 900px) {
    .strx17-wrap { padding: 40px 20px 60px; }
    .strx17-grid { grid-template-columns: repeat(2, 1fr); }
    .strx17-ctrl { flex-direction: column; align-items: flex-start; }
    .strx17-sq-wrap { width: 100%; }
    .strx17-sq-box { width: 100% !important; }
    .strx17-sq-field { opacity: 1 !important; width: auto !important; padding-right: 8px !important; }
  }

  @media (max-width: 560px) {
    .strx17-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    .strx17-hd-title { letter-spacing: -1px; }
    .strx17-crd-img { height: 170px; }
    .strx17-crd-name { font-size: 14px; }
    .strx17-crd-body { padding: 12px 12px 14px; gap: 10px; }
    .strx17-crd-btn { font-size: 11px; padding: 8px 13px; }
  }
</style>

<div class="strx17-root">
  <div class="strx17-wrap">
    <!-- HEADER -->
    <div class="strx17-hd">
      {% if section.settings.eyebrow != blank %}
        <div class="strx17-hd-eyebrow">{{ section.settings.eyebrow }}</div>
      {% endif %}
      <h1 class="strx17-hd-title">{{ section.settings.title }}</h1>
      <p class="strx17-hd-count">
        <b class="strx17-cnt">
          {% assign total_cards = 0 %}
          {% for block in section.blocks -%}
            {%- if block.type == 'strain_card' %}{% assign total_cards = total_cards | plus: 1 %}{% endif -%}
          {%- endfor %}
          {{ total_cards }}
        </b>
        strains available
      </p>
    </div>

    <!-- CONTROLS -->
    <div class="strx17-ctrl">
      <!-- Tabs -->
      <div class="strx17-tabs">
        <button class="strx17-tabx strx17-tabx-on" onclick="strx17Go('all',this)">
          {{ section.settings.tab_all_label | default: 'All' }}
        </button>
        {% for block in section.blocks %}
          {% if block.type == 'categories' %}
            {% assign cat_list = block.settings.categories | split: ',' %}
            {% for cat in cat_list %}
              {% assign ct = cat | strip %}
              {% if ct != blank %}
                <button class="strx17-tabx" onclick="strx17Go('{{ ct | downcase | replace: ' ', '-' }}',this)">
                  {{ ct }}
                </button>
              {% endif %}
            {% endfor %}
          {% endif %}
        {% endfor %}
      </div>

      <!-- Search -->
      <div class="strx17-sq-wrap">
        <div class="strx17-sq-box" id="strx17Bx">
          <button class="strx17-sq-icobtn" onclick="strx17Tog()" aria-label="Search">
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="11" cy="11" r="8"/>
              <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
          </button>
          <input
            type="text"
            class="strx17-sq-field"
            id="strx17Fld"
            placeholder="{{ section.settings.search_placeholder | default: 'Search strains...' }}"
            oninput="strx17Srch(this.value)"
            aria-label="Search strains"
          >
          <button class="strx17-sq-xbtn" id="strx17Xbtn" onclick="strx17Clr()" aria-label="Clear">
            <svg
              width="13"
              height="13"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="18" y1="6" x2="6" y2="18"/>
              <line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- GRID -->
    <div class="strx17-grid" id="strx17Grid">
      {% for block in section.blocks %}
        {% if block.type == 'strain_card' %}
          {% assign slug = block.settings.category | downcase | replace: ' ', '-' %}
          <a
            href="{{ block.settings.link }}"
            class="strx17-crd"
            data-cat="{{ slug }}"
            data-nm="{{ block.settings.name | downcase }}"
            {{ block.shopify_attributes }}
          >
            <div class="strx17-crd-img">
              {% if block.settings.image %}
                {{
                  block.settings.image
                  | image_url: width: 600
                  | image_tag: alt: block.settings.name, loading: 'lazy'
                }}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}
              {% if block.settings.category != blank %}
                <div class="strx17-crd-pill">{{ block.settings.category }}</div>
              {% endif %}
            </div>
            <div class="strx17-crd-body">
              <div class="strx17-crd-name">{{ block.settings.name }}</div>
              <span class="strx17-crd-btn">
                {{ section.settings.btn_label | default: 'View Strain' }}
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <line x1="5" y1="12" x2="19" y2="12"/>
                  <polyline points="12 5 19 12 12 19"/>
                </svg>
              </span>
            </div>
          </a>
        {% endif %}
      {% endfor %}

      <!-- No Results -->
      <div class="strx17-nores" id="strx17NR">
        <div class="strx17-nores-ico">
          <svg
            width="28"
            height="28"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="11" cy="11" r="8"/>
            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            <line x1="8" y1="11" x2="14" y2="11"/>
          </svg>
        </div>
        <div class="strx17-nores-ttl">{{ section.settings.no_results_title | default: 'No strains found' }}</div>
        <p class="strx17-nores-txt">
          {{ section.settings.no_results_text | default: 'Try a different search or browse all available strains.' }}
        </p>
        {% if section.settings.see_all_url != blank %}
          <a href="{{ section.settings.see_all_url }}" class="strx17-nores-link">
            {{ section.settings.see_all_label | default: 'Browse All Strains' }}
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="5" y1="12" x2="19" y2="12"/>
              <polyline points="12 5 19 12 12 19"/>
            </svg>
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    var _cat = 'all',
      _q = '',
      _open = false;

    window.strx17Tog = function () {
      var bx = document.getElementById('strx17Bx'),
        fld = document.getElementById('strx17Fld');
      _open = !_open;
      bx.classList.toggle('strx17-sq-on', _open);
      if (_open) {
        setTimeout(function () {
          fld.focus();
        }, 320);
      } else {
        strx17Clr();
      }
    };

    window.strx17Clr = function () {
      var fld = document.getElementById('strx17Fld'),
        xb = document.getElementById('strx17Xbtn');
      fld.value = '';
      _q = '';
      xb.classList.remove('strx17-xbtn-show');
      strx17Rnd();
    };

    window.strx17Srch = function (v) {
      var xb = document.getElementById('strx17Xbtn');
      _q = v.toLowerCase().trim();
      xb.classList.toggle('strx17-xbtn-show', _q.length > 0);
      strx17Rnd();
    };

    window.strx17Go = function (cat, el) {
      _cat = cat;
      document.querySelectorAll('.strx17-tabx').forEach(function (b) {
        b.classList.remove('strx17-tabx-on');
      });
      el.classList.add('strx17-tabx-on');
      strx17Rnd();
    };

    function strx17Rnd() {
      var cards = document.querySelectorAll('#strx17Grid .strx17-crd[data-nm]'),
        nr = document.getElementById('strx17NR'),
        cnt = document.querySelector('.strx17-cnt'),
        vis = 0;
      cards.forEach(function (c) {
        var ok = (_cat === 'all' || c.dataset.cat === _cat) && (!_q || c.dataset.nm.indexOf(_q) !== -1);
        c.classList.toggle('strx17-crd-hide', !ok);
        if (ok) vis++;
      });
      if (cnt) cnt.textContent = vis;
      nr.classList.toggle('strx17-nores-on', vis === 0);
    }

    document.addEventListener('click', function (e) {
      var bx = document.getElementById('strx17Bx'),
        fld = document.getElementById('strx17Fld');
      if (_open && !bx.contains(e.target) && fld.value === '') {
        _open = false;
        bx.classList.remove('strx17-sq-on');
      }
    });
  })();
</script>

{% schema %}
{
  "name": "All Strains Page",
  "tag": "section",
  "class": "all-strains-section",
  "settings": [
    { "type": "header", "content": "📄 Page Header" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow Text", "default": "Our Collection" },
    { "type": "text", "id": "title", "label": "Title (use <em> for accent color)", "default": "All <em>Strains</em>" },

    { "type": "header", "content": "🏷️ Labels & Text" },
    { "type": "text", "id": "tab_all_label", "label": "\"All\" Tab Label", "default": "All" },
    { "type": "text", "id": "btn_label", "label": "Card Button Text", "default": "View Strain" },
    { "type": "text", "id": "search_placeholder", "label": "Search Placeholder", "default": "Search strains..." },
    { "type": "text", "id": "no_results_title", "label": "No Results Title", "default": "No strains found" },
    {
      "type": "text",
      "id": "no_results_text",
      "label": "No Results Subtitle",
      "default": "Try a different search or browse all available strains."
    },
    { "type": "url", "id": "see_all_url", "label": "\"See All\" Button URL" },
    { "type": "text", "id": "see_all_label", "label": "\"See All\" Button Text", "default": "Browse All Strains" },

    { "type": "header", "content": "🎨 Colors — Page & Text" },
    { "type": "color", "id": "color_page_bg", "label": "Page Background", "default": "#f4f1eb" },
    { "type": "color", "id": "color_title", "label": "Heading & Strong Text", "default": "#1a1611" },
    { "type": "color", "id": "color_eyebrow", "label": "Eyebrow Text Color", "default": "#7a6e5f" },
    { "type": "color", "id": "color_meta", "label": "Secondary / Muted Text", "default": "#7a6e5f" },
    { "type": "color", "id": "color_accent", "label": "Accent Color (green)", "default": "#4a7c59" },

    { "type": "header", "content": "🎨 Colors — Tabs" },
    { "type": "color", "id": "color_tab_border", "label": "Tab Border (inactive)", "default": "#ccc5b5" },
    { "type": "color", "id": "color_tab_text", "label": "Tab Text (inactive)", "default": "#5a5347" },
    { "type": "color", "id": "color_tab_hover_bg", "label": "Tab Hover Background", "default": "#edf4ef" },
    { "type": "color", "id": "color_tab_active_bg", "label": "Active Tab Background", "default": "#1a1611" },
    { "type": "color", "id": "color_tab_active_text", "label": "Active Tab Text", "default": "#f4f1eb" },

    { "type": "header", "content": "🎨 Colors — Search Bar" },
