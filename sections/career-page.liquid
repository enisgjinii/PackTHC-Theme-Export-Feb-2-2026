          }
        },
        {
          "type": "job_listing",
          "settings": {
            "job_title": "Web Developer",
            "job_type": "Remote",
            "job_description": "Encompasses a long list of tasks including web design, front and back-end development & server management.",
            "location": "New York",
            "salary": "$45k-55k"
          }
        },
        {
          "type": "job_listing",
          "settings": {
            "job_title": "Digital Marketer",
            "job_type": "Full Time",
            "job_description": "Marketing efforts closely, with our deep intents, such as product development, sales & analytics requirement.",
            "location": "London, UK",
            "salary": "$30k-40k"
          }
        },
        {
          "type": "job_listing",
          "settings": {
            "job_title": "Sales",
            "job_type": "Remote",
            "job_description": "Encompasses a mix of task including web design, front and back-end development, & server management.",
            "location": "United State",
            "salary": "$35k-50k"
          }
        }
      ]
    }
  ]
}
{% endschema %}

